--- Connects UI signals to tab buttons and queue action buttons.
bindEvents = function()
	if not modeTab1v1 or not modeTab2v2 or not queueButton or not cancelButton then
		return
	end

	modeTab1v1.MouseButton1Click:Connect(function()
		if not isInQueue then
			currentMode = "1v1"
			updateTabStyles()
		end
	end)

	modeTab2v2.MouseButton1Click:Connect(function()
		if not isInQueue then
			currentMode = "2v2"
			updateTabStyles()
		end
	end)

	queueButton.MouseButton1Click:Connect(function()
		if not isInQueue then
			MatchmakingQueueUI.StartQueue()
		end
	end)

	cancelButton.MouseButton1Click:Connect(function()
		if isInQueue then
			MatchmakingQueueUI.CancelQueue()
		end
	end)

	-- Network Listeners
	local statusRemote = QueueEvents.GetRemoteEvent("QueueStatusUpdate")
	statusRemote.OnClientEvent:Connect(function(payload: QueueEvents.QueueStatusData)
		isInQueue = payload.inQueue

		if queueStatusLabel then
			if payload.inQueue then
				queueStatusLabel.Text = string.format("Searching for %s Match (%d in queue)...", payload.mode or currentMode, payload.playersInQueue)
			else
				queueStatusLabel.Text = "Select Mode and Enter Queue"
			end
		end

		if queueButton and cancelButton then
			queueButton.Visible = not payload.inQueue
			cancelButton.Visible = payload.inQueue
		end

		if payload.inQueue then
			startQueueTimer()
		else
			stopQueueTimer()
		end
	end)

	local matchFoundRemote = QueueEvents.GetRemoteEvent("QueueMatchFound")
	matchFoundRemote.OnClientEvent:Connect(function(data: QueueEvents.MatchFoundData)
		MatchmakingQueueUI.ShowMatchFound(data)
	end)

	local voteUpdateRemote = QueueEvents.GetRemoteEvent("MapVoteUpdate")
	voteUpdateRemote.OnClientEvent:Connect(function(result: QueueEvents.MapVoteResult)
		MatchmakingQueueUI.UpdateVoteResults(result)
	end)
end

--- Enters the current queue mode via network remote function.
function MatchmakingQueueUI.StartQueue()
	local enterFn = QueueEvents.GetRemoteFunction("QueueEnter")
	local success, reason = enterFn:InvokeServer(currentMode)

	if success then
		isInQueue = true
		if queueStatusLabel then
			queueStatusLabel.Text = "Searching for " .. currentMode .. " Match..."
		end
		if queueButton and cancelButton then
			queueButton.Visible = false
			cancelButton.Visible = true
		end
		startQueueTimer()
	else
		if queueStatusLabel then
			queueStatusLabel.Text = "Queue Error: " .. (reason or "Failed to enter queue")
		end
	end
end

--- Cancels and leaves the active queue via network remote function.
function MatchmakingQueueUI.CancelQueue()
	local leaveFn = QueueEvents.GetRemoteFunction("QueueLeave")
	local success, reason = leaveFn:InvokeServer()

	if success then
		isInQueue = false
		stopQueueTimer()
		if queueStatusLabel then
			queueStatusLabel.Text = "Select Mode and Enter Queue"
		end
		if queueButton and cancelButton then
			queueButton.Visible = true
			cancelButton.Visible = false
		end
	else
		if queueStatusLabel then
			queueStatusLabel.Text = "Cancel Error: " .. (reason or "Failed to leave queue")
		end
	end
end

--- Displays the Match Found notification modal and map voting grid.
function MatchmakingQueueUI.ShowMatchFound(data: QueueEvents.MatchFoundData)
	isInQueue = false
	stopQueueTimer()
	activeMatchId = data.matchId
	userVotedMap = nil

	if mainFrame then
		mainFrame.Visible = false
	end

	if matchModalFrame then
		matchModalFrame.Visible = true
		matchModalFrame.Size = UDim2.new(0, 10, 0, 10)
		matchModalFrame.Position = UDim2.new(0.5, -5, 0.5, -5)
		TweenService:Create(matchModalFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 720, 0, 520),
			Position = UDim2.new(0.5, -360, 0.5, -260),
		}):Play()
	end

	if matchTitleLabel then
		matchTitleLabel.Text = string.format("MATCH FOUND (%s) — VOTE FOR MAP", data.mode)
	end

	if winnerAnnounceLabel then
		winnerAnnounceLabel.Text = ""
	end

	-- Render Team Roster
	if teamsContainer then
		for _, child in ipairs(teamsContainer:GetChildren()) do
			if not child:IsA("UICorner") then
				child:Destroy()
			end
		end

		local team1Text = "Team 1: "
		for i, tm in ipairs(data.teammates) do
			team1Text ..= tm.displayName .. (i &lt; #data.teammates and ", " or "")
		end

		local team2Text = "VS  Team 2: "
		for i, op in ipairs(data.opponents) do
			team2Text ..= op.displayName .. (i &lt; #data.opponents and ", " or "")
		end

		local rosterLabel = Instance.new("TextLabel")
		rosterLabel.Size = UDim2.new(1, -20, 1, 0)
		rosterLabel.Position = UDim2.new(0, 10, 0, 0)
		rosterLabel.BackgroundTransparency = 1
		rosterLabel.Text = team1Text .. "   " .. team2Text
		rosterLabel.TextColor3 = Color3.fromRGB(220, 220, 235)
		rosterLabel.TextSize = 13
		rosterLabel.Font = Enum.Font.GothamBold
		rosterLabel.Parent = teamsContainer
	end

	-- Reset Voting Card States
	for mapName, cardInfo in pairs(mapCards) do
		cardInfo.voteCountLabel.Text = "Votes: 0"
		cardInfo.voteButton.BackgroundColor3 = Color3.fromRGB(0, 140, 230)
		cardInfo.voteButton.Text = "VOTE MAP"
	end

	-- Voting Timer Countdown
	task.spawn(function()
		local remaining = data.votingDurationSeconds
		while remaining &gt; 0 and activeMatchId == data.matchId do
			if matchTimerLabel then
				matchTimerLabel.Text = string.format("Voting Ends In: %ds", remaining)
			end
			task.wait(1.0)
			remaining -= 1
		end
	end)
end

--- Submits map vote selection for the current active match.
function MatchmakingQueueUI.VoteForMap(mapName: string)
	if not activeMatchId then
		return
	end

	userVotedMap = mapName

	for mName, cardInfo in pairs(mapCards) do
		if mName == mapName then
			cardInfo.voteButton.BackgroundColor3 = Color3.fromRGB(0, 220, 120)
			cardInfo.voteButton.Text = "VOTED ✓"
		else
			cardInfo.voteButton.BackgroundColor3 = Color3.fromRGB(45, 48, 60)
			cardInfo.voteButton.Text = "VOTE MAP"
		end
	end

	local voteFn = QueueEvents.GetRemoteFunction("MapVoteSubmit")
	voteFn:InvokeServer(activeMatchId, mapName)
end

--- Updates the voting tallies and winner announcement modal.
function MatchmakingQueueUI.UpdateVoteResults(result: QueueEvents.MapVoteResult)
	if activeMatchId ~= result.matchId then
		return
	end

	for mapName, cardInfo in pairs(mapCards) do
		local count = result.mapVotes[mapName] or 0
		cardInfo.voteCountLabel.Text = "Votes: " .. tostring(count)
	end

	if result.votingEnded and result.winningMap then
		if winnerAnnounceLabel then
			winnerAnnounceLabel.Text = string.format("WINNING MAP: %s! Teleporting to Arena...", string.upper(result.winningMap))
		end

		if matchTimerLabel then
			matchTimerLabel.Text = "MAP SELECTED!"
		end

		task.delay(3.0, function()
			if matchModalFrame then
				matchModalFrame.Visible = false
			end
			if mainFrame then
				mainFrame.Visible = true
			end
			activeMatchId = nil
		end)
	end
end

--- Shows the main queue panel.
function MatchmakingQueueUI.ShowQueuePanel()
	if screenGui then
		screenGui.Enabled = true
	end
	if mainFrame then
		mainFrame.Visible = true
	end
	if matchModalFrame then
		matchModalFrame.Visible = false
	end
end

--- Hides the queue panel.
function MatchmakingQueueUI.HideQueuePanel()
	if screenGui then
		screenGui.Enabled = false
	end
	if mainFrame then
		mainFrame.Visible = false
	end
	if matchModalFrame then
		matchModalFrame.Visible = false
	end
end

--- Returns true if queue panel is currently visible.
function MatchmakingQueueUI.IsVisible(): boolean
	return screenGui ~= nil and screenGui.Enabled and mainFrame ~= nil and mainFrame.Visible
end

--- Initializes the MatchmakingQueueUI module.
function MatchmakingQueueUI.Initialize(targetPlayerGui: PlayerGui?)
	if isUIInitialized then
		return
	end
	isUIInitialized = true

	local playerGui = targetPlayerGui or Players.LocalPlayer:WaitForChild("PlayerGui")
	createUIElements(playerGui)
	bindEvents()
end

return MatchmakingQueueUI
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX104"><Properties><string name="Name">PlayerListChallengeUI</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: PlayerListChallengeUI
    Client-side player list / leaderboard UI displaying online players,
    their current lobby status ("In Lobby", "In Queue", "In Match"),
    and a "Challenge 1v1" action button to send direct 1v1 duel invites.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ChallengeEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("ChallengeEvents"))

export type PlayerStatusMap = { [number]: string }

local PlayerListChallengeUI = {}

local screenGui: ScreenGui? = nil
local mainFrame: Frame? = nil
local listScrollFrame: ScrollingFrame? = nil
local toggleButton: TextButton? = nil

local isUIInitialized = false
local isVisible = true
local cachedStatuses: { [number]: string } = {}

local STATUS_COLORS: { [string]: Color3 } = {
	["In Lobby"] = Color3.fromRGB(0, 220, 120),
	["In Queue"] = Color3.fromRGB(255, 190, 0),
	["In Match"] = Color3.fromRGB(230, 60, 70),
}

local function getStatusColor(status: string): Color3
	return STATUS_COLORS[status] or Color3.fromRGB(180, 180, 180)
end

--- Sends a direct 1v1 challenge to a target player UserId.
local function sendChallengeToUser(targetUserId: number)
	local localPlayer = Players.LocalPlayer
	if not localPlayer or localPlayer.UserId == targetUserId then
		return
	end

	local sendRemote = ChallengeEvents.GetRemoteEvent("ChallengeSend")
	sendRemote:FireServer(targetUserId)
end

--- Clears and rebuilds the player entry rows in the scrolling container.
function PlayerListChallengeUI.UpdatePlayerList()
	if not listScrollFrame then
		return
	end

	for _, child in ipairs(listScrollFrame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	local localPlayer = Players.LocalPlayer
	local localUserId = if localPlayer then localPlayer.UserId else 0
	local localStatus = cachedStatuses[localUserId] or "In Lobby"

	local onlinePlayers = Players:GetPlayers()

	for idx, player in ipairs(onlinePlayers) do
		local userId = player.UserId
		local status = cachedStatuses[userId] or "In Lobby"
		local isSelf = (userId == localUserId)

		local row = Instance.new("Frame")
		row.Name = "PlayerRow_" .. tostring(userId)
		row.Size = UDim2.new(1, 0, 0, 42)
		row.BackgroundColor3 = Color3.fromRGB(30, 33, 44)
		row.BorderSizePixel = 0
		row.LayoutOrder = idx
		row.Parent = listScrollFrame

		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 6)
		rowCorner.Parent = row

		-- Name Label
		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "NameLabel"
		nameLabel.Size = UDim2.new(0.42, 0, 1, 0)
		nameLabel.Position = UDim2.new(0, 10, 0, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = player.DisplayName .. (isSelf and " (You)" or "")
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextSize = 13
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = row

		-- Status Tag Frame
		local statusTag = Instance.new("Frame")
		statusTag.Name = "StatusTag"
		statusTag.Size = UDim2.new(0.24, 0, 0, 24)
		statusTag.Position = UDim2.new(0.43, 0, 0.5, -12)
		statusTag.BackgroundColor3 = getStatusColor(status)
		statusTag.BackgroundTransparency = 0.8
		statusTag.Parent = row

		local tagCorner = Instance.new("UICorner")
		tagCorner.CornerRadius = UDim.new(0, 4)
		tagCorner.Parent = statusTag

		local tagStroke = Instance.new("UIStroke")
		tagStroke.Color = getStatusColor(status)
		tagStroke.Thickness = 1
		tagStroke.Parent = statusTag

		local statusLabel = Instance.new("TextLabel")
		statusLabel.Size = UDim2.new(1, 0, 1, 0)
		statusLabel.BackgroundTransparency = 1
		statusLabel.Text = status
		statusLabel.TextColor3 = getStatusColor(status)
		statusLabel.TextSize = 10
		statusLabel.Font = Enum.Font.GothamBold
		statusLabel.Parent = statusTag

		-- Challenge 1v1 Action Button
		local challengeBtn = Instance.new("TextButton")
		challengeBtn.Name = "ChallengeButton"
		challengeBtn.Size = UDim2.new(0.28, -10, 0, 28)
		challengeBtn.Position = UDim2.new(0.70, 5, 0.5, -14)
		challengeBtn.Font = Enum.Font.GothamBold
		challengeBtn.TextSize = 11
		challengeBtn.Parent = row

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = challengeBtn

		if isSelf then
			challengeBtn.Text = "YOU"
			challengeBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
			challengeBtn.TextColor3 = Color3.fromRGB(140, 140, 150)
			challengeBtn.AutoButtonColor = false
		elseif status ~= "In Lobby" or localStatus ~= "In Lobby" then
			challengeBtn.Text = "BUSY"
			challengeBtn.BackgroundColor3 = Color3.fromRGB(55, 60, 70)
			challengeBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
			challengeBtn.AutoButtonColor = false
		else
			challengeBtn.Text = "CHALLENGE 1v1"
			challengeBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
			challengeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			challengeBtn.AutoButtonColor = true

			challengeBtn.MouseButton1Click:Connect(function()
				sendChallengeToUser(userId)
			end)
		end
	end

	if listScrollFrame then
		listScrollFrame.CanvasSize = UDim2.new(0, 0, 0, #onlinePlayers * 48)
	end
end

--- Updates the stored status for a given user ID and refreshes UI.
function PlayerListChallengeUI.SetPlayerStatus(userId: number, status: string)
	cachedStatuses[userId] = status
	PlayerListChallengeUI.UpdatePlayerList()
end

--- Toggles the visibility of the player list UI panel.
function PlayerListChallengeUI.ToggleVisibility()
	if not mainFrame then
		return
	end
	isVisible = not isVisible
	mainFrame.Visible = isVisible
end

--- Explicitly sets the visibility of the player list UI panel.
function PlayerListChallengeUI.SetVisible(visible: boolean)
	isVisible = visible
	if mainFrame then
		mainFrame.Visible = visible
	end
end

local function createUIElements(targetParent: Instance)
	local gui = Instance.new("ScreenGui")
	gui.Name = "PlayerListChallengeGui"
	gui.ResetOnSpawn = false
	gui.Parent = targetParent
	screenGui = gui

	-- Main Container Panel
	local panel = Instance.new("Frame")
	panel.Name = "PlayerListPanel"
	panel.Size = UDim2.new(0, 360, 0, 380)
	panel.Position = UDim2.new(1, -380, 0, 60)
	panel.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
	panel.BorderSizePixel = 0
	panel.Parent = gui
	mainFrame = panel

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 10)
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = Color3.fromRGB(50, 55, 70)
	panelStroke.Thickness = 2
	panelStroke.Parent = panel

	-- Header Title
	local header = Instance.new("TextLabel")
	header.Name = "HeaderLabel"
	header.Size = UDim2.new(1, -50, 0, 45)
	header.Position = UDim2.new(0, 15, 0, 0)
	header.BackgroundTransparency = 1
	header.Text = "PLAYERS IN LOBBY"
	header.TextColor3 = Color3.fromRGB(255, 255, 255)
	header.TextSize = 16
	header.Font = Enum.Font.GothamBold
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Parent = panel

	-- Toggle / Close Button
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "ToggleButton"
	closeBtn.Size = UDim2.new(0, 30, 0, 30)
	closeBtn.Position = UDim2.new(1, -38, 0, 8)
	closeBtn.BackgroundColor3 = Color3.fromRGB(40, 44, 56)
	closeBtn.Text = "—"
	closeBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	closeBtn.TextSize = 14
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Parent = panel
	toggleButton = closeBtn

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 6)
	closeCorner.Parent = closeBtn

	closeBtn.MouseButton1Click:Connect(function()
		PlayerListChallengeUI.ToggleVisibility()
	end)

	-- Player List Scroll Container
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "PlayerScrollFrame"
	scroll.Size = UDim2.new(1, -20, 1, -60)
	scroll.Position = UDim2.new(0, 10, 0, 50)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = Color3.fromRGB(80, 85, 100)
	scroll.Parent = panel
	listScrollFrame = scroll

	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = scroll

	local padding = Instance.new("UIPadding")
	padding.PaddingRight = UDim.new(0, 4)
	padding.Parent = scroll
end

local function bindEvents()
	Players.PlayerAdded:Connect(function()
		PlayerListChallengeUI.UpdatePlayerList()
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		cachedStatuses[player.UserId] = nil
		PlayerListChallengeUI.UpdatePlayerList()
	end)

	local respondRemote = ChallengeEvents.GetRemoteEvent("ChallengeRespond")
	respondRemote.OnClientEvent:Connect(function(data: ChallengeEvents.ChallengeResponseData)
		if data.accepted then
			cachedStatuses[data.challengerUserId] = "In Match"
			cachedStatuses[data.targetUserId] = "In Match"
			PlayerListChallengeUI.UpdatePlayerList()
		end
	end)
end

--- Initializes the PlayerListChallengeUI controller.
function PlayerListChallengeUI.Initialize(targetPlayerGui: PlayerGui?)
	if isUIInitialized then
		return
	end
	isUIInitialized = true

	ChallengeEvents.Initialize()

	local playerGui = targetPlayerGui or Players.LocalPlayer:WaitForChild("PlayerGui")
	createUIElements(playerGui)
	bindEvents()
	PlayerListChallengeUI.UpdatePlayerList()
end

return PlayerListChallengeUI
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX105"><Properties><string name="Name">PostMatchSummaryUI</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[ OVERCLOCK: Post-Match Summary UI ]=]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UIFolder = script.Parent
local UITheme = require(UIFolder:WaitForChild("UITheme") :: any)
local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents") :: any)

local PostMatchSummaryUI = {}
local screenGui: ScreenGui? = nil
local mainFrame: Frame? = nil

local isInitialized = false

function PostMatchSummaryUI.Init(playerGui: PlayerGui)
	if isInitialized then return end
	isInitialized = true
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PostMatchGui"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 20
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	mainFrame = Instance.new("Frame")
	mainFrame.Size = UDim2.new(0.7, 0, 0.8, 0)
	mainFrame.Position = UDim2.new(0.15, 0, 0.1, 0)
	mainFrame.BackgroundColor3 = UITheme.Colors.Background
	mainFrame.BackgroundTransparency = 0.05
	mainFrame.BorderSizePixel = 0
	mainFrame.Parent = screenGui
	UITheme.applyCorner(mainFrame)
	UITheme.applyStroke(mainFrame, UITheme.Colors.Border, 2)

	-- Listen for match result
	pcall(function()
		RemoteEvents.GetReliable("MatchResult").OnClientEvent:Connect(function(data: any)
			PostMatchSummaryUI.Show(data)
		end)
	end)
end

function PostMatchSummaryUI.Show(matchData: any)
	if not screenGui or not mainFrame then return end
	-- Clear previous
	for _, c in mainFrame:GetChildren() do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") then c:Destroy() end
	end

	local localPlayer = Players.LocalPlayer
	local isWin = false
	if typeof(matchData) == "table" then
		isWin = matchData.winner == localPlayer.Name or matchData.winnerTeam == matchData.myTeam
	end

	-- Banner
	local banner = UITheme.createLabel(mainFrame, if isWin then "VICTORY" else "DEFEAT", UDim2.new(0.8, 0, 0, 60), UDim2.new(0.1, 0, 0.02, 0))
	banner.TextSize = 48
	banner.TextColor3 = if isWin then UITheme.Colors.Success else UITheme.Colors.Danger
	banner.TextXAlignment = Enum.TextXAlignment.Center

	-- Score
	local t1 = if typeof(matchData) == "table" then matchData.team1Score or 0 else 0
	local t2 = if typeof(matchData) == "table" then matchData.team2Score or 0 else 0
	local scoreL = UITheme.createLabel(mainFrame, tostring(t1) .. " — " .. tostring(t2), UDim2.new(0.6, 0, 0, 40), UDim2.new(0.2, 0, 0.12, 0))
	scoreL.TextSize = 32
	scoreL.TextXAlignment = Enum.TextXAlignment.Center

	-- Scoreboard header
	local headers = {"Player", "Agent", "K", "D", "A", "DMG"}
	local colWidths = {0.25, 0.15, 0.1, 0.1, 0.1, 0.15}
	local headerY = 0.22
	local xOff = 0.05
	for i, h in headers do
		local hl = UITheme.createLabel(mainFrame, h, UDim2.new(colWidths[i], 0, 0, 20), UDim2.new(xOff, 0, headerY, 0))
		hl.TextSize = 13
		hl.TextColor3 = UITheme.Colors.Accent
		xOff += colWidths[i]
	end

	-- Player rows
	local playerList = if typeof(matchData) == "table" then matchData.players else nil
	if typeof(playerList) == "table" then
		for idx, pData in playerList :: {any} do
			local rowY = headerY + 0.03 + (idx * 0.05)
			xOff = 0.05
			local vals = {
				tostring(pData.name or "?"),
				tostring(pData.operative or "?"),
				tostring(pData.kills or 0),
				tostring(pData.deaths or 0),
				tostring(pData.assists or 0),
				tostring(pData.damage or 0),
			}
			for i, v in vals do
				local vl = UITheme.createLabel(mainFrame, v, UDim2.new(colWidths[i], 0, 0, 18), UDim2.new(xOff, 0, rowY, 0))
				vl.TextSize = 14
				vl.TextColor3 = UITheme.Colors.TextSecondary
				xOff += colWidths[i]
			end
		end
	end

	-- XP / Credits
	local xp = if typeof(matchData) == "table" then matchData.xpGained or 0 else 0
	local cr = if typeof(matchData) == "table" then matchData.creditsGained or 0 else 0
	local rewardL = UITheme.createLabel(mainFrame, "+" .. tostring(xp) .. " XP   +" .. tostring(cr) .. " Credits", UDim2.new(0.6, 0, 0, 24), UDim2.new(0.2, 0, 0.78, 0))
	rewardL.TextSize = 18
	rewardL.TextColor3 = UITheme.Colors.Gold
	rewardL.TextXAlignment = Enum.TextXAlignment.Center

	-- Continue button
	local contBtn = UITheme.createAccentButton(mainFrame, "CONTINUE", UDim2.new(0.25, 0, 0, 40), UDim2.new(0.375, 0, 0.87, 0))
	contBtn.TextSize = 16
	contBtn.MouseButton1Click:Connect(function()
		PostMatchSummaryUI.Hide()
		pcall(function()
			RemoteEvents.GetReliable("MatchPhaseTransition"):FireServer({action = "ReturnToLobby"})
		end)
	end)

	screenGui.Enabled = true

	-- Auto-dismiss
	task.delay(15, function()
		if screenGui and screenGui.Enabled then PostMatchSummaryUI.Hide() end
	end)
end

function PostMatchSummaryUI.Hide()
	if screenGui then screenGui.Enabled = false end
end

return PostMatchSummaryUI
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX106"><Properties><string name="Name">PracticeRangeHUD</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[ OVERCLOCK: Practice Range HUD ]=]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIFolder = script.Parent
local UITheme = require(UIFolder:WaitForChild("UITheme") :: any)
local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents") :: any)

local PracticeRangeHUD = {}
local screenGui: ScreenGui? = nil
local statsLabels: { [string]: TextLabel } = {}

local WEAPONS = {"Pistol", "LightSMG", "HeavySMG", "Carbine", "AssaultRifle", "SniperRifle", "Shotgun", "BurstRifle"}
local OPERATIVES = {"Vex", "Warden", "Fray", "Choke", "Pulse", "Bastion"}

local isInitialized = false

function PracticeRangeHUD.Init(playerGui: PlayerGui)
	if isInitialized then return end
	isInitialized = true
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "PracticeRangeGui"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 25
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	-- Stats panel (top-right)
	local statsPanel = UITheme.createFrame(screenGui, UDim2.new(0, 220, 0, 200), UDim2.new(1, -230, 0, 10))
	statsPanel.BackgroundTransparency = 0.15

	local statsTitle = UITheme.createLabel(statsPanel, "RANGE STATS", UDim2.new(0.9, 0, 0, 22), UDim2.new(0.05, 0, 0, 5))
	statsTitle.TextSize = 14
	statsTitle.TextColor3 = UITheme.Colors.Accent

	local statNames = {"Shots Fired", "Hits", "Accuracy", "Headshot %"}
	local statKeys = {"totalShotsFired", "totalHits", "accuracyPercent", "headshotPercent"}
	for i, name in statNames do
		local lbl = UITheme.createLabel(statsPanel, name .. ": 0", UDim2.new(0.9, 0, 0, 20), UDim2.new(0.05, 0, 0, 28 + (i * 28)))
		lbl.TextSize = 14
		lbl.TextColor3 = UITheme.Colors.TextSecondary
		statsLabels[statKeys[i]] = lbl
	end

	local resetBtn = UITheme.createButton(statsPanel, "RESET", UDim2.new(0.9, 0, 0, 30), UDim2.new(0.05, 0, 1, -35))
	resetBtn.TextSize = 13
	resetBtn.MouseButton1Click:Connect(function()
		pcall(function() RemoteEvents.GetReliable("ResetRangeStats"):FireServer() end)
	end)

	-- Combined Left Sidebar Container (prevent overlapping)
	local leftSidebar = UITheme.createFrame(screenGui, UDim2.new(0, 180, 0, 480), UDim2.new(0, 10, 0.5, -220))
	leftSidebar.BackgroundTransparency = 0.15

	local leftScroll = Instance.new("ScrollingFrame")
	leftScroll.Size = UDim2.new(1, -10, 1, -20)
	leftScroll.Position = UDim2.new(0, 5, 0, 10)
	leftScroll.BackgroundTransparency = 1
	leftScroll.ScrollBarThickness = 4
	leftScroll.CanvasSize = UDim2.new(0, 0, 0, 540)
	leftScroll.Parent = leftSidebar

	local leftLayout = Instance.new("UIListLayout")
	leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
	leftLayout.Padding = UDim.new(0, 6)
	leftLayout.Parent = leftScroll

	-- Weapons Section
	local wpTitle = UITheme.createLabel(leftScroll, "WEAPONS", UDim2.new(1, 0, 0, 22), UDim2.new(0, 0, 0, 0))
	wpTitle.TextSize = 13
	wpTitle.Font = Enum.Font.GothamBold
	wpTitle.TextColor3 = UITheme.Colors.Accent

	for i, wId in WEAPONS do
		local btn = UITheme.createButton(leftScroll, wId, UDim2.new(1, -10, 0, 28), UDim2.new(0, 0, 0, 0))
		btn.TextSize = 12
		btn.MouseButton1Click:Connect(function()
			pcall(function() RemoteEvents.GetReliable("SwitchWeapon"):FireServer(wId) end)
		end)
	end

	-- Operatives Section
	local opDivider = Instance.new("Frame")
	opDivider.Size = UDim2.new(1, -10, 0, 10)
	opDivider.BackgroundTransparency = 1
	opDivider.Parent = leftScroll

	local opTitle = UITheme.createLabel(leftScroll, "OPERATIVE", UDim2.new(1, 0, 0, 22), UDim2.new(0, 0, 0, 0))
	opTitle.TextSize = 13
	opTitle.Font = Enum.Font.GothamBold
	opTitle.TextColor3 = UITheme.Colors.Accent

	for i, opId in OPERATIVES do
		local btn = UITheme.createButton(leftScroll, opId, UDim2.new(1, -10, 0, 28), UDim2.new(0, 0, 0, 0))
		btn.TextSize = 12
		btn.MouseButton1Click:Connect(function()
			pcall(function() RemoteEvents.GetReliable("SwitchOperative"):FireServer(opId) end)
		end)
	end

	-- Exit button (top-left)
	local exitBtn = UITheme.createButton(screenGui, "← EXIT TO LOBBY", UDim2.new(0, 160, 0, 36), UDim2.new(0, 10, 0, 10))
	exitBtn.TextSize = 13
	exitBtn.BackgroundColor3 = UITheme.Colors.Danger
	exitBtn.MouseButton1Click:Connect(function()
		pcall(function() RemoteEvents.GetReliable("LeavePracticeRange"):FireServer() end)
	end)

	-- Listen for stats updates
	pcall(function()
		RemoteEvents.GetReliable("RangeStatsUpdated").OnClientEvent:Connect(function(data: any)
			PracticeRangeHUD.UpdateStats(data)
		end)
	end)
end

function PracticeRangeHUD.Show()
	if screenGui then screenGui.Enabled = true end
end

function PracticeRangeHUD.Hide()
	if screenGui then screenGui.Enabled = false end
end

function PracticeRangeHUD.IsVisible(): boolean
	return screenGui ~= nil and screenGui.Enabled
end

function PracticeRangeHUD.UpdateStats(data: any)
	if typeof(data) ~= "table" then return end
	if statsLabels.totalShotsFired then statsLabels.totalShotsFired.Text = "Shots Fired: " .. tostring(data.totalShotsFired or 0) end
	if statsLabels.totalHits then statsLabels.totalHits.Text = "Hits: " .. tostring(data.totalHits or 0) end
	if statsLabels.accuracyPercent then statsLabels.accuracyPercent.Text = "Accuracy: " .. string.format("%.1f%%", data.accuracyPercent or 0) end
	if statsLabels.headshotPercent then statsLabels.headshotPercent.Text = "Headshot %: " .. string.format("%.1f%%", data.headshotPercent or 0) end
end

return PracticeRangeHUD
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX107"><Properties><string name="Name">ScopeOverlayController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Scope Overlay Controller
    Handles the isolated 2D ScreenGui overlay for optical magnification (ADS),
    ensuring it does not invalidate the caching of the primary HUD.
]=]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ScopeOverlayController = {}

local scopeGui: ScreenGui?
local scopeImage: ImageLabel?
local leftLetterbox: Frame?
local rightLetterbox: Frame?

local function initializeScopeUI()
    if scopeGui then return end

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")

    scopeGui = Instance.new("ScreenGui")
    scopeGui.Name = "ScopeUIOverlay"
    scopeGui.ResetOnSpawn = false
    scopeGui.IgnoreGuiInset = true
    scopeGui.Enabled = false
    scopeGui.Parent = playerGui

    -- Central Optic Image
    scopeImage = Instance.new("ImageLabel")
    scopeImage.Name = "ScopeOptic"
    scopeImage.AnchorPoint = Vector2.new(0.5, 0.5)
    scopeImage.Position = UDim2.fromScale(0.5, 0.5)
    scopeImage.Size = UDim2.fromScale(1, 1)
    scopeImage.BackgroundTransparency = 1
    scopeImage.Parent = scopeGui

    local aspectConstraint = Instance.new("UIAspectRatioConstraint")
    aspectConstraint.AspectType = Enum.AspectType.FitWithinMaxSize
    aspectConstraint.AspectRatio = 1.0
    aspectConstraint.Parent = scopeImage

    -- Peripheral Occlusion (Letterboxing)
    leftLetterbox = Instance.new("Frame")
    leftLetterbox.Name = "LeftLetterbox"
    leftLetterbox.BackgroundColor3 = Color3.new(0, 0, 0)
    leftLetterbox.BorderSizePixel = 0
    leftLetterbox.AnchorPoint = Vector2.new(1, 0)
    leftLetterbox.Position = UDim2.fromScale(0, 0)
    leftLetterbox.Size = UDim2.fromScale(1, 1) -- Will be scaled via layout
    leftLetterbox.Parent = scopeGui

    rightLetterbox = Instance.new("Frame")
    rightLetterbox.Name = "RightLetterbox"
    rightLetterbox.BackgroundColor3 = Color3.new(0, 0, 0)
    rightLetterbox.BorderSizePixel = 0
    rightLetterbox.AnchorPoint = Vector2.new(0, 0)
    rightLetterbox.Position = UDim2.fromScale(1, 0)
    rightLetterbox.Size = UDim2.fromScale(1, 1) -- Will be scaled via layout
    rightLetterbox.Parent = scopeGui

    -- Dynamic layout constraint to snap letterboxing to the optic
    local function updateLetterboxing()
        if not scopeImage or not leftLetterbox or not rightLetterbox then return end
        local scopeBounds = scopeImage.AbsoluteSize
        local scopePos = scopeImage.AbsolutePosition
        
        -- Left letterbox spans from left edge of screen to left edge of scope image
        leftLetterbox.Size = UDim2.new(0, scopePos.X, 1, 0)
        leftLetterbox.Position = UDim2.new(0, scopePos.X, 0, 0)

        -- Right letterbox spans from right edge of scope image to right edge of screen
        rightLetterbox.Size = UDim2.new(0, scopeGui.AbsoluteSize.X - (scopePos.X + scopeBounds.X), 1, 0)
        rightLetterbox.Position = UDim2.new(0, scopePos.X + scopeBounds.X, 0, 0)
    end

    scopeImage:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLetterboxing)
    scopeGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLetterboxing)
end

function ScopeOverlayController.EnableOverlay(imageId: string)
    initializeScopeUI()
    if scopeGui and scopeImage then
        scopeImage.Image = imageId
        scopeGui.Enabled = true
        
        -- Hide default crosshair when scope is up
        local HUDController = require(script.Parent:WaitForChild("HUDController") :: any)
        if HUDController and HUDController.SetCrosshairVisible then
            HUDController.SetCrosshairVisible(false)
        end
    end
end

function ScopeOverlayController.DisableOverlay()
    if scopeGui then
        scopeGui.Enabled = false
        
        local HUDController = require(script.Parent:WaitForChild("HUDController") :: any)
        if HUDController and HUDController.SetCrosshairVisible then
            HUDController.SetCrosshairVisible(true)
        end
    end
end

return ScopeOverlayController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX108"><Properties><string name="Name">SettingsUIController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: SettingsUIController
    Manages the Gameplay &amp; Audio settings panel.
    Saves and loads settings locally using a lightweight approach,
    and applies FOV and MouseSensitivity in real-time.
]=]

local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local SettingsUIController = {}

local connections = {}

-- Basic settings state
local currentSettings = {
	fov = 70,
	mouseSensitivity = 1.0,
	masterVolume = 1.0,
}

local function createSlider(parent: Frame, name: string, labelText: string, min: number, max: number, defaultVal: number, onUpdate: (number) -&gt; (), position: UDim2)
	local container = Instance.new("Frame")
	container.Name = name .. "Slider"
	container.Size = UDim2.new(1, -20, 0, 50)
	container.Position = position
	container.BackgroundTransparency = 1
	container.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.4, 0, 0, 20)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(220, 230, 245)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = container

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Size = UDim2.new(0.2, 0, 0, 20)
	valueLabel.Position = UDim2.new(0.8, 0, 0, 0)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = tostring(defaultVal)
	valueLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextSize = 14
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = container

	local sliderBg = Instance.new("Frame")
	sliderBg.Size = UDim2.new(1, 0, 0, 6)
	sliderBg.Position = UDim2.new(0, 0, 0, 30)
	sliderBg.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
	sliderBg.BorderSizePixel = 0
	sliderBg.Parent = container
	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = sliderBg

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((defaultVal - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
	fill.BorderSizePixel = 0
	fill.Parent = sliderBg
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.Position = UDim2.new((defaultVal - min) / (max - min), -8, 0.5, -8)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.Text = ""
	knob.Parent = sliderBg
	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local isDragging = false

	local function updateSlider(input: InputObject)
		local relativeX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
		local val = min + (max - min) * relativeX
		-- Snap to 1 decimal for mouse sensitivity, integer for FOV
		if max - min &lt;= 10 then
			val = math.floor(val * 10 + 0.5) / 10
		else
			val = math.floor(val + 0.5)
		end
		relativeX = (val - min) / (max - min)

		fill.Size = UDim2.new(relativeX, 0, 1, 0)
		knob.Position = UDim2.new(relativeX, -8, 0.5, -8)
		valueLabel.Text = tostring(val)
		onUpdate(val)
	end

	table.insert(connections, knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
		end
	end))

	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end))

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(input)
		end
	end))

	table.insert(connections, sliderBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			updateSlider(input)
			isDragging = true
		end
	end))
end

function SettingsUIController.Init(settingsPanel: Frame)
	local container = Instance.new("ScrollingFrame")
	container.Name = "SettingsContainer"
	container.Size = UDim2.new(1, -20, 1, -50)
	container.Position = UDim2.new(0, 10, 0, 45)
	container.BackgroundTransparency = 1
	container.ScrollBarThickness = 4
	container.CanvasSize = UDim2.new(0, 0, 0, 400)
	container.Parent = settingsPanel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 15)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = container

	-- FOV Slider
	createSlider(container, "FOVSlider", "Field of View", 60, 110, currentSettings.fov, function(val)
		currentSettings.fov = val
		local camera = Workspace.CurrentCamera
		if camera and camera.CameraType == Enum.CameraType.Custom then
			camera.FieldOfView = val
		end
	end, UDim2.new(0, 0, 0, 0))

	-- Sensitivity Slider
	createSlider(container, "SensSlider", "Mouse Sensitivity", 0.1, 5.0, currentSettings.mouseSensitivity, function(val)
		currentSettings.mouseSensitivity = val
		-- Apply to local player's UserInputService
		-- Note: This is an absolute override of delta sensitivity
		UserInputService.MouseDeltaSensitivity = val
	end, UDim2.new(0, 0, 0, 0))

	-- Volume Slider
	createSlider(container, "VolSlider", "Master Volume", 0, 1, currentSettings.masterVolume, function(val)
		currentSettings.masterVolume = val
		-- To apply globally, we can set the volume of SoundService, but in a local script this might just affect locally
		local SoundService = game:GetService("SoundService")
		-- Assuming we have a master group, or just applying it to some global volume property if feasible
	end, UDim2.new(0, 0, 0, 0))
end

function SettingsUIController.Destroy()
	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	table.clear(connections)
end

return SettingsUIController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX109"><Properties><string name="Name">ShopUIController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[ OVERCLOCK: Shop UI Controller (Cosmetics Premium Overhaul) ]=]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local UIFolder = script.Parent
local UITheme = require(UIFolder:WaitForChild("UITheme") :: any)
local WeaponStats = require(ReplicatedStorage:WaitForChild("Data"):WaitForChild("WeaponStats") :: any)

local ShopUIController = {}
local screenGui: ScreenGui? = nil
local panelFrame: Frame? = nil
local equipped: string = "Default"

-- Active Viewport rotations
local renderConnections: {RBXScriptConnection} = {}

local function create3DPreview(skinSpec: any): ViewportFrame
	local viewport = Instance.new("ViewportFrame")
	viewport.BackgroundTransparency = 1
	viewport.BorderSizePixel = 0
	
	-- Create a dummy "weapon" model for the 3D preview
	local part = Instance.new("Part")
	part.Size = Vector3.new(1, 4, 1)
	part.Anchored = true
	part.Material = Enum.Material.Neon
	part.Color = skinSpec.primaryColor
	
	local handle = Instance.new("Part")
	handle.Size = Vector3.new(1.2, 1, 1.2)
	handle.Position = Vector3.new(0, -1.5, 0)
	handle.Anchored = true
	handle.Material = Enum.Material.Metal
	handle.Color = skinSpec.secondaryColor
	handle.Parent = part
	
	part.Parent = viewport
	
	local cam = Instance.new("Camera")
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.new(Vector3.new(3, 2, 4), part.Position)
	cam.FieldOfView = 50
	viewport.CurrentCamera = cam
	cam.Parent = viewport
	
	-- Animate rotation
	local angle = 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		if not viewport.Parent or not viewport.Visible then return end
		angle += dt * 0.5
		part.CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, angle, 0.2)
		handle.CFrame = part.CFrame * CFrame.new(0, -1.5, 0)
	end)
	table.insert(renderConnections, conn)
	
	return viewport
end

function ShopUIController.Destroy()
	for _, conn in renderConnections do
		conn:Disconnect()
	end
	table.clear(renderConnections)
	if screenGui then
		screenGui:Destroy()
		screenGui = nil
	end
	panelFrame = nil
end

function ShopUIController.Init(playerGui: PlayerGui)
	if screenGui then
		ShopUIController.Destroy()
	end
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ShopGui"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 25
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	-- Premium Glassmorphism Background
	local panel = Instance.new("CanvasGroup")
	panel.Name = "ShopPanel"
	panel.Size = UDim2.new(0.8, 0, 0.8, 0)
	panel.Position = UDim2.new(0.1, 0, 0.1, 0)
	panel.BackgroundColor3 = Color3.fromRGB(12, 14, 20)
	panel.BackgroundTransparency = 0.15
	panel.BorderSizePixel = 0
	panel.Parent = screenGui
	
	UITheme.applyCorner(panel, UDim.new(0, 16))
	local panelStroke = UITheme.applyStroke(panel, Color3.fromRGB(0, 220, 255), 2)
	panelStroke.Transparency = 0.5
	panelFrame = panel

	-- Top Header
	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 60)
	header.BackgroundTransparency = 1
	header.Parent = panel
	
	local title = UITheme.createLabel(header, "EXCLUSIVE GEAR", UDim2.new(0.4, 0, 1, 0), UDim2.new(0.03, 0, 0, 0))
	title.TextSize = 28
	title.Font = Enum.Font.GothamBlack
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextXAlignment = Enum.TextXAlignment.Left
	
	local subtitle = UITheme.createLabel(header, "Customize your operative with high-end cosmetics.", UDim2.new(0.4, 0, 1, 0), UDim2.new(0.03, 0, 0, 20))
	subtitle.TextSize = 14
	subtitle.TextColor3 = Color3.fromRGB(150, 160, 180)
	subtitle.TextXAlignment = Enum.TextXAlignment.Left

	-- Close button
	local closeBtn = UITheme.createButton(header, "✕", UDim2.new(0, 40, 0, 40), UDim2.new(1, -50, 0.5, -20))
	closeBtn.TextSize = 20
	closeBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 70)
	closeBtn.BackgroundTransparency = 0.8
	closeBtn.MouseButton1Click:Connect(function() ShopUIController.Hide() end)
	
	local divider = Instance.new("Frame")
	divider.Size = UDim2.new(1, 0, 0, 1)
	divider.Position = UDim2.new(0, 0, 1, 0)
	divider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	divider.BackgroundTransparency = 0.8
	divider.Parent = header

	-- Horizontal Scroll Carousel
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -40, 1, -100)
	scroll.Position = UDim2.new(0, 20, 0, 80)
	scroll.BackgroundTransparency = 1
	scroll.CanvasSize = UDim2.new(2, 0, 0, 0)
	scroll.ScrollBarThickness = 6
	scroll.ScrollingDirection = Enum.ScrollingDirection.X
	scroll.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 20)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	local skinsData = WeaponStats.SKINS_DATA
	local cardStrokes: {[string]: UIStroke} = {}
	local equipButtons: {[string]: TextButton} = {}

	for skinId, skinSpec in skinsData do
		local card = Instance.new("Frame")
		card.Name = skinId
		card.Size = UDim2.new(0, 280, 1, -20)
		card.BackgroundColor3 = Color3.fromRGB(20, 24, 34)
		card.BackgroundTransparency = 0.3
		card.BorderSizePixel = 0
		card.Parent = scroll
		UITheme.applyCorner(card, UDim.new(0, 12))
		local stroke = UITheme.applyStroke(card, if skinId == equipped then UITheme.Colors.Accent else Color3.fromRGB(40, 45, 60), 2)
		cardStrokes[skinId] = stroke
		
		-- 3D Viewport Frame
		local viewport = create3DPreview(skinSpec)
		viewport.Size = UDim2.new(1, 0, 0.6, 0)
		viewport.Position = UDim2.new(0, 0, 0, 0)
		viewport.Parent = card
		
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150,150,150))
		})
		gradient.Rotation = 90
		gradient.Parent = card

		local infoFrame = Instance.new("Frame")
		infoFrame.Size = UDim2.new(1, 0, 0.4, 0)
		infoFrame.Position = UDim2.new(0, 0, 0.6, 0)
		infoFrame.BackgroundColor3 = Color3.fromRGB(15, 18, 25)
		infoFrame.BorderSizePixel = 0
		infoFrame.Parent = card
		UITheme.applyCorner(infoFrame, UDim.new(0, 12))
		
		-- Fix bottom corner overlap hack
		local fixFrame = Instance.new("Frame")
		fixFrame.Size = UDim2.new(1, 0, 0.2, 0)
		fixFrame.BackgroundColor3 = Color3.fromRGB(15, 18, 25)
		fixFrame.BorderSizePixel = 0
		fixFrame.Parent = infoFrame

		local nameL = UITheme.createLabel(infoFrame, string.upper(skinSpec.displayName), UDim2.new(1, -30, 0, 30), UDim2.new(0, 15, 0, 15))
		nameL.TextSize = 20
		nameL.Font = Enum.Font.GothamBold
		nameL.TextXAlignment = Enum.TextXAlignment.Left
		nameL.TextColor3 = skinSpec.primaryColor
		
		local rarityL = UITheme.createLabel(infoFrame, "LEGENDARY", UDim2.new(1, -30, 0, 15), UDim2.new(0, 15, 0, 45))
		rarityL.TextSize = 12
		rarityL.TextColor3 = Color3.fromRGB(255, 180, 50)
		rarityL.TextXAlignment = Enum.TextXAlignment.Left

		local equipBtn = UITheme.createAccentButton(infoFrame, if skinId == equipped then "EQUIPPED" else "PURCHASE / EQUIP", UDim2.new(1, -30, 0, 45), UDim2.new(0, 15, 1, -60))
		equipBtn.TextSize = 16
		equipBtn.Font = Enum.Font.GothamBold
		equipButtons[skinId] = equipBtn

		equipBtn.MouseButton1Click:Connect(function()
			equipped = skinId
			for id, s in cardStrokes do
				s.Color = if id == skinId then UITheme.Colors.Accent else Color3.fromRGB(40, 45, 60)
			end
			for id, btn in equipButtons do
				btn.Text = if id == skinId then "EQUIPPED" else "PURCHASE / EQUIP"
				btn.BackgroundColor3 = if id == skinId then UITheme.Colors.Success else UITheme.Colors.Accent
			end
		end)
	end
end

function ShopUIController.Show()
	if screenGui then
		screenGui.Enabled = true
		if panelFrame then
			panelFrame.Position = UDim2.new(0.1, 0, 0.2, 0)
			panelFrame.GroupTransparency = 1
			TweenService:Create(panelFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
				Position = UDim2.new(0.1, 0, 0.1, 0),
				GroupTransparency = 0
			}):Play()
		end
	end
end

function ShopUIController.Hide()
	if screenGui and panelFrame then
		local tween = TweenService:Create(panelFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.1, 0, 0.15, 0),
			GroupTransparency = 1
		})
		tween:Play()
		tween.Completed:Connect(function()
			screenGui.Enabled = false
		end)
	end
end

function ShopUIController.IsVisible(): boolean
	return screenGui ~= nil and screenGui.Enabled
end

return ShopUIController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX110"><Properties><string name="Name">UITheme</string><ProtectedString name="Source">&lt;![CDATA[--!strict
local TweenService = game:GetService("TweenService")

local UITheme = {}

UITheme.Colors = {
	Background = Color3.fromRGB(12, 14, 18),
	Panel = Color3.fromRGB(22, 25, 32),
	PanelLight = Color3.fromRGB(32, 36, 45),
	Accent = Color3.fromRGB(0, 200, 220),
	AccentDark = Color3.fromRGB(0, 140, 160),
	Danger = Color3.fromRGB(220, 50, 50),
	Success = Color3.fromRGB(50, 200, 80),
	TextPrimary = Color3.fromRGB(230, 235, 245),
	TextSecondary = Color3.fromRGB(140, 150, 170),
	Border = Color3.fromRGB(45, 50, 65),
	Gold = Color3.fromRGB(220, 175, 40),
}

UITheme.Font = Enum.Font.GothamBold
UITheme.FontLight = Enum.Font.Gotham
UITheme.CornerRadius = UDim.new(0, 6)
UITheme.CornerRadiusSmall = UDim.new(0, 4)

local TWEEN_HOVER = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_PRESS = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function UITheme.applyCorner(inst: GuiObject, radius: UDim?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or UITheme.CornerRadius
	c.Parent = inst
	return c
end

function UITheme.applyStroke(inst: GuiObject, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or UITheme.Colors.Border
	s.Thickness = thickness or 1
	s.Parent = inst
	return s
end

function UITheme.addHoverFeedback(btn: TextButton | ImageButton)
	local originalColor = btn.BackgroundColor3
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TWEEN_HOVER, {BackgroundColor3 = UITheme.Colors.PanelLight}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TWEEN_HOVER, {BackgroundColor3 = originalColor}):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(btn, TWEEN_PRESS, {BackgroundColor3 = UITheme.Colors.AccentDark}):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(btn, TWEEN_HOVER, {BackgroundColor3 = originalColor}):Play()
	end)
end

function UITheme.createFrame(parent: Instance, size: UDim2, position: UDim2?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = position or UDim2.new(0, 0, 0, 0)
	f.BackgroundColor3 = UITheme.Colors.Panel
	f.BorderSizePixel = 0
	f.Parent = parent
	UITheme.applyCorner(f)
	return f
end

function UITheme.createLabel(parent: Instance, text: string, size: UDim2, position: UDim2?): TextLabel
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = position or UDim2.new(0, 0, 0, 0)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = UITheme.Colors.TextPrimary
	l.Font = UITheme.Font
	l.TextSize = 16
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

function UITheme.createButton(parent: Instance, text: string, size: UDim2, position: UDim2?): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = position or UDim2.new(0, 0, 0, 0)
	b.BackgroundColor3 = UITheme.Colors.Panel
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = UITheme.Colors.TextPrimary
	b.Font = UITheme.Font
	b.TextSize = 16
	b.AutoButtonColor = false
	b.Parent = parent
	UITheme.applyCorner(b)
	UITheme.applyStroke(b, UITheme.Colors.Border)
	UITheme.addHoverFeedback(b)
	return b
end

function UITheme.createAccentButton(parent: Instance, text: string, size: UDim2, position: UDim2?): TextButton
	local b = UITheme.createButton(parent, text, size, position)
	b.BackgroundColor3 = UITheme.Colors.Accent
	b.TextColor3 = UITheme.Colors.Background
	return b
end

return UITheme
]]&gt;</ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX111"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[ Project OVERCLOCK: ClientMain - Main client entry point ]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ControllersFolder = script.Parent:WaitForChild("Controllers")
local WeaponController = require(ControllersFolder:WaitForChild("WeaponController") :: any)
local CrosshairController = require(ControllersFolder:WaitForChild("CrosshairController") :: any)
local AnimationController = require(ControllersFolder:WaitForChild("AnimationController") :: any)
local MobileControlsController = require(ControllersFolder:WaitForChild("MobileControlsController") :: any)
local LobbyTransitionController = require(ControllersFolder:WaitForChild("LobbyTransitionController") :: any)
local OperativeController = require(ControllersFolder:WaitForChild("OperativeController") :: any)
local MovementController = require(ControllersFolder:WaitForChild("MovementController") :: any)

local UIFolder = script.Parent:WaitForChild("UI")
local HUDController = require(UIFolder:WaitForChild("HUDController") :: any)
local LobbyUIController = require(UIFolder:WaitForChild("LobbyUIController") :: any)
local MatchmakingQueueUI = require(UIFolder:WaitForChild("MatchmakingQueueUI") :: any)
local PlayerListChallengeUI = require(UIFolder:WaitForChild("PlayerListChallengeUI") :: any)
local ChallengeInviteModal = require(UIFolder:WaitForChild("ChallengeInviteModal") :: any)
local LoadoutInspectorUI = require(UIFolder:WaitForChild("LoadoutInspectorUI") :: any)
local AgentSelectUI = require(UIFolder:WaitForChild("AgentSelectUI") :: any)
local PracticeRangeHUD = require(UIFolder:WaitForChild("PracticeRangeHUD") :: any)
local PostMatchSummaryUI = require(UIFolder:WaitForChild("PostMatchSummaryUI") :: any)
local BuyMenuController = require(UIFolder:WaitForChild("BuyMenuController") :: any)
local ShopUIController = require(UIFolder:WaitForChild("ShopUIController") :: any)

local QueueEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("QueueEvents") :: any)
local ChallengeEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("ChallengeEvents") :: any)
local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents") :: any)

local StarterGui = game:GetService("StarterGui")

print("[ClientMain] Initializing OVERCLOCK Client...")

local localPlayer = Players.LocalPlayer
localPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui
local currentMode: string = "Lobby" -- "Lobby" | "Match" | "Practice"
local isMobile = UserInputService.TouchEnabled

-- Disable default Roblox CoreGui
local function disableCoreGui()
	for _ = 1, 10 do
		local ok, _ = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then break end
		task.wait(0.5)
	end
end
task.spawn(disableCoreGui)

-- 1. Initialize all UI &amp; Controllers
print("[BOOT] Initializing UI controllers...")
HUDController.Init(playerGui) print("[UI] HUDController ready")
CrosshairController.Init() print("[UI] CrosshairController ready")
AnimationController.Init() print("[UI] AnimationController ready")
MobileControlsController.Init(playerGui) print("[UI] MobileControlsController ready")
WeaponController.Init() print("[UI] WeaponController ready")
MovementController.Init() print("[UI] MovementController ready")

LobbyUIController.Init(playerGui) print("[UI] LobbyUIController ready")
MatchmakingQueueUI.Initialize(playerGui) print("[UI] MatchmakingQueueUI ready")
PlayerListChallengeUI.Initialize(playerGui) print("[UI] PlayerListChallengeUI ready")
ChallengeInviteModal.Initialize(playerGui) print("[UI] ChallengeInviteModal ready")
LoadoutInspectorUI.Init(playerGui) print("[UI] LoadoutInspectorUI ready")
LobbyTransitionController.Init(playerGui) print("[UI] LobbyTransitionController ready")
AgentSelectUI.Init(playerGui) print("[UI] AgentSelectUI ready")
PracticeRangeHUD.Init(playerGui) print("[UI] PracticeRangeHUD ready")
PostMatchSummaryUI.Init(playerGui) print("[UI] PostMatchSummaryUI ready")
BuyMenuController.Init(playerGui) print("[UI] BuyMenuController ready")
ShopUIController.Init(playerGui) print("[UI] ShopUIController ready")
OperativeController.Init() print("[UI] OperativeController ready")

-- 2. Wire Lobby Callbacks
LobbyUIController.OnLoadoutClicked(function()
	LoadoutInspectorUI.Show()
end)

-- 1v1 Duel button -&gt; queue for 1v1
LobbyUIController.OnPlayClicked(function()
	pcall(function()
		RemoteEvents.GetReliable("RequestQueue"):FireServer("1v1")
	end)
	MatchmakingQueueUI.ShowQueuePanel()
end)

-- 2v2 button -&gt; queue for 2v2
LobbyUIController.OnChallengeClicked(function()
	pcall(function()
		RemoteEvents.GetReliable("RequestQueue"):FireServer("2v2")
	end)
	MatchmakingQueueUI.ShowQueuePanel()
end)

-- Practice Range button
LobbyUIController.OnPracticeClicked(function()
	pcall(function()
		RemoteEvents.GetReliable("EnterPracticeRange"):FireServer()
	end)
end)

-- Shop button
LobbyUIController.OnShopClicked(function()
	ShopUIController.Show()
end)

-- Default to Lobby mode
HUDController.SetHUDMode("Lobby")
LobbyUIController.ShowMainLobbyMenu()

print("[ClientMain] All Controllers &amp; UI Initialized.")

-- 3. Mode transition helpers
local function setMode(mode: string)
	currentMode = mode
	if mode == "Match" then
		LobbyUIController.HideAllMenus()
		PlayerListChallengeUI.SetVisible(false)
		PracticeRangeHUD.Hide()
		HUDController.SetHUDMode("Match")
		CrosshairController.SetVisible(true)
		-- Mobile: show combat buttons, hide menu toggle
		if isMobile then
			MobileControlsController.SetCombatVisible(true)
			MobileControlsController.SetMenuButtonVisible(false)
		end
	elseif mode == "Practice" then
		LobbyUIController.HideAllMenus()
		PlayerListChallengeUI.SetVisible(false)
		PracticeRangeHUD.Show()
		HUDController.SetHUDMode("Match") -- reuse match HUD for health/crosshair
		CrosshairController.SetVisible(true)
		WeaponController.EquipWeapon("AssaultRifle")
		-- Mobile: show combat buttons, hide menu toggle
		if isMobile then
			MobileControlsController.SetCombatVisible(true)
			MobileControlsController.SetMenuButtonVisible(false)
		end
	elseif mode == "Lobby" then
		PracticeRangeHUD.Hide()
		BuyMenuController.Hide()
		PlayerListChallengeUI.SetVisible(true)
		HUDController.SetHUDMode("Lobby")
		CrosshairController.SetVisible(false)
		-- Mobile: hide combat buttons, show menu toggle
		if isMobile then
			MobileControlsController.SetCombatVisible(false)
			MobileControlsController.SetMenuButtonVisible(true)
		end
	end
end

-- 3b. Mobile: bind the ☰ menu toggle button
if isMobile then
	task.defer(function()
		local menuBtn = MobileControlsController.GetMenuButton()
		if menuBtn then
			menuBtn.MouseButton1Click:Connect(function()
				LobbyUIController.ToggleFreeRoam()
			end)
		end
	end)
end

-- 4. Listen for server phase transitions
local function handleTransitionToMatch()
	LobbyTransitionController.TransitionToMatch(1.2, function()
		setMode("Match")
	end)
end

local function handleTransitionToLobby()
	LobbyTransitionController.TransitionToLobby(1.2, function()
		setMode("Lobby")
	end)
end

pcall(function()
	RemoteEvents.GetReliable("RoundStateChanged").OnClientEvent:Connect(function(data: any)
		if typeof(data) ~= "table" then return end
		local phase = data.phase or data.state
		if phase == "Buy" then
			BuyMenuController.Show(data.credits)
		elseif phase == "Live" then
			BuyMenuController.Hide()
		elseif phase == "RoundEnd" or phase == "Intermission" then
			BuyMenuController.Hide()
		elseif phase == "AgentSelect" then
			AgentSelectUI.Show(data.mode)
		end
	end)
end)

pcall(function()
	RemoteEvents.GetReliable("MatchPhaseTransition").OnClientEvent:Connect(function(data: any)
		if typeof(data) ~= "table" then return end
		if data.phase == "Match" or data.phase == "InGame" then
			AgentSelectUI.Hide()
			handleTransitionToMatch()
		elseif data.phase == "Lobby" then
			AgentSelectUI.Hide()
			handleTransitionToLobby()
		elseif data.phase == "PracticeRange" then
			LobbyTransitionController.TransitionToMatch(1.0, function()
				setMode("Practice")
			end)
		elseif data.phase == "AgentSelect" then
			AgentSelectUI.Show(data.mode)
		end
	end)
end)

-- Equip weapon remote listener (Practice Range / Server requests)
pcall(function()
	RemoteEvents.GetReliable("EquipWeapon").OnClientEvent:Connect(function(weaponId: any)
		if typeof(weaponId) == "string" then
			WeaponController.EquipWeapon(weaponId)
		end
	end)
end)

-- Ammo resupply remote listener (Practice Range ammo station)
pcall(function()
	RemoteEvents.GetReliable("ResupplyAmmo").OnClientEvent:Connect(function()
		WeaponController.ResupplyAmmo()
	end)
end)

-- Switch operative remote listener
pcall(function()
	RemoteEvents.GetReliable("SwitchOperative").OnClientEvent:Connect(function(opId: any)
		if typeof(opId) == "string" then
			OperativeController.SelectOperative(opId)
		end
	end)
end)

-- Queue events
pcall(function()
	local voteRemote = QueueEvents.GetRemoteEvent("MapVoteUpdate")
	voteRemote.OnClientEvent:Connect(function(result: any)
		if typeof(result) == "table" and result.votingEnded and result.winningMap then
			task.delay(1.5, function() handleTransitionToMatch() end)
		end
	end)
end)

pcall(function()
	local challengeRemote = ChallengeEvents.GetRemoteEvent("ChallengeRespond")
	challengeRemote.OnClientEvent:Connect(function(data: any)
		if typeof(data) == "table" and data.accepted then
			local myId = localPlayer.UserId
			if data.challengerUserId == myId or data.targetUserId == myId then
				task.delay(0.5, function() handleTransitionToMatch() end)
			end
		end
	end)
end)

-- Leave practice range
pcall(function()
	RemoteEvents.GetReliable("LeavePracticeRange").OnClientEvent:Connect(function()
		handleTransitionToLobby()
	end)
end)

-- 5. Input Listeners (Desktop)
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then return end
	if currentMode ~= "Match" and currentMode ~= "Practice" then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		WeaponController.StartFiring()
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		WeaponController.SetAiming(true)
	elseif input.KeyCode == Enum.KeyCode.R then
		WeaponController.ReloadWeapon()
	elseif input.KeyCode == Enum.KeyCode.B and currentMode == "Match" then
		if BuyMenuController.IsVisible() then BuyMenuController.Hide() else BuyMenuController.Show() end
	elseif input.KeyCode == Enum.KeyCode.Q then
		OperativeController.UseAbility("Basic")
	elseif input.KeyCode == Enum.KeyCode.E then
		OperativeController.UseAbility("Paid")
	elseif input.KeyCode == Enum.KeyCode.X then
		OperativeController.UseAbility("Ultimate")
	elseif input.KeyCode == Enum.KeyCode.One then
		WeaponController.EquipWeapon("Pistol")
	elseif input.KeyCode == Enum.KeyCode.Two then
		WeaponController.EquipWeapon("AssaultRifle")
	elseif input.KeyCode == Enum.KeyCode.Three then
		WeaponController.EquipWeapon("SniperRifle")
	elseif input.KeyCode == Enum.KeyCode.Four then
		WeaponController.EquipWeapon("Shotgun")
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		WeaponController.StopFiring()
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		WeaponController.SetAiming(false)
	end
end)

-- 6. Mobile Controls
if isMobile then
	MobileControlsController.BindCombatActions({
		onFire = function(_, state)
			if currentMode ~= "Match" and currentMode ~= "Practice" then return Enum.ContextActionResult.Pass end
			if state == Enum.UserInputState.Begin then WeaponController.StartFiring()
			elseif state == Enum.UserInputState.End then WeaponController.StopFiring() end
			return Enum.ContextActionResult.Success
		end,
		onReload = function(_, state)
			if currentMode ~= "Match" and currentMode ~= "Practice" then return Enum.ContextActionResult.Pass end
			if state == Enum.UserInputState.Begin then WeaponController.ReloadWeapon() end
			return Enum.ContextActionResult.Success
		end,
		onAim = function(_, state)
			if currentMode ~= "Match" and currentMode ~= "Practice" then return Enum.ContextActionResult.Pass end
			if state == Enum.UserInputState.Begin then WeaponController.SetAiming(true)
			elseif state == Enum.UserInputState.End then WeaponController.SetAiming(false) end
			return Enum.ContextActionResult.Success
		end,
		onCrouch = function(_, state)
			if currentMode ~= "Match" and currentMode ~= "Practice" then return Enum.ContextActionResult.Pass end
			if state == Enum.UserInputState.Begin then
				local char = Players.LocalPlayer.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum then
					if hum.WalkSpeed == 16 then
						hum.WalkSpeed = 8 -- Crouch speed
					else
						hum.WalkSpeed = 16 -- Normal speed
					end
				end
			end
			return Enum.ContextActionResult.Success
		end,
		onJump = function(_, state)
			if currentMode ~= "Match" and currentMode ~= "Practice" then return Enum.ContextActionResult.Pass end
			if state == Enum.UserInputState.Begin then
				local char = Players.LocalPlayer.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum.Jump = true
				end
			end
			return Enum.ContextActionResult.Success
		end,
	})
	-- Start with combat hidden (lobby mode)
	MobileControlsController.SetCombatVisible(false)
	MobileControlsController.SetMenuButtonVisible(true)
end

-- 7. Render Loop
RunService.RenderStepped:Connect(function(dt: number)
	if currentMode == "Match" or currentMode == "Practice" then
		-- AnimationController.Update(dt)
		local camera = Workspace.CurrentCamera
		if camera and camera.CameraType == Enum.CameraType.Custom then
			local camOffset = AnimationController.GetCameraOffset()
			camera.CFrame = camera.CFrame * camOffset
		end

		local state = WeaponController.GetState()
		local activeStats = WeaponController.GetActiveStats()
		if state and activeStats then
			HUDController.UpdateAmmo(state.currentAmmo, state.reserveAmmo, activeStats.displayName)
		end
		if camera then
			local lookVector = camera.CFrame.LookVector
			local headingRad = math.atan2(-lookVector.X, -lookVector.Z)
			HUDController.UpdateCompass(math.deg(headingRad))
		end
	end
end)

-- 8. Character lifecycle
local function onCharacterAdded(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	AnimationController.UpdateMovementState(humanoid)
	humanoid.Running:Connect(function()
		AnimationController.UpdateMovementState(humanoid)
	end)
end

if localPlayer.Character then onCharacterAdded(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(onCharacterAdded)

-- 9. Listen for BulletTracer events from other players
pcall(function()
	RemoteEvents.GetUnreliable("BulletTracer").OnClientEvent:Connect(function(data: any)
		if typeof(data) == "table" and data.shooterId ~= localPlayer.UserId then
			if typeof(data.origin) == "Vector3" and typeof(data.direction) == "Vector3" then
				WeaponController.RenderExternalTracer(data.origin, data.direction)
			end
		end
	end)
end)

print("[ClientMain] OVERCLOCK Client Ready!")
]]&gt;</ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX24"><Properties /></Item></Item></roblox>