-- Helpers --------------------------------------------------------------------

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?,
	transparency: number?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe + MAP_OFFSET
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.Transparency = transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CastShadow = (transparency or 0) &lt; 0.5
	part.Parent = parent
	return part
end

local function addLight(parent: Instance, color: Color3, range: number, brightness: number, type: string?)
	if type == "Spot" then
		local s = Instance.new("SpotLight")
		s.Color, s.Range, s.Brightness, s.Angle, s.Face = color, range, brightness, 90, Enum.NormalId.Bottom
		s.Parent = parent
	else
		local p = Instance.new("PointLight")
		p.Color, p.Range, p.Brightness = color, range, brightness
		p.Parent = parent
	end
end

local function makeBillboard(
	parent: Instance,
	name: string,
	text: string,
	color: Color3,
	size: UDim2,
	offset: Vector3,
	textSize: number
)
	local bb = Instance.new("BillboardGui")
	bb.Name = name
	bb.Size = size
	bb.StudsOffset = offset
	bb.AlwaysOnTop = true
	bb.MaxDistance = 80
	bb.Parent = parent
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = color
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextSize = textSize
	lbl.Text = text
	lbl.TextStrokeTransparency = 0.5
	lbl.Parent = bb
end

local function createBeam(parent: Part, a0: Attachment, a1: Attachment, color: Color3, width: number)
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = width
	beam.Width1 = width
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Transparency = NumberSequence.new(0.3, 0.6)
	beam.Parent = parent
end

-- Multi-ring concentric bullseye target builder -----------------------------
-- Based on real bullseye target ring patterns [web:24]
local RING_COLORS = { C.TARGET_RED, C.TARGET_WHITE, C.TARGET_RED, C.TARGET_WHITE, C.TARGET_RED }
local RING_SCALE = { 1.0, 0.78, 0.56, 0.34, 0.15 }

local function createBullseyeTarget(tDef: TargetDef, parent: Instance): Part
	local base = createPart(tDef.name, tDef.size, tDef.cframe, C.TARGET_RED, Enum.Material.SmoothPlastic, parent, true)
	base:SetAttribute("TargetId", tDef.id)
	base:SetAttribute("TargetType", "Stationary")
	base:SetAttribute("IsTarget", true)
	base:SetAttribute("MaxScore", 100)

	for ringIdx = 1, #RING_COLORS do
		local scale = RING_SCALE[ringIdx]
		local ring = createPart(
			"TargetRing_" .. ringIdx,
			Vector3.new(tDef.size.X * scale, tDef.size.Y * scale, tDef.size.Z + 0.05 * ringIdx),
			tDef.cframe * CFrame.new(0, 0, 0.03 * ringIdx),
			RING_COLORS[ringIdx],
			Enum.Material.Neon,
			base,
			false,
			0
		)
		ring:SetAttribute("RingIndex", ringIdx)
		ring:SetAttribute("RingScore", math.floor(100 - (ringIdx - 1) * 20))
		ring:SetAttribute("TargetId", tDef.id)
	end

	addLight(base, C.NEON_RED, 8, 1)
	return base
end

-- Moving rail target with tween cycle ---------------------------------------
local function createMovingTarget(mDef: MovingTargetDef, parent: Instance): Part
	local rail = createPart(
		mDef.name .. "_Rail",
		Vector3.new(math.abs(mDef.endPos.X - mDef.startPos.X) + 1, 0.3, 0.5),
		CFrame.new((mDef.startPos + mDef.endPos) / 2),
		C.TRIM,
		Enum.Material.Neon,
		parent,
		false,
		0.5
	)

	local target = createPart(
		mDef.name,
		mDef.size,
		CFrame.new(mDef.startPos),
		C.TARGET_RED,
		Enum.Material.SmoothPlastic,
		parent,
		true
	)
	target:SetAttribute("TargetId", mDef.id)
	target:SetAttribute("TargetType", "Moving")
	target:SetAttribute("IsTarget", true)
	target:SetAttribute("MaxScore", 150)

	-- Inner ring on moving target
	local ring = createPart(
		mDef.name .. "_Center",
		Vector3.new(mDef.size.X * 0.35, mDef.size.Y * 0.35, mDef.size.Z + 0.1),
		CFrame.new(mDef.startPos) * CFrame.new(0, 0, 0.05),
		C.TARGET_WHITE,
		Enum.Material.Neon,
		target,
		false,
		0
	)
	ring:SetAttribute("RingScore", 150)
	ring:SetAttribute("TargetId", mDef.id)

	addLight(target, C.NEON_ORANGE, 6, 1)

	-- Tween back and forth
	local dur = 4 + mDef.id % 3
	local tweenForward = TweenService:Create(
		target,
		TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ CFrame = CFrame.new(mDef.endPos) }
	)
	local tweenBack = TweenService:Create(
		target,
		TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ CFrame = CFrame.new(mDef.startPos) }
	)

	tweenForward.Completed:Connect(function(playbackState)
		if playbackState == Enum.PlaybackState.Completed then
			tweenBack:Play()
		end
	end)
	tweenBack.Completed:Connect(function(playbackState)
		if playbackState == Enum.PlaybackState.Completed then
			tweenForward:Play()
		end
	end)
	tweenForward:Play()

	table.insert(_activeTweens, tweenForward)
	table.insert(_activeTweens, tweenBack)

	return target
end

-- Cleanup -------------------------------------------------------------------

local function cleanup()
	for _, t in _activeTweens do
		t:Cancel()
	end
	table.clear(_activeTweens)
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

-- Main Build ----------------------------------------------------------------

function PracticeRangeMapLayout.BuildMap(parent: Instance?): Folder
	cleanup()
	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- Roblox developer: immersive lighting rig (map-maker best practice)
	-- Only apply if not already configured, keep Studio defaults safe
	pcall(function()
		Lighting.Ambient = Color3.fromRGB(90, 95, 110)
		Lighting.Brightness = 3
		Lighting.EnvironmentDiffuseScale = 0.25
		Lighting.EnvironmentSpecularScale = 0.25
		Lighting.ShadowDensity = 0.7
		if not Lighting:FindFirstChild("PracticeRangeAtmosphere") then
			local atm = Instance.new("Atmosphere")
			atm.Name = "PracticeRangeAtmosphere"
			atm.Density = 0.15
			atm.Offset = 0.5
			atm.Glare = 0.2
			atm.Haze = 0.8
			atm.Color = Color3.fromRGB(140, 170, 255)
			atm.Decay = Color3.fromRGB(15, 30, 60)
			atm.Parent = Lighting
		end
		if not Lighting:FindFirstChild("PracticeRangeBloom") then
			local bloom = Instance.new("BloomEffect")
			bloom.Name = "PracticeRangeBloom"
			bloom.Intensity = 0.25
			bloom.Size = 12
			bloom.Threshold = 1.2
			bloom.Parent = Lighting
		end
		if not Lighting:FindFirstChild("PracticeRangeCC") then
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "PracticeRangeCC"
			cc.Brightness = 0.02
			cc.Contrast = 0.08
			cc.Saturation = 0.15
			cc.TintColor = Color3.fromRGB(255, 252, 240)
			cc.Parent = Lighting
		end
		if not Lighting:FindFirstChild("PracticeRangeSun") then
			local sun = Instance.new("SunRaysEffect")
			sun.Name = "PracticeRangeSun"
			sun.Intensity = 0.08
			sun.Spread = 0.6
			sun.Parent = Lighting
		end
	end)

	------------------------------------------------------------------------
	-- 1. Perimeter &amp; Environment — map-maker: concrete base with metal trim, not flat grey
	------------------------------------------------------------------------
	local perimeter = Instance.new("Folder")
	perimeter.Name = "Perimeter"
	perimeter.Parent = mapFolder

	-- Main floor with hexagonal diamond plate (map-maker: material variety, not flat)
	createPart(
		"MainFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		C.FLOOR,
		Enum.Material.Concrete,
		perimeter,
		true
	)
	-- Diamond plate trim via DiamondPlate metal + Asphalt inlay
	createPart(
		"FloorPlate_Border",
		Vector3.new(MAP_WIDTH_X + 0.4, 0.15, MAP_LENGTH_Z + 0.4),
		CFrame.new(0, -0.12, 0),
		C.TRIM,
		Enum.Material.DiamondPlate,
		perimeter,
		true
	)
	createPart(
		"FloorInlay_Center",
		Vector3.new(2, 0.08, MAP_LENGTH_Z),
		CFrame.new(0, 0.03, 0),
		C.NEON_CYAN,
		Enum.Material.Neon,
		perimeter,
		false,
		0.15
	)
	createPart(
		"FloorInlay_West",
		Vector3.new(1.2, 0.08, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 4, 0.03, 0),
		C.NEON_BLUE,
		Enum.Material.Neon,
		perimeter,
		false,
		0.18
	)
	createPart(
		"FloorInlay_East",
		Vector3.new(1.2, 0.08, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 4, 0.03, 0),
		C.NEON_BLUE,
		Enum.Material.Neon,
		perimeter,
		false,
		0.18
	)
	-- Ceiling soft glow (bounced light)
	createPart(
		"FloorUnderglow",
		Vector3.new(MAP_WIDTH_X - 8, 0.4, MAP_LENGTH_Z - 8),
		CFrame.new(0, -0.35, 0),
		C.WALL_ACCENT,
		Enum.Material.SmoothPlastic,
		perimeter,
		false,
		0.8
	)

	-- Walls with accent strips
	for _, w in
		{
			{
				"NorthWall",
				Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
				CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
			},
			{
				"SouthWall",
				Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
				CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
			},
			{
				"WestWall",
				Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
				CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
			},
			{
				"EastWall",
				Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
				CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
			},
		}
	do
		createPart(w[1] :: string, w[2] :: Vector3, w[3] :: CFrame, C.WALL, Enum.Material.Concrete, perimeter, true)
		-- Neon accent strip at top of each wall
		createPart(
			w[1] .. "_Accent",
			Vector3.new(w[2].X, 1, w[2].Z),
			w[3] :: CFrame * CFrame.new(0, MAP_HEIGHT_Y / 2 - 1, 0),
			C.NEON_CYAN,
			Enum.Material.Neon,
			perimeter,
			false,
			0.1
		)
	end

	-- Invisible ceiling barrier
	createPart(
		"CeilingBarrier",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, MAP_HEIGHT_Y, 0),
		Color3.new(),
		Enum.Material.SmoothPlastic,
		perimeter,
		true,
		1
	)

	------------------------------------------------------------------------
	-- 2. Distance Markers with Billboard Signs
	------------------------------------------------------------------------
	local markers = Instance.new("Folder")
	markers.Name = "DistanceMarkers"
	markers.Parent = mapFolder

	-- Firing deck at Z = 70, targets at Z = -90
	-- 10m ≈ 32.8 studs -&gt; Z = 37.2
	-- 25m ≈ 82 studs -&gt; Z = -12.0
	-- 50m ≈ 164 studs -&gt; Z = -94.0 (near target wall)
	local markerDefs = {
		{ name = "DM_10m", z = 37.2, meters = 10, color = C.NEON_GREEN },
		{ name = "DM_25m", z = -12.0, meters = 25, color = C.NEON_ORANGE },
		{ name = "DM_50m", z = -78.0, meters = 50, color = C.NEON_RED },
	}

	for _, mDef in markerDefs do
		createPart(
			mDef.name,
			Vector3.new(MAP_WIDTH_X - 4, 0.3, 1.2),
			CFrame.new(0, 0.15, mDef.z),
			mDef.color,
			Enum.Material.Neon,
			markers,
			false,
			0.2
		):SetAttribute("DistanceMeters", mDef.meters)

		-- Signage post
		local post = createPart(
			mDef.name .. "_Post",
			Vector3.new(0.5, 4, 0.5),
			CFrame.new(MAP_WIDTH_X / 2 - 5, 2, mDef.z),
			C.TRIM,
			Enum.Material.Metal,
			markers,
			true
		)
		makeBillboard(
			post,
			mDef.name .. "_Label",
			mDef.meters .. "m",
			mDef.color,
			UDim2.new(0, 120, 0, 50),
			Vector3.new(0, 3, 0),
			28
		)
	end

	------------------------------------------------------------------------
	-- 3. Target Wall Section (multi-ring bullseyes + moving rails)
	------------------------------------------------------------------------
	local targetSection = Instance.new("Folder")
	targetSection.Name = "TargetWallSection"
	targetSection.Parent = mapFolder

	-- Reinforced backboard with neon frame
	createPart(
		"TargetBackboard",
		Vector3.new(110, 24, 2),
		CFrame.new(0, 12, -92),
		C.FLOOR_INLAY,
		Enum.Material.Metal,
		targetSection,
		true
	)
	createPart(
		"Backboard_FrameTop",
		Vector3.new(112, 0.8, 2.5),
		CFrame.new(0, 24, -92),
		C.NEON_CYAN,
		Enum.Material.Neon,
		targetSection,
		false,
		0.1
	)
	createPart(
		"Backboard_FrameBottom",
		Vector3.new(112, 0.8, 2.5),
		CFrame.new(0, 0.4, -92),
		C.NEON_CYAN,
		Enum.Material.Neon,
		targetSection,
		false,
		0.1
	)
	createPart(
		"Backboard_FrameLeft",
		Vector3.new(0.8, 24, 2.5),
		CFrame.new(-55, 12, -92),
		C.NEON_CYAN,
		Enum.Material.Neon,
		targetSection,
		false,
		0.1
	)
	createPart(
		"Backboard_FrameRight",
		Vector3.new(0.8, 24, 2.5),
		CFrame.new(55, 12, -92),
		C.NEON_CYAN,
		Enum.Material.Neon,
		targetSection,
		false,
		0.1
	)

	-- Stationary multi-ring targets
	for _, tDef in STATIONARY_TARGETS do
		createBullseyeTarget(tDef, targetSection)
	end

	-- Moving rail targets
	local movingFolder = Instance.new("Folder")
	movingFolder.Name = "MovingTargets"
	movingFolder.Parent = targetSection

	for _, mDef in MOVING_TARGETS do
		createMovingTarget(mDef, movingFolder)
	end

	------------------------------------------------------------------------
	-- 4. Patrol Bot Arena (holographic waypoints + connecting beams)
	------------------------------------------------------------------------
	local patrolSection = Instance.new("Folder")
	patrolSection.Name = "PatrolBotSection"
	patrolSection.Parent = mapFolder

	local waypointsFolder = Instance.new("Folder")
	waypointsFolder.Name = "Waypoints"
	waypointsFolder.Parent = patrolSection

	local prevAtt: Attachment? = nil
	for i, wPos in BOT_WAYPOINT_POSITIONS do
		-- Beacon pillar
		local beacon = createPart(
			"Waypoints_Bot_" .. i,
			Vector3.new(0.5, 0.2, 0.5),
			CFrame.new(wPos),
			C.NEON_GREEN,
			Enum.Material.Neon,
			waypointsFolder,
			false,
			0.3
		)
		beacon:SetAttribute("WaypointIndex", i)

		-- Vertical hologram beam
		local beamPart = createPart(
			"WP_Beam_" .. i,
			Vector3.new(0.3, 8, 0.3),
			CFrame.new(wPos + Vector3.new(0, 4, 0)),
			C.NEON_GREEN,
			Enum.Material.Neon,
			waypointsFolder,
			false,
			0.5
		)
		addLight(beamPart, C.NEON_GREEN, 6, 0.5)

		-- Connecting beam to previous waypoint
		local att0 = Instance.new("Attachment")
		att0.Position = Vector3.new(0, 0, 0)
		att0.Parent = beamPart
		if prevAtt then
			createBeam(beamPart, prevAtt, att0, C.NEON_GREEN, 0.3)
		end
		prevAtt = att0
	end
	-- Close the loop: connect last waypoint to first
	if prevAtt then
		local firstBeam = waypointsFolder:FindFirstChild("WP_Beam_1")
		if firstBeam then
			local firstAtt = firstBeam:FindFirstChild("Attachment")
			if firstAtt then
				createBeam(firstBeam :: Part, prevAtt, firstAtt :: Attachment, C.NEON_GREEN, 0.3)
			end
		end
	end

	------------------------------------------------------------------------
	-- 5. Player Spawns &amp; Firing Deck
	------------------------------------------------------------------------
	local spawns = Instance.new("Folder")
	spawns.Name = "Spawns"
	spawns.Parent = mapFolder

	-- Elevated firing deck with neon edge
	createPart("FiringDeck", Vector3.new(100, 1, 35), CFrame.new(0, 0.5, 70), C.TRIM, Enum.Material.Metal, spawns, true)
	createPart(
		"FiringDeck_EdgeN",
		Vector3.new(100, 0.3, 0.8),
		CFrame.new(0, 1.15, 52.5),
		C.NEON_CYAN,
		Enum.Material.Neon,
		spawns,
		false,
		0.1
	)
	createPart(
		"FiringDeck_EdgeS",
		Vector3.new(100, 0.3, 0.8),
		CFrame.new(0, 1.15, 87.5),
		C.NEON_CYAN,
		Enum.Material.Neon,
		spawns,
		false,
		0.1
	)

	-- Weapon rack station with ProximityPrompt
	local weaponRack = createPart(
		"WeaponRackPad",
		Vector3.new(8, 6, 4),
		CFrame.new(-25, 3, 78),
		C.TRIM,
		Enum.Material.Metal,
		spawns,
		true
	)
	weaponRack:SetAttribute("StationType", "WeaponRack")
	addLight(weaponRack, C.NEON_BLUE, 10, 1.5)
	makeBillboard(
		weaponRack,
		"WeaponRackLabel",
		"[ WEAPON RACK ]",
		C.NEON_CYAN,
		UDim2.new(0, 200, 0, 50),
		Vector3.new(0, 4, 0),
		22
	)
	local wrPrompt = Instance.new("ProximityPrompt")
	wrPrompt.Name = "WeaponRackPrompt"
	wrPrompt.ActionText = "Equip Weapon"
	wrPrompt.ObjectText = "Armory Station"
	wrPrompt.HoldDuration = 0
	wrPrompt.MaxActivationDistance = 10
	wrPrompt.RequiresLineOfSight = false
	wrPrompt:SetAttribute("StationType", "WeaponRack")
	wrPrompt.Parent = weaponRack

	-- Ammo resupply station with ProximityPrompt
	local ammoStation = createPart(
		"AmmoResupplyPad",
		Vector3.new(6, 4, 4),
		CFrame.new(25, 2, 78),
		C.TRIM,
		Enum.Material.Metal,
		spawns,
		true
	)
	ammoStation:SetAttribute("StationType", "AmmoResupply")
	addLight(ammoStation, C.NEON_ORANGE, 10, 1.5)
	makeBillboard(
		ammoStation,
		"AmmoLabel",
		"[ AMMO RESUPPLY ]",
		C.NEON_ORANGE,
		UDim2.new(0, 200, 0, 50),
		Vector3.new(0, 3.5, 0),
		22
	)
	local ammoPrompt = Instance.new("ProximityPrompt")
	ammoPrompt.Name = "AmmoPrompt"
	ammoPrompt.ActionText = "Resupply Ammo"
	ammoPrompt.ObjectText = "Ammo Station"
	ammoPrompt.HoldDuration = 0.5
	ammoPrompt.MaxActivationDistance = 10
	ammoPrompt.RequiresLineOfSight = false
	ammoPrompt:SetAttribute("StationType", "AmmoResupply")
	ammoPrompt.Parent = ammoStation

	-- Player spawn pads with team coloring
	local playerSpawnFolder = Instance.new("Folder")
	playerSpawnFolder.Name = "PlayerSpawn"
	playerSpawnFolder.Parent = spawns

	for i, sPos in PLAYER_SPAWN_POSITIONS do
		local pad = createPart(
			"Spawn_Player_" .. i,
			Vector3.new(5, 0.5, 5),
			CFrame.new(sPos - Vector3.new(0, 0.75, 0)),
			C.TRIM,
			Enum.Material.Metal,
			playerSpawnFolder,
			true
		)
		createPart(
			"SpawnRing_" .. i,
			Vector3.new(5.5, 0.2, 5.5),
			CFrame.new(sPos - Vector3.new(0, 1.0, 0)),
			C.NEON_CYAN,
			Enum.Material.Neon,
			playerSpawnFolder,
			false,
			0.2
		)
		addLight(pad, C.NEON_CYAN, 8, 1)
		pad:SetAttribute("Team", "Player")
		pad:SetAttribute("SpawnIndex", i)

		local spawnLoc = Instance.new("SpawnLocation")
		spawnLoc.Name = "SpawnLocation_" .. i
		spawnLoc.Size = Vector3.new(4, 0.4, 4)
		spawnLoc.CFrame = CFrame.new(sPos) + MAP_OFFSET
		spawnLoc.Anchored = true
		spawnLoc.Neutral = true
		spawnLoc.Enabled = true
		spawnLoc.AllowTeamChangeOnTouch = false
		spawnLoc.TeamColor = BrickColor.new("Medium royal blue")
		spawnLoc.Color = C.TRIM
		spawnLoc.Material = Enum.Material.SmoothPlastic
		spawnLoc.TopSurface = Enum.SurfaceType.Smooth
		spawnLoc.BottomSurface = Enum.SurfaceType.Smooth
		spawnLoc:SetAttribute("PracticeSpawnIndex", i)
		spawnLoc:SetAttribute("IsPracticeSpawn", true)
		spawnLoc.Parent = playerSpawnFolder
	end

	------------------------------------------------------------------------
	-- 6. Cover System (tiered obstacles with health attributes)
	------------------------------------------------------------------------
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	local coverColors = { Low = C.TRIM, Mid = C.WALL_ACCENT, High = C.WALL }

	for _, cDef in COVER_DEFS do
		local cover = createPart(
			cDef.name,
			cDef.size,
			CFrame.new(cDef.pos),
			coverColors[cDef.tier] :: Color3,
			Enum.Material.Concrete,
			coverFolder,
			true
		)
		cover:SetAttribute("CoverTier", cDef.tier)
		cover:SetAttribute("CoverHealth", cDef.health)
		cover:SetAttribute("MaxHealth", cDef.health)

		-- Neon edge trim on high cover
		if cDef.tier == "High" then
			createPart(
				cDef.name .. "_Trim",
				Vector3.new(cDef.size.X + 0.2, 0.3, cDef.size.Z + 0.2),
				CFrame.new(cDef.pos + Vector3.new(0, cDef.size.Y / 2, 0)),
				C.NEON_CYAN,
				Enum.Material.Neon,
				coverFolder,
				false,
				0.15
			)
		end
	end

	-- Barrel clusters (prop clustering technique from map design guide) [web:16]
	for _, barrelPos in
		{
			Vector3.new(-22, 1.5, -5),
			Vector3.new(-20, 1.5, -5),
			Vector3.new(-21, 1.5, -3),
			Vector3.new(22, 1.5, -5),
			Vector3.new(20, 1.5, -5),
			Vector3.new(21, 1.5, -3),
		}
	do
		local barrel = createPart(
			"Barrel",
			Vector3.new(2, 3, 2),
			CFrame.new(barrelPos),
			C.NEON_ORANGE,
			Enum.Material.Metal,
			coverFolder,
			true
		)
		barrel.Shape = Enum.PartType.Cylinder
		barrel.CFrame = CFrame.new(barrelPos) * CFrame.Angles(0, 0, math.rad(90)) + MAP_OFFSET
		barrel:SetAttribute("CoverTier", "Barrel")
		barrel:SetAttribute("CoverHealth", 50)
		barrel:SetAttribute("MaxHealth", 50)
		barrel:SetAttribute("IsExplosive", true)
	end

	------------------------------------------------------------------------
	-- 7. Observational Catwalk (overlooking the range)
	------------------------------------------------------------------------
	local catwalk = Instance.new("Folder")
	catwalk.Name = "Catwalk"
	catwalk.Parent = mapFolder

	createPart(
		"CatwalkPlatform",
		Vector3.new(60, 1, 6),
		CFrame.new(0, 20, 65),
		C.TRIM,
		Enum.Material.Metal,
		catwalk,
		true
	)
	createPart(
		"CatwalkRailing_L",
		Vector3.new(60, 0.3, 0.4),
		CFrame.new(-29, 21, 65),
		C.NEON_CYAN,
		Enum.Material.Neon,
		catwalk,
		false,
		0.2
	)
	createPart(
		"CatwalkRailing_R",
		Vector3.new(60, 0.3, 0.4),
		CFrame.new(29, 21, 65),
		C.NEON_CYAN,
		Enum.Material.Neon,
		catwalk,
		false,
		0.2
	)

	-- Support pillars
	for _, px in { -25, 0, 25 } do
		createPart(
			"CatwalkPillar_" .. px,
			Vector3.new(1, 20, 1),
			CFrame.new(px, 10, 68),
			C.WALL,
			Enum.Material.Concrete,
			catwalk,
			true
		)
		createPart(
			"CatwalkPillarLight_" .. px,
			Vector3.new(1.2, 0.5, 1.2),
			CFrame.new(px, 20.5, 68),
			C.NEON_CYAN,
			Enum.Material.Neon,
			catwalk,
			false,
			0.1
		)
		addLight(catwalk:FindFirstChild("CatwalkPillarLight_" .. px) :: BasePart, C.NEON_CYAN, 12, 1)
	end

	------------------------------------------------------------------------
	-- 8. Lighting Rig (ceiling lights + post-processing)
	------------------------------------------------------------------------
	local lightingFolder = Instance.new("Folder")
	lightingFolder.Name = "LightingRig"
	lightingFolder.Parent = mapFolder

	-- Ceiling light strips
	for _, lx in { -40, -20, 0, 20, 40 } do
		local strip = createPart(
			"CeilingLight_" .. lx,
			Vector3.new(8, 0.5, 40),
			CFrame.new(lx, MAP_HEIGHT_Y - 1, 0),
			Color3.fromRGB(200, 230, 255),
			Enum.Material.Neon,
			lightingFolder,
			false,
			0.2
		)
		addLight(strip, Color3.fromRGB(180, 220, 255), 40, 2, "Spot")
	end

	-- Post-processing effects stored as attributes for the bootstrap to apply
	mapFolder:SetAttribute("Lighting_Technology", "Future")
	mapFolder:SetAttribute("Lighting_Ambient", "45,50,65")
	mapFolder:SetAttribute("Lighting_OutdoorAmbient", "15,18,28")
	mapFolder:SetAttribute("Lighting_Brightness", "1.5")
	mapFolder:SetAttribute("Lighting_ClockTime", "14")
	mapFolder:SetAttribute("Lighting_GeographicLatitude", "0")
	mapFolder:SetAttribute("Lighting_ShadowSoftness", "0.3")
	mapFolder:SetAttribute("Atmosphere_Density", "0.35")
	mapFolder:SetAttribute("Atmosphere_Offset", "0")
	mapFolder:SetAttribute("Atmosphere_Color", "120,150,200")
	mapFolder:SetAttribute("Atmosphere_Decay", "100,130,160")
	mapFolder:SetAttribute("Atmosphere_Glare", "0.3")
	mapFolder:SetAttribute("Atmosphere_Haze", "1.5")
	mapFolder:SetAttribute("ColorCorrection_Brightness", "-0.05")
	mapFolder:SetAttribute("ColorCorrection_Contrast", "0.15")
	mapFolder:SetAttribute("ColorCorrection_Saturation", "0.1")
	mapFolder:SetAttribute("ColorCorrection_TintColor", "210,230,255")
	mapFolder:SetAttribute("Bloom_Intensity", "0.8")
	mapFolder:SetAttribute("Bloom_Size", "24")
	mapFolder:SetAttribute("Bloom_Threshold", "0.9")
	mapFolder:SetAttribute("SunRays_Intensity", "0.15")
	mapFolder:SetAttribute("SunRays_Spread", "1")

	------------------------------------------------------------------------
	-- 9. Score Zone Volumes (invisible regions for scoring detection)
	------------------------------------------------------------------------
	local scoreZones = Instance.new("Folder")
	scoreZones.Name = "ScoreZones"
	scoreZones.Parent = mapFolder

	for _, zone in
		{
			{ name = "BullseyeZone", center = Vector3.new(0, 10, -90), size = Vector3.new(110, 24, 4), score = 100 },
			{ name = "MovingTargetZone", center = Vector3.new(0, 8, -70), size = Vector3.new(60, 16, 20), score = 150 },
			{ name = "PatrolZone", center = Vector3.new(0, 2, -10), size = Vector3.new(80, 10, 60), score = 200 },
		}
	do
		local vol = createPart(
			zone.name,
			zone.size,
			CFrame.new(zone.center),
			Color3.new(),
			Enum.Material.SmoothPlastic,
			scoreZones,
			false,
			1
		)
		vol:SetAttribute("ZoneType", zone.name)
		vol:SetAttribute("ZoneScore", zone.score)
		vol.CanCollide = false
		vol.CanQuery = false
		vol.CanTouch = true
	end

	------------------------------------------------------------------------
	-- 10. Atmospheric FX (ambient dust)
	------------------------------------------------------------------------
	local fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = mapFolder

	local emitterPart = createPart(
		"AmbientDust",
		Vector3.new(1, 1, 1),
		CFrame.new(0, 10, -20),
		Color3.new(),
		Enum.Material.SmoothPlastic,
		fx,
		false,
		1
	)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(C.NEON_CYAN)
	pe.Size = NumberSequence.new(0.2, 0)
	pe.Transparency = NumberSequence.new(0.5, 1)
	pe.Lifetime = NumberRange.new(4, 7)
	pe.Rate = 8
	pe.Speed = NumberRange.new(1, 2)
	pe.SpreadAngle = Vector2.new(45, 45)
	pe.Parent = emitterPart

	------------------------------------------------------------------------
	-- Finalize
	------------------------------------------------------------------------
	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder
	return mapFolder
end

-- API Methods ---------------------------------------------------------------

function PracticeRangeMapLayout.DestroyMap()
	cleanup()
end

function PracticeRangeMapLayout.GetSpawnPoints(teamName: string?): { Vector3 }
	local results: { Vector3 } = {}
	for _, pos in PLAYER_SPAWN_POSITIONS do
		table.insert(results, pos + MAP_OFFSET)
	end
	return results
end

function PracticeRangeMapLayout.GetStationaryTargets(): { BasePart }
	if not _activeMapFolder then
		return {}
	end
	local section = _activeMapFolder:FindFirstChild("TargetWallSection")
	if not section then
		return {}
	end
	local targets: { BasePart } = {}
	for _, child in section:GetDescendants() do
		if
			child:IsA("BasePart")
			and child:GetAttribute("IsTarget") == true
			and child:GetAttribute("TargetType") == "Stationary"
		then
			table.insert(targets, child)
		end
	end
	return targets
end

function PracticeRangeMapLayout.GetMovingTargets(): { BasePart }
	if not _activeMapFolder then
		return {}
	end
	local section = _activeMapFolder:FindFirstChild("TargetWallSection")
	if not section then
		return {}
	end
	local moving = section:FindFirstChild("MovingTargets")
	if not moving then
		return {}
	end
	local targets: { BasePart } = {}
	for _, child in moving:GetChildren() do
		if child:IsA("BasePart") and child:GetAttribute("IsTarget") == true then
			table.insert(targets, child)
		end
	end
	return targets
end

function PracticeRangeMapLayout.GetBotWaypoints(): { Vector3 }
	local results: { Vector3 } = {}
	for _, pos in BOT_WAYPOINT_POSITIONS do
		table.insert(results, pos + MAP_OFFSET)
	end
	return results
end

function PracticeRangeMapLayout.GetCoverPositions(): { Vector3 }
	local results: { Vector3 } = {}
	for _, cDef in COVER_DEFS do
		table.insert(results, cDef.pos + MAP_OFFSET)
	end
	return results
end

function PracticeRangeMapLayout.GetAllTargets(): { BasePart }
	local all = PracticeRangeMapLayout.GetStationaryTargets()
	for _, t in PracticeRangeMapLayout.GetMovingTargets() do
		table.insert(all, t)
	end
	return all
end

function PracticeRangeMapLayout.GetSitePositions(): SitePositions?
	return {
		siteA = MAP_OFFSET + Vector3.new(0, 2, -90),
		siteB = MAP_OFFSET + Vector3.new(0, 2, 70),
	}
end

function PracticeRangeMapLayout.GetMapBounds(): (Vector3, Vector3)
	local minB = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2) + MAP_OFFSET
	local maxB = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2) + MAP_OFFSET
	return minB, maxB
end

function PracticeRangeMapLayout.GetLayoutData(): MapLayoutData
	local minB, maxB = PracticeRangeMapLayout.GetMapBounds()
	return {
		mapId = "PracticeRangeMap",
		mapName = "PracticeRange_Sandbox_v2",
		theme = "Industrial Sci-Fi Firing Range",
		bounds = { min = minB, max = maxB },
		redSpawns = PracticeRangeMapLayout.GetSpawnPoints("Red"),
		blueSpawns = PracticeRangeMapLayout.GetSpawnPoints("Blue"),
		sites = PracticeRangeMapLayout.GetSitePositions(),
		coverPositions = PracticeRangeMapLayout.GetCoverPositions(),
		lanes = {
			West = {
				center = MAP_OFFSET + Vector3.new(-MAP_WIDTH_X / 4, 0, 0),
				size = Vector3.new(30, MAP_HEIGHT_Y, MAP_LENGTH_Z),
			},
			Center = { center = MAP_OFFSET + Vector3.new(0, 0, 0), size = Vector3.new(30, MAP_HEIGHT_Y, MAP_LENGTH_Z) },
			East = {
				center = MAP_OFFSET + Vector3.new(MAP_WIDTH_X / 4, 0, 0),
				size = Vector3.new(30, MAP_HEIGHT_Y, MAP_LENGTH_Z),
			},
		},
	}
end

return PracticeRangeMapLayout
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">PracticeRangeMapLayout.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for PracticeRangeMapLayout
    Verifies singleplayer Practice Range sandbox map layout generation, hierarchy,
    target wall section (Target_Stationary_1..6), bot waypoints (Waypoints_Bot_1..8),
    distance markers, part property invariants (Anchored = true), and clean teardown.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local PracticeRangeMapLayout = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("PracticeRangeMapLayout"))

local function runTests()
	print("[PracticeRangeMapLayout.spec] Starting PracticeRangeMapLayout unit tests...")

	-- 1. Test Map Building
	local mapFolder = PracticeRangeMapLayout.BuildMap(Workspace)
	assert(mapFolder ~= nil, "BuildMap must return a valid Folder instance")
	assert(mapFolder.Name == "PracticeRangeMap", "Map folder name must be 'PracticeRangeMap'")
	assert(mapFolder.Parent == Workspace, "Map folder must be parented to Workspace")

	-- 2. Test Hierarchy &amp; Section Structures
	local perimeter = mapFolder:FindFirstChild("Perimeter")
	assert(perimeter ~= nil, "Perimeter folder missing")
	assert(perimeter:FindFirstChild("MainFloor") ~= nil, "MainFloor missing")

	local distanceMarkers = mapFolder:FindFirstChild("DistanceMarkers")
	assert(distanceMarkers ~= nil, "DistanceMarkers folder missing")
	assert(distanceMarkers:FindFirstChild("DistanceMarker_10m") ~= nil, "DistanceMarker_10m missing")
	assert(distanceMarkers:FindFirstChild("DistanceMarker_25m") ~= nil, "DistanceMarker_25m missing")
	assert(distanceMarkers:FindFirstChild("DistanceMarker_50m") ~= nil, "DistanceMarker_50m missing")

	local targetWallFolder = mapFolder:FindFirstChild("TargetWallSection")
	assert(targetWallFolder ~= nil, "TargetWallSection folder missing")
	assert(targetWallFolder:FindFirstChild("TargetWallBackboard") ~= nil, "TargetWallBackboard missing")

	for i = 1, 6 do
		local tName = "Target_Stationary_" .. i
		local targetPart = targetWallFolder:FindFirstChild(tName) :: BasePart?
		assert(targetPart ~= nil, tName .. " missing from TargetWallSection")
		assert(targetPart:GetAttribute("IsTarget") == true, tName .. " must have IsTarget = true")
		assert(targetPart:GetAttribute("TargetType") == "Stationary", tName .. " must have TargetType = 'Stationary'")
		assert(targetPart:GetAttribute("TargetId") == i, tName .. " TargetId attribute mismatch")

		local bullseye = targetPart:FindFirstChild("Bullseye") :: BasePart?
		assert(bullseye ~= nil, tName .. " must contain a Bullseye inner disc part")
		assert(bullseye:GetAttribute("IsBullseye") == true, "Bullseye must have IsBullseye = true")
		assert(bullseye.CanCollide == false, "Bullseye disc must have CanCollide = false")
	end

	local patrolBotFolder = mapFolder:FindFirstChild("PatrolBotSection")
	assert(patrolBotFolder ~= nil, "PatrolBotSection folder missing")
	local waypointsFolder = patrolBotFolder:FindFirstChild("Waypoints")
	assert(waypointsFolder ~= nil, "Waypoints folder missing")

	for i = 1, 8 do
		local wpName = "Waypoints_Bot_" .. i
		local wpPart = waypointsFolder:FindFirstChild(wpName) :: BasePart?
		assert(wpPart ~= nil, wpName .. " missing from Waypoints folder")
		assert(wpPart:GetAttribute("WaypointIndex") == i, wpName .. " WaypointIndex mismatch")
		assert(wpPart.CanCollide == false, wpName .. " must have CanCollide = false")
	end

	local spawnsFolder = mapFolder:FindFirstChild("Spawns")
	assert(spawnsFolder ~= nil, "Spawns folder missing")
	local playerSpawnFolder = spawnsFolder:FindFirstChild("PlayerSpawn")
	assert(playerSpawnFolder ~= nil, "PlayerSpawn folder missing")

	for i = 1, 3 do
		local sName = "Spawn_Player_" .. i
		local spPart = playerSpawnFolder:FindFirstChild(sName) :: BasePart?
		assert(spPart ~= nil, sName .. " missing from PlayerSpawn folder")
		assert(spPart.CanCollide == false, sName .. " must have CanCollide = false")
	end

	-- 3. Test API Helper Functions
	local stationaryTargets = PracticeRangeMapLayout.GetStationaryTargets()
	assert(#stationaryTargets == 6, "GetStationaryTargets must return 6 target parts, got " .. #stationaryTargets)

	local botWaypoints = PracticeRangeMapLayout.GetBotWaypoints()
	assert(#botWaypoints == 8, "GetBotWaypoints must return 8 waypoint positions, got " .. #botWaypoints)

	local playerSpawns = PracticeRangeMapLayout.GetSpawnPoints()
	assert(#playerSpawns == 3, "GetSpawnPoints must return 3 player spawn positions, got " .. #playerSpawns)

	local coverPositions = PracticeRangeMapLayout.GetCoverPositions()
	assert(#coverPositions &gt;= 3, "GetCoverPositions must return at least 3 cover positions")

	-- 4. Test Part Property Invariants
	for _, desc in mapFolder:GetDescendants() do
		if desc:IsA("BasePart") then
			assert(desc.Anchored == true, "Part '" .. desc.Name .. "' must be Anchored = true")
		end
	end

	-- 5. Test Layout Data &amp; Bounds
	local layoutData = PracticeRangeMapLayout.GetLayoutData()
	assert(layoutData.mapId == "PracticeRangeMap", "Layout mapId mismatch")
	assert(layoutData.mapName == "PracticeRange_Sandbox", "Layout mapName mismatch")
	assert(layoutData.bounds.min.X == -70 or layoutData.bounds.min.X == 430, "Min bound X mismatch")
	assert(layoutData.bounds.max.X == 70 or layoutData.bounds.max.X == 570, "Max bound X mismatch")

	-- 6. Test Map Teardown
	PracticeRangeMapLayout.DestroyMap()
	assert(mapFolder.Parent == nil, "Map folder must be unparented after DestroyMap()")

	print("[PracticeRangeMapLayout.spec] All PracticeRangeMapLayout tests passed successfully!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">UrbanWarehouseMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: UrbanWarehouseMap
    Procedural 5v5 FPS Urban Warehouse layout builder module.
    Generates an industrial warehouse environment featuring shipping containers,
    steel crates, elevated catwalks with access stairs, heavy concrete pillars,
    interior room/rack mazes, spawn locations, and objective sites.
]=]

local Workspace = game:GetService("Workspace")

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type LaneData = {
	center: Vector3,
	size: Vector3,
}

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions,
	coverPositions: { Vector3 },
	lanes: { [string]: LaneData },
}

local UrbanWarehouseMap = {}

local MAP_FOLDER_NAME = "UrbanWarehouseMap"
local _activeMapFolder: Folder? = nil

-- Map Dimension Constants
local MAP_WIDTH_X = 170
local MAP_LENGTH_Z = 250
local MAP_HEIGHT_Y = 32

local RED_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-14, 2, -105),
	Vector3.new(-7, 2, -105),
	Vector3.new(0, 2, -105),
	Vector3.new(7, 2, -105),
	Vector3.new(14, 2, -105),
}

local BLUE_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-14, 2, 105),
	Vector3.new(-7, 2, 105),
	Vector3.new(0, 2, 105),
	Vector3.new(7, 2, 105),
	Vector3.new(14, 2, 105),
}

local SITE_A_POSITION = Vector3.new(-50, 1, -40)
local SITE_B_POSITION = Vector3.new(50, 1, 40)

local COVER_POSITIONS: { Vector3 } = {
	-- Site A Containers &amp; Crates
	Vector3.new(-50, 5, -40),
	Vector3.new(-62, 2.5, -30),
	Vector3.new(-38, 2.5, -50),
	-- Site B Containers &amp; Crates
	Vector3.new(50, 5, 40),
	Vector3.new(62, 2.5, 30),
	Vector3.new(38, 2.5, 50),
	-- Mid Interior Pillars &amp; Steel Crates
	Vector3.new(-18, 6, 0),
	Vector3.new(18, 6, 0),
	Vector3.new(0, 2.5, -20),
	Vector3.new(0, 2.5, 20),
	-- Catwalk Vantage Points
	Vector3.new(-45, 14, -75),
	Vector3.new(45, 14, 75),
}

local LANES_DATA: { [string]: LaneData } = {
	CentralAisle = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(26, 0.4, 165) },
	WestStorageBay = { center = Vector3.new(-50, 0.2, 0), size = Vector3.new(28, 0.4, 185) },
	EastLoadingDock = { center = Vector3.new(50, 0.2, 0), size = Vector3.new(28, 0.4, 185) },
	RackConnectorNorth = { center = Vector3.new(-25, 0.2, -40), size = Vector3.new(26, 0.4, 16) },
	RackConnectorSouth = { center = Vector3.new(25, 0.2, 40), size = Vector3.new(26, 0.4, 16) },
}

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

-- Helper to create corrugated shipping containers
local function createShippingContainer(
	name: string,
	position: Vector3,
	rotationYDeg: number,
	color: Color3,
	parent: Instance
)
	local containerFolder = Instance.new("Folder")
	containerFolder.Name = name
	containerFolder.Parent = parent

	local cf = CFrame.new(position) * CFrame.Angles(0, math.rad(rotationYDeg), 0)
	local containerSize = Vector3.new(10, 9, 24)

	-- Main Box Body
	createPart(
		"Body",
		containerSize,
		cf * CFrame.new(0, containerSize.Y / 2, 0),
		color,
		Enum.Material.Corrugated,
		containerFolder
	)

	-- Steel End Frame Highlights
	local darkMetal = Color3.fromRGB(45, 45, 50)
	createPart(
		"FrontFrame",
		Vector3.new(containerSize.X + 0.4, containerSize.Y + 0.4, 0.8),
		cf * CFrame.new(0, containerSize.Y / 2, containerSize.Z / 2),
		darkMetal,
		Enum.Material.DiamondPlate,
		containerFolder
	)
	createPart(
		"BackFrame",
		Vector3.new(containerSize.X + 0.4, containerSize.Y + 0.4, 0.8),
		cf * CFrame.new(0, containerSize.Y / 2, -containerSize.Z / 2),
		darkMetal,
		Enum.Material.DiamondPlate,
		containerFolder
	)
end

-- Helper to create steel crates
local function createSteelCrate(
	name: string,
	size: Vector3,
	cframe: CFrame,
	parent: Instance
)
	local crateColor = Color3.fromRGB(90, 95, 100)
	local crate = createPart(
		name,
		size,
		cframe,
		crateColor,
		Enum.Material.DiamondPlate,
		parent
	)
	crate:SetAttribute("CoverType", "SteelCrate")
end

-- Helper to create elevated catwalk with stairs
local function buildCatwalk(
	name: string,
	startPos: Vector3,
	length: number,
	height: number,
	parent: Instance
)
	local catwalkFolder = Instance.new("Folder")
	catwalkFolder.Name = name
	catwalkFolder.Parent = parent

	local metalColor = Color3.fromRGB(70, 75, 80)
	local railColor = Color3.fromRGB(180, 185, 190)
	local width = 6

	-- Main Deck Platform
	local deckCF = CFrame.new(startPos + Vector3.new(0, height, length / 2))
	createPart(
		"CatwalkDeck",
		Vector3.new(width, 1, length),
		deckCF,
		metalColor,
		Enum.Material.DiamondPlate,
		catwalkFolder
	)

	-- Railings
	createPart(
		"RailingLeft",
		Vector3.new(0.5, 3.5, length),
		deckCF * CFrame.new(-width / 2 + 0.25, 2, 0),
		railColor,
		Enum.Material.Metal,
		catwalkFolder
	)
	createPart(
		"RailingRight",
		Vector3.new(0.5, 3.5, length),
		deckCF * CFrame.new(width / 2 - 0.25, 2, 0),
		railColor,
		Enum.Material.Metal,
		catwalkFolder
	)

	-- Support Columns underneath
	local numColumns = math.floor(length / 20) + 1
	for i = 0, numColumns do
		local zOffset = (i / numColumns) * length
		createPart(
			"SupportPillar_" .. i,
			Vector3.new(1.5, height, 1.5),
			CFrame.new(startPos + Vector3.new(0, height / 2, zOffset)),
			metalColor,
			Enum.Material.Metal,
			catwalkFolder
		)
	end

	-- Stair Ramp Access
	local stairLength = 16
	createWedge(
		"StairsRamp",
		Vector3.new(width, height, stairLength),
		CFrame.new(startPos + Vector3.new(0, height / 2, -stairLength / 2)),
		metalColor,
		Enum.Material.DiamondPlate,
		catwalkFolder
	)
end

function UrbanWarehouseMap.BuildMap(parent: Instance?): Folder
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- 1. Outer Perimeter &amp; Concrete Floor
	local perimeterFolder = Instance.new("Folder")
	perimeterFolder.Name = "Perimeter"
	perimeterFolder.Parent = mapFolder

	local concreteColor = Color3.fromRGB(85, 88, 92)
	local wallColor = Color3.fromRGB(65, 70, 75)

	-- Warehouse Slab Floor
	createPart(
		"WarehouseFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		concreteColor,
		Enum.Material.Concrete,
		perimeterFolder
	)

	-- Outer Reinforced Walls
	createPart(
		"NorthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
		wallColor,
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"SouthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
		wallColor,
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"WestWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		wallColor,
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"EastWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		wallColor,
		Enum.Material.Concrete,
		perimeterFolder
	)

	-- Ceiling Girders (Structural Roof Trusses)
	for z = -100, 100, 40 do
		createPart(
			"RoofTruss_" .. z,
			Vector3.new(MAP_WIDTH_X, 3, 2),
			CFrame.new(0, MAP_HEIGHT_Y - 1.5, z),
			Color3.fromRGB(50, 55, 60),
			Enum.Material.Metal,
			perimeterFolder
		)
	end

	-- 2. Spawns Folder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local redSpawnFolder = Instance.new("Folder")
	redSpawnFolder.Name = "RedSpawn"
	redSpawnFolder.Parent = spawnsFolder

	createPart(
		"RedLoadingBayPad",
		Vector3.new(38, 1, 24),
		CFrame.new(0, 0.5, -105),
		Color3.fromRGB(170, 50, 50),
		Enum.Material.DiamondPlate,
		redSpawnFolder
	)

	for i, pos in RED_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(230, 80, 80),
			Enum.Material.Neon,
			redSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Red")
		sp:SetAttribute("Index", i)
	end

	local blueSpawnFolder = Instance.new("Folder")
	blueSpawnFolder.Name = "BlueSpawn"
	blueSpawnFolder.Parent = spawnsFolder

	createPart(
		"BlueOfficePad",
		Vector3.new(38, 1, 24),
		CFrame.new(0, 0.5, 105),
		Color3.fromRGB(50, 100, 170),
		Enum.Material.DiamondPlate,
		blueSpawnFolder
	)

	for i, pos in BLUE_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(80, 140, 230),
			Enum.Material.Neon,
			blueSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Blue")
		sp:SetAttribute("Index", i)
	end

	-- 3. Environment Assets Folder (Containers, Pillars, Catwalks, Interior Maze)
	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = mapFolder

	-- Shipping Containers (Red, Blue, Yellow, Teal)
	createShippingContainer("Container_Red_1", Vector3.new(-50, 0, -40), 15, Color3.fromRGB(180, 45, 45), envFolder)
	createShippingContainer("Container_Blue_1", Vector3.new(50, 0, 40), -15, Color3.fromRGB(45, 90, 180), envFolder)
	createShippingContainer("Container_Yellow_1", Vector3.new(-55, 0, 30), 90, Color3.fromRGB(200, 160, 40), envFolder)
	createShippingContainer("Container_Teal_1", Vector3.new(55, 0, -30), -90, Color3.fromRGB(40, 160, 150), envFolder)

	-- Stacked Upper Containers
	createShippingContainer("Container_Red_Upper", Vector3.new(-50, 9, -40), 15, Color3.fromRGB(160, 40, 40), envFolder)
	createShippingContainer("Container_Blue_Upper", Vector3.new(50, 9, 40), -15, Color3.fromRGB(40, 80, 160), envFolder)

	-- Heavy Concrete Interior Support Pillars
	local pillarPositions = {
		Vector3.new(-18, 16, -60),
		Vector3.new(18, 16, -60),
		Vector3.new(-18, 16, 0),
		Vector3.new(18, 16, 0),
		Vector3.new(-18, 16, 60),
		Vector3.new(18, 16, 60),
	}
	for i, pPos in pillarPositions do
		createPart(
			"ConcretePillar_" .. i,
			Vector3.new(6, 32, 6),
			CFrame.new(pPos),
			Color3.fromRGB(100, 105, 110),
			Enum.Material.Concrete,
			envFolder
		)
	end

	-- Elevated Catwalks with Stairs
	buildCatwalk("Catwalk_West", Vector3.new(-45, 0, -80), 60, 14, envFolder)
	buildCatwalk("Catwalk_East", Vector3.new(45, 0, 20), 60, 14, envFolder)

	-- Storage Rack Partition Maze Walls
	local rackColor = Color3.fromRGB(110, 75, 40)
	createPart(
		"StorageRack_North_1",
		Vector3.new(24, 10, 4),
		CFrame.new(-30, 5, -70),
		rackColor,
		Enum.Material.WoodPlanks,
		envFolder
	)
	createPart(
		"StorageRack_North_2",
		Vector3.new(24, 10, 4),
		CFrame.new(30, 5, -70),
		rackColor,
		Enum.Material.WoodPlanks,
		envFolder
	)
	createPart(
		"StorageRack_South_1",
		Vector3.new(24, 10, 4),
		CFrame.new(-30, 5, 70),
		rackColor,
		Enum.Material.WoodPlanks,
		envFolder
	)
	createPart(
		"StorageRack_South_2",
		Vector3.new(24, 10, 4),
		CFrame.new(30, 5, 70),
		rackColor,
		Enum.Material.WoodPlanks,
		envFolder
	)

	-- 4. Sites Folder
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local siteA = createPart(
		"SiteA",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_A_POSITION),
		Color3.fromRGB(240, 180, 40),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteA.Transparency = 0.5
	siteA:SetAttribute("SiteName", "A")

	local siteB = createPart(
		"SiteB",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_B_POSITION),
		Color3.fromRGB(240, 180, 40),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteB.Transparency = 0.5
	siteB:SetAttribute("SiteName", "B")

	-- 5. Cover &amp; Steel Crates Folder
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	-- Steel Crates around Site A
	createSteelCrate("SteelCrate_SiteA_1", Vector3.new(5, 5, 5), CFrame.new(-62, 2.5, -30), coverFolder)
	createSteelCrate("SteelCrate_SiteA_2", Vector3.new(6, 5, 4), CFrame.new(-38, 2.5, -50), coverFolder)

	-- Steel Crates around Site B
	createSteelCrate("SteelCrate_SiteB_1", Vector3.new(5, 5, 5), CFrame.new(62, 2.5, 30), coverFolder)
	createSteelCrate("SteelCrate_SiteB_2", Vector3.new(6, 5, 4), CFrame.new(38, 2.5, 50), coverFolder)

	-- Mid Aisle Steel Crates
	createSteelCrate("SteelCrate_Mid_1", Vector3.new(7, 5, 5), CFrame.new(0, 2.5, -20), coverFolder)
	createSteelCrate("SteelCrate_Mid_2", Vector3.new(7, 5, 5), CFrame.new(0, 2.5, 20), coverFolder)

	-- 6. Lanes Folder
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		createPart(
			laneName,
			data.size,
			CFrame.new(data.center),
			Color3.fromRGB(100, 105, 110),
			Enum.Material.SmoothPlastic,
			lanesFolder,
			false
		)
	end

	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder

	return mapFolder
end

function UrbanWarehouseMap.DestroyMap()
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

function UrbanWarehouseMap.GetSpawnPoints(teamName: string): { Vector3 }
	if teamName == "Red" then
		return table.clone(RED_SPAWN_POSITIONS)
	elseif teamName == "Blue" then
		return table.clone(BLUE_SPAWN_POSITIONS)
	else
		warn("[UrbanWarehouseMap] Invalid team name: " .. tostring(teamName))
		return {}
	end
end

function UrbanWarehouseMap.GetCoverPositions(): { Vector3 }
	return table.clone(COVER_POSITIONS)
end

function UrbanWarehouseMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_A_POSITION,
		siteB = SITE_B_POSITION,
	}
end

function UrbanWarehouseMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2)
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2)
	return minBounds, maxBounds
end

function UrbanWarehouseMap.GetLayoutData(): MapLayoutData
	local minB, maxB = UrbanWarehouseMap.GetMapBounds()
	return {
		mapId = "UrbanWarehouse",
		mapName = "Urban Warehouse",
		theme = "Urban",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = table.clone(RED_SPAWN_POSITIONS),
		blueSpawns = table.clone(BLUE_SPAWN_POSITIONS),
		sites = UrbanWarehouseMap.GetSitePositions(),
		coverPositions = table.clone(COVER_POSITIONS),
		lanes = LANES_DATA,
	}
end

return UrbanWarehouseMap
]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX12"><Properties><string name="Name">Network</string></Properties><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">BufferSerializer</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Buffer Serialization Module
    Provides high-performance binary buffer serialization/deserialization
    using Luau buffer datatype and bit32 operations.
]=]

local Types = require(script.Parent.Parent.Types)

local BufferSerializer = {}

-- ----------------------------------------------------------------------------
-- 1. Vector3 Serialization (Exactly 12 Bytes)
-- ----------------------------------------------------------------------------

--- Serializes a Vector3 into a new 12-byte buffer (3 x 32-bit floats).
function BufferSerializer.SerializeVector3(v: Vector3): buffer
    local buf = buffer.create(12)
    buffer.writef32(buf, 0, v.X)
    buffer.writef32(buf, 4, v.Y)
    buffer.writef32(buf, 8, v.Z)
    return buf
end

--- Writes a Vector3 into an existing buffer at the specified byte offset. Returns new offset.
function BufferSerializer.WriteVector3(buf: buffer, offset: number, v: Vector3): number
    buffer.writef32(buf, offset, v.X)
    buffer.writef32(buf, offset + 4, v.Y)
    buffer.writef32(buf, offset + 8, v.Z)
    return offset + 12
end

--- Deserializes a Vector3 from a buffer starting at offset. Returns Vector3 and new offset.
function BufferSerializer.DeserializeVector3(buf: buffer, offset: number?): (Vector3, number)
    local off = offset or 0
    local x = buffer.readf32(buf, off)
    local y = buffer.readf32(buf, off + 4)
    local z = buffer.readf32(buf, off + 8)
    return Vector3.new(x, y, z), off + 12
end

-- ----------------------------------------------------------------------------
-- 2. CFrame Serialization (13 to 15 Bytes)
-- Position: 12 bytes (3 x f32)
-- Rotation: 1-3 bytes (Compressed Euler YXZ / Yaw representation)
-- Default SerializeCFrame produces 15 bytes (12b pos + 3b Euler YXZ u8)
-- ----------------------------------------------------------------------------

--- Angle conversion helper: maps [-pi, pi] to [0, 255] u8
local function angleToU8(angle: number): number
    local norm = (angle + math.pi) / (2 * math.pi)
    norm = norm - math.floor(norm)
    return math.clamp(math.floor(norm * 256), 0, 255)
end

--- Angle conversion helper: maps [0, 255] u8 to [-pi, pi]
local function u8ToAngle(u: number): number
    return (u / 256) * (2 * math.pi) - math.pi
end

--- Writes a CFrame into a buffer starting at offset using 15 bytes (12b pos + 3b Euler YXZ).
function BufferSerializer.WriteCFrame(buf: buffer, offset: number, cf: CFrame): number
    local pos = cf.Position
    buffer.writef32(buf, offset, pos.X)
    buffer.writef32(buf, offset + 4, pos.Y)
    buffer.writef32(buf, offset + 8, pos.Z)

    local rx, ry, rz = cf:ToEulerAnglesYXZ()
    buffer.writeu8(buf, offset + 12, angleToU8(rx))
    buffer.writeu8(buf, offset + 13, angleToU8(ry))
    buffer.writeu8(buf, offset + 14, angleToU8(rz))

    return offset + 15
end

--- Serializes a CFrame into a new 15-byte buffer (12b position + 3b compressed rotation).
function BufferSerializer.SerializeCFrame(cf: CFrame): buffer
    local buf = buffer.create(15)
    BufferSerializer.WriteCFrame(buf, 0, cf)
    return buf
end

--- Deserializes a 15-byte CFrame from buffer starting at offset.
function BufferSerializer.DeserializeCFrame(buf: buffer, offset: number?): (CFrame, number)
    local off = offset or 0
    local px = buffer.readf32(buf, off)
    local py = buffer.readf32(buf, off + 4)
    local pz = buffer.readf32(buf, off + 8)

    local bx = buffer.readu8(buf, off + 12)
    local by = buffer.readu8(buf, off + 13)
    local bz = buffer.readu8(buf, off + 14)

    local pos = Vector3.new(px, py, pz)
    local rot = CFrame.fromEulerAnglesYXZ(u8ToAngle(bx), u8ToAngle(by), u8ToAngle(bz))

    return CFrame.new(pos) * rot, off + 15
end

--- Serializes a CFrame into a 13-byte buffer (12b position + 1b compressed Yaw index).
function BufferSerializer.SerializeCFrame13(cf: CFrame): buffer
    local buf = buffer.create(13)
    local pos = cf.Position
    buffer.writef32(buf, 0, pos.X)
    buffer.writef32(buf, 4, pos.Y)
    buffer.writef32(buf, 8, pos.Z)

    local _, yaw, _ = cf:ToEulerAnglesYXZ()
    buffer.writeu8(buf, 12, angleToU8(yaw))
    return buf
end

--- Deserializes a 13-byte CFrame (12b pos + 1b Yaw) from buffer.
function BufferSerializer.DeserializeCFrame13(buf: buffer, offset: number?): (CFrame, number)
    local off = offset or 0
    local px = buffer.readf32(buf, off)
    local py = buffer.readf32(buf, off + 4)
    local pz = buffer.readf32(buf, off + 8)
    local by = buffer.readu8(buf, off + 12)

    local yaw = u8ToAngle(by)
    return CFrame.new(px, py, pz) * CFrame.Angles(0, yaw, 0), off + 13
end

-- ----------------------------------------------------------------------------
-- 3. Boolean Array Bit-Packing (8 Booleans per Byte)
-- ----------------------------------------------------------------------------

--- Bit-packs an array of booleans into a buffer at 8 booleans per byte.
function BufferSerializer.BitPackBooleans(bools: { boolean }): buffer
    local count = #bools
    local numBytes = math.max(1, math.ceil(count / 8))
    local buf = buffer.create(numBytes)

    for i = 1, count do
        if bools[i] then
            local byteIdx = math.floor((i - 1) / 8)
            local bitPos = (i - 1) % 8
            local currentByte = buffer.readu8(buf, byteIdx)
            local newByte = bit32.bor(currentByte, bit32.lshift(1, bitPos))
            buffer.writeu8(buf, byteIdx, newByte)
        end
    end

    return buf
end

--- Unpacks count booleans from a bit-packed buffer starting at offset.
function BufferSerializer.BitUnpackBooleans(buf: buffer, offset: number?, count: number): { boolean }
    local off = offset or 0
    local result: { boolean } = table.create(count)

    for i = 1, count do
        local byteIdx = math.floor((i - 1) / 8)
        local bitPos = (i - 1) % 8
        local byteVal = buffer.readu8(buf, off + byteIdx)
        local isSet = bit32.band(byteVal, bit32.lshift(1, bitPos)) ~= 0
        result[i] = isSet
    end

    return result
end

-- ----------------------------------------------------------------------------
-- 4. High-Level Struct Serialization (Hit Verification Payload)
-- ----------------------------------------------------------------------------

--- Serializes a HitVerificationPayload into a packed binary buffer.
function BufferSerializer.SerializeHitVerification(payload: Types.HitVerificationPayload): buffer
    local wId = payload.weaponId or ""
    local wLen = math.min(#wId, 255)
    local bufSize = 53 + wLen
    local buf = buffer.create(bufSize)

    local off = 0
    off = BufferSerializer.WriteVector3(buf, off, payload.origin)
    off = BufferSerializer.WriteVector3(buf, off, payload.direction)
    buffer.writef32(buf, off, payload.distance)
    off = off + 4
    off = BufferSerializer.WriteVector3(buf, off, payload.hitPosition)
    buffer.writef64(buf, off, payload.clientTimestamp)
    off = off + 8
    buffer.writeu32(buf, off, payload.sequenceId)
    off = off + 4

    buffer.writeu8(buf, off, wLen)
    off = off + 1
    buffer.writestring(buf, off, wId, wLen)

    return buf
end

--- Deserializes a HitVerificationPayload from a binary buffer.
function BufferSerializer.DeserializeHitVerification(buf: buffer, offset: number?): (Types.HitVerificationPayload, number)
    local off = offset or 0
    local origin, off1 = BufferSerializer.DeserializeVector3(buf, off)
    local direction, off2 = BufferSerializer.DeserializeVector3(buf, off1)
    local distance = buffer.readf32(buf, off2)
    off2 = off2 + 4
    local hitPosition, off3 = BufferSerializer.DeserializeVector3(buf, off2)
    local clientTimestamp = buffer.readf64(buf, off3)
    off3 = off3 + 8
    local sequenceId = buffer.readu32(buf, off3)
    off3 = off3 + 4

    local wLen = buffer.readu8(buf, off3)
    off3 = off3 + 1
    local weaponId = buffer.readstring(buf, off3, wLen)
    off3 = off3 + wLen

    local payload: Types.HitVerificationPayload = {
        origin = origin,
        direction = direction,
        distance = distance,
        hitPosition = hitPosition,
        clientTimestamp = clientTimestamp,
        sequenceId = sequenceId,
        weaponId = weaponId,
        targetInstance = nil,
    }

    return payload, off3
end

-- ----------------------------------------------------------------------------
-- 5. Fire Intent Serialization (24 bytes)
-- ----------------------------------------------------------------------------

--- Serializes a Fire Intent into a 24-byte buffer (origin + direction).
function BufferSerializer.SerializeFireIntent(origin: Vector3, direction: Vector3): buffer
    local buf = buffer.create(24)
    local off = BufferSerializer.WriteVector3(buf, 0, origin)
    BufferSerializer.WriteVector3(buf, off, direction)
    return buf
end

--- Deserializes a Fire Intent buffer back into origin and direction vectors.
function BufferSerializer.DeserializeFireIntent(buf: buffer): (Vector3, Vector3)
    local origin, off = BufferSerializer.DeserializeVector3(buf, 0)
    local direction = BufferSerializer.DeserializeVector3(buf, off)
	return origin, direction
end

-- ----------------------------------------------------------------------------
-- 6. Spatial State Sync (Movement Reconciliation) (28 bytes)
-- ----------------------------------------------------------------------------

--- Serializes a Spatial State (timestamp + position + velocity) into a 28-byte buffer.
function BufferSerializer.SerializeSpatialState(timestamp: number, position: Vector3, velocity: Vector3): buffer
    local buf = buffer.create(28)
    buffer.writef32(buf, 0, timestamp)
    local off = BufferSerializer.WriteVector3(buf, 4, position)
    BufferSerializer.WriteVector3(buf, off, velocity)
    return buf
end

--- Deserializes a Spatial State buffer back into timestamp, position, and velocity.
function BufferSerializer.DeserializeSpatialState(buf: buffer): (number, Vector3, Vector3)
    local timestamp = buffer.readf32(buf, 0)
    local position, off = BufferSerializer.DeserializeVector3(buf, 4)
    local velocity = BufferSerializer.DeserializeVector3(buf, off)
    return timestamp, position, velocity
end

return BufferSerializer
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">ChallengeEvents</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: ChallengeEvents Network Module
    Defines and initializes reliable RemoteEvents for direct player-to-player 1v1 challenges
    (ChallengeSend, ChallengeReceive, ChallengeRespond, ChallengeCancel, ChallengeExpired).
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type ChallengeState = "Pending" | "Accepted" | "Declined" | "Expired" | "Canceled"

export type PlayerInfo = {
	userId: number,
	username: string,
	displayName: string,
}

export type ChallengeRequestData = {
	challengeId: string,
	challenger: PlayerInfo,
	target: PlayerInfo,
	timestamp: number,
	expiresAt: number,
}

export type ChallengeResponseData = {
	challengeId: string,
	challengerUserId: number,
	targetUserId: number,
	accepted: boolean,
	timestamp: number,
}

export type ChallengeCancelData = {
	challengeId: string,
	challengerUserId: number,
	targetUserId: number,
	reason: string?,
}

export type ChallengeExpiredData = {
	challengeId: string,
	challengerUserId: number,
	targetUserId: number,
}

export type ChallengeEventName =
	"ChallengeSend"
	| "ChallengeReceive"
	| "ChallengeRespond"
	| "ChallengeCancel"
	| "ChallengeExpired"

local ChallengeEvents = {}

local remoteEventsCache: { [string]: RemoteEvent } = {}
local remotesFolder: Folder? = nil
local reliableFolder: Folder? = nil

local RELIABLE_EVENT_NAMES: { ChallengeEventName } = {
	"ChallengeSend",
	"ChallengeReceive",
	"ChallengeRespond",
	"ChallengeCancel",
	"ChallengeExpired",
}

local function getOrCreateFolders(): (Folder, Folder)
	if remotesFolder and reliableFolder then
		return remotesFolder, reliableFolder
	end

	local networkFolder = ReplicatedStorage:FindFirstChild("Network")
	if not networkFolder then
		if RunService:IsServer() then
			networkFolder = Instance.new("Folder")
			networkFolder.Name = "Network"
			networkFolder.Parent = ReplicatedStorage
		else
			networkFolder = ReplicatedStorage:WaitForChild("Network", 10)
		end
	end

	if not networkFolder then
		error("[Network] Failed to find Network folder in ReplicatedStorage within timeout")
	end

	local remDir = networkFolder and networkFolder:FindFirstChild("Remotes")
	if not remDir then
		if RunService:IsServer() then
			remDir = Instance.new("Folder")
			remDir.Name = "Remotes"
			remDir.Parent = networkFolder
		else
			remDir = networkFolder:WaitForChild("Remotes", 10) :: Folder
		end
	end
	remotesFolder = remDir :: Folder

	local existingRel = remDir:FindFirstChild("Reliable")
	if existingRel and existingRel:IsA("Folder") then
		reliableFolder = existingRel
	elseif RunService:IsServer() then
		local sf = Instance.new("Folder")
		sf.Name = "Reliable"
		sf.Parent = remDir
		reliableFolder = sf
	else
		reliableFolder = remDir:WaitForChild("Reliable", 10) :: Folder
	end

	return remotesFolder :: Folder, reliableFolder :: Folder
end

--- Initializes all challenge RemoteEvent channels.
function ChallengeEvents.Initialize()
	local container, relFolder = getOrCreateFolders()

	if RunService:IsServer() then
		for _, name in ipairs(RELIABLE_EVENT_NAMES) do
			local remote = relFolder:FindFirstChild(name) or container:FindFirstChild(name)
			if not remote or not remote:IsA("RemoteEvent") then
				local newRemote = Instance.new("RemoteEvent")
				newRemote.Name = name
				newRemote.Parent = relFolder
				remoteEventsCache[name] = newRemote
			else
				remoteEventsCache[name] = remote :: RemoteEvent
			end
		end
	else
		for _, name in ipairs(RELIABLE_EVENT_NAMES) do
			local remote = relFolder:WaitForChild(name, 15) or container:WaitForChild(name, 5)
			if remote and remote:IsA("RemoteEvent") then
				remoteEventsCache[name] = remote :: RemoteEvent
			end
		end
	end
end

--- Returns a cached RemoteEvent channel by name.
function ChallengeEvents.GetRemoteEvent(name: ChallengeEventName): RemoteEvent
	if remoteEventsCache[name] then
		return remoteEventsCache[name]
	end

	local container, relFolder = getOrCreateFolders()
	local remote = relFolder:FindFirstChild(name) or container:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		remoteEventsCache[name] = remote :: RemoteEvent
		return remote :: RemoteEvent
	end

	if RunService:IsServer() then
		local newRemote = Instance.new("RemoteEvent")
		newRemote.Name = name
		newRemote.Parent = relFolder
		remoteEventsCache[name] = newRemote
		return newRemote
	end

	error("[ChallengeEvents] RemoteEvent '" .. tostring(name) .. "' not found!")
end

return ChallengeEvents
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">QueueEvents</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: QueueEvents Network Module
    Defines and initializes reliable RemoteEvents and RemoteFunctions for queue management,
    player matchmaking, map voting, and match found notifications.
]=]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

export type QueueMode = "1v1" | "2v2"

export type PlayerInfo = {
	userId: number,
	username: string,
	displayName: string,
}

export type QueueStatusData = {
	inQueue: boolean,
	mode: QueueMode?,
	queueTimeSeconds: number,
	playersInQueue: number,
}

export type MatchFoundData = {
	matchId: string,
	mode: QueueMode,
	teamId: number,
	teammates: { PlayerInfo },
	opponents: { PlayerInfo },
	votingDurationSeconds: number,
	availableMaps: { string },
}

export type MapVoteData = {
	matchId: string,
	mapName: string,
}

export type MapVoteResult = {
	matchId: string,
	mapVotes: { [string]: number },
	winningMap: string?,
	votingEnded: boolean,
}

local QueueEvents = {}

local remoteEventsCache: { [string]: RemoteEvent } = {}
local remoteFunctionsCache: { [string]: RemoteFunction } = {}
local remotesFolder: Folder? = nil
local reliableFolder: Folder? = nil
local functionsFolder: Folder? = nil

local RELIABLE_EVENT_NAMES = {
	"QueueMatchFound",
	"QueueStatusUpdate",
	"MapVoteUpdate",
}

local REMOTE_FUNCTION_NAMES = {
	"QueueEnter",
	"QueueLeave",
	"MapVoteSubmit",
}

local function getOrCreateFolders(): (Folder, Folder, Folder)
	if remotesFolder and reliableFolder and functionsFolder then
		return remotesFolder, reliableFolder, functionsFolder
	end

	local networkFolder = ReplicatedStorage:FindFirstChild("Network")
	if not networkFolder then
		if RunService:IsServer() then
			networkFolder = Instance.new("Folder")
			networkFolder.Name = "Network"
			networkFolder.Parent = ReplicatedStorage
		else
			networkFolder = ReplicatedStorage:WaitForChild("Network", 10)
		end
	end

	if not networkFolder then
		error("[Network] Failed to find Network folder in ReplicatedStorage within timeout")
	end

	local remDir = networkFolder and networkFolder:FindFirstChild("Remotes")
	if not remDir then
		if RunService:IsServer() then
			remDir = Instance.new("Folder")
			remDir.Name = "Remotes"
			remDir.Parent = networkFolder
		else
			remDir = networkFolder:WaitForChild("Remotes", 10) :: Folder
		end
	end
	remotesFolder = remDir :: Folder

	local function getSubfolder(name: string): Folder
		local existing = remDir:FindFirstChild(name)
		if existing and existing:IsA("Folder") then
			return existing
		end
		if RunService:IsServer() then
			local sf = Instance.new("Folder")
			sf.Name = name
			sf.Parent = remDir
			return sf
		else
			local sf = remDir:WaitForChild(name, 10) :: Folder
			return sf
		end
	end

	reliableFolder = getSubfolder("Reliable")
	functionsFolder = getSubfolder("Functions")

	return remotesFolder :: Folder, reliableFolder :: Folder, functionsFolder :: Folder
end

--- Initializes all queue RemoteEvent and RemoteFunction channels.
function QueueEvents.Initialize()
	local container, relFolder, fnFolder = getOrCreateFolders()

	if RunService:IsServer() then
		for _, name in ipairs(RELIABLE_EVENT_NAMES) do
			local existing = relFolder:FindFirstChild(name) or container:FindFirstChild(name)
			if not existing or not existing:IsA("RemoteEvent") then
				local newRemote = Instance.new("RemoteEvent")
				newRemote.Name = name
				newRemote.Parent = relFolder
				remoteEventsCache[name] = newRemote
			else
				remoteEventsCache[name] = existing :: RemoteEvent
			end
		end

		for _, name in ipairs(REMOTE_FUNCTION_NAMES) do
			local existing = fnFolder:FindFirstChild(name) or container:FindFirstChild(name)
			if not existing or not existing:IsA("RemoteFunction") then
				local newFn = Instance.new("RemoteFunction")
				newFn.Name = name
				newFn.Parent = fnFolder
				remoteFunctionsCache[name] = newFn
			else
				remoteFunctionsCache[name] = existing :: RemoteFunction
			end
		end
	else
		for _, name in ipairs(RELIABLE_EVENT_NAMES) do
			local remote = relFolder:WaitForChild(name, 15) or container:WaitForChild(name, 5)
			if remote and remote:IsA("RemoteEvent") then
				remoteEventsCache[name] = remote :: RemoteEvent
			end
		end

		for _, name in ipairs(REMOTE_FUNCTION_NAMES) do
			local fn = fnFolder:WaitForChild(name, 15) or container:WaitForChild(name, 5)
			if fn and fn:IsA("RemoteFunction") then
				remoteFunctionsCache[name] = fn :: RemoteFunction
			end
		end
	end
end

--- Returns a cached RemoteEvent channel by name.
function QueueEvents.GetRemoteEvent(name: string): RemoteEvent
	if remoteEventsCache[name] then
		return remoteEventsCache[name]
	end

	local container, relFolder, _ = getOrCreateFolders()
	local remote = relFolder:FindFirstChild(name) or container:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		remoteEventsCache[name] = remote :: RemoteEvent
		return remote :: RemoteEvent
	end

	if RunService:IsServer() then
		local newRemote = Instance.new("RemoteEvent")
		newRemote.Name = name
		newRemote.Parent = relFolder
		remoteEventsCache[name] = newRemote
		return newRemote
	end

	error("[QueueEvents] RemoteEvent '" .. name .. "' not found!")
end

--- Returns a cached RemoteFunction channel by name.
function QueueEvents.GetRemoteFunction(name: string): RemoteFunction
	if remoteFunctionsCache[name] then
		return remoteFunctionsCache[name]
	end

	local container, _, fnFolder = getOrCreateFolders()
	local fn = fnFolder:FindFirstChild(name) or container:FindFirstChild(name)
	if fn and fn:IsA("RemoteFunction") then
		remoteFunctionsCache[name] = fn :: RemoteFunction
		return fn :: RemoteFunction
	end

	if RunService:IsServer() then
		local newFn = Instance.new("RemoteFunction")
		newFn.Name = name
		newFn.Parent = fnFolder
		remoteFunctionsCache[name] = newFn
		return newFn
	end

	error("[QueueEvents] RemoteFunction '" .. name .. "' not found!")
end

return QueueEvents
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">RemoteEvents</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[ OVERCLOCK: RemoteEvents - Centralized Network Remote Manager ]=]
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteEvents = {}
local FOLDER_NAME = "Remotes"

local reliableNames = {
	"DamageDealt", "PlayerDeath", "ItemPurchase", "MatchPhaseTransition",
	"ProfileSync", "ReliableCombat", "RoundStateChanged", "RequestPurchase",
	"PurchaseResult", "UseAbility", "AbilityStateUpdate", "SelectAgent",
	"AgentSelectUpdate", "AgentLocked", "ResetRangeStats", "RangeStatsUpdated",
	"SwitchOperative", "SwitchWeapon", "EquipWeapon", "KillFeed",
	"MatchResult", "EnterPracticeRange", "LeavePracticeRange",
	"RequestQueue", "CancelQueue", "QueueUpdate", "EnemyRevealed",
	"AbilityReplicated", "OperativeStateSync", "KillRewardNotice",
	"QueueMatchFound", "QueueStatusUpdate", "MapVoteUpdate",
	"ChallengeSend", "ChallengeReceive", "ChallengeRespond",
	"ChallengeCancel", "ChallengeExpired", "ResupplyAmmo",
}

local unreliableNames = {
	"BulletTracer", "WeaponSwaySync", "FootstepSound", "SpatialStateSync", "UnreliableCombat",
}

local functionNames = {
	"QueueEnter", "QueueLeave", "MapVoteSubmit",
}

local cacheReliable: { [string]: RemoteEvent } = {}
local cacheUnreliable: { [string]: UnreliableRemoteEvent } = {}
local cacheFunctions: { [string]: RemoteFunction } = {}

local folderInstance: Folder? = nil
local folderReliable: Folder? = nil
local folderUnreliable: Folder? = nil
local folderFunctions: Folder? = nil

local function getOrCreateFolders(): (Folder, Folder, Folder, Folder)
	if folderInstance and folderReliable and folderUnreliable and folderFunctions then
		return folderInstance, folderReliable, folderUnreliable, folderFunctions
	end

	local networkFolder = ReplicatedStorage:FindFirstChild("Network")
	if not networkFolder then
		if RunService:IsServer() then
			networkFolder = Instance.new("Folder")
			networkFolder.Name = "Network"
			networkFolder.Parent = ReplicatedStorage
		else
			networkFolder = ReplicatedStorage:WaitForChild("Network", 10)
		end
	end

	if not networkFolder then
		error("[Network] Failed to find Network folder in ReplicatedStorage within timeout")
	end

	local remotesDir = networkFolder and networkFolder:FindFirstChild(FOLDER_NAME)
	if not remotesDir then
		if RunService:IsServer() then
			remotesDir = Instance.new("Folder")
			remotesDir.Name = FOLDER_NAME
			remotesDir.Parent = networkFolder
		else
			remotesDir = networkFolder:WaitForChild(FOLDER_NAME, 10) :: Folder
		end
	end
	folderInstance = remotesDir :: Folder

	local function getSubfolder(name: string): Folder
		local existing = remotesDir:FindFirstChild(name)
		if existing and existing:IsA("Folder") then
			return existing
		end
		if RunService:IsServer() then
			local sf = Instance.new("Folder")
			sf.Name = name
			sf.Parent = remotesDir
			return sf
		else
			local sf = remotesDir:WaitForChild(name, 10) :: Folder
			return sf
		end
	end

	folderReliable = getSubfolder("Reliable")
	folderUnreliable = getSubfolder("Unreliable")
	folderFunctions = getSubfolder("Functions")

	return folderInstance :: Folder, folderReliable :: Folder, folderUnreliable :: Folder, folderFunctions :: Folder
end

function RemoteEvents.Initialize()
	local container, reliableFolder, unreliableFolder, functionsFolder = getOrCreateFolders()

	if RunService:IsServer() then
		for _, name in reliableNames do
			local existing = reliableFolder:FindFirstChild(name) or container:FindFirstChild(name)
			if not existing or not existing:IsA("RemoteEvent") then
				local r = Instance.new("RemoteEvent")
				r.Name = name
				r.Parent = reliableFolder
				cacheReliable[name] = r
			else
				cacheReliable[name] = existing :: RemoteEvent
			end
		end

		for _, name in unreliableNames do
			local existing = unreliableFolder:FindFirstChild(name) or container:FindFirstChild(name)
			if not existing or not existing:IsA("UnreliableRemoteEvent") then
				local r = Instance.new("UnreliableRemoteEvent")
				r.Name = name
				r.Parent = unreliableFolder
				cacheUnreliable[name] = r
			else
				cacheUnreliable[name] = existing :: UnreliableRemoteEvent
			end
		end

		for _, name in functionNames do
			local existing = functionsFolder:FindFirstChild(name) or container:FindFirstChild(name)
			if not existing or not existing:IsA("RemoteFunction") then
				local fn = Instance.new("RemoteFunction")
				fn.Name = name
				fn.Parent = functionsFolder
				cacheFunctions[name] = fn
			else
				cacheFunctions[name] = existing :: RemoteFunction
			end
		end

		print("[NETWORK] All required remotes available")
	else
		for _, name in reliableNames do
			local r = reliableFolder:WaitForChild(name, 15) or container:WaitForChild(name, 5)
			if r and r:IsA("RemoteEvent") then cacheReliable[name] = r :: RemoteEvent end
		end
		for _, name in unreliableNames do
			local r = unreliableFolder:WaitForChild(name, 15) or container:WaitForChild(name, 5)
			if r and r:IsA("UnreliableRemoteEvent") then cacheUnreliable[name] = r :: UnreliableRemoteEvent end
		end
		for _, name in functionNames do
			local fn = functionsFolder:WaitForChild(name, 15) or container:WaitForChild(name, 5)
			if fn and fn:IsA("RemoteFunction") then cacheFunctions[name] = fn :: RemoteFunction end
		end
	end
end

function RemoteEvents.GetReliable(name: string): RemoteEvent
	if cacheReliable[name] then return cacheReliable[name] end
	local container, reliableFolder, _, _ = getOrCreateFolders()
	local r = reliableFolder:FindFirstChild(name) or (container and container:FindFirstChild(name))
	if r and r:IsA("RemoteEvent") then
		cacheReliable[name] = r :: RemoteEvent
		return r :: RemoteEvent
	end
	if RunService:IsServer() then
		local nr = Instance.new("RemoteEvent")
		nr.Name = name
		nr.Parent = reliableFolder
		cacheReliable[name] = nr
		return nr
	end
	error(`RemoteEvent '{name}' not found!`)
end

function RemoteEvents.GetUnreliable(name: string): UnreliableRemoteEvent
	if cacheUnreliable[name] then return cacheUnreliable[name] end
	local container, _, unreliableFolder, _ = getOrCreateFolders()
	local r = unreliableFolder:FindFirstChild(name) or (container and container:FindFirstChild(name))
	if r and r:IsA("UnreliableRemoteEvent") then
		cacheUnreliable[name] = r :: UnreliableRemoteEvent
		return r :: UnreliableRemoteEvent
	end
	if RunService:IsServer() then
		local nr = Instance.new("UnreliableRemoteEvent")
		nr.Name = name
		nr.Parent = unreliableFolder
		cacheUnreliable[name] = nr
		return nr
	end
	error(`UnreliableRemoteEvent '{name}' not found!`)
end

function RemoteEvents.GetRemoteFunction(name: string): RemoteFunction
	if cacheFunctions[name] then return cacheFunctions[name] end
	local container, _, _, functionsFolder = getOrCreateFolders()
	local fn = functionsFolder:FindFirstChild(name) or (container and container:FindFirstChild(name))
	if fn and fn:IsA("RemoteFunction") then
		cacheFunctions[name] = fn :: RemoteFunction
		return fn :: RemoteFunction
	end
	if RunService:IsServer() then
		local nfn = Instance.new("RemoteFunction")
		nfn.Name = name
		nfn.Parent = functionsFolder
		cacheFunctions[name] = nfn
		return nfn
	end
	error(`RemoteFunction '{name}' not found!`)
end

return RemoteEvents
]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX13"><Properties><string name="Name">Data</string></Properties><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">Constants</string><ProtectedString name="Source">&lt;![CDATA[--!strict
