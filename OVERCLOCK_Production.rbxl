local LocalPlayer = Players.LocalPlayer
local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local WeaponStats = require(ReplicatedStorage:WaitForChild("Data"):WaitForChild("WeaponStats") :: ModuleScript)

export type LoadoutConfig = {
	weaponId: string,
	skinId: string,
	attachments: {
		optic: string,
		muzzle: string,
		underbarrel: string,
		magazine: string,
	},
}

export type AttachmentSlot = "optic" | "muzzle" | "underbarrel" | "magazine"

type AttDef = {
	displayName: string,
	damageMult: number,
	recoilMult: number,
	rangeMult: number,
	mobilityMult: number,
	fireRateMult: number?,
	magMult: number?,
}

type ModStats = {
	damage: number,
	fireRate: number,
	maxRange: number,
	recoil: number,
	mobility: number,
	magazine: number?,
}

local LoadoutInspectorUI = {}

