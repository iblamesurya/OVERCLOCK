llide">true</bool><float name="Transparency">0</float><token name="Material">SmoothPlastic</token></Properties></Item><Item class="SpawnLocation" referent="RBX7"><Properties><string name="Name">LobbySpawn_1</string><CoordinateFrame name="CFrame"><X>-75</X><Y>103.5</Y><Z>-75</Z><R00>1</R00><R11>1</R11><R22>1</R22><R01>0</R01><R02>0</R02><R10>0</R10><R12>0</R12><R20>0</R20><R21>0</R21></CoordinateFrame><Vector3 name="Size">&lt;Vector3&gt;&lt;X&gt;4&lt;/X&gt;&lt;Y&gt;0.40000009536743164&lt;/Y&gt;&lt;Z&gt;4&lt;/Z&gt;&lt;/Vector3&gt;</Vector3><bool name="Anchored">true</bool><bool name="Neutral">true</bool><bool name="AllowTeamChangeOnTouch">false</bool><float name="Duration">0</float></Properties></Item><Item class="SpawnLocation" referent="RBX8"><Properties><string name="Name">LobbySpawn_2</string><CoordinateFrame name="CFrame"><X>75</X><Y>103.5</Y><Z>-75</Z><R00>1</R00><R11>1</R11><R22>1</R22><R01>0</R01><R02>0</R02><R10>0</R10><R12>0</R12><R20>0</R20><R21>0</R21></CoordinateFrame><Vector3 name="Size">&lt;Vector3&gt;&lt;X&gt;4&lt;/X&gt;&lt;Y&gt;0.40000009536743164&lt;/Y&gt;&lt;Z&gt;4&lt;/Z&gt;&lt;/Vector3&gt;</Vector3><bool name="Anchored">true</bool><bool name="Neutral">true</bool><bool name="AllowTeamChangeOnTouch">false</bool><float name="Duration">0</float></Properties></Item><Item class="SpawnLocation" referent="RBX9"><Properties><string name="Name">LobbySpawn_3</string><CoordinateFrame name="CFrame"><X>0</X><Y>103.5</Y><Z>-85</Z><R00>1</R00><R11>1</R11><R22>1</R22><R01>0</R01><R02>0</R02><R10>0</R10><R12>0</R12><R20>0</R20><R21>0</R21></CoordinateFrame><Vector3 name="Size">&lt;Vector3&gt;&lt;X&gt;4&lt;/X&gt;&lt;Y&gt;0.40000009536743164&lt;/Y&gt;&lt;Z&gt;4&lt;/Z&gt;&lt;/Vector3&gt;</Vector3><bool name="Anchored">true</bool><bool name="Neutral">true</bool><bool name="AllowTeamChangeOnTouch">false</bool><float name="Duration">0</float></Properties></Item></Item><Item class="Lighting" referent="RBX3"><Properties><float name="ClockTime">14.5</float></Properties></Item><Item class="ReplicatedStorage" referent="RBX10"><Properties /><Item class="Folder" referent="RBX11"><Properties><string name="Name">Map</string></Properties><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">ClassicGreyboxMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: ClassicGreyboxMap
    Procedural 5v5 FPS Competitive Greybox layout builder module.
    Generates a pristine competitive 3-lane FPS blockout map featuring grid blocks,
    mid-lane sniper walls with head-shot window cutouts, flank corridors with L-corners,
    chokepoints, spawn locations, and objective sites.
]=]

local Workspace = game:GetService("Workspace")

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type LaneData = {
	center: Vector3,
	size: Vector3,
}

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions,
	coverPositions: { Vector3 },
	lanes: { [string]: LaneData },
}

local ClassicGreyboxMap = {}

local MAP_FOLDER_NAME = "ClassicGreyboxMap"
local _activeMapFolder: Folder? = nil

-- Map Dimension Constants
local MAP_WIDTH_X = 160
local MAP_LENGTH_Z = 240
local MAP_HEIGHT_Y = 30

local RED_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-12, 2, -100),
	Vector3.new(-6, 2, -100),
	Vector3.new(0, 2, -100),
	Vector3.new(6, 2, -100),
	Vector3.new(12, 2, -100),
}

local BLUE_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-12, 2, 100),
	Vector3.new(-6, 2, 100),
	Vector3.new(0, 2, 100),
	Vector3.new(6, 2, 100),
	Vector3.new(12, 2, 100),
}

local SITE_A_POSITION = Vector3.new(-50, 1, -40)
local SITE_B_POSITION = Vector3.new(50, 1, 40)

local COVER_POSITIONS: { Vector3 } = {
	-- Site A Covers
	Vector3.new(-50, 4, -40),
	Vector3.new(-60, 2, -30),
	Vector3.new(-40, 2, -50),
	-- Site B Covers
	Vector3.new(50, 5, 40),
	Vector3.new(60, 2, 30),
	Vector3.new(40, 2, 50),
	-- Mid Lane Covers &amp; Sniper Walls
	Vector3.new(-15, 6, 0),
	Vector3.new(15, 6, 0),
	Vector3.new(0, 2.5, -20),
	Vector3.new(0, 2.5, 20),
	-- Sniper Perches
	Vector3.new(-65, 8, -80),
	Vector3.new(65, 8, 80),
}

local LANES_DATA: { [string]: LaneData } = {
	CenterMid = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(24, 0.4, 160) },
	LeftFlankCorridor = { center = Vector3.new(-50, 0.2, 0), size = Vector3.new(24, 0.4, 180) },
	RightFlankCorridor = { center = Vector3.new(50, 0.2, 0), size = Vector3.new(24, 0.4, 180) },
	ConnectorSiteA = { center = Vector3.new(-25, 0.2, -40), size = Vector3.new(30, 0.4, 16) },
	ConnectorSiteB = { center = Vector3.new(25, 0.2, 40), size = Vector3.new(30, 0.4, 16) },
}

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

-- Helper to create mid-lane sniper wall with headshot window cutout
local function createSniperWall(
	name: string,
	position: Vector3,
	rotationYDeg: number,
	parent: Instance
)
	local wallFolder = Instance.new("Folder")
	wallFolder.Name = name
	wallFolder.Parent = parent

	local cf = CFrame.new(position) * CFrame.Angles(0, math.rad(rotationYDeg), 0)
	local greyColor = Color3.fromRGB(140, 145, 150)
	local windowWidth = 6
	local totalWidth = 20
	local wallHeight = 10
	local sideWidth = (totalWidth - windowWidth) / 2

	-- Left Pillar Side
	createPart(
		"WallLeft",
		Vector3.new(sideWidth, wallHeight, 3),
		cf * CFrame.new(-totalWidth / 2 + sideWidth / 2, wallHeight / 2, 0),
		greyColor,
		Enum.Material.Concrete,
		wallFolder
	)

	-- Right Pillar Side
	createPart(
		"WallRight",
		Vector3.new(sideWidth, wallHeight, 3),
		cf * CFrame.new(totalWidth / 2 - sideWidth / 2, wallHeight / 2, 0),
		greyColor,
		Enum.Material.Concrete,
		wallFolder
	)

	-- Lower Wall Sill below Window (Headshot height)
	createPart(
		"WallSill",
		Vector3.new(windowWidth, 4, 3),
		cf * CFrame.new(0, 2, 0),
		greyColor,
		Enum.Material.Concrete,
		wallFolder
	)

	-- Upper Arch Lintels above Window
	createPart(
		"WallLintel",
		Vector3.new(windowWidth, 2, 3),
		cf * CFrame.new(0, 9, 0),
		greyColor,
		Enum.Material.Concrete,
		wallFolder
	)
end

-- Helper to build flank corridor with L-corners and low cover
local function createFlankCorridor(
	name: string,
	centerPos: Vector3,
	isWest: boolean,
	parent: Instance
)
	local corridorFolder = Instance.new("Folder")
	corridorFolder.Name = name
	corridorFolder.Parent = parent

	local darkGrey = Color3.fromRGB(90, 95, 100)
	local dir = if isWest then -1 else 1

	-- L-Corner Wall 1
	createPart(
		"LWall_Outer",
		Vector3.new(4, 12, 40),
		CFrame.new(centerPos + Vector3.new(dir * 12, 6, 0)),
		darkGrey,
		Enum.Material.Concrete,
		corridorFolder
	)

	-- L-Corner Wall 2
	createPart(
		"LWall_Inner",
		Vector3.new(20, 12, 4),
		CFrame.new(centerPos + Vector3.new(dir * 2, 6, 20)),
		darkGrey,
		Enum.Material.Concrete,
		corridorFolder
	)
end

function ClassicGreyboxMap.BuildMap(parent: Instance?): Folder
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- 1. Outer Perimeter &amp; Grid Floor
	local perimeterFolder = Instance.new("Folder")
	perimeterFolder.Name = "Perimeter"
	perimeterFolder.Parent = mapFolder

	local floorGrey = Color3.fromRGB(110, 115, 120)
	local wallGrey = Color3.fromRGB(70, 75, 80)

	-- Grid Floor Base
	createPart(
		"MainFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		floorGrey,
		Enum.Material.Concrete,
		perimeterFolder
	)

	-- Boundary Walls
	createPart(
		"NorthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
		wallGrey,
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"SouthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
		wallGrey,
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"WestWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		wallGrey,
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"EastWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		wallGrey,
		Enum.Material.Concrete,
		perimeterFolder
	)

	-- 2. Spawns Folder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local redSpawnFolder = Instance.new("Folder")
	redSpawnFolder.Name = "RedSpawn"
	redSpawnFolder.Parent = spawnsFolder

	createPart(
		"RedPlatform",
		Vector3.new(40, 1, 30),
		CFrame.new(0, 0.5, -100),
		Color3.fromRGB(180, 50, 50),
		Enum.Material.SmoothPlastic,
		redSpawnFolder
	)

	for i, pos in RED_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(220, 80, 80),
			Enum.Material.Neon,
			redSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Red")
		sp:SetAttribute("Index", i)
	end

	local blueSpawnFolder = Instance.new("Folder")
	blueSpawnFolder.Name = "BlueSpawn"
	blueSpawnFolder.Parent = spawnsFolder

	createPart(
		"BluePlatform",
		Vector3.new(40, 1, 30),
		CFrame.new(0, 0.5, 100),
		Color3.fromRGB(50, 100, 180),
		Enum.Material.SmoothPlastic,
		blueSpawnFolder
	)

	for i, pos in BLUE_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(80, 140, 220),
			Enum.Material.Neon,
			blueSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Blue")
		sp:SetAttribute("Index", i)
	end

	-- 3. Environment Assets (Mid-lane Sniper Walls &amp; Flank Corridors)
	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = mapFolder

	-- Mid-lane Sniper Walls with Window Cutouts
	createSniperWall("SniperWall_NorthMid", Vector3.new(0, 0, -35), 0, envFolder)
	createSniperWall("SniperWall_SouthMid", Vector3.new(0, 0, 35), 0, envFolder)

	-- Flank Corridors
	createFlankCorridor("FlankCorridor_West", Vector3.new(-50, 0, 0), true, envFolder)
	createFlankCorridor("FlankCorridor_East", Vector3.new(50, 0, 0), false, envFolder)

	-- 4. Objective Sites Folder
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local siteA = createPart(
		"SiteA",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_A_POSITION),
		Color3.fromRGB(240, 180, 40),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteA.Transparency = 0.5
	siteA:SetAttribute("SiteName", "A")

	local siteB = createPart(
		"SiteB",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_B_POSITION),
		Color3.fromRGB(240, 180, 40),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteB.Transparency = 0.5
	siteB:SetAttribute("SiteName", "B")

	-- 5. Cover &amp; Obstacles Folder
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	local blockColor = Color3.fromRGB(130, 135, 140)

	-- Site A Cover Blocks
	createPart("HighCover_SiteA", Vector3.new(6, 8, 6), CFrame.new(-50, 4, -40), blockColor, Enum.Material.Concrete, coverFolder)
	createPart("LowCover_SiteA_1", Vector3.new(4, 4, 4), CFrame.new(-60, 2, -30), blockColor, Enum.Material.SmoothPlastic, coverFolder)
	createPart("LowCover_SiteA_2", Vector3.new(4, 4, 4), CFrame.new(-40, 2, -50), blockColor, Enum.Material.SmoothPlastic, coverFolder)

	-- Site B Cover Blocks
	createPart("HighCover_SiteB", Vector3.new(6, 10, 6), CFrame.new(50, 5, 40), blockColor, Enum.Material.Concrete, coverFolder)
	createPart("LowCover_SiteB_1", Vector3.new(4, 4, 4), CFrame.new(60, 2, 30), blockColor, Enum.Material.SmoothPlastic, coverFolder)
	createPart("LowCover_SiteB_2", Vector3.new(4, 4, 4), CFrame.new(40, 2, 50), blockColor, Enum.Material.SmoothPlastic, coverFolder)

	-- Mid Lane Covers &amp; Chokepoint Pillars
	createPart("Pillar_Mid_Left", Vector3.new(6, 12, 6), CFrame.new(-15, 6, 0), blockColor, Enum.Material.Concrete, coverFolder)
	createPart("Pillar_Mid_Right", Vector3.new(6, 12, 6), CFrame.new(15, 6, 0), blockColor, Enum.Material.Concrete, coverFolder)
	createPart("LowCover_Mid_1", Vector3.new(6, 3.5, 4), CFrame.new(0, 1.75, -20), blockColor, Enum.Material.SmoothPlastic, coverFolder)
	createPart("LowCover_Mid_2", Vector3.new(6, 3.5, 4), CFrame.new(0, 1.75, 20), blockColor, Enum.Material.SmoothPlastic, coverFolder)

	-- Sniper Perches &amp; Ramps
	createPart("Perch_Red", Vector3.new(16, 2, 16), CFrame.new(-65, 8, -80), blockColor, Enum.Material.SmoothPlastic, coverFolder)
	createWedge("Ramp_Red", Vector3.new(8, 8, 12), CFrame.new(-65, 4, -92), blockColor, Enum.Material.Concrete, coverFolder)

	createPart("Perch_Blue", Vector3.new(16, 2, 16), CFrame.new(65, 8, 80), blockColor, Enum.Material.SmoothPlastic, coverFolder)
	createWedge("Ramp_Blue", Vector3.new(8, 8, 12), CFrame.new(65, 4, 92) * CFrame.Angles(0, math.pi, 0), blockColor, Enum.Material.Concrete, coverFolder)

	-- 6. Lanes Folder
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		createPart(
			laneName,
			data.size,
			CFrame.new(data.center),
			Color3.fromRGB(100, 105, 110),
			Enum.Material.SmoothPlastic,
			lanesFolder,
			false
		)
	end

	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder

	return mapFolder
end

function ClassicGreyboxMap.DestroyMap()
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

function ClassicGreyboxMap.GetSpawnPoints(teamName: string): { Vector3 }
	if teamName == "Red" then
		return table.clone(RED_SPAWN_POSITIONS)
	elseif teamName == "Blue" then
		return table.clone(BLUE_SPAWN_POSITIONS)
	else
		warn("[ClassicGreyboxMap] Invalid team name: " .. tostring(teamName))
		return {}
	end
end

function ClassicGreyboxMap.GetCoverPositions(): { Vector3 }
	return table.clone(COVER_POSITIONS)
end

function ClassicGreyboxMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_A_POSITION,
		siteB = SITE_B_POSITION,
	}
end

function ClassicGreyboxMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2)
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2)
	return minBounds, maxBounds
end

function ClassicGreyboxMap.GetLayoutData(): MapLayoutData
	local minB, maxB = ClassicGreyboxMap.GetMapBounds()
	return {
		mapId = "ClassicGreybox",
		mapName = "Classic Greybox",
		theme = "Competitive Greybox",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = table.clone(RED_SPAWN_POSITIONS),
		blueSpawns = table.clone(BLUE_SPAWN_POSITIONS),
		sites = ClassicGreyboxMap.GetSitePositions(),
		coverPositions = table.clone(COVER_POSITIONS),
		lanes = LANES_DATA,
	}
end

return ClassicGreyboxMap
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">CyberArenaMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: CyberArenaMap
    Procedural 5v5 FPS Sci-Fi Cyber Arena layout builder module.
    Generates a futuristic cyberpunk arena environment featuring glowing neon light barriers,
    glass wall sightline partitions, multi-level metallic platforms with energy ramps,
    holographic objective pads, spawn locations, and high-tech cover structures.
]=]

local Workspace = game:GetService("Workspace")

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type LaneData = {
	center: Vector3,
	size: Vector3,
}

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions,
	coverPositions: { Vector3 },
	lanes: { [string]: LaneData },
}

local CyberArenaMap = {}

local MAP_FOLDER_NAME = "CyberArenaMap"
local _activeMapFolder: Folder? = nil

-- Map Dimension Constants
local MAP_WIDTH_X = 160
local MAP_LENGTH_Z = 240
local MAP_HEIGHT_Y = 32

local RED_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-12, 2, -100),
	Vector3.new(-6, 2, -100),
	Vector3.new(0, 2, -100),
	Vector3.new(6, 2, -100),
	Vector3.new(12, 2, -100),
}

local BLUE_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-12, 2, 100),
	Vector3.new(-6, 2, 100),
	Vector3.new(0, 2, 100),
	Vector3.new(6, 2, 100),
	Vector3.new(12, 2, 100),
}

local SITE_A_POSITION = Vector3.new(-48, 1, -38)
local SITE_B_POSITION = Vector3.new(48, 1, 38)

local COVER_POSITIONS: { Vector3 } = {
	-- Site A Holo Barricades &amp; Neon Pillars
	Vector3.new(-48, 4, -38),
	Vector3.new(-58, 2.5, -28),
	Vector3.new(-38, 2.5, -48),
	-- Site B Holo Barricades &amp; Neon Pillars
	Vector3.new(48, 4, 38),
	Vector3.new(58, 2.5, 28),
	Vector3.new(38, 2.5, 48),
	-- Mid Energy Pillars &amp; Low Light Shields
	Vector3.new(-16, 6, 0),
	Vector3.new(16, 6, 0),
	Vector3.new(0, 2.5, -20),
	Vector3.new(0, 2.5, 20),
	-- Upper Platform Perches
	Vector3.new(-42, 14, -72),
	Vector3.new(42, 14, 72),
}

local LANES_DATA: { [string]: LaneData } = {
	MainCyberGrid = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(24, 0.4, 160) },
	NeonWestConcourse = { center = Vector3.new(-48, 0.2, 0), size = Vector3.new(26, 0.4, 180) },
	NeonEastConcourse = { center = Vector3.new(48, 0.2, 0), size = Vector3.new(26, 0.4, 180) },
	GlassConnectorNorth = { center = Vector3.new(-24, 0.2, -38), size = Vector3.new(24, 0.4, 16) },
	GlassConnectorSouth = { center = Vector3.new(24, 0.2, 38), size = Vector3.new(24, 0.4, 16) },
}

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

-- Helper to create glowing neon light barriers
local function createNeonBarrier(
	name: string,
	size: Vector3,
	cframe: CFrame,
	neonColor: Color3,
	parent: Instance
)
	local barrierFolder = Instance.new("Folder")
	barrierFolder.Name = name
	barrierFolder.Parent = parent

	-- Semi-transparent neon core
	local core = createPart(
		"Core",
		size,
		cframe,
		neonColor,
		Enum.Material.Neon,
		barrierFolder,
		true
	)
	core.Transparency = 0.3

	-- Dark Metallic Border Frame
	local frameColor = Color3.fromRGB(30, 35, 45)
	local t = 0.6
	createPart(
		"FrameTop",
		Vector3.new(size.X + t, t, size.Z + t),
		cframe * CFrame.new(0, size.Y / 2, 0),
		frameColor,
		Enum.Material.Metal,
		barrierFolder
	)
	createPart(
		"FrameBottom",
		Vector3.new(size.X + t, t, size.Z + t),
		cframe * CFrame.new(0, -size.Y / 2, 0),
		frameColor,
		Enum.Material.Metal,
		barrierFolder
	)
end

-- Helper to create glass sightline walls
local function createGlassWall(
	name: string,
	size: Vector3,
	cframe: CFrame,
	parent: Instance
)
	local glass = createPart(
		name,
		size,
		cframe,
		Color3.fromRGB(180, 230, 255),
		Enum.Material.Glass,
		parent,
		true
	)
	glass.Transparency = 0.6
	glass:SetAttribute("WallType", "GlassSightline")
end

-- Helper to create multi-level metallic platform
local function buildMultiLevelPlatform(
	name: string,
	centerPos: Vector3,
	size: Vector3,
	height: number,
	parent: Instance
)
	local platFolder = Instance.new("Folder")
	platFolder.Name = name
	platFolder.Parent = parent

	local chromeColor = Color3.fromRGB(80, 85, 95)
	local neonCyan = Color3.fromRGB(0, 220, 255)

	-- Platform Floor
	local platCF = CFrame.new(centerPos + Vector3.new(0, height, 0))
	createPart(
		"PlatFloor",
		Vector3.new(size.X, 1.2, size.Z),
		platCF,
		chromeColor,
		Enum.Material.Metal,
		platFolder
	)

	-- Neon Under-Glow Strips
	createPart(
		"NeonStrip_1",
		Vector3.new(size.X, 0.4, 0.6),
		platCF * CFrame.new(0, -0.6, size.Z / 2),
		neonCyan,
		Enum.Material.Neon,
		platFolder,
		false
	)
	createPart(
		"NeonStrip_2",
		Vector3.new(size.X, 0.4, 0.6),
		platCF * CFrame.new(0, -0.6, -size.Z / 2),
		neonCyan,
		Enum.Material.Neon,
		platFolder,
		false
	)

	-- Metal Support Legs
	local legOffsets = {
		Vector3.new(-size.X / 2 + 1, height / 2, -size.Z / 2 + 1),
		Vector3.new(size.X / 2 - 1, height / 2, -size.Z / 2 + 1),
		Vector3.new(-size.X / 2 + 1, height / 2, size.Z / 2 - 1),
		Vector3.new(size.X / 2 - 1, height / 2, size.Z / 2 - 1),
	}
	for i, legOffset in legOffsets do
		createPart(
			"Leg_" .. i,
			Vector3.new(1.8, height, 1.8),
			CFrame.new(centerPos + legOffset),
			chromeColor,
			Enum.Material.Metal,
			platFolder
		)
	end

	-- Energy Ramp Access
	local rampLength = 16
	createWedge(
		"EnergyRamp",
		Vector3.new(6, height, rampLength),
		CFrame.new(centerPos + Vector3.new(0, height / 2, size.Z / 2 + rampLength / 2)),
		Color3.fromRGB(0, 180, 220),
		Enum.Material.SmoothPlastic,
		platFolder
	)
end

function CyberArenaMap.BuildMap(parent: Instance?): Folder
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- 1. Outer Perimeter &amp; Metallic Grid Floor
	local perimeterFolder = Instance.new("Folder")
	perimeterFolder.Name = "Perimeter"
	perimeterFolder.Parent = mapFolder

	local darkGridColor = Color3.fromRGB(25, 28, 35)
	local wallColor = Color3.fromRGB(40, 45, 55)
	local neonPink = Color3.fromRGB(255, 0, 128)
	local neonCyan = Color3.fromRGB(0, 220, 255)

	-- Main Arena Metallic Floor
	createPart(
		"CyberFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		darkGridColor,
		Enum.Material.DiamondPlate,
		perimeterFolder
	)

	-- Neon Grid Lines on Floor
	createPart(
		"GridLine_CenterZ",
		Vector3.new(0.8, 0.1, MAP_LENGTH_Z),
		CFrame.new(0, 0.05, 0),
		neonCyan,
		Enum.Material.Neon,
		perimeterFolder,
		false
	)
	createPart(
		"GridLine_CenterX",
		Vector3.new(MAP_WIDTH_X, 0.1, 0.8),
		CFrame.new(0, 0.05, 0),
		neonPink,
		Enum.Material.Neon,
		perimeterFolder,
		false
	)

	-- Outer Enclosure Walls with Neon Trims
	createPart(
		"NorthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
		wallColor,
		Enum.Material.Metal,
		perimeterFolder
	)
	createPart(
		"SouthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
		wallColor,
		Enum.Material.Metal,
		perimeterFolder
	)
	createPart(
		"WestWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		wallColor,
		Enum.Material.Metal,
		perimeterFolder
	)
	createPart(
		"EastWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		wallColor,
		Enum.Material.Metal,
		perimeterFolder
	)

	-- 2. Spawns Folder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local redSpawnFolder = Instance.new("Folder")
	redSpawnFolder.Name = "RedSpawn"
	redSpawnFolder.Parent = spawnsFolder

	createPart(
		"RedCyberBayPad",
		Vector3.new(36, 1, 24),
		CFrame.new(0, 0.5, -100),
		Color3.fromRGB(180, 30, 80),
		Enum.Material.SmoothPlastic,
		redSpawnFolder
	)

	for i, pos in RED_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(255, 50, 120),
			Enum.Material.Neon,
			redSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Red")
		sp:SetAttribute("Index", i)
	end

	local blueSpawnFolder = Instance.new("Folder")
	blueSpawnFolder.Name = "BlueSpawn"
	blueSpawnFolder.Parent = spawnsFolder

	createPart(
		"BlueCyberBayPad",
		Vector3.new(36, 1, 24),
		CFrame.new(0, 0.5, 100),
		Color3.fromRGB(30, 140, 220),
		Enum.Material.SmoothPlastic,
		blueSpawnFolder
	)

	for i, pos in BLUE_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(50, 200, 255),
			Enum.Material.Neon,
			blueSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Blue")
		sp:SetAttribute("Index", i)
	end

	-- 3. Environment Assets Folder (Neon Barriers, Glass Walls, Multi-level Platforms)
	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = mapFolder

	-- Glowing Neon Light Barriers
	createNeonBarrier("NeonBarrier_West_1", Vector3.new(8, 7, 2), CFrame.new(-48, 3.5, -20), neonPink, envFolder)
	createNeonBarrier("NeonBarrier_East_1", Vector3.new(8, 7, 2), CFrame.new(48, 3.5, 20), neonCyan, envFolder)

	-- Translucent Glass Sightline Walls
	createGlassWall("GlassWall_MidWest", Vector3.new(1, 10, 24), CFrame.new(-24, 5, 0), envFolder)
	createGlassWall("GlassWall_MidEast", Vector3.new(1, 10, 24), CFrame.new(24, 5, 0), envFolder)

	-- Multi-level Metallic Platforms with Energy Ramps
	buildMultiLevelPlatform("Platform_NorthWest", Vector3.new(-42, 0, -72), Vector3.new(16, 1.2, 16), 14, envFolder)
	buildMultiLevelPlatform("Platform_SouthEast", Vector3.new(42, 0, 72), Vector3.new(16, 1.2, 16), 14, envFolder)

	-- Metallic Sci-Fi Pillars
	local pillarColor = Color3.fromRGB(50, 55, 65)
	createPart("SciFiPillar_Mid_L", Vector3.new(5, 18, 5), CFrame.new(-16, 9, 0), pillarColor, Enum.Material.Metal, envFolder)
	createPart("SciFiPillar_Mid_R", Vector3.new(5, 18, 5), CFrame.new(16, 9, 0), pillarColor, Enum.Material.Metal, envFolder)

	-- 4. Objective Sites Folder (Holographic Pads)
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local siteA = createPart(
		"SiteA",
		Vector3.new(28, 0.4, 28),
		CFrame.new(SITE_A_POSITION),
		neonPink,
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteA.Transparency = 0.4
	siteA:SetAttribute("SiteName", "A")

	local siteB = createPart(
		"SiteB",
		Vector3.new(28, 0.4, 28),
		CFrame.new(SITE_B_POSITION),
		neonCyan,
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteB.Transparency = 0.4
	siteB:SetAttribute("SiteName", "B")

	-- 5. Cover &amp; Holo Shield Folder
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	local metalCoverColor = Color3.fromRGB(60, 65, 75)

	-- Site A Covers
	createPart("HoloCover_SiteA_1", Vector3.new(6, 6, 6), CFrame.new(-48, 3, -38), metalCoverColor, Enum.Material.SmoothPlastic, coverFolder)
	createPart("HoloCover_SiteA_2", Vector3.new(5, 4, 5), CFrame.new(-58, 2, -28), metalCoverColor, Enum.Material.Metal, coverFolder)
	createPart("HoloCover_SiteA_3", Vector3.new(5, 4, 5), CFrame.new(-38, 2, -48), metalCoverColor, Enum.Material.Metal, coverFolder)

	-- Site B Covers
	createPart("HoloCover_SiteB_1", Vector3.new(6, 6, 6), CFrame.new(48, 3, 38), metalCoverColor, Enum.Material.SmoothPlastic, coverFolder)
	createPart("HoloCover_SiteB_2", Vector3.new(5, 4, 5), CFrame.new(58, 2, 28), metalCoverColor, Enum.Material.Metal, coverFolder)
	createPart("HoloCover_SiteB_3", Vector3.new(5, 4, 5), CFrame.new(38, 2, 48), metalCoverColor, Enum.Material.Metal, coverFolder)

	-- Mid Shields
	createPart("MidShield_North", Vector3.new(8, 4, 3), CFrame.new(0, 2, -20), neonCyan, Enum.Material.Neon, coverFolder)
	createPart("MidShield_South", Vector3.new(8, 4, 3), CFrame.new(0, 2, 20), neonPink, Enum.Material.Neon, coverFolder)

	-- 6. Lanes Folder
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		createPart(
			laneName,
			data.size,
			CFrame.new(data.center),
			Color3.fromRGB(40, 50, 65),
			Enum.Material.SmoothPlastic,
			lanesFolder,
			false
		)
	end

	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder

	return mapFolder
end

function CyberArenaMap.DestroyMap()
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

function CyberArenaMap.GetSpawnPoints(teamName: string): { Vector3 }
	if teamName == "Red" then
		return table.clone(RED_SPAWN_POSITIONS)
	elseif teamName == "Blue" then
		return table.clone(BLUE_SPAWN_POSITIONS)
	else
		warn("[CyberArenaMap] Invalid team name: " .. tostring(teamName))
		return {}
	end
end

function CyberArenaMap.GetCoverPositions(): { Vector3 }
	return table.clone(COVER_POSITIONS)
end

function CyberArenaMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_A_POSITION,
		siteB = SITE_B_POSITION,
	}
end

function CyberArenaMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2)
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2)
	return minBounds, maxBounds
end

function CyberArenaMap.GetLayoutData(): MapLayoutData
	local minB, maxB = CyberArenaMap.GetMapBounds()
	return {
		mapId = "CyberArena",
		mapName = "Cyber Arena",
		theme = "Sci-Fi Cyber",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = table.clone(RED_SPAWN_POSITIONS),
		blueSpawns = table.clone(BLUE_SPAWN_POSITIONS),
		sites = CyberArenaMap.GetSitePositions(),
		coverPositions = table.clone(COVER_POSITIONS),
		lanes = LANES_DATA,
	}
end

return CyberArenaMap
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">DesertRuinsMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: DesertRuinsMap
    Procedural 5v5 FPS Desert Ruins layout builder module.
    Generates an ancient desert archaeological environment featuring sandstone pillars,
    ancient grand arches, sand dunes, crumbling stone walls, open courtyards with
    long sightlines and cover, spawn locations, and objective sites.
]=]

local Workspace = game:GetService("Workspace")

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type LaneData = {
	center: Vector3,
	size: Vector3,
}

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions,
	coverPositions: { Vector3 },
	lanes: { [string]: LaneData },
}

local DesertRuinsMap = {}

local MAP_FOLDER_NAME = "DesertRuinsMap"
local _activeMapFolder: Folder? = nil

-- Map Dimension Constants
local MAP_WIDTH_X = 180
local MAP_LENGTH_Z = 260
local MAP_HEIGHT_Y = 36

local RED_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-15, 2, -110),
	Vector3.new(-7.5, 2, -110),
	Vector3.new(0, 2, -110),
	Vector3.new(7.5, 2, -110),
	Vector3.new(15, 2, -110),
}

local BLUE_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-15, 2, 110),
	Vector3.new(-7.5, 2, 110),
	Vector3.new(0, 2, 110),
	Vector3.new(7.5, 2, 110),
	Vector3.new(15, 2, 110),
}

local SITE_A_POSITION = Vector3.new(-55, 1, -40)
local SITE_B_POSITION = Vector3.new(55, 1, 40)

local COVER_POSITIONS: { Vector3 } = {
	-- Site A Crumbling Walls &amp; Pillars
	Vector3.new(-55, 4, -40),
	Vector3.new(-68, 3, -30),
	Vector3.new(-42, 3, -52),
	-- Site B Crumbling Walls &amp; Pillars
	Vector3.new(55, 4, 40),
	Vector3.new(68, 3, 30),
	Vector3.new(42, 3, 52),
	-- Mid Oasis &amp; Sunken Plaza Cover
	Vector3.new(-22, 5, 0),
	Vector3.new(22, 5, 0),
	Vector3.new(0, 3.5, -25),
	Vector3.new(0, 3.5, 25),
	-- Archway High Perches
	Vector3.new(-50, 16, -80),
	Vector3.new(50, 16, 80),
}

local LANES_DATA: { [string]: LaneData } = {
	SunkenPlaza = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(30, 0.4, 170) },
	ColonnadeWest = { center = Vector3.new(-55, 0.2, 0), size = Vector3.new(26, 0.4, 190) },
	DuneFlankEast = { center = Vector3.new(55, 0.2, 0), size = Vector3.new(26, 0.4, 190) },
	ArchPassA = { center = Vector3.new(-28, 0.2, -40), size = Vector3.new(28, 0.4, 18) },
	ArchPassB = { center = Vector3.new(28, 0.2, 40), size = Vector3.new(28, 0.4, 18) },
}

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

-- Helper to create sandstone pillars (standing or broken)
local function buildSandstonePillar(
	name: string,
	position: Vector3,
	height: number,
	isBroken: boolean,
	parent: Instance
)
	local pillarFolder = Instance.new("Folder")
	pillarFolder.Name = name
	pillarFolder.Parent = parent

	local sandstoneColor = Color3.fromRGB(215, 175, 125)
	local trimColor = Color3.fromRGB(190, 145, 95)
	local radius = 3.5

	if not isBroken then
		-- Base
		createPart(
			"Base",
			Vector3.new(radius + 1.5, 2, radius + 1.5),
			CFrame.new(position + Vector3.new(0, 1, 0)),
			trimColor,
			Enum.Material.Sandstone,
			pillarFolder
		)
		-- Main Shaft
		createPart(
			"Shaft",
			Vector3.new(radius, height - 4, radius),
			CFrame.new(position + Vector3.new(0, (height - 4) / 2 + 2, 0)),
			sandstoneColor,
			Enum.Material.Sandstone,
			pillarFolder
		)
		-- Capital Top
		createPart(
			"Capital",
			Vector3.new(radius + 2, 2, radius + 2),
			CFrame.new(position + Vector3.new(0, height - 1, 0)),
			trimColor,
			Enum.Material.Sandstone,
			pillarFolder
		)
	else
		-- Broken Stump
		local stumpHeight = height * 0.4
		createPart(
			"StumpBase",
			Vector3.new(radius + 1.5, 2, radius + 1.5),
			CFrame.new(position + Vector3.new(0, 1, 0)),
			trimColor,
			Enum.Material.Sandstone,
			pillarFolder
		)
		createPart(
			"StumpShaft",
			Vector3.new(radius, stumpHeight, radius),
			CFrame.new(position + Vector3.new(0, stumpHeight / 2 + 2, 0)),
			sandstoneColor,
			Enum.Material.Sandstone,
			pillarFolder
		)

		-- Fallen Column Segment lying on ground
		local fallenLength = height * 0.55
		local fallenCF = CFrame.new(position + Vector3.new(4, 1.8, 4))
			* CFrame.Angles(0, math.rad(45), math.rad(80))
		createPart(
			"FallenSegment",
			Vector3.new(radius, fallenLength, radius),
			fallenCF,
			sandstoneColor,
			Enum.Material.Sandstone,
			pillarFolder
		)
	end
end

-- Helper to create grand ancient arches
local function buildAncientArch(
	name: string,
	centerPosition: Vector3,
	width: number,
	height: number,
	parent: Instance
)
	local archFolder = Instance.new("Folder")
	archFolder.Name = name
	archFolder.Parent = parent

	local sandstoneColor = Color3.fromRGB(215, 175, 125)
	local pillarWidth = 4.5

	-- Left Pillar Leg
	createPart(
		"LegLeft",
		Vector3.new(pillarWidth, height, pillarWidth),
		CFrame.new(centerPosition + Vector3.new(-width / 2 + pillarWidth / 2, height / 2, 0)),
		sandstoneColor,
		Enum.Material.Sandstone,
		archFolder
	)

	-- Right Pillar Leg
	createPart(
		"LegRight",
		Vector3.new(pillarWidth, height, pillarWidth),
		CFrame.new(centerPosition + Vector3.new(width / 2 - pillarWidth / 2, height / 2, 0)),
		sandstoneColor,
		Enum.Material.Sandstone,
		archFolder
	)

	-- Top Arch Keystone Span
	local spanHeight = 4.5
	createPart(
		"ArchSpan",
		Vector3.new(width + 2, spanHeight, pillarWidth + 1),
		CFrame.new(centerPosition + Vector3.new(0, height + spanHeight / 2, 0)),
		sandstoneColor,
		Enum.Material.Sandstone,
		archFolder
	)
end

-- Helper to create crumbling stone wall
local function buildCrumblingWall(
	name: string,
	startPos: Vector3,
	length: number,
	maxHeight: number,
	rotationDeg: number,
	parent: Instance
)
	local wallFolder = Instance.new("Folder")
	wallFolder.Name = name
	wallFolder.Parent = parent

	local stoneColor = Color3.fromRGB(195, 160, 115)
	local wallThickness = 2.5
	local numSegments = math.floor(length / 6)

	local cfBase = CFrame.new(startPos) * CFrame.Angles(0, math.rad(rotationDeg), 0)

	for i = 0, numSegments - 1 do
		local zOffset = i * 6 - length / 2 + 3
		-- Irregular crumbling heights
		local segHeight = maxHeight - (i % 3) * 1.5
		if segHeight &lt; 2 then
			segHeight = 2
		end

		createPart(
			"WallSegment_" .. i,
			Vector3.new(wallThickness, segHeight, 5.8),
			cfBase * CFrame.new(0, segHeight / 2, zOffset),
			stoneColor,
			Enum.Material.Sandstone,
			wallFolder
		)
	end
end

function DesertRuinsMap.BuildMap(parent: Instance?): Folder
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- 1. Outer Perimeter &amp; Sand Terrain Ground
	local terrainFolder = Instance.new("Folder")
	terrainFolder.Name = "Perimeter"
	terrainFolder.Parent = mapFolder

	local sandColor = Color3.fromRGB(225, 185, 130)
	local rockColor = Color3.fromRGB(175, 135, 90)

	-- Sand Ground Base
	createPart(
		"DesertFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		sandColor,
		Enum.Material.Sand,
		terrainFolder
	)

	-- Sand Dunes (Sloped elevations)
	createWedge(
		"Dune_West_Slope",
		Vector3.new(50, 8, 70),
		CFrame.new(-60, 4, -10) * CFrame.Angles(0, math.rad(-90), 0),
		sandColor,
		Enum.Material.Sand,
		terrainFolder
	)
	createWedge(
		"Dune_East_Slope",
		Vector3.new(50, 8, 70),
		CFrame.new(60, 4, 10) * CFrame.Angles(0, math.rad(90), 0),
		sandColor,
		Enum.Material.Sand,
		terrainFolder
	)

	-- Outer Canyon Wall Boundaries
	createPart(
		"NorthCanyonWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 4),
		CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)
	createPart(
		"SouthCanyonWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 4),
		CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)
	createPart(
		"WestCanyonWall",
		Vector3.new(4, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)
	createPart(
		"EastCanyonWall",
		Vector3.new(4, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)

	-- 2. Spawns Folder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local redSpawnFolder = Instance.new("Folder")
	redSpawnFolder.Name = "RedSpawn"
	redSpawnFolder.Parent = spawnsFolder

	createPart(
		"RedOasisBase",
		Vector3.new(40, 1, 26),
		CFrame.new(0, 0.5, -110),
		Color3.fromRGB(160, 45, 45),
		Enum.Material.Sandstone,
		redSpawnFolder
	)

	for i, pos in RED_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(230, 80, 80),
			Enum.Material.Neon,
			redSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Red")
		sp:SetAttribute("Index", i)
	end

	local blueSpawnFolder = Instance.new("Folder")
	blueSpawnFolder.Name = "BlueSpawn"
	blueSpawnFolder.Parent = spawnsFolder

	createPart(
		"BlueExcavationBase",
		Vector3.new(40, 1, 26),
		CFrame.new(0, 0.5, 110),
		Color3.fromRGB(45, 95, 165),
		Enum.Material.Sandstone,
		blueSpawnFolder
	)

	for i, pos in BLUE_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(80, 140, 230),
			Enum.Material.Neon,
			blueSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Blue")
		sp:SetAttribute("Index", i)
	end

	-- 3. Environment Assets Folder (Pillars, Arches, Crumbling Walls, Obelisks)
	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = mapFolder

	-- Ancient Sandstone Pillars
	buildSandstonePillar("Pillar_Intact_1", Vector3.new(-50, 0, -80), 16, false, envFolder)
	buildSandstonePillar("Pillar_Intact_2", Vector3.new(50, 0, 80), 16, false, envFolder)
	buildSandstonePillar("Pillar_Broken_1", Vector3.new(-55, 0, 30), 14, true, envFolder)
	buildSandstonePillar("Pillar_Broken_2", Vector3.new(55, 0, -30), 14, true, envFolder)

	-- Grand Ancient Arches
	buildAncientArch("Arch_NorthPortal", Vector3.new(0, 0, -70), 22, 14, envFolder)
	buildAncientArch("Arch_SouthPortal", Vector3.new(0, 0, 70), 22, 14, envFolder)
	buildAncientArch("Arch_WestEntry", Vector3.new(-55, 0, 0), 18, 12, envFolder)
	buildAncientArch("Arch_EastEntry", Vector3.new(55, 0, 0), 18, 12, envFolder)

	-- Crumbling Stone Walls
	buildCrumblingWall("CrumblingWall_SiteA", Vector3.new(-65, 0, -35), 24, 7, 30, envFolder)
	buildCrumblingWall("CrumblingWall_SiteB", Vector3.new(65, 0, 35), 24, 7, -30, envFolder)
	buildCrumblingWall("CrumblingWall_MidWest", Vector3.new(-22, 0, 0), 20, 8, 90, envFolder)
	buildCrumblingWall("CrumblingWall_MidEast", Vector3.new(22, 0, 0), 20, 8, -90, envFolder)

	-- Sandstone Obelisk in Sunken Plaza Center
	local obeliskColor = Color3.fromRGB(205, 165, 115)
	createPart(
		"CentralObelisk",
		Vector3.new(5, 16, 5),
		CFrame.new(0, 8, 0),
		obeliskColor,
		Enum.Material.Sandstone,
		envFolder
	)

	-- 4. Objective Sites Folder
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local siteA = createPart(
		"SiteA",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_A_POSITION),
		Color3.fromRGB(240, 175, 35),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteA.Transparency = 0.5
	siteA:SetAttribute("SiteName", "A")

	local siteB = createPart(
		"SiteB",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_B_POSITION),
		Color3.fromRGB(240, 175, 35),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteB.Transparency = 0.5
	siteB:SetAttribute("SiteName", "B")

	-- 5. Cover Folder
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	local rubbleColor = Color3.fromRGB(185, 150, 105)

	-- Site A Rubble &amp; Pillars
	createPart("RubbleBlock_SiteA_1", Vector3.new(6, 4, 6), CFrame.new(-55, 2, -40), rubbleColor, Enum.Material.Sandstone, coverFolder)
	createPart("RubbleBlock_SiteA_2", Vector3.new(5, 3.5, 5), CFrame.new(-68, 1.75, -30), rubbleColor, Enum.Material.Sandstone, coverFolder)
	createPart("RubbleBlock_SiteA_3", Vector3.new(5, 3.5, 5), CFrame.new(-42, 1.75, -52), rubbleColor, Enum.Material.Sandstone, coverFolder)

	-- Site B Rubble &amp; Pillars
	createPart("RubbleBlock_SiteB_1", Vector3.new(6, 4, 6), CFrame.new(55, 2, 40), rubbleColor, Enum.Material.Sandstone, coverFolder)
	createPart("RubbleBlock_SiteB_2", Vector3.new(5, 3.5, 5), CFrame.new(68, 1.75, 30), rubbleColor, Enum.Material.Sandstone, coverFolder)
	createPart("RubbleBlock_SiteB_3", Vector3.new(5, 3.5, 5), CFrame.new(42, 1.75, 52), rubbleColor, Enum.Material.Sandstone, coverFolder)

	-- Mid Plaza Cover
	createPart("PlazaCover_North", Vector3.new(8, 3.5, 4), CFrame.new(0, 1.75, -25), rubbleColor, Enum.Material.Sandstone, coverFolder)
	createPart("PlazaCover_South", Vector3.new(8, 3.5, 4), CFrame.new(0, 1.75, 25), rubbleColor, Enum.Material.Sandstone, coverFolder)

	-- 6. Lanes Folder
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		createPart(
			laneName,
			data.size,
			CFrame.new(data.center),
			Color3.fromRGB(205, 165, 115),
			Enum.Material.SmoothPlastic,
			lanesFolder,
			false
		)
	end

	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder

	return mapFolder
end

function DesertRuinsMap.DestroyMap()
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

function DesertRuinsMap.GetSpawnPoints(teamName: string): { Vector3 }
	if teamName == "Red" then
		return table.clone(RED_SPAWN_POSITIONS)
	elseif teamName == "Blue" then
		return table.clone(BLUE_SPAWN_POSITIONS)
	else
		warn("[DesertRuinsMap] Invalid team name: " .. tostring(teamName))
		return {}
	end
end

function DesertRuinsMap.GetCoverPositions(): { Vector3 }
	return table.clone(COVER_POSITIONS)
end

function DesertRuinsMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_A_POSITION,
		siteB = SITE_B_POSITION,
	}
end

function DesertRuinsMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2)
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2)
	return minBounds, maxBounds
end

function DesertRuinsMap.GetLayoutData(): MapLayoutData
	local minB, maxB = DesertRuinsMap.GetMapBounds()
	return {
		mapId = "DesertRuins",
		mapName = "Desert Ruins",
		theme = "Desert",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = table.clone(RED_SPAWN_POSITIONS),
		blueSpawns = table.clone(BLUE_SPAWN_POSITIONS),
		sites = DesertRuinsMap.GetSitePositions(),
		coverPositions = table.clone(COVER_POSITIONS),
		lanes = LANES_DATA,
	}
end

return DesertRuinsMap
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">DuelArenaMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: DuelArenaMap (Legendary Edition)

    Research-backed competitive 1v1 / 2v2 tactical arena:
    - 3-lane design with symmetrical travel times [web:25][web:39]
    - Rotational symmetry (180°) so both teams have identical layouts [web:34]
    - Choke points, connectors, risk/reward high ground [web:35][web:43]
    - Tiered cover (Low / Mid / High) with health attributes
    - Proper SpawnLocation instances + team platforms
    - Capture / control sites with neon rings + billboards
    - Full lighting rig attributes + ambient FX
    - No duplicate geometry (legacy Red/Blue aliases via attributes only)
]=]

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local DuelArenaMap = {}

-- Types ----------------------------------------------------------------------

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions?,
	coverPositions: { Vector3 },
	lanes: { [string]: { center: Vector3, size: Vector3 } },
}

-- Constants ------------------------------------------------------------------

local MAP_FOLDER_NAME = "DuelArenaMap"
local _activeMapFolder: Folder? = nil
local _activeTweens: { Tween } = {}

local MAP_WIDTH_X = 120
local MAP_LENGTH_Z = 160
local MAP_HEIGHT_Y = 32

local MAP_OFFSET = Vector3.new(-500, 100, 0)

local C = {
	FLOOR       = Color3.fromRGB(22, 26, 34),
	FLOOR_ALT   = Color3.fromRGB(28, 32, 42),
	WALL        = Color3.fromRGB(40, 46, 56),
	WALL_ACCENT = Color3.fromRGB(55, 62, 74),
	TRIM        = Color3.fromRGB(65, 72, 88),
	CONCRETE    = Color3.fromRGB(50, 56, 66),
	NEON_CYAN   = Color3.fromRGB(0, 210, 255),
	NEON_BLUE   = Color3.fromRGB(0, 140, 255),
	NEON_RED    = Color3.fromRGB(255, 55, 55),
	NEON_GREEN  = Color3.fromRGB(0, 230, 140),
	NEON_GOLD   = Color3.fromRGB(255, 190, 50),
	SITE_TEAL   = Color3.fromRGB(0, 220, 190),
	GLASS       = Color3.fromRGB(120, 190, 240),
	WHITE       = Color3.fromRGB(220, 235, 255),
}

-- Spawns (4 per team, clustered for 1v1 / 2v2) -------------------------------
local TEAM1_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-10, 2, -62),
	Vector3.new(10, 2, -62),
	Vector3.new(-4, 2, -66),
	Vector3.new(4, 2, -66),
}

local TEAM2_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-10, 2, 62),
	Vector3.new(10, 2, 62),
	Vector3.new(-4, 2, 66),
	Vector3.new(4, 2, 66),
}

local SITE_POSITIONS = {
	siteA = Vector3.new(-32, 1, 0),
	siteB = Vector3.new(32, 1, 0),
}

-- Lane metadata (world-space centers before offset) --------------------------
local LANES_DATA: { [string]: { center: Vector3, size: Vector3 } } = {
	MainLane = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(22, 0.4, 124) },
	LeftFlank = { center = Vector3.new(-40, 0.2, 0), size = Vector3.new(18, 0.4, 124) },
	RightFlank = { center = Vector3.new(40, 0.2, 0), size = Vector3.new(18, 0.4, 124) },
	Connector_North = { center = Vector3.new(0, 0.2, -28), size = Vector3.new(62, 0.4, 14) },
	Connector_South = { center = Vector3.new(0, 0.2, 28), size = Vector3.new(62, 0.4, 14) },
}

-- Cover definitions (tiered + rotational pairs) ------------------------------
type CoverDef = {
	name: string,
	pos: Vector3,
	size: Vector3,
	tier: string, -- "Low" | "Mid" | "High" | "Pillar"
	health: number,
	rotation: number?, -- yaw degrees
}

local COVER_DEFS: { CoverDef } = {
	-- Mid lane
	{ name = "Pillar_Center", pos = Vector3.new(0, 6, 0), size = Vector3.new(7, 12, 7), tier = "Pillar", health = 9999 },
	{ name = "LowCover_Mid_N", pos = Vector3.new(0, 1.5, -22), size = Vector3.new(8, 3, 3.5), tier = "Low", health = 120 },
	{ name = "LowCover_Mid_S", pos = Vector3.new(0, 1.5, 22), size = Vector3.new(8, 3, 3.5), tier = "Low", health = 120 },
	{ name = "MidCover_Mid_N", pos = Vector3.new(0, 2.5, -38), size = Vector3.new(5, 5, 4), tier = "Mid", health = 220 },
	{ name = "MidCover_Mid_S", pos = Vector3.new(0, 2.5, 38), size = Vector3.new(5, 5, 4), tier = "Mid", health = 220 },

	-- Left flank
	{ name = "LowCover_Left_N", pos = Vector3.new(-40, 1.75, -28), size = Vector3.new(4, 3.5, 9), tier = "Low", health = 120 },
	{ name = "LowCover_Left_S", pos = Vector3.new(-40, 1.75, 28), size = Vector3.new(4, 3.5, 9), tier = "Low", health = 120 },
	{ name = "MidCover_Left_Mid", pos = Vector3.new(-38, 2.5, 0), size = Vector3.new(5, 5, 6), tier = "Mid", health = 220 },

	-- Right flank
	{ name = "LowCover_Right_N", pos = Vector3.new(40, 1.75, -28), size = Vector3.new(4, 3.5, 9), tier = "Low", health = 120 },
	{ name = "LowCover_Right_S", pos = Vector3.new(40, 1.75, 28), size = Vector3.new(4, 3.5, 9), tier = "Low", health = 120 },
	{ name = "MidCover_Right_Mid", pos = Vector3.new(38, 2.5, 0), size = Vector3.new(5, 5, 6), tier = "Mid", health = 220 },

	-- Connector choke blocks
	{ name = "Choke_NW", pos = Vector3.new(-18, 2, -28), size = Vector3.new(4, 4, 4), tier = "Mid", health = 200 },
	{ name = "Choke_NE", pos = Vector3.new(18, 2, -28), size = Vector3.new(4, 4, 4), tier = "Mid", health = 200 },
	{ name = "Choke_SW", pos = Vector3.new(-18, 2, 28), size = Vector3.new(4, 4, 4), tier = "Mid", health = 200 },
	{ name = "Choke_SE", pos = Vector3.new(18, 2, 28), size = Vector3.new(4, 4, 4), tier = "Mid", health = 200 },
}

local COVER_POSITIONS: { Vector3 } = {}
for _, d in COVER_DEFS do
	table.insert(COVER_POSITIONS, d.pos)
end

-- Helpers --------------------------------------------------------------------

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?,
	transparency: number?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe + MAP_OFFSET
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.Transparency = transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CastShadow = (transparency or 0) &lt; 0.5
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe + MAP_OFFSET
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

local function addLight(parent: Instance, color: Color3, range: number, brightness: number, spot: boolean?)
	if spot then
		local s = Instance.new("SpotLight")
		s.Color = color
		s.Range = range
		s.Brightness = brightness
		s.Angle = 95
		s.Face = Enum.NormalId.Bottom
		s.Parent = parent
	else
		local p = Instance.new("PointLight")
		p.Color = color
		p.Range = range
		p.Brightness = brightness
		p.Parent = parent
	end
end

local function makeBillboard(
	parent: Instance,
	name: string,
	text: string,
	color: Color3,
	size: UDim2,
	offset: Vector3,
	textSize: number
)
	local bb = Instance.new("BillboardGui")
	bb.Name = name
	bb.Size = size
	bb.StudsOffset = offset
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Parent = parent

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = color
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextSize = textSize
	lbl.Text = text
	lbl.TextStrokeTransparency = 0.45
	lbl.Parent = bb
end

local function cleanup()
	for _, t in _activeTweens do
		t:Cancel()
	end
	table.clear(_activeTweens)
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

-- Build ----------------------------------------------------------------------

function DuelArenaMap.BuildMap(parent: Instance?): Folder
	cleanup()

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	------------------------------------------------------------------------
	-- 1. Perimeter &amp; Floor (dark tactical base)
	------------------------------------------------------------------------
	local perimeter = Instance.new("Folder")
	perimeter.Name = "Perimeter"
	perimeter.Parent = mapFolder

	createPart("MainFloor", Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0), C.FLOOR, Enum.Material.Concrete, perimeter, true)

	-- Subtle center lane inlay (navigation landmark)
	createPart("FloorInlay_Mid", Vector3.new(1.5, 0.06, MAP_LENGTH_Z - 8),
		CFrame.new(0, 0.03, 0), C.NEON_CYAN, Enum.Material.Neon, perimeter, false, 0.45)
	createPart("FloorInlay_Left", Vector3.new(1.2, 0.06, MAP_LENGTH_Z - 8),
		CFrame.new(-40, 0.03, 0), C.NEON_BLUE, Enum.Material.Neon, perimeter, false, 0.55)
	createPart("FloorInlay_Right", Vector3.new(1.2, 0.06, MAP_LENGTH_Z - 8),
		CFrame.new(40, 0.03, 0), C.NEON_BLUE, Enum.Material.Neon, perimeter, false, 0.55)

	local wallColor = C.WALL
	for _, w in {
		{ "NorthWall", Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2), CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2) },
		{ "SouthWall", Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2), CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2) },
		{ "WestWall", Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z), CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0) },
		{ "EastWall", Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z), CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0) },
	} do
		createPart(w[1] :: string, w[2] :: Vector3, w[3] :: CFrame, wallColor,
			Enum.Material.Concrete, perimeter, true)
		createPart((w[1] :: string) .. "_Accent",
			Vector3.new((w[2] :: Vector3).X, 0.8, (w[2] :: Vector3).Z),
			(w[3] :: CFrame) * CFrame.new(0, MAP_HEIGHT_Y / 2 - 1.2, 0),
			C.NEON_CYAN, Enum.Material.Neon, perimeter, false, 0.15)
	end

	-- Invisible ceiling
	createPart("CeilingBarrier", Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, MAP_HEIGHT_Y, 0), Color3.new(),
		Enum.Material.SmoothPlastic, perimeter, true, 1)

	------------------------------------------------------------------------
	-- 2. Lanes (visual floor strips + metadata attributes)
	------------------------------------------------------------------------
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		local lane = createPart(laneName, data.size, CFrame.new(data.center),
			C.FLOOR_ALT, Enum.Material.SmoothPlastic, lanesFolder, false, 0.35)
		lane:SetAttribute("LaneName", laneName)
		lane:SetAttribute("IsLane", true)
	end

	------------------------------------------------------------------------
	-- 3. Team Spawns (single geometry, dual attributes, real SpawnLocations)
	------------------------------------------------------------------------
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local function buildTeamSpawn(
		folderName: string,
		legacyName: string,
		teamAttr: string,
		legacyTeam: string,
		positions: { Vector3 },
		platformZ: number,
		teamColor: Color3,
		neonColor: Color3,
		brickTeam: string
	)
		local teamFolder = Instance.new("Folder")
		teamFolder.Name = folderName
		teamFolder.Parent = spawnsFolder

		-- Legacy alias folder (empty, for FindFirstChild compatibility)
		local legacyFolder = Instance.new("Folder")
		legacyFolder.Name = legacyName
		legacyFolder.Parent = spawnsFolder
		legacyFolder:SetAttribute("AliasOf", folderName)
		legacyFolder:SetAttribute("Team", legacyTeam)

		-- Raised spawn platform
		local platform = createPart("Platform_" .. folderName, Vector3.new(38, 1, 22),
			CFrame.new(0, 0.5, platformZ), teamColor, Enum.Material.Metal, teamFolder, true)
		createPart("PlatformEdge_" .. folderName, Vector3.new(38.4, 0.25, 0.6),
			CFrame.new(0, 1.1, platformZ + (if platformZ &lt; 0 then 11 else -11)),
			neonColor, Enum.Material.Neon, teamFolder, false, 0.1)
		addLight(platform, neonColor, 18, 1.2)

		makeBillboard(platform, folderName .. "Label",
			"[ " .. string.upper(legacyTeam) .. " SPAWN ]",
			neonColor, UDim2.new(0, 280, 0, 50), Vector3.new(0, 8, 0), 22)

		for i, pos in positions do
			-- Visual pad
			local pad = createPart("Spawn_" .. folderName .. "_" .. i, Vector3.new(4.5, 0.4, 4.5),
				CFrame.new(pos - Vector3.new(0, 0.3, 0)), C.TRIM,
				Enum.Material.Metal, teamFolder, true)
			createPart("SpawnRing_" .. folderName .. "_" .. i, Vector3.new(5, 0.15, 5),
				CFrame.new(pos - Vector3.new(0, 0.55, 0)), neonColor,
				Enum.Material.Neon, teamFolder, false, 0.2)
			pad:SetAttribute("Team", teamAttr)
			pad:SetAttribute("LegacyTeam", legacyTeam)
			pad:SetAttribute("SpawnIndex", i)
			pad:SetAttribute("Index", i)

			-- Real SpawnLocation (Neutral = false for team games if you set teams later)
			local spawnLoc = Instance.new("SpawnLocation")
			spawnLoc.Name = "SpawnLocation_" .. folderName .. "_" .. i
			spawnLoc.Size = Vector3.new(4, 0.35, 4)
			spawnLoc.CFrame = CFrame.new(pos) + MAP_OFFSET
			spawnLoc.Anchored = true
			spawnLoc.CanCollide = true
			spawnLoc.Neutral = true
			spawnLoc.AllowTeamChangeOnTouch = false
			spawnLoc.TeamColor = BrickColor.new(brickTeam)
			spawnLoc.Color = neonColor
			spawnLoc.Material = Enum.Material.SmoothPlastic
			spawnLoc.TopSurface = Enum.SurfaceType.Smooth
			spawnLoc.BottomSurface = Enum.SurfaceType.Smooth
			spawnLoc:SetAttribute("Team", teamAttr)
			spawnLoc:SetAttribute("LegacyTeam", legacyTeam)
			spawnLoc:SetAttribute("SpawnIndex", i)
			spawnLoc.Parent = teamFolder

			-- Lightweight proxy in legacy folder (for old scripts that scan RedSpawn/BlueSpawn)
			local proxy = Instance.new("ObjectValue")
			proxy.Name = "SpawnPoint" .. i
			proxy.Value = spawnLoc
			proxy:SetAttribute("Team", legacyTeam)
			proxy:SetAttribute("Index", i)
			proxy.Parent = legacyFolder
		end
	end

	buildTeamSpawn("Team1Spawn", "RedSpawn", "Team1", "Red",
		TEAM1_SPAWN_POSITIONS, -62, Color3.fromRGB(140, 35, 40), C.NEON_RED, "Bright red")
	buildTeamSpawn("Team2Spawn", "BlueSpawn", "Team2", "Blue",
		TEAM2_SPAWN_POSITIONS, 62, Color3.fromRGB(25, 90, 160), C.NEON_BLUE, "Bright blue")

	-- Spawn safety barriers (prevent early spawn peeks)
	createPart("SpawnGate_Team1", Vector3.new(40, 8, 1.5),
		CFrame.new(0, 4, -50), C.WALL_ACCENT, Enum.Material.Concrete, spawnsFolder, true)
	createPart("SpawnGate_Team2", Vector3.new(40, 8, 1.5),
		CFrame.new(0, 4, 50), C.WALL_ACCENT, Enum.Material.Concrete, spawnsFolder, true)
	-- Gate doors (semi-open corridors)
	createPart("SpawnGateDoor_T1_L", Vector3.new(8, 6, 1.2),
		CFrame.new(-14, 3, -50), C.TRIM, Enum.Material.Metal, spawnsFolder, true)
	createPart("SpawnGateDoor_T1_R", Vector3.new(8, 6, 1.2),
		CFrame.new(14, 3, -50), C.TRIM, Enum.Material.Metal, spawnsFolder, true)
	createPart("SpawnGateDoor_T2_L", Vector3.new(8, 6, 1.2),
		CFrame.new(-14, 3, 50), C.TRIM, Enum.Material.Metal, spawnsFolder, true)
	createPart("SpawnGateDoor_T2_R", Vector3.new(8, 6, 1.2),
		CFrame.new(14, 3, 50), C.TRIM, Enum.Material.Metal, spawnsFolder, true)

	------------------------------------------------------------------------
	-- 4. Control Sites (A / B) with rings, lights, prompts hooks
	------------------------------------------------------------------------
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local function buildSite(name: string, siteKey: string, pos: Vector3, accent: Color3)
		local pad = createPart(name, Vector3.new(18, 0.35, 18),
			CFrame.new(pos), accent, Enum.Material.Neon, sitesFolder, false, 0.55)
		pad:SetAttribute("SiteName", siteKey)
		pad:SetAttribute("IsSite", true)

		createPart(name .. "_RingOuter", Vector3.new(20, 0.2, 20),
			CFrame.new(pos - Vector3.new(0, 0.1, 0)), accent,
			Enum.Material.Neon, sitesFolder, false, 0.25)
		createPart(name .. "_RingInner", Vector3.new(10, 0.25, 10),
			CFrame.new(pos + Vector3.new(0, 0.05, 0)), C.WHITE,
			Enum.Material.Neon, sitesFolder, false, 0.4)

		-- Soft pillars at corners of site
		for i, off in {
			Vector3.new(-8, 2.5, -8), Vector3.new(8, 2.5, -8),
			Vector3.new(-8, 2.5, 8), Vector3.new(8, 2.5, 8),
		} do
			local p = createPart(name .. "_Pillar" .. i, Vector3.new(1.2, 5, 1.2),
				CFrame.new(pos + off), C.TRIM, Enum.Material.Metal, sitesFolder, true)
			addLight(p, accent, 10, 0.8)
		end

		makeBillboard(pad, name .. "Billboard", "[ SITE " .. siteKey .. " ]",
			accent, UDim2.new(0, 220, 0, 48), Vector3.new(0, 7, 0), 24)

		-- Capture volume (invisible)
		local vol = createPart(name .. "_CaptureVolume", Vector3.new(16, 8, 16),
			CFrame.new(pos + Vector3.new(0, 4, 0)), Color3.new(),
			Enum.Material.SmoothPlastic, sitesFolder, false, 1)
		vol.CanCollide = false
		vol.CanTouch = true
		vol:SetAttribute("SiteName", siteKey)
		vol:SetAttribute("IsCaptureVolume", true)
	end

	buildSite("SiteA", "A", SITE_POSITIONS.siteA, C.SITE_TEAL)
	buildSite("SiteB", "B", SITE_POSITIONS.siteB, C.NEON_GOLD)

	------------------------------------------------------------------------
	-- 5. Cover &amp; Structures
	------------------------------------------------------------------------
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	local tierColor = {
		Low = C.TRIM,
		Mid = C.WALL_ACCENT,
		High = C.CONCRETE,
		Pillar = C.CONCRETE,
	}

	for _, def in COVER_DEFS do
		local cf = CFrame.new(def.pos)
		if def.rotation then
			cf = cf * CFrame.Angles(0, math.rad(def.rotation), 0)
		end
		local part = createPart(def.name, def.size, cf,
			tierColor[def.tier] or C.TRIM, Enum.Material.Concrete, coverFolder, true)
		part:SetAttribute("CoverTier", def.tier)
		part:SetAttribute("CoverHealth", def.health)
		part:SetAttribute("MaxHealth", def.health)
		part:SetAttribute("IsCover", true)

		if def.tier == "Pillar" or def.tier == "High" then
			createPart(def.name .. "_Trim",
				Vector3.new(def.size.X + 0.3, 0.25, def.size.Z + 0.3),
				CFrame.new(def.pos + Vector3.new(0, def.size.Y / 2, 0)),
				C.NEON_CYAN, Enum.Material.Neon, coverFolder, false, 0.2)
		end
	end

	-- Barrel clusters near connectors (prop clustering)
	for _, bPos in {
		Vector3.new(-12, 1.4, -18), Vector3.new(-10, 1.4, -16),
		Vector3.new(12, 1.4, 18), Vector3.new(10, 1.4, 16),
		Vector3.new(-42, 1.4, 8), Vector3.new(42, 1.4, -8),
	} do
		local barrel = createPart("Barrel", Vector3.new(2, 2.8, 2),
			CFrame.new(bPos), C.NEON_GOLD, Enum.Material.Metal, coverFolder, true)
		barrel.Shape = Enum.PartType.Cylinder
		barrel.CFrame = (CFrame.new(bPos) * CFrame.Angles(0, 0, math.rad(90))) + MAP_OFFSET
		barrel:SetAttribute("CoverTier", "Barrel")
		barrel:SetAttribute("CoverHealth", 40)
		barrel:SetAttribute("MaxHealth", 40)
		barrel:SetAttribute("IsExplosive", true)
	end

	------------------------------------------------------------------------
	-- 6. High Ground / Sniper Perches (risk vs reward, mirrored)
	------------------------------------------------------------------------
	local highGround = Instance.new("Folder")
	highGround.Name = "HighGround"
	highGround.Parent = mapFolder

	-- Team1 side perch (NW) — favors Team1 approaching mid-left
	createPart("Perch_NW_Platform", Vector3.new(14, 1.5, 12),
		CFrame.new(-44, 6, -48), C.TRIM, Enum.Material.Metal, highGround, true)
	createPart("Perch_NW_RailN", Vector3.new(14, 0.3, 0.4),
		CFrame.new(-44, 7.2, -54), C.NEON_RED, Enum.Material.Neon, highGround, false, 0.15)
	createPart("Perch_NW_RailS", Vector3.new(14, 0.3, 0.4),
		CFrame.new(-44, 7.2, -42), C.NEON_RED, Enum.Material.Neon, highGround, false, 0.15)
	createWedge("Ramp_NW", Vector3.new(8, 6, 12),
		CFrame.new(-44, 3, -58), C.CONCRETE, Enum.Material.Concrete, highGround)
	createPart("Perch_NW_Support", Vector3.new(2, 6, 2),
		CFrame.new(-44, 3, -48), C.WALL, Enum.Material.Concrete, highGround, true)
	addLight(highGround:FindFirstChild("Perch_NW_Platform") :: BasePart, C.NEON_RED, 14, 1)
	makeBillboard(highGround:FindFirstChild("Perch_NW_Platform") :: BasePart,
		"PerchNW_Label", "PERCH", C.NEON_RED, UDim2.new(0, 120, 0, 36), Vector3.new(0, 4, 0), 18)

	-- Team2 side perch (SE) — 180° rotational pair
	createPart("Perch_SE_Platform", Vector3.new(14, 1.5, 12),
		CFrame.new(44, 6, 48), C.TRIM, Enum.Material.Metal, highGround, true)
	createPart("Perch_SE_RailN", Vector3.new(14, 0.3, 0.4),
		CFrame.new(44, 7.2, 42), C.NEON_BLUE, Enum.Material.Neon, highGround, false, 0.15)
	createPart("Perch_SE_RailS", Vector3.new(14, 0.3, 0.4),
		CFrame.new(44, 7.2, 54), C.NEON_BLUE, Enum.Material.Neon, highGround, false, 0.15)
	createWedge("Ramp_SE", Vector3.new(8, 6, 12),
		CFrame.new(44, 3, 58) * CFrame.Angles(0, math.pi, 0),
		C.CONCRETE, Enum.Material.Concrete, highGround)
	createPart("Perch_SE_Support", Vector3.new(2, 6, 2),
		CFrame.new(44, 3, 48), C.WALL, Enum.Material.Concrete, highGround, true)
	addLight(highGround:FindFirstChild("Perch_SE_Platform") :: BasePart, C.NEON_BLUE, 14, 1)
	makeBillboard(highGround:FindFirstChild("Perch_SE_Platform") :: BasePart,
		"PerchSE_Label", "PERCH", C.NEON_BLUE, UDim2.new(0, 120, 0, 36), Vector3.new(0, 4, 0), 18)

	-- Secondary mid-height balconies (risk/reward near sites)
	createPart("Balcony_West", Vector3.new(10, 1.2, 8),
		CFrame.new(-48, 4.5, 0), C.TRIM, Enum.Material.Metal, highGround, true)
	createWedge("Balcony_West_Ramp", Vector3.new(6, 4, 8),
		CFrame.new(-48, 2, -8) * CFrame.Angles(0, math.rad(90), 0),
		C.CONCRETE, Enum.Material.Concrete, highGround)
	createPart("Balcony_East", Vector3.new(10, 1.2, 8),
		CFrame.new(48, 4.5, 0), C.TRIM, Enum.Material.Metal, highGround, true)
	createWedge("Balcony_East_Ramp", Vector3.new(6, 4, 8),
		CFrame.new(48, 2, 8) * CFrame.Angles(0, math.rad(-90), 0),
		C.CONCRETE, Enum.Material.Concrete, highGround)

	------------------------------------------------------------------------
	-- 7. Mid Landmark (center pillar details)
	------------------------------------------------------------------------
	local landmark = Instance.new("Folder")
	landmark.Name = "Landmark"
	landmark.Parent = mapFolder

	local centerCore = createPart("CenterCore", Vector3.new(4, 10, 4),
		CFrame.new(0, 6, 0), C.NEON_CYAN, Enum.Material.Neon, landmark, false, 0.35)
	addLight(centerCore, C.NEON_CYAN, 22, 2)
	makeBillboard(centerCore, "MidLabel", "⬡ MID ⬡", C.WHITE,
		UDim2.new(0, 160, 0, 40), Vector3.new(0, 8, 0), 20)

	-- Soft spin on core for life
	local spin = TweenService:Create(centerCore,
		TweenInfo.new(12, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
		{ CFrame = (CFrame.new(0, 6, 0) + MAP_OFFSET) * CFrame.Angles(0, math.rad(360), 0) })
	spin:Play()
	table.insert(_activeTweens, spin)

	------------------------------------------------------------------------
	-- 8. Lighting Rig + Atmosphere attributes
	------------------------------------------------------------------------
	local lightingFolder = Instance.new("Folder")
	lightingFolder.Name = "LightingRig"
	lightingFolder.Parent = mapFolder

	for _, lx in { -35, 0, 35 } do
		for _, lz in { -40, 0, 40 } do
			local strip = createPart("CeilLight_" .. lx .. "_" .. lz,
				Vector3.new(6, 0.4, 6),
				CFrame.new(lx, MAP_HEIGHT_Y - 1.5, lz),
				Color3.fromRGB(190, 220, 255), Enum.Material.Neon, lightingFolder, false, 0.25)
			addLight(strip, Color3.fromRGB(170, 210, 255), 35, 1.8, true)
		end
	end

	-- Team-colored ambient strips near spawns
	createPart("AmbientStrip_Red", Vector3.new(36, 0.4, 2),
		CFrame.new(0, 12, -70), C.NEON_RED, Enum.Material.Neon, lightingFolder, false, 0.2)
	createPart("AmbientStrip_Blue", Vector3.new(36, 0.4, 2),
		CFrame.new(0, 12, 70), C.NEON_BLUE, Enum.Material.Neon, lightingFolder, false, 0.2)

	mapFolder:SetAttribute("Lighting_Technology", "Future")
	mapFolder:SetAttribute("Lighting_Ambient", "35,40,55")
	mapFolder:SetAttribute("Lighting_OutdoorAmbient", "12,14,22")
	mapFolder:SetAttribute("Lighting_Brightness", "1.4")
	mapFolder:SetAttribute("Lighting_ClockTime", "20")
	mapFolder:SetAttribute("Lighting_ShadowSoftness", "0.25")
	mapFolder:SetAttribute("Atmosphere_Density", "0.4")
	mapFolder:SetAttribute("Atmosphere_Offset", "0.1")
	mapFolder:SetAttribute("Atmosphere_Color", "80,100,140")
	mapFolder:SetAttribute("Atmosphere_Decay", "60,80,110")
	mapFolder:SetAttribute("Atmosphere_Glare", "0.2")
	mapFolder:SetAttribute("Atmosphere_Haze", "1.8")
	mapFolder:SetAttribute("ColorCorrection_Brightness", "-0.08")
	mapFolder:SetAttribute("ColorCorrection_Contrast", "0.2")
	mapFolder:SetAttribute("ColorCorrection_Saturation", "0.05")
	mapFolder:SetAttribute("ColorCorrection_TintColor", "200,220,255")
	mapFolder:SetAttribute("Bloom_Intensity", "0.9")
	mapFolder:SetAttribute("Bloom_Size", "28")
	mapFolder:SetAttribute("Bloom_Threshold", "0.85")
	mapFolder:SetAttribute("SunRays_Intensity", "0.05")
	mapFolder:SetAttribute("SunRays_Spread", "0.8")

	------------------------------------------------------------------------
	-- 9. Kill / Out-of-bounds volumes
	------------------------------------------------------------------------
	local volumes = Instance.new("Folder")
	volumes.Name = "Volumes"
	volumes.Parent = mapFolder

	-- Mid fight volume (for analytics / music intensity hooks)
	local midVol = createPart("MidFightVolume", Vector3.new(50, 16, 50),
		CFrame.new(0, 8, 0), Color3.new(), Enum.Material.SmoothPlastic, volumes, false, 1)
	midVol.CanCollide = false
	midVol.CanTouch = true
	midVol:SetAttribute("VolumeType", "MidFight")

	------------------------------------------------------------------------
	-- 10. FX
	------------------------------------------------------------------------
	local fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = mapFolder

	local dust = createPart("AmbientDust", Vector3.new(1, 1, 1),
		CFrame.new(0, 8, 0), Color3.new(), Enum.Material.SmoothPlastic, fx, false, 1)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(C.NEON_CYAN)
	pe.Size = NumberSequence.new(0.15, 0)
	pe.Transparency = NumberSequence.new(0.55, 1)
	pe.Lifetime = NumberRange.new(3, 6)
	pe.Rate = 6
	pe.Speed = NumberRange.new(0.8, 1.8)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.Parent = dust

	------------------------------------------------------------------------
	-- Finalize
	------------------------------------------------------------------------
	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder
	return mapFolder
end

-- API ------------------------------------------------------------------------

function DuelArenaMap.DestroyMap()
	cleanup()
end

function DuelArenaMap.GetSpawnPoints(teamName: string): { Vector3 }
	local baseSpawns: { Vector3 } = {}
	if teamName == "Team1" or teamName == "Red" then
		baseSpawns = TEAM1_SPAWN_POSITIONS
	elseif teamName == "Team2" or teamName == "Blue" then
		baseSpawns = TEAM2_SPAWN_POSITIONS
	end
	local results: { Vector3 } = {}
	for _, pos in baseSpawns do
		table.insert(results, pos + MAP_OFFSET)
	end
	return results
end

function DuelArenaMap.GetSpawnLocations(teamName: string?): { SpawnLocation }
	local result: { SpawnLocation } = {}
	if not _activeMapFolder then
		return result
	end
	local spawns = _activeMapFolder:FindFirstChild("Spawns")
	if not spawns then
		return result
	end
	for _, desc in spawns:GetDescendants() do
		if desc:IsA("SpawnLocation") then
			if not teamName then
				table.insert(result, desc)
			else
				local t = desc:GetAttribute("Team")
				local legacy = desc:GetAttribute("LegacyTeam")
				if t == teamName or legacy == teamName then
					table.insert(result, desc)
				end
			end
		end
	end
	return result
end

function DuelArenaMap.GetCoverPositions(): { Vector3 }
	local results: { Vector3 } = {}
	for _, pos in COVER_POSITIONS do
		table.insert(results, pos + MAP_OFFSET)
	end
	return results
end

function DuelArenaMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_POSITIONS.siteA + MAP_OFFSET,
		siteB = SITE_POSITIONS.siteB + MAP_OFFSET,
	}
end

function DuelArenaMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2) + MAP_OFFSET
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2) + MAP_OFFSET
	return minBounds, maxBounds
end

function DuelArenaMap.GetLanes(): { [string]: { center: Vector3, size: Vector3 } }
	local out: { [string]: { center: Vector3, size: Vector3 } } = {}
	for name, data in LANES_DATA do
		out[name] = {
			center = data.center + MAP_OFFSET,
			size = data.size,
		}
	end
	return out
end

function DuelArenaMap.GetLayoutData(): MapLayoutData
	local minB, maxB = DuelArenaMap.GetMapBounds()
	return {
		mapId = "DuelArena",
		mapName = "DuelArena_1v1_2v2_v2",
		theme = "Dark Tactical Competitive",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = DuelArenaMap.GetSpawnPoints("Red"),
		blueSpawns = DuelArenaMap.GetSpawnPoints("Blue"),
		sites = DuelArenaMap.GetSitePositions(),
		coverPositions = DuelArenaMap.GetCoverPositions(),
		lanes = DuelArenaMap.GetLanes(),
	}
end

return DuelArenaMap
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">DuelArenaMap.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for DuelArenaMap
    Verifies 1v1 and 2v2 tactical greybox map generation, hierarchy, part property invariants (Anchored = true),
    team spawn resolution, cover points, layout metadata, and clean teardown.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local DuelArenaMap = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("DuelArenaMap"))

local function runTests()
	print("[DuelArenaMap.spec] Starting DuelArenaMap unit tests...")

	-- 1. Test Map Building
	local mapFolder = DuelArenaMap.BuildMap(Workspace)
	assert(mapFolder ~= nil, "BuildMap must return a valid Folder instance")
	assert(mapFolder.Name == "DuelArenaMap", "Map folder name must be 'DuelArenaMap'")
	assert(mapFolder.Parent == Workspace, "Map folder must be parented to Workspace")

	-- 2. Test Structure Hierarchy
	local perimeter = mapFolder:FindFirstChild("Perimeter")
	assert(perimeter ~= nil, "Perimeter folder missing")
	assert(perimeter:FindFirstChild("MainFloor") ~= nil, "MainFloor part missing")
	assert(perimeter:FindFirstChild("NorthWall") ~= nil, "NorthWall part missing")
	assert(perimeter:FindFirstChild("SouthWall") ~= nil, "SouthWall part missing")

	local spawns = mapFolder:FindFirstChild("Spawns")
	assert(spawns ~= nil, "Spawns folder missing")

	local team1Folder = spawns:FindFirstChild("Team1Spawn")
	assert(team1Folder ~= nil, "Team1Spawn folder missing")
	assert(team1Folder:FindFirstChild("Spawn_Team1_1") ~= nil, "Spawn_Team1_1 missing")
	assert(team1Folder:FindFirstChild("Spawn_Team1_2") ~= nil, "Spawn_Team1_2 missing")
	assert(team1Folder:FindFirstChild("Spawn_Team1_3") ~= nil, "Spawn_Team1_3 missing")
	assert(team1Folder:FindFirstChild("Spawn_Team1_4") ~= nil, "Spawn_Team1_4 missing")

	local team2Folder = spawns:FindFirstChild("Team2Spawn")
	assert(team2Folder ~= nil, "Team2Spawn folder missing")
	assert(team2Folder:FindFirstChild("Spawn_Team2_1") ~= nil, "Spawn_Team2_1 missing")
	assert(team2Folder:FindFirstChild("Spawn_Team2_2") ~= nil, "Spawn_Team2_2 missing")
	assert(team2Folder:FindFirstChild("Spawn_Team2_3") ~= nil, "Spawn_Team2_3 missing")
	assert(team2Folder:FindFirstChild("Spawn_Team2_4") ~= nil, "Spawn_Team2_4 missing")

	local lanes = mapFolder:FindFirstChild("Lanes")
	assert(lanes ~= nil, "Lanes folder missing")
	assert(lanes:FindFirstChild("MainLane") ~= nil, "MainLane missing")

	local cover = mapFolder:FindFirstChild("Cover")
	assert(cover ~= nil, "Cover folder missing")
	assert(cover:FindFirstChild("Pillar_Center") ~= nil, "Pillar_Center missing")

	-- 3. Test Spawn &amp; Cover API
	local team1Spawns = DuelArenaMap.GetSpawnPoints("Team1")
	assert(#team1Spawns == 4, "Expected 4 Team1 spawn points, got " .. #team1Spawns)

	local redSpawns = DuelArenaMap.GetSpawnPoints("Red")
	assert(#redSpawns == 4, "Expected 4 Red spawn points, got " .. #redSpawns)

	local team2Spawns = DuelArenaMap.GetSpawnPoints("Team2")
	assert(#team2Spawns == 4, "Expected 4 Team2 spawn points, got " .. #team2Spawns)

	local blueSpawns = DuelArenaMap.GetSpawnPoints("Blue")
	assert(#blueSpawns == 4, "Expected 4 Blue spawn points, got " .. #blueSpawns)

	local coverPositions = DuelArenaMap.GetCoverPositions()
	assert(#coverPositions &gt;= 8, "Expected at least 8 cover positions, got " .. #coverPositions)

	-- 4. Test Part Properties Invariants
	for _, desc in mapFolder:GetDescendants() do
		if desc:IsA("BasePart") then
			assert(desc.Anchored == true, "Part '" .. desc.Name .. "' must be Anchored = true")

			if desc.Name:sub(1, 11) == "Spawn_Team1" or desc.Name:sub(1, 11) == "Spawn_Team2" then
				assert(desc.CanCollide == false, "Spawn part '" .. desc.Name .. "' must have CanCollide = false")
			end
		end
	end

	-- 5. Test Layout Data &amp; Bounds
	local layoutData = DuelArenaMap.GetLayoutData()
	assert(layoutData.mapId == "DuelArena", "Layout mapId mismatch")
	assert(layoutData.mapName == "DuelArena_1v1_2v2", "Layout mapName mismatch")
	assert(layoutData.bounds.min.X == -60 or layoutData.bounds.min.X == -560, "Min bound X mismatch")
	assert(layoutData.bounds.max.X == 60 or layoutData.bounds.max.X == -440, "Max bound X mismatch")
	assert(layoutData.bounds.min.Z == -80, "Min bound Z mismatch")
	assert(layoutData.bounds.max.Z == 80, "Max bound Z mismatch")

	-- 6. Test Map Teardown
	DuelArenaMap.DestroyMap()
	assert(mapFolder.Parent == nil, "Map folder must be unparented after DestroyMap()")

	print("[DuelArenaMap.spec] All DuelArenaMap tests passed successfully!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">ForestOutpostMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: ForestOutpostMap
    Procedural 5v5 FPS Forest Outpost layout builder module.
    Generates a natural wilderness environment featuring trees with canopies/branches,
    foliage, log barricades, elevated wooden watchtowers, uneven terrain mounds,
    chokepoints, spawn locations, and objective sites.
]=]

local Workspace = game:GetService("Workspace")

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type LaneData = {
	center: Vector3,
	size: Vector3,
}

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions,
	coverPositions: { Vector3 },
	lanes: { [string]: LaneData },
}

local ForestOutpostMap = {}

local MAP_FOLDER_NAME = "ForestOutpostMap"
local _activeMapFolder: Folder? = nil

-- Map Dimension Constants
local MAP_WIDTH_X = 180
local MAP_LENGTH_Z = 260
local MAP_HEIGHT_Y = 35

local RED_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-15, 2, -110),
	Vector3.new(-7.5, 2, -110),
	Vector3.new(0, 2, -110),
	Vector3.new(7.5, 2, -110),
	Vector3.new(15, 2, -110),
}

local BLUE_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-15, 2, 110),
	Vector3.new(-7.5, 2, 110),
	Vector3.new(0, 2, 110),
	Vector3.new(7.5, 2, 110),
	Vector3.new(15, 2, 110),
}

local SITE_A_POSITION = Vector3.new(-55, 1, -35)
local SITE_B_POSITION = Vector3.new(55, 1, 35)

local COVER_POSITIONS: { Vector3 } = {
	-- Site A Covers
	Vector3.new(-55, 3.5, -35),
	Vector3.new(-65, 3.5, -25),
	Vector3.new(-45, 3.5, -45),
	-- Site B Covers
	Vector3.new(55, 3.5, 35),
	Vector3.new(65, 3.5, 25),
	Vector3.new(45, 3.5, 45),
	-- Mid Ridge &amp; Chokepoints
	Vector3.new(-20, 3.5, 0),
	Vector3.new(20, 3.5, 0),
	Vector3.new(0, 3.5, -25),
	Vector3.new(0, 3.5, 25),
	-- Watchtowers (Elevated)
	Vector3.new(-50, 14, -80),
	Vector3.new(50, 14, 80),
}

local LANES_DATA: { [string]: LaneData } = {
	CentralGorge = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(28, 0.4, 170) },
	RidgePassWest = { center = Vector3.new(-55, 0.2, 0), size = Vector3.new(26, 0.4, 190) },
	EastTreeFlank = { center = Vector3.new(55, 0.2, 0), size = Vector3.new(26, 0.4, 190) },
	ChokeConnectorA = { center = Vector3.new(-28, 0.2, -35), size = Vector3.new(28, 0.4, 18) },
	ChokeConnectorB = { center = Vector3.new(28, 0.2, 35), size = Vector3.new(28, 0.4, 18) },
}

-- Helper functions
local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

-- Tree builder helper
local function buildTree(name: string, basePos: Vector3, height: number, parent: Instance)
	local treeFolder = Instance.new("Folder")
	treeFolder.Name = name
	treeFolder.Parent = parent

	-- Trunk
	local trunkColor = Color3.fromRGB(85, 55, 30)
	local trunkRadius = 2.5
	createPart(
		"Trunk",
		Vector3.new(trunkRadius, height, trunkRadius),
		CFrame.new(basePos + Vector3.new(0, height / 2, 0)),
		trunkColor,
		Enum.Material.Wood,
		treeFolder
	)

	-- Branches
	local branchColor = Color3.fromRGB(75, 48, 25)
	local branchAngles = { 0, math.pi / 2, math.pi, math.pi * 1.5 }
	for idx, angle in branchAngles do
		local branchLength = 6
		local branchHeightOffset = height * 0.6 + (idx * 1.5)
		local branchCF = CFrame.new(basePos + Vector3.new(0, branchHeightOffset, 0))
			* CFrame.Angles(0, angle, 0)
			* CFrame.Angles(0, 0, math.rad(30))
			* CFrame.new(branchLength / 2, 0, 0)
		createPart(
			"Branch_" .. idx,
			Vector3.new(branchLength, 1, 1),
			branchCF,
			branchColor,
			Enum.Material.Wood,
			treeFolder
		)
	end

	-- Foliage Canopy Layer 1 (Lower Broad)
	local foliageColor = Color3.fromRGB(35, 100, 45)
	createPart(
		"Canopy_Lower",
		Vector3.new(16, 8, 16),
		CFrame.new(basePos + Vector3.new(0, height + 2, 0)),
		foliageColor,
		Enum.Material.Leaves,
		treeFolder
	)

	-- Foliage Canopy Layer 2 (Upper Cone/Mid)
	createPart(
		"Canopy_Upper",
		Vector3.new(11, 7, 11),
		CFrame.new(basePos + Vector3.new(0, height + 8, 0)),
		Color3.fromRGB(45, 120, 50),
		Enum.Material.Leaves,
		treeFolder
	)
end

-- Watchtower builder helper
local function buildWatchtower(name: string, position: Vector3, parent: Instance)
	local towerFolder = Instance.new("Folder")
	towerFolder.Name = name
	towerFolder.Parent = parent

	local legColor = Color3.fromRGB(90, 60, 35)
	local platformColor = Color3.fromRGB(110, 75, 45)
	local roofColor = Color3.fromRGB(70, 45, 25)

	local towerHeight = 14
	local platWidth = 14
	local platLength = 14

	-- 4 Support Legs
	local offsets = {
		Vector3.new(-platWidth / 2 + 1, towerHeight / 2, -platLength / 2 + 1),
		Vector3.new(platWidth / 2 - 1, towerHeight / 2, -platLength / 2 + 1),
		Vector3.new(-platWidth / 2 + 1, towerHeight / 2, platLength / 2 - 1),
		Vector3.new(platWidth / 2 - 1, towerHeight / 2, platLength / 2 - 1),
	}
	for i, legOffset in offsets do
		createPart(
			"Leg_" .. i,
			Vector3.new(1.8, towerHeight, 1.8),
			CFrame.new(position + legOffset),
			legColor,
			Enum.Material.Wood,
			towerFolder
		)
	end

	-- Elevated Platform Floor
	local platCF = CFrame.new(position + Vector3.new(0, towerHeight, 0))
	createPart(
		"PlatformFloor",
		Vector3.new(platWidth, 1.2, platLength),
		platCF,
		platformColor,
		Enum.Material.WoodPlanks,
		towerFolder
	)

	-- Railings around Platform
	local railHeight = 3.5
	local railThickness = 0.6
	createPart(
		"Railing_North",
		Vector3.new(platWidth, railHeight, railThickness),
		platCF * CFrame.new(0, railHeight / 2, -platLength / 2),
		platformColor,
		Enum.Material.Wood,
		towerFolder
	)
	createPart(
		"Railing_South",
		Vector3.new(platWidth, railHeight, railThickness),
		platCF * CFrame.new(0, railHeight / 2, platLength / 2),
		platformColor,
		Enum.Material.Wood,
		towerFolder
	)
	createPart(
		"Railing_West",
		Vector3.new(railThickness, railHeight, platLength),
		platCF * CFrame.new(-platWidth / 2, railHeight / 2, 0),
		platformColor,
		Enum.Material.Wood,
		towerFolder
	)
	createPart(
		"Railing_East",
		Vector3.new(railThickness, railHeight, platLength),
		platCF * CFrame.new(platWidth / 2, railHeight / 2, 0),
		platformColor,
		Enum.Material.Wood,
		towerFolder
	)

	-- Access Stair Ramp
	local stairLength = 18
	local stairWidth = 5
	createWedge(
		"AccessStairs",
		Vector3.new(stairWidth, towerHeight, stairLength),
		CFrame.new(position + Vector3.new(0, towerHeight / 2, -platLength / 2 - stairLength / 2)),
		platformColor,
		Enum.Material.WoodPlanks,
		towerFolder
	)

	-- Roof Structure
	createPart(
		"RoofCanopy",
		Vector3.new(platWidth + 4, 1.5, platLength + 4),
		platCF * CFrame.new(0, 9, 0),
		roofColor,
		Enum.Material.Wood,
		towerFolder
	)
end

function ForestOutpostMap.BuildMap(parent: Instance?): Folder
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- 1. Outer Perimeter &amp; Terrain Ground
	local terrainFolder = Instance.new("Folder")
	terrainFolder.Name = "Perimeter"
	terrainFolder.Parent = mapFolder

	local grassColor = Color3.fromRGB(60, 110, 45)
	local dirtColor = Color3.fromRGB(95, 70, 45)
	local rockColor = Color3.fromRGB(105, 100, 95)

	-- Main Ground Base
	createPart(
		"ForestFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		grassColor,
		Enum.Material.Grass,
		terrainFolder
	)

	-- Uneven Terrain Mounds &amp; Hills
	createPart(
		"TerrainMound_West",
		Vector3.new(45, 6, 80),
		CFrame.new(-60, 2, 0),
		grassColor,
		Enum.Material.Grass,
		terrainFolder
	)
	createPart(
		"TerrainMound_East",
		Vector3.new(45, 6, 80),
		CFrame.new(60, 2, 0),
		grassColor,
		Enum.Material.Grass,
		terrainFolder
	)
	createPart(
		"CentralGorgeRidge",
		Vector3.new(30, 4, 40),
		CFrame.new(0, 1, 0),
		dirtColor,
		Enum.Material.Ground,
		terrainFolder
	)

	-- Outer Cliff Boundary Walls
	createPart(
		"NorthCliff",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 4),
		CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)
	createPart(
		"SouthCliff",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 4),
		CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)
	createPart(
		"WestCliff",
		Vector3.new(4, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)
	createPart(
		"EastCliff",
		Vector3.new(4, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		rockColor,
		Enum.Material.Slate,
		terrainFolder
	)

	-- 2. Spawns Folder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local redSpawnFolder = Instance.new("Folder")
	redSpawnFolder.Name = "RedSpawn"
	redSpawnFolder.Parent = spawnsFolder

	createPart(
		"RedOutpostBase",
		Vector3.new(40, 1, 26),
		CFrame.new(0, 0.5, -110),
		Color3.fromRGB(150, 40, 40),
		Enum.Material.WoodPlanks,
		redSpawnFolder
	)

	for i, pos in RED_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(230, 80, 80),
			Enum.Material.Neon,
			redSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Red")
		sp:SetAttribute("Index", i)
	end

	local blueSpawnFolder = Instance.new("Folder")
	blueSpawnFolder.Name = "BlueSpawn"
	blueSpawnFolder.Parent = spawnsFolder

	createPart(
		"BlueOutpostBase",
		Vector3.new(40, 1, 26),
		CFrame.new(0, 0.5, 110),
		Color3.fromRGB(40, 90, 160),
		Enum.Material.WoodPlanks,
		blueSpawnFolder
	)

	for i, pos in BLUE_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(80, 140, 230),
			Enum.Material.Neon,
			blueSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Blue")
		sp:SetAttribute("Index", i)
	end

	-- 3. Environment Assets Folder (Trees, Watchtowers, Foliage)
	local envFolder = Instance.new("Folder")
	envFolder.Name = "Environment"
	envFolder.Parent = mapFolder

	-- Trees
	local treePositions = {
		Vector3.new(-70, 0, -90),
		Vector3.new(-35, 0, -75),
		Vector3.new(35, 0, -75),
		Vector3.new(70, 0, -90),
		Vector3.new(-75, 3, -15),
		Vector3.new(-40, 0, 20),
		Vector3.new(40, 0, -20),
		Vector3.new(75, 3, 15),
		Vector3.new(-70, 0, 90),
		Vector3.new(-35, 0, 75),
		Vector3.new(35, 0, 75),
		Vector3.new(70, 0, 90),
	}
	for i, tPos in treePositions do
		buildTree("Tree_" .. i, tPos, 16 + (i % 3) * 3, envFolder)
	end

	-- Watchtowers
	buildWatchtower("Watchtower_Red", Vector3.new(-50, 0, -80), envFolder)
	buildWatchtower("Watchtower_Blue", Vector3.new(50, 0, 80), envFolder)

	-- Fallen Logs &amp; Foliage Patches
	local logColor = Color3.fromRGB(70, 45, 25)
	createPart(
		"FallenLog_1",
		Vector3.new(16, 2.5, 2.5),
		CFrame.new(-25, 1.25, -45) * CFrame.Angles(0, math.rad(35), math.rad(10)),
		logColor,
		Enum.Material.Wood,
		envFolder
	)
	createPart(
		"FallenLog_2",
		Vector3.new(16, 2.5, 2.5),
		CFrame.new(25, 1.25, 45) * CFrame.Angles(0, math.rad(-35), math.rad(-10)),
		logColor,
		Enum.Material.Wood,
		envFolder
	)

	-- Foliage Bushes
	local bushPositions = {
		Vector3.new(-60, 3, -40),
		Vector3.new(-50, 3, -20),
		Vector3.new(60, 3, 40),
		Vector3.new(50, 3, 20),
		Vector3.new(-10, 0.5, 0),
		Vector3.new(10, 0.5, 0),
	}
	for idx, bPos in bushPositions do
		createPart(
			"FoliageBush_" .. idx,
			Vector3.new(5, 4, 5),
			CFrame.new(bPos),
			Color3.fromRGB(45, 115, 40),
			Enum.Material.Leaves,
			envFolder,
			false
		)
	end

	-- 4. Objective Sites Folder
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local siteA = createPart(
		"SiteA",
		Vector3.new(28, 0.4, 28),
		CFrame.new(SITE_A_POSITION),
		Color3.fromRGB(240, 170, 30),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteA.Transparency = 0.5
	siteA:SetAttribute("SiteName", "A")

	local siteB = createPart(
		"SiteB",
		Vector3.new(28, 0.4, 28),
		CFrame.new(SITE_B_POSITION),
		Color3.fromRGB(240, 170, 30),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteB.Transparency = 0.5
	siteB:SetAttribute("SiteName", "B")

	-- 5. Cover &amp; Log Barricades Folder
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	-- Site A Log Barricades
	createPart(
		"LogBarricade_SiteA_1",
		Vector3.new(10, 3.5, 3),
		CFrame.new(-55, 3.5, -35),
		logColor,
		Enum.Material.Wood,
		coverFolder
	)
	createPart(
		"LogBarricade_SiteA_2",
		Vector3.new(8, 3.5, 3),
		CFrame.new(-65, 3.5, -25),
		logColor,
		Enum.Material.Wood,
		coverFolder
	)
	createPart(
		"RockCover_SiteA",
		Vector3.new(7, 6, 7),
		CFrame.new(-45, 3.5, -45),
		rockColor,
		Enum.Material.Slate,
		coverFolder
	)

	-- Site B Log Barricades
	createPart(
		"LogBarricade_SiteB_1",
		Vector3.new(10, 3.5, 3),
		CFrame.new(55, 3.5, 35),
		logColor,
		Enum.Material.Wood,
		coverFolder
	)
	createPart(
		"LogBarricade_SiteB_2",
		Vector3.new(8, 3.5, 3),
		CFrame.new(65, 3.5, 25),
		logColor,
		Enum.Material.Wood,
		coverFolder
	)
	createPart(
		"RockCover_SiteB",
		Vector3.new(7, 6, 7),
		CFrame.new(45, 3.5, 45),
		rockColor,
		Enum.Material.Slate,
		coverFolder
	)

	-- Mid Ridge Chokepoint Rocks &amp; Logs
	createPart(
		"MidGorgeRock_West",
		Vector3.new(8, 7, 8),
		CFrame.new(-20, 3.5, 0),
		rockColor,
		Enum.Material.Slate,
		coverFolder
	)
	createPart(
		"MidGorgeRock_East",
		Vector3.new(8, 7, 8),
		CFrame.new(20, 3.5, 0),
		rockColor,
		Enum.Material.Slate,
		coverFolder
	)
	createPart(
		"LogStack_Mid_North",
		Vector3.new(8, 3.5, 4),
		CFrame.new(0, 3.5, -25),
		logColor,
		Enum.Material.Wood,
		coverFolder
	)
	createPart(
		"LogStack_Mid_South",
		Vector3.new(8, 3.5, 4),
		CFrame.new(0, 3.5, 25),
		logColor,
		Enum.Material.Wood,
		coverFolder
	)

	-- 6. Lanes Folder
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		createPart(
			laneName,
			data.size,
			CFrame.new(data.center),
			Color3.fromRGB(80, 110, 65),
			Enum.Material.SmoothPlastic,
			lanesFolder,
			false
		)
	end

	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder

	return mapFolder
end

function ForestOutpostMap.DestroyMap()
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

function ForestOutpostMap.GetSpawnPoints(teamName: string): { Vector3 }
	if teamName == "Red" then
		return table.clone(RED_SPAWN_POSITIONS)
	elseif teamName == "Blue" then
		return table.clone(BLUE_SPAWN_POSITIONS)
	else
		warn("[ForestOutpostMap] Invalid team name: " .. tostring(teamName))
		return {}
	end
end

function ForestOutpostMap.GetCoverPositions(): { Vector3 }
	return table.clone(COVER_POSITIONS)
end

function ForestOutpostMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_A_POSITION,
		siteB = SITE_B_POSITION,
	}
end

function ForestOutpostMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2)
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2)
	return minBounds, maxBounds
end

function ForestOutpostMap.GetLayoutData(): MapLayoutData
	local minB, maxB = ForestOutpostMap.GetMapBounds()
	return {
		mapId = "ForestOutpost",
		mapName = "Forest Outpost",
		theme = "Forest",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = table.clone(RED_SPAWN_POSITIONS),
		blueSpawns = table.clone(BLUE_SPAWN_POSITIONS),
		sites = ForestOutpostMap.GetSitePositions(),
		coverPositions = table.clone(COVER_POSITIONS),
		lanes = LANES_DATA,
	}
end

return ForestOutpostMap
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">GreyboxArenaMap</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: GreyboxArenaMap
    Rojo-compatible 5v5 greybox arena layout builder module.
    Constructs geometric shapes for lanes, cover positions, spawn areas,
    objective sites, and outer map boundaries for round-based competitive play.
]=]

local Workspace = game:GetService("Workspace")

local GreyboxArenaMap = {}

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type MapLayoutData = {
	mapName: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions,
	coverPositions: { Vector3 },
	lanes: { [string]: { center: Vector3, size: Vector3 } },
}

local MAP_FOLDER_NAME = "GreyboxArenaMap"
local _activeMapFolder: Folder? = nil

-- Map Dimensions Constants
local MAP_WIDTH_X = 160
local MAP_LENGTH_Z = 240
local MAP_HEIGHT_Y = 30

local RED_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-12, 2, -100),
	Vector3.new(-6, 2, -100),
	Vector3.new(0, 2, -100),
	Vector3.new(6, 2, -100),
	Vector3.new(12, 2, -100),
}

local BLUE_SPAWN_POSITIONS: { Vector3 } = {
	Vector3.new(-12, 2, 100),
	Vector3.new(-6, 2, 100),
	Vector3.new(0, 2, 100),
	Vector3.new(6, 2, 100),
	Vector3.new(12, 2, 100),
}

local SITE_A_POSITION = Vector3.new(-50, 1, -40)
local SITE_B_POSITION = Vector3.new(50, 1, 40)

local COVER_POSITIONS: { Vector3 } = {
	-- Site A Cover
	Vector3.new(-50, 4, -40),
	Vector3.new(-60, 2, -30),
	Vector3.new(-40, 2, -50),
	-- Site B Cover
	Vector3.new(50, 5, 40),
	Vector3.new(60, 2, 30),
	Vector3.new(40, 2, 50),
	-- Mid Lane Cover
	Vector3.new(-15, 3, 0),
	Vector3.new(15, 3, 0),
	Vector3.new(0, 2.5, -20),
	Vector3.new(0, 2.5, 20),
	-- Sniper Perches
	Vector3.new(-65, 8, -80),
	Vector3.new(65, 8, 80),
}

local LANES_DATA: { [string]: { center: Vector3, size: Vector3 } } = {
	MainLane = { center = Vector3.new(0, 0.2, 0), size = Vector3.new(24, 0.4, 160) },
	LeftFlank = { center = Vector3.new(-50, 0.2, 0), size = Vector3.new(24, 0.4, 180) },
	RightFlank = { center = Vector3.new(50, 0.2, 0), size = Vector3.new(24, 0.4, 180) },
	ConnectorA = { center = Vector3.new(-25, 0.2, -40), size = Vector3.new(30, 0.4, 16) },
	ConnectorB = { center = Vector3.new(25, 0.2, 40), size = Vector3.new(30, 0.4, 16) },
}

local MAP_OFFSET = Vector3.new(0, 100, 0)

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe + MAP_OFFSET
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createWedge(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance
): WedgePart
	local wedge = Instance.new("WedgePart")
	wedge.Name = name
	wedge.Size = size
	wedge.CFrame = cframe + MAP_OFFSET
	wedge.Color = color
	wedge.Material = material or Enum.Material.SmoothPlastic
	wedge.Anchored = true
	wedge.CanCollide = true
	wedge.TopSurface = Enum.SurfaceType.Smooth
	wedge.BottomSurface = Enum.SurfaceType.Smooth
	wedge.Parent = parent
	return wedge
end

function GreyboxArenaMap.BuildMap(parent: Instance?): Folder
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end

	local targetParent = parent or Workspace
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = MAP_FOLDER_NAME

	-- 1. Outer Perimeter &amp; Floor
	local perimeterFolder = Instance.new("Folder")
	perimeterFolder.Name = "Perimeter"
	perimeterFolder.Parent = mapFolder

	-- Main Floor
	createPart(
		"MainFloor",
		Vector3.new(MAP_WIDTH_X, 2, MAP_LENGTH_Z),
		CFrame.new(0, -1, 0),
		Color3.fromRGB(80, 80, 85),
		Enum.Material.Concrete,
		perimeterFolder
	)

	-- Outer Walls
	createPart(
		"NorthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, -MAP_LENGTH_Z / 2),
		Color3.fromRGB(60, 60, 65),
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"SouthWall",
		Vector3.new(MAP_WIDTH_X, MAP_HEIGHT_Y, 2),
		CFrame.new(0, MAP_HEIGHT_Y / 2, MAP_LENGTH_Z / 2),
		Color3.fromRGB(60, 60, 65),
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"WestWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(-MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		Color3.fromRGB(60, 60, 65),
		Enum.Material.Concrete,
		perimeterFolder
	)
	createPart(
		"EastWall",
		Vector3.new(2, MAP_HEIGHT_Y, MAP_LENGTH_Z),
		CFrame.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y / 2, 0),
		Color3.fromRGB(60, 60, 65),
		Enum.Material.Concrete,
		perimeterFolder
	)

	-- 2. Spawns Folder
	local spawnsFolder = Instance.new("Folder")
	spawnsFolder.Name = "Spawns"
	spawnsFolder.Parent = mapFolder

	local redSpawnFolder = Instance.new("Folder")
	redSpawnFolder.Name = "RedSpawn"
	redSpawnFolder.Parent = spawnsFolder

	createPart(
		"RedPlatform",
		Vector3.new(40, 1, 30),
		CFrame.new(0, 0.5, -100),
		Color3.fromRGB(180, 50, 50),
		Enum.Material.SmoothPlastic,
		redSpawnFolder
	)

	for i, pos in RED_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(220, 80, 80),
			Enum.Material.Neon,
			redSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Red")
		sp:SetAttribute("Index", i)
	end

	local blueSpawnFolder = Instance.new("Folder")
	blueSpawnFolder.Name = "BlueSpawn"
	blueSpawnFolder.Parent = spawnsFolder

	createPart(
		"BluePlatform",
		Vector3.new(40, 1, 30),
		CFrame.new(0, 0.5, 100),
		Color3.fromRGB(50, 100, 180),
		Enum.Material.SmoothPlastic,
		blueSpawnFolder
	)

	for i, pos in BLUE_SPAWN_POSITIONS do
		local sp = createPart(
			"SpawnPoint" .. i,
			Vector3.new(4, 1, 4),
			CFrame.new(pos),
			Color3.fromRGB(80, 140, 220),
			Enum.Material.Neon,
			blueSpawnFolder,
			false
		)
		sp:SetAttribute("Team", "Blue")
		sp:SetAttribute("Index", i)
	end

	-- 3. Lanes Folder
	local lanesFolder = Instance.new("Folder")
	lanesFolder.Name = "Lanes"
	lanesFolder.Parent = mapFolder

	for laneName, data in LANES_DATA do
		createPart(
			laneName,
			data.size,
			CFrame.new(data.center),
			Color3.fromRGB(100, 105, 110),
			Enum.Material.SmoothPlastic,
			lanesFolder,
			false
		)
	end

	-- 4. Sites Folder
	local sitesFolder = Instance.new("Folder")
	sitesFolder.Name = "Sites"
	sitesFolder.Parent = mapFolder

	local siteA = createPart(
		"SiteA",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_A_POSITION),
		Color3.fromRGB(240, 180, 40),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteA.Transparency = 0.5
	siteA:SetAttribute("SiteName", "A")

	local siteB = createPart(
		"SiteB",
		Vector3.new(30, 0.4, 30),
		CFrame.new(SITE_B_POSITION),
		Color3.fromRGB(240, 180, 40),
		Enum.Material.Neon,
		sitesFolder,
		false
	)
	siteB.Transparency = 0.5
	siteB:SetAttribute("SiteName", "B")

	-- 5. Cover &amp; Obstacles Folder
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = mapFolder

	-- Site A Covers
	createPart(
		"HighCover_SiteA",
		Vector3.new(6, 8, 6),
		CFrame.new(Vector3.new(-50, 4, -40)),
		Color3.fromRGB(140, 145, 150),
		Enum.Material.Concrete,
		coverFolder
	)
	createPart(
		"LowCover_SiteA_1",
		Vector3.new(4, 4, 4),
		CFrame.new(Vector3.new(-60, 2, -30)),
		Color3.fromRGB(120, 125, 130),
		Enum.Material.SmoothPlastic,
		coverFolder
	)
	createPart(
		"LowCover_SiteA_2",
		Vector3.new(4, 4, 4),
		CFrame.new(Vector3.new(-40, 2, -50)),
		Color3.fromRGB(120, 125, 130),
		Enum.Material.SmoothPlastic,
		coverFolder
	)

	-- Site B Covers
	createPart(
		"HighCover_SiteB",
		Vector3.new(6, 10, 6),
		CFrame.new(Vector3.new(50, 5, 40)),
		Color3.fromRGB(140, 145, 150),
		Enum.Material.Concrete,
		coverFolder
	)
	createPart(
		"LowCover_SiteB_1",
		Vector3.new(4, 4, 4),
		CFrame.new(Vector3.new(60, 2, 30)),
		Color3.fromRGB(120, 125, 130),
		Enum.Material.SmoothPlastic,
		coverFolder
	)
	createPart(
		"LowCover_SiteB_2",
		Vector3.new(4, 4, 4),
		CFrame.new(Vector3.new(40, 2, 50)),
		Color3.fromRGB(120, 125, 130),
		Enum.Material.SmoothPlastic,
		coverFolder
	)

	-- Mid Lane Covers &amp; Chokepoint Pillars
	createPart(
		"Pillar_Mid_Left",
		Vector3.new(6, 12, 6),
		CFrame.new(Vector3.new(-15, 6, 0)),
		Color3.fromRGB(160, 165, 170),
		Enum.Material.Concrete,
		coverFolder
	)
	createPart(
		"Pillar_Mid_Right",
		Vector3.new(6, 12, 6),
		CFrame.new(Vector3.new(15, 6, 0)),
		Color3.fromRGB(160, 165, 170),
		Enum.Material.Concrete,
		coverFolder
	)
	createPart(
		"LowCover_Mid_1",
		Vector3.new(6, 3.5, 4),
		CFrame.new(Vector3.new(0, 1.75, -20)),
		Color3.fromRGB(120, 125, 130),
		Enum.Material.SmoothPlastic,
		coverFolder
	)
	createPart(
		"LowCover_Mid_2",
		Vector3.new(6, 3.5, 4),
		CFrame.new(Vector3.new(0, 1.75, 20)),
		Color3.fromRGB(120, 125, 130),
		Enum.Material.SmoothPlastic,
		coverFolder
	)

	-- Sniper Perches &amp; Ramps
	createPart(
		"Perch_Red",
		Vector3.new(16, 2, 16),
		CFrame.new(Vector3.new(-65, 8, -80)),
		Color3.fromRGB(170, 175, 180),
		Enum.Material.SmoothPlastic,
		coverFolder
	)
	createWedge(
		"Ramp_Red",
		Vector3.new(8, 8, 12),
		CFrame.new(Vector3.new(-65, 4, -92)),
		Color3.fromRGB(150, 155, 160),
		Enum.Material.Concrete,
		coverFolder
	)

	createPart(
		"Perch_Blue",
		Vector3.new(16, 2, 16),
		CFrame.new(Vector3.new(65, 8, 80)),
		Color3.fromRGB(170, 175, 180),
		Enum.Material.SmoothPlastic,
		coverFolder
	)
	createWedge(
		"Ramp_Blue",
		Vector3.new(8, 8, 12),
		CFrame.new(Vector3.new(65, 4, 92)) * CFrame.Angles(0, math.pi, 0),
		Color3.fromRGB(150, 155, 160),
		Enum.Material.Concrete,
		coverFolder
	)

	mapFolder.Parent = targetParent
	_activeMapFolder = mapFolder

	return mapFolder
end

function GreyboxArenaMap.DestroyMap()
	if _activeMapFolder then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

function GreyboxArenaMap.GetSpawnPoints(teamName: string): { Vector3 }
	local baseSpawns = if teamName == "Red" then RED_SPAWN_POSITIONS elseif teamName == "Blue" then BLUE_SPAWN_POSITIONS else {}
	local results: { Vector3 } = {}
	for _, pos in baseSpawns do
		table.insert(results, pos + MAP_OFFSET)
	end
	return results
end

function GreyboxArenaMap.GetCoverPositions(): { Vector3 }
	local results: { Vector3 } = {}
	for _, pos in COVER_POSITIONS do
		table.insert(results, pos + MAP_OFFSET)
	end
	return results
end

function GreyboxArenaMap.GetSitePositions(): SitePositions
	return {
		siteA = SITE_A_POSITION + MAP_OFFSET,
		siteB = SITE_B_POSITION + MAP_OFFSET,
	}
end

function GreyboxArenaMap.GetMapBounds(): (Vector3, Vector3)
	local minBounds = Vector3.new(-MAP_WIDTH_X / 2, 0, -MAP_LENGTH_Z / 2) + MAP_OFFSET
	local maxBounds = Vector3.new(MAP_WIDTH_X / 2, MAP_HEIGHT_Y, MAP_LENGTH_Z / 2) + MAP_OFFSET
	return minBounds, maxBounds
end

function GreyboxArenaMap.GetLayoutData(): MapLayoutData
	local minB, maxB = GreyboxArenaMap.GetMapBounds()
	local mappedLanes = {}
	for laneName, data in LANES_DATA do
		mappedLanes[laneName] = {
			center = data.center + MAP_OFFSET,
			size = data.size
		}
	end

	return {
		mapName = "Greybox_Arena_5v5",
		bounds = {
			min = minB,
			max = maxB,
		},
		redSpawns = GreyboxArenaMap.GetSpawnPoints("Red"),
		blueSpawns = GreyboxArenaMap.GetSpawnPoints("Blue"),
		sites = GreyboxArenaMap.GetSitePositions(),
		coverPositions = GreyboxArenaMap.GetCoverPositions(),
		lanes = mappedLanes,
	}
end

return GreyboxArenaMap
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">GreyboxArenaMap.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for GreyboxArenaMap
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GreyboxArenaMap = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("GreyboxArenaMap"))

local function runTests()
	-- 1. Test Map Building
	local mapFolder = GreyboxArenaMap.BuildMap(Workspace)
	assert(mapFolder ~= nil, "BuildMap must return folder instance")
	assert(mapFolder.Name == "GreyboxArenaMap", "Map folder name mismatch")
	assert(mapFolder.Parent == Workspace, "Map folder parent mismatch")

	-- 2. Test Structure Hierarchy
	local spawns = mapFolder:FindFirstChild("Spawns")
	assert(spawns ~= nil, "Spawns folder missing")

	local redSpawn = spawns and spawns:FindFirstChild("RedSpawn")
	assert(redSpawn ~= nil, "RedSpawn folder missing")

	local blueSpawn = spawns and spawns:FindFirstChild("BlueSpawn")
	assert(blueSpawn ~= nil, "BlueSpawn folder missing")

	local sites = mapFolder:FindFirstChild("Sites")
	assert(sites ~= nil, "Sites folder missing")
	assert(sites and sites:FindFirstChild("SiteA") ~= nil, "SiteA missing")
	assert(sites and sites:FindFirstChild("SiteB") ~= nil, "SiteB missing")

	-- 3. Test Spawn &amp; Cover API
	local redSpawnPoints = GreyboxArenaMap.GetSpawnPoints("Red")
	assert(#redSpawnPoints == 5, "Red team spawn points count should be 5")

	local blueSpawnPoints = GreyboxArenaMap.GetSpawnPoints("Blue")
	assert(#blueSpawnPoints == 5, "Blue team spawn points count should be 5")

	local coverPositions = GreyboxArenaMap.GetCoverPositions()
	assert(#coverPositions &gt;= 10, "Expected at least 10 cover positions")

	-- 4. Test Layout Data &amp; Bounds
	local layoutData = GreyboxArenaMap.GetLayoutData()
	assert(layoutData.mapName == "Greybox_Arena_5v5", "Map name mismatch")
	assert(layoutData.bounds.min.X == -80, "Min bound X mismatch")
	assert(layoutData.bounds.max.X == 80, "Max bound X mismatch")

	-- 5. Test Map Destruction
	GreyboxArenaMap.DestroyMap()
	assert(mapFolder.Parent == nil, "Map folder should be destroyed")

	print("[GreyboxArenaMap.spec] All tests passed!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">LobbyFolder</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v3: LobbyFolder (Legendary Edition)
    Generates a full professional Roblox lobby:
    Environment, Geometry, SpawnLocations, InteractiveTriggers,
    Props, FX, Lighting — all runtime-built, cleanly managed.
]=]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LobbyFolder = {}

export type LobbyLayoutData = {
	lobbyName: string,
	boundsMin: Vector3,
	boundsMax: Vector3,
	spawnPositions: { Vector3 },
	triggers: { [string]: Vector3 },
}

local LOBBY_FOLDER_NAME = "LobbyFolder"
local activeLobbyFolder: Folder? = nil
local activeTweens: { Tween } = {}

-- Layout constants — MASSIVE lobby (production, 1000-player optimized)
local LOBBY_CENTER = Vector3.new(0, 100, 0)
local LOBBY_SIZE = Vector3.new(380, 40, 380)

local C = {
	BG_DARK = Color3.fromRGB(18, 20, 28),
	FLOOR = Color3.fromRGB(28, 32, 44),
	TRIM = Color3.fromRGB(48, 54, 70),
	NEON_BLUE = Color3.fromRGB(0, 170, 255),
	NEON_CYAN = Color3.fromRGB(0, 230, 255),
	NEON_PURP = Color3.fromRGB(140, 80, 255),
	GOLD = Color3.fromRGB(255, 200, 60),
	WHITE = Color3.fromRGB(220, 240, 255),
}

local SPAWN_POSITIONS: { Vector3 } = {
	LOBBY_CENTER + Vector3.new(-75, 1.5, -75),
	LOBBY_CENTER + Vector3.new(75, 1.5, -75),
	LOBBY_CENTER + Vector3.new(-75, 1.5, 75),
	LOBBY_CENTER + Vector3.new(75, 1.5, 75),
	LOBBY_CENTER + Vector3.new(0, 1.5, -85),
	LOBBY_CENTER + Vector3.new(0, 1.5, 85),
	LOBBY_CENTER + Vector3.new(-45, 1.5, -85),
	LOBBY_CENTER + Vector3.new(45, 1.5, -85),
	LOBBY_CENTER + Vector3.new(-85, 1.5, 0),
	LOBBY_CENTER + Vector3.new(85, 1.5, 0),
	LOBBY_CENTER + Vector3.new(-45, 1.5, 85),
	LOBBY_CENTER + Vector3.new(45, 1.5, 85),
}

local TRIGGER_DATA = {
	Play = {
		position = LOBBY_CENTER + Vector3.new(0, 2, -35),
		actionText = "PLAY",
		objectText = "Matchmaking Arena",
		promptText = "Enter Queue / Start Match",
		accent = C.NEON_CYAN,
	},
	Challenge = {
		position = LOBBY_CENTER + Vector3.new(-35, 2, 0),
		actionText = "1v1 CHALLENGE",
		objectText = "Duels Pavilion",
		promptText = "Initiate 1v1 Challenge",
		accent = C.NEON_PURP,
	},
	Loadout = {
		position = LOBBY_CENTER + Vector3.new(35, 2, 0),
		actionText = "LOADOUT",
		objectText = "Armory Inspector",
		promptText = "Inspect &amp; Customize Weapons",
		accent = C.GOLD,
	},
	Settings = {
		position = LOBBY_CENTER + Vector3.new(0, 2, 35),
		actionText = "SETTINGS",
		objectText = "System Terminal",
		promptText = "Configure Audio &amp; Gameplay",
		accent = C.NEON_BLUE,
	},
}

local function createPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	parent: Instance,
	canCollide: boolean?,
	transparency: number?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = if canCollide ~= nil then canCollide else true
	part.Transparency = transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CastShadow = (transparency or 0) == 0
	part.Parent = parent
	return part
end

local function addPointLight(parent: Instance, color: Color3, range: number, brightness: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Parent = parent
end

local function addSparkles(parent: Instance, color: Color3)
	local s = Instance.new("Sparkles")
	s.SparkleColor = color
	s.Parent = parent
end

local function createBeam(parent: Part, a0: Attachment, a1: Attachment, color: Color3, width: number)
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color)
	beam.Width0 = width
	beam.Width1 = width
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Parent = parent
end

local function makeBillboard(
	parent: Instance,
	name: string,
	text: string,
	color: Color3,
	size: UDim2,
	offset: Vector3,
	textSize: number
)
	local bb = Instance.new("BillboardGui")
	bb.Name = name
	bb.Size = size
	bb.StudsOffset = offset
	bb.AlwaysOnTop = true
	bb.MaxDistance = 60
	bb.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.Font = Enum.Font.GothamBlack
	label.TextSize = textSize
	label.Text = text
	label.TextStrokeTransparency = 0.6
	label.Parent = bb
end

local function createPortalArch(parent: Instance, name: string, center: CFrame, accent: Color3)
	local arch = Instance.new("Model")
	arch.Name = name .. "Portal"

	local h, w, t = 12, 10, 1.5
	local left = createPart(
		"ArchLeft",
		Vector3.new(t, h, t),
		center * CFrame.new(-w / 2, h / 2, 0),
		C.TRIM,
		Enum.Material.Metal,
		arch,
		true
	)
	local right = createPart(
		"ArchRight",
		Vector3.new(t, h, t),
		center * CFrame.new(w / 2, h / 2, 0),
		C.TRIM,
		Enum.Material.Metal,
		arch,
		true
	)
	local top = createPart(
		"ArchTop",
		Vector3.new(w + t, t, t),
		center * CFrame.new(0, h + t / 2, 0),
		C.TRIM,
		Enum.Material.Metal,
		arch,
		true
	)

	-- Neon accent strips on the arch
	for _, strip in
		{
			{ "StripL", center * CFrame.new(-w / 2, h / 2, 0.8), Vector3.new(0.4, h, 0.4) },
			{ "StripR", center * CFrame.new(w / 2, h / 2, 0.8), Vector3.new(0.4, h, 0.4) },
			{ "StripT", center * CFrame.new(0, h + t / 2, 0.8), Vector3.new(w, 0.4, 0.4) },
		}
	do
		createPart(
			strip[1] :: string,
			strip[3] :: Vector3,
			strip[2] :: CFrame,
			accent,
			Enum.Material.Neon,
			arch,
			false,
			0.1
		)
	end

	-- Hologram panel inside the arch (semi-transparent, spins via tween)
	local holo = createPart(
		"Hologram",
		Vector3.new(w - 2, h - 1, 0.1),
		center * CFrame.new(0, h / 2, 0),
		accent,
		Enum.Material.ForceField,
		arch,
		false,
		0.65
	)
	holo.CastShadow = false

	arch.Parent = parent
	return arch, holo
end

local function cleanup()
	for _, t in activeTweens do
		t:Cancel()
	end
	table.clear(activeTweens)
	if activeLobbyFolder then
		activeLobbyFolder:Destroy()
		activeLobbyFolder = nil
	end
end

function LobbyFolder.BuildLobby(parent: Instance?): Folder
	cleanup()
	local targetParent = parent or Workspace

	local folder = Instance.new("Folder")
	folder.Name = LOBBY_FOLDER_NAME

	----------------------------------------------------------------
	-- 1. Environment (atmosphere + sky handled via attributes)
	----------------------------------------------------------------
	local env = Instance.new("Folder")
	env.Name = "Environment"
	env.Parent = folder

	-- LobbyBounds (invisible forcefield box)
	local boundsPart = createPart(
		"BoundingBox",
		LOBBY_SIZE,
		CFrame.new(LOBBY_CENTER + Vector3.new(0, LOBBY_SIZE.Y / 2, 0)),
		C.NEON_BLUE,
		Enum.Material.ForceField,
		env,
		false,
		1
	)
	boundsPart.CastShadow = false

	-- Massive foundation + invisible safety walls (production: 600×600 for massive lobby)
	local foundation = createPart(
		"Foundation",
		Vector3.new(600, 4, 600),
		CFrame.new(LOBBY_CENTER - Vector3.new(0, 2, 0)),
		C.BG_DARK,
		Enum.Material.Slate,
		env,
		true
	)
	foundation.CastShadow = false
	-- Grass terrain ring (free model technique: use Material=Grass + Terrain for 1000-player streaming)
	pcall(function()
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			-- Clear old and fill grass apron outside the 260 floor (visual, not physics heavy)
			local region = Region3.new(LOBBY_CENTER - Vector3.new(300, 0, 300), LOBBY_CENTER + Vector3.new(300, 6, 300))
			terrain:FillRegion(region:ExpandToGrid(4), 4, Enum.Material.Grass)
			-- Carve out the lobby floor area back to air so floor part shows
			local inner = Region3.new(LOBBY_CENTER - Vector3.new(135, 0, 135), LOBBY_CENTER + Vector3.new(135, 6, 135))
			terrain:FillRegion(inner:ExpandToGrid(4), 4, Enum.Material.Air)
		end
	end)
	-- Skybox (free sky: Blue Sky — asset 243135001 style recreation via procedural Color + Atmosphere if no Sky object)
	pcall(function()
		if not Lighting:FindFirstChild("LobbySky") then
			local sky = Instance.new("Sky")
			sky.Name = "LobbySky"
			sky.SkyboxBk = "rbxassetid://243135001"
			sky.SkyboxDn = "rbxassetid://243135002"
			sky.SkyboxFt = "rbxassetid://243135003"
			sky.SkyboxLf = "rbxassetid://243135004"
			sky.SkyboxRt = "rbxassetid://243135005"
			sky.SkyboxUp = "rbxassetid://243135006"
			sky.StarCount = 2500
			sky.SunAngularSize = 12
			sky.SunTextureId = "rbxassetid://1084358844"
			sky.Parent = Lighting
		end
		Lighting.Ambient = Color3.fromRGB(100, 105, 120)
		Lighting.OutdoorAmbient = Color3.fromRGB(40, 45, 65)
		Lighting.FogEnd = 1800
		Lighting.FogColor = Color3.fromRGB(35, 42, 58)
		Lighting.Brightness = 2.5
		Lighting.ExposureCompensation = 0.1
		-- Remove placeholder fake values
		Lighting.ClockTime = 14.5
	end)

	for _, w in
		{
			{ "WallNorth", Vector3.new(600, 60, 4), CFrame.new(0, 130, -290) },
			{ "WallSouth", Vector3.new(600, 60, 4), CFrame.new(0, 130, 290) },
			{ "WallEast", Vector3.new(4, 60, 600), CFrame.new(290, 130, 0) },
			{ "WallWest", Vector3.new(4, 60, 600), CFrame.new(-290, 130, 0) },
		}
	do
		local wall = createPart(
			w[1] :: string,
			w[2] :: Vector3,
			w[3] :: CFrame + Vector3.new(0, LOBBY_CENTER.Y - 100, 0),
			Color3.new(),
			Enum.Material.SmoothPlastic,
			env,
			true,
			1
		)
		wall.CanQuery = false
		wall.CanTouch = false
	end

	----------------------------------------------------------------
	-- 2. Geometry (floor, walls, towers, ceiling)
	----------------------------------------------------------------
	local geo = Instance.new("Folder")
	geo.Name = "Geometry"
	geo.Parent = folder

	-- Main lobby floor — MASSIVE 260×260 marble + outer apron (production)
	createPart(
		"LobbyFloor",
		Vector3.new(260, 2, 260),
		CFrame.new(LOBBY_CENTER),
		C.FLOOR,
		Enum.Material.Marble,
		geo,
		true
	)
	createPart(
		"LobbyFloorEdge",
		Vector3.new(264, 0.5, 264),
		CFrame.new(LOBBY_CENTER - Vector3.new(0, 0.8, 0)),
		C.TRIM,
		Enum.Material.Metal,
		geo,
		true
	)
	createPart(
		"OuterApron",
		Vector3.new(380, 1, 380),
		CFrame.new(LOBBY_CENTER - Vector3.new(0, 1.4, 0)),
		C.BG_DARK,
		Enum.Material.Concrete,
		geo,
		true
	)
	-- Optimized: no shadow on giant floor for 1000 players
	for _, p in geo:GetChildren() do
		if p:IsA("BasePart") then
			p.CastShadow = false
		end
	end

	-- Floor grid neon inlays
	createPart(
		"GridNS",
		Vector3.new(1.5, 2.05, 100),
		CFrame.new(LOBBY_CENTER),
		C.NEON_BLUE,
		Enum.Material.Neon,
		geo,
		false,
		0.2
	)
	createPart(
		"GridEW",
		Vector3.new(100, 2.05, 1.5),
		CFrame.new(LOBBY_CENTER),
		C.NEON_BLUE,
		Enum.Material.Neon,
		geo,
		false,
		0.2
	)

	-- Neon edge trim
	local half = 50
	for _, e in
		{
			{ "EdgeN", Vector3.new(100, 0.3, 1.2), Vector3.new(0, 1.15, -half) },
			{ "EdgeS", Vector3.new(100, 0.3, 1.2), Vector3.new(0, 1.15, half) },
			{ "EdgeE", Vector3.new(1.2, 0.3, 100), Vector3.new(half, 1.15, 0) },
			{ "EdgeW", Vector3.new(1.2, 0.3, 100), Vector3.new(-half, 1.15, 0) },
		}
	do
		createPart(
			e[1] :: string,
			e[2] :: Vector3,
			CFrame.new(LOBBY_CENTER + e[3] :: Vector3),
			C.NEON_CYAN,
			Enum.Material.Neon,
			geo,
			false,
			0.1
		)
	end

	-- Glass perimeter walls — MASSIVE 260 offset
	local wallH, wallOff = 18, 128
	for _, g in
		{
			{ "GlassN", Vector3.new(260, wallH, 1), Vector3.new(0, wallH / 2, -wallOff) },
			{ "GlassS", Vector3.new(260, wallH, 1), Vector3.new(0, wallH / 2, wallOff) },
			{ "GlassE", Vector3.new(1, wallH, 260), Vector3.new(wallOff, wallH / 2, 0) },
			{ "GlassW", Vector3.new(1, wallH, 260), Vector3.new(-wallOff, wallH / 2, 0) },
		}
	do
		local wall = createPart(
			g[1] :: string,
			g[2] :: Vector3,
			CFrame.new(LOBBY_CENTER + g[3] :: Vector3),
			Color3.fromRGB(120, 190, 245),
			Enum.Material.Glass,
			geo,
			true,
			0.65
		)
		wall.CanQuery = false
	end

	-- Corner towers with lights
	for i, off in
		{
			Vector3.new(-46, 9, -46),
			Vector3.new(46, 9, -46),
			Vector3.new(-46, 9, 46),
			Vector3.new(46, 9, 46),
		}
	do
		local tower = createPart(
			"Tower_" .. i,
			Vector3.new(5, 18, 5),
			CFrame.new(LOBBY_CENTER + off),
			C.TRIM,
			Enum.Material.Metal,
			geo,
			true
		)
		createPart(
			"TowerCap_" .. i,
			Vector3.new(6, 1, 6),
			CFrame.new(LOBBY_CENTER + off + Vector3.new(0, 9.5, 0)),
			C.NEON_PURP,
			Enum.Material.Neon,
			geo,
			false,
			0.1
		)
		addPointLight(tower, C.NEON_BLUE, 30, 2)
	end

	-- Ceiling ring + spotlight
	local ringPart = createPart(
		"CeilingRing",
		Vector3.new(30, 1, 30),
		CFrame.new(LOBBY_CENTER + Vector3.new(0, 24, 0)),
		C.NEON_CYAN,
		Enum.Material.Neon,
		geo,
		false,
		0.2
	)
	ringPart.Shape = Enum.PartType.Cylinder
	ringPart.CFrame = CFrame.new(LOBBY_CENTER + Vector3.new(0, 24, 0)) * CFrame.Angles(0, 0, math.rad(90))

	local spot = Instance.new("SpotLight")
	spot.Color = C.WHITE
	spot.Range = 60
	spot.Brightness = 5
	spot.Angle = 100
	spot.Face = Enum.NormalId.Bottom
	spot.Parent = ringPart

	----------------------------------------------------------------
	-- 3. SpawnLocations (pedestals + neon rings + team color)
	----------------------------------------------------------------
	local spawns = Instance.new("Folder")
	spawns.Name = "SpawnLocations"
	spawns.Parent = folder

	for i, pos in SPAWN_POSITIONS do
		createPart(
			"Pedestal_" .. i,
			Vector3.new(6, 1, 6),
			CFrame.new(pos - Vector3.new(0, 0.5, 0)),
			C.TRIM,
			Enum.Material.Metal,
			spawns,
			true
		)
		createPart(
			"PedestalRing_" .. i,
			Vector3.new(6.6, 0.2, 6.6),
			CFrame.new(pos - Vector3.new(0, 0.9, 0)),
			C.NEON_CYAN,
			Enum.Material.Neon,
			spawns,
			false,
			0.2
		)

		local spawnLoc = Instance.new("SpawnLocation")
		spawnLoc.Name = "LobbySpawn_" .. i
		spawnLoc.Size = Vector3.new(4, 0.4, 4)
		spawnLoc.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
		spawnLoc.Anchored = true
		spawnLoc.Neutral = true
		spawnLoc.AllowTeamChangeOnTouch = false
		spawnLoc.TeamColor = BrickColor.new("Medium royal blue")
		spawnLoc.Color = C.FLOOR
		spawnLoc.Material = Enum.Material.SmoothPlastic
		spawnLoc.TopSurface = Enum.SurfaceType.Smooth
		spawnLoc.BottomSurface = Enum.SurfaceType.Smooth
		spawnLoc:SetAttribute("LobbySpawnIndex", i)
		spawnLoc.Duration = 0
		spawnLoc.Parent = spawns
	end

	----------------------------------------------------------------
	-- 4. InteractiveTriggers (portal arches + prompts + holos)
	----------------------------------------------------------------
	local triggers = Instance.new("Folder")
	triggers.Name = "InteractiveTriggers"
	triggers.Parent = folder

	local holograms: { Part } = {}

	for key, data in TRIGGER_DATA do
		local pad = createPart(
			key .. "TriggerPart",
			Vector3.new(9, 0.6, 9),
			CFrame.new(data.position),
			C.BG_DARK,
			Enum.Material.Metal,
			triggers,
			true
		)
		createPart(
			key .. "GlowRing",
			Vector3.new(9.6, 0.2, 9.6),
			CFrame.new(data.position - Vector3.new(0, 0.2, 0)),
			data.accent,
			Enum.Material.Neon,
			triggers,
			false,
			0.25
		)

		-- Portal arch facing the lobby center
		local facing = CFrame.lookAt(
			data.position + Vector3.new(0, 0.5, 0),
			Vector3.new(LOBBY_CENTER.X, data.position.Y + 0.5, LOBBY_CENTER.Z)
		)
		local _, holo = createPortalArch(triggers, key, facing, data.accent)
		table.insert(holograms, holo)

		addPointLight(pad, data.accent, 18, 1.5)

		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = key .. "Prompt"
		prompt.ActionText = data.promptText
		prompt.ObjectText = data.objectText
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("TriggerType", key)
		prompt.Parent = pad

		makeBillboard(
			pad,
			key .. "Billboard",
			"[ " .. data.actionText .. " ]",
			data.accent,
			UDim2.new(0, 260, 0, 60),
			Vector3.new(0, 13.5, 0),
			24
		)
	end

	----------------------------------------------------------------
	-- 5. Props (center monument, floating logo, decor)
	----------------------------------------------------------------
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = folder

	createPart(
		"CenterPedestal",
		Vector3.new(14, 1.4, 14),
		CFrame.new(LOBBY_CENTER + Vector3.new(0, 1.7, 0)),
		C.TRIM,
		Enum.Material.Metal,
		props,
		true
	)
	local glow = createPart(
		"CenterGlow",
		Vector3.new(12, 1.45, 12),
		CFrame.new(LOBBY_CENTER + Vector3.new(0, 1.7, 0)),
		C.NEON_CYAN,
		Enum.Material.Neon,
		props,
		false,
		0.45
	)

	-- Rotating centerpiece crystal
	local crystal = createPart(
		"CenterCrystal",
		Vector3.new(3, 6, 3),
		CFrame.new(LOBBY_CENTER + Vector3.new(0, 7, 0)),
		C.NEON_PURP,
		Enum.Material.Neon,
		props,
		false,
		0.15
	)
	crystal.CastShadow = false
	addSparkles(crystal, C.NEON_CYAN)
	addPointLight(crystal, C.NEON_PURP, 24, 3)

	-- Spin tween (looped)
	local spin = TweenService:Create(
		crystal,
		TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
		{ CFrame = crystal.CFrame * CFrame.Angles(0, math.rad(360), 0) }
	)
	spin:Play()
	table.insert(activeTweens, spin)

	makeBillboard(
		crystal,
		"LogoBillboard",
		"⬡ OVERCLOCK ⬡",
		C.WHITE,
		UDim2.new(0, 400, 0, 80),
		Vector3.new(0, 5, 0),
		36
	)

	-- Light beams from crystal to ceiling ring
	local a0 = Instance.new("Attachment")
	a0.Parent = crystal
	local a1 = Instance.new("Attachment")
	a1.Parent = ringPart
	createBeam(crystal, a0, a1, C.NEON_CYAN, 0.6)

	-- Banner poles along N/S edges
	for i, p in
		{
			Vector3.new(-30, 6, -47),
			Vector3.new(30, 6, -47),
			Vector3.new(-30, 6, 47),
			Vector3.new(30, 6, 47),
		}
	do
		local pole = createPart(
			"BannerPole_" .. i,
			Vector3.new(0.8, 12, 0.8),
			CFrame.new(LOBBY_CENTER + p),
			C.TRIM,
			Enum.Material.Metal,
			props,
			true
		)
		createPart(
			"BannerFlag_" .. i,
			Vector3.new(4, 6, 0.2),
			CFrame.new(LOBBY_CENTER + p + Vector3.new(2.4, 3, 0)),
			C.NEON_BLUE,
			Enum.Material.Fabric,
			props,
			false,
			0.1
		)
		addPointLight(pole, C.NEON_BLUE, 15, 1)
	end

	-- FREE 3D models: benches (6), lampposts, grass tufts, trash cans — massive lobby decor (streaming-friendly)
	for i, bPos in
		{
			Vector3.new(-90, 1, -90),
			Vector3.new(90, 1, -90),
			Vector3.new(-90, 1, 90),
			Vector3.new(90, 1, 90),
			Vector3.new(0, 1, -110),
			Vector3.new(0, 1, 110),
		}
	do
		local benchBase = createPart(
			"Bench_Base_" .. i,
			Vector3.new(10, 1.2, 3),
			CFrame.new(LOBBY_CENTER + bPos),
			Color3.fromRGB(55, 38, 22),
			Enum.Material.Wood,
			props,
			true
		)
		benchBase.CastShadow = false
		createPart(
			"Bench_Back_" .. i,
			Vector3.new(10, 3, 0.6),
			CFrame.new(LOBBY_CENTER + bPos + Vector3.new(0, 1.6, -1.1)),
			Color3.fromRGB(72, 50, 30),
			Enum.Material.Wood,
			props,
			true
		).CastShadow =
			false
		-- Metal legs
		createPart(
			"Bench_LegL_" .. i,
			Vector3.new(0.6, 2, 2.8),
			CFrame.new(LOBBY_CENTER + bPos + Vector3.new(-4, -0.4, 0)),
			C.TRIM,
			Enum.Material.Metal,
			props,
			true
		).CastShadow =
			false
		createPart(
			"Bench_LegR_" .. i,
			Vector3.new(0.6, 2, 2.8),
			CFrame.new(LOBBY_CENTER + bPos + Vector3.new(4, -0.4, 0)),
			C.TRIM,
			Enum.Material.Metal,
			props,
			true
		).CastShadow =
			false
		-- Seat prompt (cosmetic)
		local seat = Instance.new("Seat")
		seat.Name = "BenchSeat_" .. i
		seat.Size = Vector3.new(8, 1, 2.5)
		seat.CFrame = CFrame.new(LOBBY_CENTER + bPos + Vector3.new(0, 0.8, 0))
		seat.Anchored = true
		seat.CanCollide = false
		seat.Transparency = 1
		seat.Parent = props
	end
	-- Grass tufts (16) around outer apron — free model look
	for i = 1, 16 do
		local ang = (i / 16) * math.pi * 2
		local rad = 145 + (i % 2) * 8
		local pos = LOBBY_CENTER + Vector3.new(math.cos(ang) * rad, 0.5, math.sin(ang) * rad)
		local tuft = createPart(
			"GrassTuft_" .. i,
			Vector3.new(2, 1.5, 2),
			CFrame.new(pos),
			Color3.fromRGB(45, 135, 45),
			Enum.Material.Grass,
			props,
			false,
			0.2
		)
		tuft.CastShadow = false
		tuft.CanQuery = false
	end
	-- Lampposts (8) for night sky vibe
	for i, lPos in
		{
			Vector3.new(-120, 6, 0),
			Vector3.new(120, 6, 0),
			Vector3.new(0, 6, -120),
			Vector3.new(0, 6, 120),
			Vector3.new(-85, 6, -85),
			Vector3.new(85, 6, -85),
			Vector3.new(-85, 6, 85),
			Vector3.new(85, 6, 85),
		}
	do
		local post = createPart(
			"LampPost_" .. i,
			Vector3.new(0.7, 12, 0.7),
			CFrame.new(LOBBY_CENTER + lPos),
			C.TRIM,
			Enum.Material.Metal,
			props,
			true
		)
		post.CastShadow = false
		local head = createPart(
			"LampHead_" .. i,
			Vector3.new(2, 1, 2),
			CFrame.new(LOBBY_CENTER + lPos + Vector3.new(0, 6.5, 0)),
			Color3.fromRGB(255, 240, 180),
			Enum.Material.Neon,
			props,
			false,
			0.2
		)
		addPointLight(head, Color3.fromRGB(255, 230, 150), 35, 2)
		head.CastShadow = false
	end

	----------------------------------------------------------------
	-- 6. FX folder (particle emitters container + config)
	----------------------------------------------------------------
	local fx = Instance.new("Folder")
	fx.Name = "FX"
	fx.Parent = folder

	-- Ambient dust particles rising from the center
	local emitterPart = createPart(
		"AmbientEmitter",
		Vector3.new(1, 1, 1),
		CFrame.new(LOBBY_CENTER + Vector3.new(0, 2, 0)),
		C.WHITE,
		Enum.Material.SmoothPlastic,
		fx,
		false,
		1
	)
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(C.NEON_CYAN)
	pe.Size = NumberSequence.new(0.3, 0)
	pe.Transparency = NumberSequence.new(0.4, 1)
	pe.Lifetime = NumberRange.new(3, 5)
	pe.Rate = 12
	pe.Speed = NumberRange.new(2, 4)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = emitterPart

	----------------------------------------------------------------
	-- 7. Lighting config (apply polished mood)
	----------------------------------------------------------------
	folder:SetAttribute("Ambient", "70,75,95")
	folder:SetAttribute("OutdoorAmbient", "20,22,35")
	folder:SetAttribute("ClockTime", 18.5)
	folder:SetAttribute("FogEnd", 600)
	folder:SetAttribute("FogColor", "18,20,30")

	folder.Parent = targetParent
	activeLobbyFolder = folder
	return folder
end

function LobbyFolder.GetLobbyFolder(): Folder?
	return activeLobbyFolder
end

function LobbyFolder.DestroyLobby()
	cleanup()
end

function LobbyFolder.GetSpawnLocations(): { SpawnLocation }
	local result: { SpawnLocation } = {}
	local spawns = activeLobbyFolder and activeLobbyFolder:FindFirstChild("SpawnLocations")
	if spawns then
		for _, child in spawns:GetChildren() do
			if child:IsA("SpawnLocation") then
				table.insert(result, child)
			end
		end
	end
	return result
end

function LobbyFolder.GetInteractiveTriggers(): { [string]: BasePart }
	local result: { [string]: BasePart } = {}
	local trigFolder = activeLobbyFolder and activeLobbyFolder:FindFirstChild("InteractiveTriggers")
	if trigFolder then
		for _, child in trigFolder:GetChildren() do
			if child:IsA("BasePart") and string.find(child.Name, "TriggerPart") then
				result[string.gsub(child.Name, "TriggerPart", "")] = child
			end
		end
	end
	return result
end

function LobbyFolder.GetLobbyBounds(): (Vector3, Vector3)
	return LOBBY_CENTER - LOBBY_SIZE / 2, LOBBY_CENTER + LOBBY_SIZE / 2
end

function LobbyFolder.GetLayoutData(): LobbyLayoutData
	local minB, maxB = LobbyFolder.GetLobbyBounds()
	local triggerPosMap: { [string]: Vector3 } = {}
	for k, v in TRIGGER_DATA do
		triggerPosMap[k] = v.position
	end
	return {
		lobbyName = "MainLobby_Paradigm",
		boundsMin = minB,
		boundsMax = maxB,
		spawnPositions = table.clone(SPAWN_POSITIONS),
		triggers = triggerPosMap,
	}
end

return LobbyFolder
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">LobbyFolder.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for LobbyFolder
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LobbyFolder = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("LobbyFolder") :: any)

local function runTests()
	-- 1. Test Lobby Building
	local folder = LobbyFolder.BuildLobby(Workspace)
	assert(folder ~= nil, "BuildLobby must return folder instance")
	assert(folder.Name == "LobbyFolder", "Lobby folder name mismatch")
	assert(folder.Parent == Workspace, "Lobby folder parent mismatch")

	-- 2. Test Structure Hierarchy
	local boundsFolder = folder:FindFirstChild("LobbyBounds")
	assert(boundsFolder ~= nil, "LobbyBounds folder missing")
	assert(boundsFolder:FindFirstChild("BoundingBox") ~= nil, "BoundingBox missing")

	local spawnsFolder = folder:FindFirstChild("SpawnLocations")
	assert(spawnsFolder ~= nil, "SpawnLocations folder missing")

	local triggersFolder = folder:FindFirstChild("InteractiveTriggers")
	assert(triggersFolder ~= nil, "InteractiveTriggers folder missing")
	assert(triggersFolder:FindFirstChild("PlayTriggerPart") ~= nil, "PlayTriggerPart missing")
	assert(triggersFolder:FindFirstChild("ChallengeTriggerPart") ~= nil, "ChallengeTriggerPart missing")
	assert(triggersFolder:FindFirstChild("LoadoutTriggerPart") ~= nil, "LoadoutTriggerPart missing")
	assert(triggersFolder:FindFirstChild("SettingsTriggerPart") ~= nil, "SettingsTriggerPart missing")

	local geometryFolder = folder:FindFirstChild("Geometry")
	assert(geometryFolder ~= nil, "Geometry folder missing")
	assert(geometryFolder:FindFirstChild("LobbyFloor") ~= nil, "LobbyFloor missing")

	-- 3. Test Getter API
	local spawns = LobbyFolder.GetSpawnLocations()
	assert(#spawns == 6, "Expected 6 spawn locations")

	local triggers = LobbyFolder.GetInteractiveTriggers()
	assert(triggers["Play"] ~= nil, "Play trigger missing in getter map")
	assert(triggers["Challenge"] ~= nil, "Challenge trigger missing in getter map")
	assert(triggers["Loadout"] ~= nil, "Loadout trigger missing in getter map")
	assert(triggers["Settings"] ~= nil, "Settings trigger missing in getter map")

	local minB, maxB = LobbyFolder.GetLobbyBounds()
	assert(maxB.X - minB.X == 120, "Lobby width X should be 120")
	assert(maxB.Z - minB.Z == 120, "Lobby length Z should be 120")

	local layoutData = LobbyFolder.GetLayoutData()
	assert(layoutData.lobbyName == "MainLobby_Paradigm", "Lobby name mismatch")
	assert(#layoutData.spawnPositions == 6, "Layout data spawn count mismatch")

	-- 4. Test Lobby Destruction
	LobbyFolder.DestroyLobby()
	assert(folder.Parent == nil, "Lobby folder should be destroyed")

	print("[LobbyFolder.spec] All tests passed!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">MapRegistry</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: MapRegistry
    Central registry interface managing map module registration, metadata retrieval,
    dynamic map instance loading (LoadMapInstance), and unloading (UnloadMapInstance).
]=]

local Workspace = game:GetService("Workspace")

export type MapBounds = {
	min: Vector3,
	max: Vector3,
}

export type SitePositions = {
	siteA: Vector3,
	siteB: Vector3,
}

export type LaneData = {
	center: Vector3,
	size: Vector3,
}

export type MapLayoutData = {
	mapId: string?,
	mapName: string,
	theme: string?,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions?,
	coverPositions: { Vector3 },
	lanes: { [string]: LaneData }?,
}

export type MapModule = {
	BuildMap: (parent: Instance?) -&gt; Folder,
	DestroyMap: () -&gt; (),
	GetSpawnPoints: (teamName: string) -&gt; { Vector3 },
	GetCoverPositions: () -&gt; { Vector3 },
	GetSitePositions: () -&gt; SitePositions?,
	GetMapBounds: () -&gt; (Vector3, Vector3),
	GetLayoutData: () -&gt; MapLayoutData,
}

export type MapMetadata = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	spawnCountRed: number,
	spawnCountBlue: number,
	siteA: Vector3,
	siteB: Vector3,
}

local MapRegistry = {}

local _registeredMaps: { [string]: MapModule } = {}
local _activeMapId: string? = nil
local _activeMapFolder: Folder? = nil

--[=[
    Registers a map module under a unique map ID.
]=]
function MapRegistry.RegisterMap(mapId: string, mapModule: MapModule): boolean
	if type(mapId) ~= "string" or mapId == "" then
		warn("[MapRegistry] Invalid mapId provided for registration.")
		return false
	end

	if type(mapModule) ~= "table" then
		warn("[MapRegistry] Invalid mapModule provided for mapId: " .. mapId)
		return false
	end

	_registeredMaps[mapId] = mapModule
	return true
end

--[=[
    Unregisters a map module by map ID.
]=]
function MapRegistry.UnregisterMap(mapId: string): boolean
	if _registeredMaps[mapId] ~= nil then
		if _activeMapId == mapId then
			MapRegistry.UnloadMapInstance()
		end
		_registeredMaps[mapId] = nil
		return true
	end
	return false
end

--[=[
    Checks if a map ID is registered.
]=]
function MapRegistry.IsMapRegistered(mapId: string): boolean
	return _registeredMaps[mapId] ~= nil
end

--[=[
    Returns a list of all registered map IDs.
]=]
function MapRegistry.GetRegisteredMapNames(): { string }
	local names: { string } = {}
	for mapId in _registeredMaps do
		table.insert(names, mapId)
	end
	table.sort(names)
	return names
end

--[=[
    Retrieves metadata for a specific registered map.
]=]
function MapRegistry.GetMapMetadata(mapId: string): MapMetadata?
	local module = _registeredMaps[mapId]
	if not module then
		return nil
	end

	local layout = module.GetLayoutData()
	local sites = layout.sites
	return {
		mapId = layout.mapId or mapId,
		mapName = layout.mapName or mapId,
		theme = layout.theme or "Tactical Greybox",
		bounds = layout.bounds,
		spawnCountRed = layout.redSpawns and #layout.redSpawns or 0,
		spawnCountBlue = layout.blueSpawns and #layout.blueSpawns or 0,
		siteA = sites and sites.siteA or Vector3.zero,
		siteB = sites and sites.siteB or Vector3.zero,
	}
end

--[=[
    Retrieves a list of metadata for all registered maps.
]=]
function MapRegistry.GetAllMapMetadata(): { MapMetadata }
	local list: { MapMetadata } = {}
	for mapId in _registeredMaps do
		local meta = MapRegistry.GetMapMetadata(mapId)
		if meta then
			table.insert(list, meta)
		end
	end
	table.sort(list, function(a: MapMetadata, b: MapMetadata)
		return a.mapId &lt; b.mapId
	end)
	return list
end

--[=[
    Loads a dynamic instance of a registered map into Workspace or specified parent.
    Unloads any currently active map prior to loading the new map.
]=]
function MapRegistry.LoadMapInstance(mapId: string, parent: Instance?): Folder?
	local module = _registeredMaps[mapId]
	if not module then
		warn("[MapRegistry] Failed to load map instance: Map ID '" .. tostring(mapId) .. "' is not registered.")
		return nil
	end

	if _activeMapId ~= nil then
		MapRegistry.UnloadMapInstance()
	end

	local targetParent = parent or Workspace
	local folder = module.BuildMap(targetParent)
	_activeMapId = mapId
	_activeMapFolder = folder

	return folder
end

--[=[
    Unloads and destroys the currently active map instance.
]=]
function MapRegistry.UnloadMapInstance()
	if _activeMapId ~= nil then
		local module = _registeredMaps[_activeMapId]
		if module then
			module.DestroyMap()
		end
		_activeMapId = nil
		_activeMapFolder = nil
	elseif _activeMapFolder ~= nil then
		_activeMapFolder:Destroy()
		_activeMapFolder = nil
	end
end

--[=[
    Gets the map ID of the currently active map instance.
]=]
function MapRegistry.GetActiveMapId(): string?
	return _activeMapId
end

--[=[
    Gets the Folder instance of the currently active map instance.
]=]
function MapRegistry.GetActiveMapFolder(): Folder?
	return _activeMapFolder
end

--[=[
    Gets the MapLayoutData of the currently active map instance.
]=]
function MapRegistry.GetActiveMapLayoutData(): MapLayoutData?
	if _activeMapId == nil then
		return nil
	end
	local module = _registeredMaps[_activeMapId]
	if not module then
		return nil
	end
	return module.GetLayoutData()
end

--[=[
    Attempts to lazy-load and auto-register standard project map modules if available.
]=]
function MapRegistry.AutoRegisterDefaultMaps()
	local mapFolder = script.Parent
	if not mapFolder then
		return
	end

	local defaultMapNames = {
		"ForestOutpostMap",
		"UrbanWarehouseMap",
		"DesertRuinsMap",
		"CyberArenaMap",
		"ClassicGreyboxMap",
		"GreyboxArenaMap",
		"DuelArenaMap",
		"PracticeRangeMapLayout",
		"PracticeRangeMap",
	}

	for _, name in defaultMapNames do
		local child = mapFolder:FindFirstChild(name)
		if child and child:IsA("ModuleScript") then
			local success, result = pcall(function()
				return require(child) :: any
			end)
			if success and type(result) == "table" and type(result.BuildMap) == "function" then
				local cleanId = name
				if name == "DuelArenaMap" then
					cleanId = "DuelArena"
				elseif name == "PracticeRangeMapLayout" or name == "PracticeRangeMap" then
					cleanId = "PracticeRangeMap"
				else
					cleanId = name:gsub("Map$", "")
				end
				MapRegistry.RegisterMap(cleanId, result :: MapModule)
			end
		end
	end
end

-- Execute auto-registration upon module require
MapRegistry.AutoRegisterDefaultMaps()

return MapRegistry
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">MapRegistry.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for MapRegistry &amp; Milestone 5 Maps (DuelArena &amp; PracticeRangeMap)
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local MapRegistry = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("MapRegistry"))

local function runTests()
	print("[MapRegistry.spec] Starting MapRegistry verification tests...")

	-- 1. Test Default Auto-Registered Maps
	local registeredNames = MapRegistry.GetRegisteredMapNames()
	assert(#registeredNames &gt;= 5, "Expected at least 5 registered map names")
	print("[MapRegistry.spec] Registered maps count: " .. tostring(#registeredNames))

	-- Verify OVERCLOCK M5 Map Registrations
	assert(MapRegistry.IsMapRegistered("DuelArena"), "DuelArena should be registered in MapRegistry")
	assert(MapRegistry.IsMapRegistered("PracticeRangeMap"), "PracticeRangeMap should be registered in MapRegistry")

	-- 2. Test Legacy Maps Metadata &amp; Loading
	local legacyMapsToTest = {
		"ForestOutpost",
		"UrbanWarehouse",
		"DesertRuins",
		"CyberArena",
		"ClassicGreybox",
	}

	for _, mapId in legacyMapsToTest do
		if MapRegistry.IsMapRegistered(mapId) then
			local meta = MapRegistry.GetMapMetadata(mapId)
			assert(meta ~= nil, "Metadata for " .. mapId .. " must not be nil")
			assert(meta.mapId == mapId, "Metadata mapId mismatch for " .. mapId)

			local folder = MapRegistry.LoadMapInstance(mapId, Workspace)
			assert(folder ~= nil, "LoadMapInstance must return Folder for " .. mapId)
			assert(MapRegistry.GetActiveMapId() == mapId, "Active map ID mismatch for " .. mapId)

			MapRegistry.UnloadMapInstance()
			assert(MapRegistry.GetActiveMapId() == nil, "Active map ID should be nil after unload")
		end
	end

	-- 3. Test DuelArena Map Loading &amp; Metadata
	do
		local mapId = "DuelArena"
		local meta = MapRegistry.GetMapMetadata(mapId)
		assert(meta ~= nil, "Metadata for DuelArena must not be nil")
		assert(meta.mapId == "DuelArena", "Metadata mapId mismatch for DuelArena")
		assert(meta.spawnCountRed &gt;= 4, "Expected at least 4 Red/Team1 spawns for DuelArena")
		assert(meta.spawnCountBlue &gt;= 4, "Expected at least 4 Blue/Team2 spawns for DuelArena")

		local folder = MapRegistry.LoadMapInstance(mapId, Workspace)
		assert(folder ~= nil, "LoadMapInstance must return Folder for DuelArena")
		assert(folder.Name == "DuelArenaMap", "DuelArena map folder name mismatch")
		assert(MapRegistry.GetActiveMapId() == mapId, "Active map ID mismatch for DuelArena")

		local spawns = folder:FindFirstChild("Spawns")
		assert(spawns ~= nil, "Spawns folder missing in DuelArenaMap")
		assert(spawns:FindFirstChild("Team1Spawn") ~= nil, "Team1Spawn folder missing in DuelArenaMap")
		assert(spawns:FindFirstChild("Team2Spawn") ~= nil, "Team2Spawn folder missing in DuelArenaMap")

		MapRegistry.UnloadMapInstance()
		assert(MapRegistry.GetActiveMapId() == nil, "Active map ID should be nil after unload")
	end

	-- 4. Test PracticeRangeMap Loading &amp; Optional Sites Metadata Guard
	do
		local mapId = "PracticeRangeMap"
		local meta = MapRegistry.GetMapMetadata(mapId)
		assert(meta ~= nil, "Metadata for PracticeRangeMap must not be nil")
		assert(meta.mapId == "PracticeRangeMap", "Metadata mapId mismatch for PracticeRangeMap")
		assert(meta.siteA == Vector3.zero or meta.siteA == Vector3.new(500, 100, 0), "PracticeRangeMap siteA should default to Vector3.zero or MAP_OFFSET")
		assert(meta.siteB == Vector3.zero or meta.siteB == Vector3.new(500, 100, 0), "PracticeRangeMap siteB should default to Vector3.zero or MAP_OFFSET")

		local folder = MapRegistry.LoadMapInstance(mapId, Workspace)
		assert(folder ~= nil, "LoadMapInstance must return Folder for PracticeRangeMap")
		assert(folder.Name == "PracticeRangeMap", "PracticeRangeMap folder name mismatch")
		assert(MapRegistry.GetActiveMapId() == mapId, "Active map ID mismatch for PracticeRangeMap")

		local targetWall = folder:FindFirstChild("TargetWallSection")
		assert(targetWall ~= nil, "TargetWallSection folder missing in PracticeRangeMap")

		local patrolBot = folder:FindFirstChild("PatrolBotSection")
		assert(patrolBot ~= nil, "PatrolBotSection folder missing in PracticeRangeMap")

		MapRegistry.UnloadMapInstance()
		assert(MapRegistry.GetActiveMapId() == nil, "Active map ID should be nil after unload")
	end

	print("[MapRegistry.spec] All MapRegistry verification tests passed successfully!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">MapSafety</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: MapSafety
    Validates map spawn points via downward raycasting to ensure floor collision safety.
]=]

local Workspace = game:GetService("Workspace")

local MapSafety = {}

--[=[
    Verifies that a single spawn point has a collidable floor beneath it.
    Performs a downward raycast from spawnCFrame.Position + Vector3.new(0, 5, 0)
    extending downwards Vector3.new(0, -15, 0) with RaycastParams (IgnoreWater = true, RespectCanCollide = true).
]=]
function MapSafety.verifySpawnPointFloor(
	spawnCFrame: CFrame | Vector3 | BasePart,
	mapFolder: Instance?
): (boolean, string?)
	local cf: CFrame
	if typeof(spawnCFrame) == "CFrame" then
		cf = spawnCFrame
	elseif typeof(spawnCFrame) == "Vector3" then
		cf = CFrame.new(spawnCFrame)
	elseif typeof(spawnCFrame) == "Instance" and spawnCFrame:IsA("BasePart") then
		cf = spawnCFrame.CFrame
	else
		local err = string.format("Invalid spawn point argument type: %s", typeof(spawnCFrame))
		return false, err
	end

	local origin = cf.Position + Vector3.new(0, 5, 0)
	local direction = Vector3.new(0, -15, 0)

	local params = RaycastParams.new()
	params.IgnoreWater = true
	params.RespectCanCollide = true
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- Exclude all player characters so we don't falsely detect a character as floor
	local chars: { Instance } = {}
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		if p.Character then
			table.insert(chars, p.Character)
		end
	end
	if mapFolder then
		-- Don't filter the map itself; only characters. Keep filter minimal for accuracy.
	end
	if #chars &gt; 0 then
		params.FilterDescendantsInstances = chars
	end

	local result = Workspace:Raycast(origin, direction, params)
	if result and result.Instance and result.Instance.CanCollide then
		return true, nil
	end

	local posStr = string.format("(%.1f, %.1f, %.1f)", cf.Position.X, cf.Position.Y, cf.Position.Z)
	local errMsg = string.format("Spawn point at %s lacks collidable floor!", posStr)
	return false, errMsg
end

--[=[
    Validates all spawn points for a map.
    Returns true if every spawn point has a collidable floor, false otherwise.
]=]
function MapSafety.assertMapReady(mapFolder: Instance?, spawnPoints: { any }): boolean
	if not spawnPoints or #spawnPoints == 0 then
		warn("[MAP ERROR] No spawn points provided for map validation!")
		return false
	end

	local allPassed = true
	for _, spawnPoint in spawnPoints do
		local cf: CFrame
		if typeof(spawnPoint) == "CFrame" then
			cf = spawnPoint
		elseif typeof(spawnPoint) == "Vector3" then
			cf = CFrame.new(spawnPoint)
		elseif typeof(spawnPoint) == "Instance" and spawnPoint:IsA("BasePart") then
			cf = spawnPoint.CFrame
		else
			warn("[MAP ERROR] Invalid spawn point item encountered during map ready assertion!")
			allPassed = false
			continue
		end

		local ok, errMsg = MapSafety.verifySpawnPointFloor(cf, mapFolder)
		if not ok then
			warn(string.format("[MAP ERROR] %s", errMsg or "Spawn point lacks collidable floor!"))
			allPassed = false
		end
	end

	if allPassed then
		print("[MAP] Every spawn has collidable floor")
		return true
	else
		return false
	end
end

return MapSafety
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">PracticeRangeMapLayout</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: PracticeRangeMapLayout (Legendary Edition)

    Research-backed rebuild referencing:
    - sshar1/FPS-Framework (open-source Roblox FPS) [web:4]
    - Ruski's Map Design Tutorial (fluid layouts, cover balance, clustering) [web:16]
    - Roblox Lighting best practices (Atmosphere, Bloom, ColorCorrection) [web:17]
    - Bullseye Target Systems (multi-ring concentric scoring) [web:24]
    - 3-lane FPS map design (symmetrical distance balance) [web:25]

    Features:
    (a) Multi-ring concentric bullseye targets (5 scoring zones each)
    (b) Moving rail targets with pop-up/pop-down cycle hooks
    (c) Tiered cover system (Low / Mid / High with health attributes)
    (d) Three-lane arena layout with symmetric distance balance
    (e) Holographic waypoint beacons with connecting beams
    (f) Ammo resupply + weapon rack stations with ProximityPrompts
    (g) Distance marker signage with billboard labels
    (h) Full lighting rig (Atmosphere, ColorCorrection, Bloom, ceiling lights)
    (i) Observational catwalk + score zone volumes
]=]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local PracticeRangeMapLayout = {}

-- Types -----------------------------------------------------------------------

export type MapBounds = { min: Vector3, max: Vector3 }
export type SitePositions = { siteA: Vector3, siteB: Vector3 }

export type MapLayoutData = {
	mapId: string,
	mapName: string,
	theme: string,
	bounds: MapBounds,
	redSpawns: { Vector3 },
	blueSpawns: { Vector3 },
	sites: SitePositions?,
	coverPositions: { Vector3 },
	lanes: { [string]: { center: Vector3, size: Vector3 } }?,
}

-- Constants ------------------------------------------------------------------

local MAP_FOLDER_NAME = "PracticeRangeMap"
