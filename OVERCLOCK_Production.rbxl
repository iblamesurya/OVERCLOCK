-- Centralized Attachment Categories &amp; Options
local ATTACHMENT_OPTIONS: { [string]: { [string]: AttachmentSpec } } = {
	optic = {
		["Stock Sights"] = { displayName = "Stock Sights", damageMult = 1.0, recoilMult = 1.0, rangeMult = 1.0, mobilityMult = 1.0 },
		["Red Dot"] = { displayName = "Red Dot Sight", damageMult = 1.0, recoilMult = 0.95, rangeMult = 1.05, mobilityMult = 0.99 },
		["Holographic"] = { displayName = "Holo Sight", damageMult = 1.0, recoilMult = 0.92, rangeMult = 1.10, mobilityMult = 0.98 },
		["Scope 4x"] = { displayName = "4x Scope", damageMult = 1.0, recoilMult = 0.88, rangeMult = 1.25, mobilityMult = 0.94 },
	},
	muzzle = {
		["Default Muzzle"] = { displayName = "Default Muzzle", damageMult = 1.0, recoilMult = 1.0, rangeMult = 1.0, mobilityMult = 1.0 },
		["Suppressor"] = { displayName = "Tactical Suppressor", damageMult = 0.95, recoilMult = 0.85, rangeMult = 0.95, mobilityMult = 0.98 },
		["Compensator"] = { displayName = "Compensator", damageMult = 1.0, recoilMult = 0.80, rangeMult = 1.0, mobilityMult = 0.97 },
	},
	underbarrel = {
		["None"] = { displayName = "None", damageMult = 1.0, recoilMult = 1.0, rangeMult = 1.0, mobilityMult = 1.0 },
		["Vertical Grip"] = { displayName = "Vertical Grip", damageMult = 1.0, recoilMult = 0.75, rangeMult = 1.0, mobilityMult = 0.96 },
		["Tac Laser"] = { displayName = "Tac Laser", damageMult = 1.0, recoilMult = 0.95, rangeMult = 1.0, mobilityMult = 1.05 },
	},
	magazine = {
		["Standard"] = { displayName = "Standard Mag", damageMult = 1.0, recoilMult = 1.0, rangeMult = 1.0, mobilityMult = 1.0 },
		["Extended Mag"] = { displayName = "Extended Mag", damageMult = 1.0, recoilMult = 1.02, rangeMult = 1.0, mobilityMult = 0.95 },
	},
}

local WeaponStats = {}

WeaponStats.SKINS_DATA = SKINS_DATA
WeaponStats.ATTACHMENT_OPTIONS = ATTACHMENT_OPTIONS

function WeaponStats.Get(weaponId: string): WeaponData?
	local data = WeaponRegistry[weaponId]
	if not data and weaponId == "SMG" then
		data = WeaponRegistry.Pistol
	end
	if not data then
		warn(string.format("[WeaponStats] Unknown weaponId requested: %s", tostring(weaponId)))
		return nil
	end
	return data
end

function WeaponStats.GetAll(): { [string]: WeaponData }
	return WeaponRegistry
end

function WeaponStats.GetArmor(armorId: string): ArmorData?
	return ArmorRegistry[armorId]
end

function WeaponStats.GetAllArmor(): { [string]: ArmorData }
	return ArmorRegistry
end

function WeaponStats.GetModifiedStats(
	weaponId: string,
	attachments: { optic: string?, muzzle: string?, underbarrel: string?, magazine: string? }?
): ModifiedWeaponData?
	local base = WeaponStats.Get(weaponId)
	if not base then
		warn(string.format("[WeaponStats] Unknown weaponId in GetModifiedStats: %s", tostring(weaponId)))
		return nil
	end

	local atts = attachments or {}
	local opticKey = atts.optic or "Stock Sights"
	local muzzleKey = atts.muzzle or "Default Muzzle"
	local underbarrelKey = atts.underbarrel or "None"
	local magazineKey = atts.magazine or "Standard"

	local opt = ATTACHMENT_OPTIONS.optic[opticKey] or ATTACHMENT_OPTIONS.optic["Stock Sights"]
	local muz = ATTACHMENT_OPTIONS.muzzle[muzzleKey] or ATTACHMENT_OPTIONS.muzzle["Default Muzzle"]
	local und = ATTACHMENT_OPTIONS.underbarrel[underbarrelKey] or ATTACHMENT_OPTIONS.underbarrel["None"]
	local mag = ATTACHMENT_OPTIONS.magazine[magazineKey] or ATTACHMENT_OPTIONS.magazine["Standard"]

	local dMult = (opt.damageMult or 1.0) * (muz.damageMult or 1.0) * (und.damageMult or 1.0) * (mag.damageMult or 1.0)
	local rMult = (opt.recoilMult or 1.0) * (muz.recoilMult or 1.0) * (und.recoilMult or 1.0) * (mag.recoilMult or 1.0)
	local rngMult = (opt.rangeMult or 1.0) * (muz.rangeMult or 1.0) * (und.rangeMult or 1.0) * (mag.rangeMult or 1.0)
	local mobMult = (opt.mobilityMult or 1.0) * (muz.mobilityMult or 1.0) * (und.mobilityMult or 1.0) * (mag.mobilityMult or 1.0)

	local recoilMag = base.recoilImpulse.Magnitude * 1000

	local result: ModifiedWeaponData = {
		id = base.id,
		displayName = base.displayName,
		damage = math.round(base.damage * dMult),
		headshotMultiplier = base.headshotMultiplier,
		fireRate = base.fireRate,
		spreadMin = base.spreadMin,
		spreadMax = base.spreadMax,
		spreadIncreasePerShot = base.spreadIncreasePerShot,
		spreadRecoveryRate = base.spreadRecoveryRate,
		recoilImpulse = base.recoilImpulse * rMult,
		recoilImpulseADS = base.recoilImpulseADS * rMult,
		mobilitySpeed = base.mobilitySpeed * mobMult,
		reloadDuration = base.reloadDuration,
		fireMode = base.fireMode,
		magazineCapacity = base.magazineCapacity,
		reserveCapacity = base.reserveCapacity,
		bulletVelocity = base.bulletVelocity,
		maxRange = math.round(base.maxRange * rngMult),
		adsFov = base.adsFov,
		zoomSpeed = base.zoomSpeed,
		burstCount = base.burstCount,
		burstDelay = base.burstDelay,
		recoil = math.round(recoilMag * rMult),
		mobility = math.round(base.mobilitySpeed * 100 * mobMult),
		damageMult = dMult,
		recoilMult = rMult,
		rangeMult = rngMult,
		mobilityMult = mobMult,
	}

	return result
end

function WeaponStats.CalculateDamage(weaponId: string, isHeadshot: boolean, distance: number): number
	local stats = WeaponStats.Get(weaponId)
	if not stats then
		return 0
	end

	local baseDamage = stats.damage
	local mult = isHeadshot and stats.headshotMultiplier or 1.0

	-- Distance falloff calculation (linear dropoff past maxRange * 0.5)
	local falloffStart = stats.maxRange * 0.5
	local damageScale = 1.0

	if distance &gt; falloffStart then
		local excess = distance - falloffStart
		local falloffRange = stats.maxRange - falloffStart
		if falloffRange &lt;= 0 then
			return math.floor(baseDamage * mult + 0.5)
		end
		local falloffPercent = math.clamp(excess / falloffRange, 0, 0.6) -- Max 60% reduction
		damageScale = 1.0 - falloffPercent
	end

	return math.floor(baseDamage * mult * damageScale + 0.5)
end

return WeaponStats

]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX14"><Properties><string name="Name">Physics</string></Properties><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">BallisticPhysics</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Ballistic Physics Engine
    A highly optimized, custom projectile physics module utilizing swept raycasts 
    (Continuous Collision Detection / CCD) to simulate bullet drop, travel time, 
    and penetration without relying on Roblox's native physics engine.
]=]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BallisticPhysics = {}

export type ProjectileData = {
    id: string,
    shooterId: number,
    weaponId: string,
    origin: Vector3,
    position: Vector3,
    velocity: Vector3,
    acceleration: Vector3,
    gravityMultiplier: number,
    distanceTraveled: number,
    maxRange: number,
    damage: number,
    isHeadshotCapable: boolean,
    raycastParams: RaycastParams,
    startTime: number,
    onHitCallback: ((hitResult: RaycastResult, projectile: ProjectileData) -&gt; ())?,
    onExpireCallback: ((projectile: ProjectileData) -&gt; ())?,
}

local activeProjectiles: { [string]: ProjectileData } = {}
local GLOBAL_GRAVITY = Vector3.new(0, -Workspace.Gravity, 0)
local HttpService = game:GetService("HttpService")

-- Steps a projectile forward by DeltaTime using kinematic equations:
-- pos = pos + vel * dt + 0.5 * a * dt^2
-- vel = vel + a * dt
local function stepProjectile(proj: ProjectileData, dt: number)
    local oldPos = proj.position
    
    local accel = proj.acceleration + (GLOBAL_GRAVITY * proj.gravityMultiplier)
    local stepDisplacement = (proj.velocity * dt) + (0.5 * accel * dt * dt)
    local newPos = oldPos + stepDisplacement
    
    local stepVelocity = proj.velocity + (accel * dt)
    
    -- Swept Raycast for Continuous Collision Detection (CCD)
    local dir = stepDisplacement
    local dist = dir.Magnitude
    
    if dist &gt; 0.001 then
        local hitResult = Workspace:Raycast(oldPos, dir, proj.raycastParams)
        
        if hitResult then
            if proj.onHitCallback then
                proj.onHitCallback(hitResult, proj)
            end
            return true -- Projectile consumed
        end
    end
    
    proj.position = newPos
    proj.velocity = stepVelocity
    proj.distanceTraveled += dist
    
    if proj.distanceTraveled &gt;= proj.maxRange then
        if proj.onExpireCallback then
            proj.onExpireCallback(proj)
        end
        return true -- Expired
    end
    
    return false -- Still active
end

-- Hook into physics step for Server, or RenderStepped for Client
local stepConnection: RBXScriptConnection? = nil

local function onStep(dt: number)
    for id, proj in pairs(activeProjectiles) do
        local consumed = stepProjectile(proj, dt)
        if consumed then
            activeProjectiles[id] = nil
        end
    end
end

function BallisticPhysics.Initialize()
    if stepConnection then return end
    
    if RunService:IsServer() then
        stepConnection = RunService.Heartbeat:Connect(onStep)
    else
        stepConnection = RunService.RenderStepped:Connect(onStep)
    end
end

function BallisticPhysics.FireProjectile(config: {
    shooterId: number,
    weaponId: string,
    origin: Vector3,
    direction: Vector3,
    velocityMod: number,
    gravityMult: number,
    maxRange: number,
    damage: number,
    raycastParams: RaycastParams,
    onHit: ((hitResult: RaycastResult, proj: ProjectileData) -&gt; ())?,
    onExpire: ((proj: ProjectileData) -&gt; ())?
}): string
    local id = HttpService:GenerateGUID(false)
    
    local proj: ProjectileData = {
        id = id,
        shooterId = config.shooterId,
        weaponId = config.weaponId,
        origin = config.origin,
        position = config.origin,
        velocity = config.direction.Unit * config.velocityMod,
        acceleration = Vector3.zero,
        gravityMultiplier = config.gravityMult,
        distanceTraveled = 0,
        maxRange = config.maxRange,
        damage = config.damage,
        isHeadshotCapable = true,
        raycastParams = config.raycastParams,
        startTime = os.clock(),
        onHitCallback = config.onHit,
        onExpireCallback = config.onExpire,
    }
    
    activeProjectiles[id] = proj
    return id
end

function BallisticPhysics.ClearProjectiles()
    table.clear(activeProjectiles)
end

return BallisticPhysics
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">Spring</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Damped Harmonic Oscillator Spring Physics Module
    Provides 3D mass-spring-damper physics simulation for procedural camera recoil,
    weapon sway, viewmodel bobbing, and spring-driven UI components.
]=]

export type Spring = {
    Mass: number,
    Stiffness: number,
    Damping: number,
    Position: Vector3,
    Velocity: Vector3,
    Target: Vector3,

    Update: (self: Spring, dt: number) -&gt; Vector3,
    Impulse: (self: Spring, velocity: Vector3) -&gt; (),
    SetTarget: (self: Spring, target: Vector3) -&gt; (),
    SetPosition: (self: Spring, position: Vector3) -&gt; (),
    SetVelocity: (self: Spring, velocity: Vector3) -&gt; (),
    Reset: (self: Spring, position: Vector3?) -&gt; (),
}

local Spring = {}
Spring.__index = Spring

function Spring.new(
    mass: number?,
    stiffness: number?,
    damping: number?,
    initialPosition: Vector3?
): Spring
    local self = setmetatable({}, Spring)
    self.Mass = mass or 1.0
    self.Stiffness = stiffness or 150.0
    self.Damping = damping or 15.0
    self.Position = initialPosition or Vector3.zero
    self.Velocity = Vector3.zero
    self.Target = initialPosition or Vector3.zero
    return (self :: any) :: Spring
end

function Spring.Update(self: Spring, dt: number): Vector3
    if dt &lt;= 0 then
        return self.Position
    end

    -- Sub-stepping to guarantee numerical stability across varying frame rates
    local MAX_SUBSTEP = 1 / 120
    local remaining = dt

    while remaining &gt; 0 do
        local step = math.min(remaining, MAX_SUBSTEP)
        remaining -= step

        -- Spring force: F_spring = -k * (x - x0)
        -- Damping force: F_damping = -c * v
        -- Acceleration: a = (F_spring + F_damping) / m
        local displacement = self.Position - self.Target
        local springForce = -displacement * self.Stiffness
        local dampingForce = -self.Velocity * self.Damping
        local acceleration = (springForce + dampingForce) / math.max(self.Mass, 0.0001)

        -- Semi-implicit Euler integration for symplectic energy stability
        self.Velocity += acceleration * step
        self.Position += self.Velocity * step
    end

    return self.Position
end

function Spring.Impulse(self: Spring, velocity: Vector3): ()
    -- Compounds given velocity impulse directly with existing momentum
    self.Velocity += velocity
end

function Spring.SetTarget(self: Spring, target: Vector3): ()
    self.Target = target
end

function Spring.SetPosition(self: Spring, position: Vector3): ()
    self.Position = position
end

function Spring.SetVelocity(self: Spring, velocity: Vector3): ()
    self.Velocity = velocity
end

function Spring.Reset(self: Spring, position: Vector3?): ()
    local pos = position or Vector3.zero
    self.Position = pos
    self.Target = pos
    self.Velocity = Vector3.zero
end

return Spring
]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX15"><Properties><string name="Name">Utils</string></Properties><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">ObjectPool</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: ObjectPool
    High-performance object pooling utility for Roblox instances.
    Pre-allocates reusable instances during loading to eliminate dynamic allocations
    (Instance.new / Destroy) during active gameplay.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

export type PoolResetCallback = (instance: Instance) -&gt; ()
export type PoolGetCallback = (instance: Instance) -&gt; ()

export type ObjectPoolConfig = {
	template: Instance | () -&gt; Instance,
	initialSize: number,
	container: Instance?,
	resetHandler: PoolResetCallback?,
	getHandler: PoolGetCallback?,
}

export type ObjectPoolImpl = {
	__index: ObjectPoolImpl,
	new: (config: ObjectPoolConfig) -&gt; ObjectPool,
	createHitmarkerPool: (initialSize: number?, container: Instance?) -&gt; ObjectPool,
	createTracerPool: (initialSize: number?, container: Instance?) -&gt; ObjectPool,
	Get: (self: ObjectPool) -&gt; Instance,
	Return: (self: ObjectPool, instance: Instance) -&gt; boolean,
	Preallocate: (self: ObjectPool, count: number) -&gt; (),
	GetAvailableCount: (self: ObjectPool) -&gt; number,
	GetTotalCount: (self: ObjectPool) -&gt; number,
	GetInUseCount: (self: ObjectPool) -&gt; number,
	Destroy: (self: ObjectPool) -&gt; (),
}

export type ObjectPool = typeof(setmetatable(
	{} :: {
		_template: Instance | () -&gt; Instance,
		_container: Instance,
		_available: { Instance },
		_inUse: { [Instance]: boolean },
		_totalCount: number,
		_resetHandler: PoolResetCallback?,
		_getHandler: PoolGetCallback?,
	},
	{} :: ObjectPoolImpl
))

local ObjectPool = {} :: ObjectPoolImpl
ObjectPool.__index = ObjectPool

local defaultContainerFolder: Folder? = nil

local function getDefaultContainer(): Folder
	if not defaultContainerFolder then
		local folder = Instance.new("Folder")
		folder.Name = "ObjectPoolContainer"
		folder.Parent = ReplicatedStorage
		defaultContainerFolder = folder
	end
	return defaultContainerFolder :: Folder
end

function ObjectPool.new(templateOrConfig: any, initialSizeParam: number?, containerParam: Instance?): ObjectPool
	local template: Instance | () -&gt; Instance
	local initialSize: number
	local container: Instance
	local resetHandler: ((item: Instance) -&gt; ())?
	local getHandler: ((item: Instance) -&gt; ())?

	if typeof(templateOrConfig) == "Instance" or type(templateOrConfig) == "function" then
		template = templateOrConfig
		initialSize = initialSizeParam or 10
		container = containerParam or getDefaultContainer()
	elseif type(templateOrConfig) == "table" then
		template = templateOrConfig.template
		initialSize = templateOrConfig.initialSize or 10
		container = templateOrConfig.container or getDefaultContainer()
		resetHandler = templateOrConfig.resetHandler
		getHandler = templateOrConfig.getHandler
	else
		error("[ObjectPool] Invalid arguments provided to ObjectPool.new")
	end

	local self = setmetatable({
		_template = template,
		_container = container,
		_available = {},
		_inUse = {},
		_totalCount = 0,
		_resetHandler = resetHandler,
		_getHandler = getHandler,
	}, ObjectPool)

	if initialSize &gt; 0 then
		self:Preallocate(initialSize)
	end

	return self :: ObjectPool
end

function ObjectPool.Preallocate(self: ObjectPool, count: number)
	for _ = 1, count do
		local inst: Instance
		if typeof(self._template) == "function" then
			inst = (self._template :: () -&gt; Instance)()
		else
			inst = (self._template :: Instance):Clone()
		end

		if self._resetHandler then
			self._resetHandler(inst)
		else
			if inst:IsA("LayerCollector") then
				(inst :: any).Enabled = false
			elseif inst:IsA("GuiObject") then
				(inst :: any).Visible = false
			end
		end
		inst.Parent = self._container

		table.insert(self._available, inst)
		self._totalCount += 1
	end
end

function ObjectPool.Get(self: ObjectPool): Instance
	local inst: Instance
	if #self._available &gt; 0 then
		inst = table.remove(self._available, #self._available) :: Instance
	else
		if typeof(self._template) == "function" then
			inst = (self._template :: () -&gt; Instance)()
		else
			inst = (self._template :: Instance):Clone()
		end
		self._totalCount += 1
	end

	self._inUse[inst] = true

	if self._getHandler then
		self._getHandler(inst)
	else
		-- Default activation
		if inst:IsA("BasePart") then
			inst.Parent = workspace
		end
		if inst:IsA("LayerCollector") then
			(inst :: any).Enabled = true
		elseif inst:IsA("GuiObject") then
			(inst :: any).Visible = true
		end
	end

	return inst
end

function ObjectPool.Return(self: ObjectPool, instance: Instance): boolean
	if not self._inUse[instance] then
		return false
	end

	self._inUse[instance] = nil

	if self._resetHandler then
		self._resetHandler(instance)
	else
		-- Default deactivation
		if instance:IsA("BasePart") then
			instance.CFrame = CFrame.new(0, -1000, 0)
		end
		if instance:IsA("LayerCollector") then
			(instance :: any).Enabled = false
		elseif instance:IsA("GuiObject") then
			(instance :: any).Visible = false
		end
	end

	instance.Parent = self._container
	table.insert(self._available, instance)
	return true
end

function ObjectPool.GetAvailableCount(self: ObjectPool): number
	return #self._available
end

function ObjectPool.GetTotalCount(self: ObjectPool): number
	return self._totalCount
end

function ObjectPool.GetInUseCount(self: ObjectPool): number
	local count = 0
	for _ in self._inUse do
		count += 1
	end
	return count
end

function ObjectPool.createHitmarkerPool(initialSize: number?, container: Instance?): ObjectPool
	local size = initialSize or 30

	local function hitmarkerFactory(): Instance
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "HitmarkerBillboard"
		billboard.Size = UDim2.new(0, 40, 0, 40)
		billboard.AlwaysOnTop = true
		billboard.ResetOnSpawn = false
		billboard.Enabled = false

		local containerFrame = Instance.new("Frame")
		containerFrame.Name = "Container"
		containerFrame.Size = UDim2.new(1, 0, 1, 0)
		containerFrame.BackgroundTransparency = 1
		containerFrame.Parent = billboard

		local line1 = Instance.new("Frame")
		line1.Name = "Line1"
		line1.Size = UDim2.new(0, 14, 0, 2)
		line1.Position = UDim2.new(0.5, 0, 0.5, 0)
		line1.AnchorPoint = Vector2.new(0.5, 0.5)
		line1.Rotation = 45
		line1.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		line1.BorderSizePixel = 0
		line1.Parent = containerFrame

		local line2 = Instance.new("Frame")
		line2.Name = "Line2"
		line2.Size = UDim2.new(0, 14, 0, 2)
		line2.Position = UDim2.new(0.5, 0, 0.5, 0)
		line2.AnchorPoint = Vector2.new(0.5, 0.5)
		line2.Rotation = -45
		line2.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		line2.BorderSizePixel = 0
		line2.Parent = containerFrame

		return billboard
	end

	return ObjectPool.new({
		template = hitmarkerFactory,
		initialSize = size,
		container = container,
		resetHandler = function(inst: Instance)
			if inst:IsA("BillboardGui") then
				inst.Enabled = false
				inst.Adornee = nil
			end
		end,
		getHandler = function(inst: Instance)
			if inst:IsA("BillboardGui") then
				inst.Enabled = true
			end
		end,
	})
end

function ObjectPool.createTracerPool(initialSize: number?, container: Instance?): ObjectPool
	local size = initialSize or 50

	local function tracerFactory(): Instance
		local part = Instance.new("Part")
		part.Name = "BulletTracer"
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Size = Vector3.new(0.1, 0.1, 4)
		part.Color = Color3.fromRGB(255, 220, 100)
		part.Transparency = 0
		return part
	end

	return ObjectPool.new({
		template = tracerFactory,
		initialSize = size,
		container = container,
		resetHandler = function(inst: Instance)
			if inst:IsA("BasePart") then
				inst.Transparency = 1
				inst.CFrame = CFrame.new(0, -9999, 0)
			end
		end,
		getHandler = function(inst: Instance)
			if inst:IsA("BasePart") then
				inst.Transparency = 0
			end
		end,
	})
end

function ObjectPool.Destroy(self: ObjectPool)
	for _, inst in self._available do
		inst:Destroy()
	end
	for inst in self._inUse do
		inst:Destroy()
	end
	table.clear(self._available)
	table.clear(self._inUse)
	self._totalCount = 0
end

return ObjectPool
]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX16"><Properties><string name="Name">Types</string></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Constants</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Constants
    Centralized game constants for game modes, round rules, economy values,
    operative IDs, map IDs, and UI theme configuration.
]=]

local Constants = {}

-- Game Modes
Constants.GameModes = {
	DUEL_1V1 = "1v1",
