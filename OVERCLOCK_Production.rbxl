-- Player profiles
local playerProfiles: { [number]: any } = {}

-- Practice Range tracking
local practiceRangePlayers: { [number]: boolean } = {}

local function onPlayerAdded(player: Player)
	DirectChallengeService.SetPlayerStatus(player, "In Lobby")

	task.spawn(function()
		local profile = ProfileServiceWrapper.LoadProfileAsync(player.UserId)
		if not profile then
			warn("[BOOT] Profile load failed for " .. player.Name .. ", using fallback.")
			local ok1, defaultData = pcall(function()
				return ProfileServiceWrapper.GetDefaultProfile(player.UserId, player.Name)
			end)
			if ok1 and defaultData then
				local ok2, fallback = pcall(function()
					return ProfileServiceWrapper.CreateInMemoryFallback(player.UserId, defaultData)
				end)
				if ok2 and fallback then
					profile = fallback
				end
			end
		end
		if profile then
			playerProfiles[player.UserId] = profile
			pcall(function()
				ProfileServiceWrapper.RegisterActiveProfile(player.UserId, profile)
			end)
		end
		print("[BOOT] Profile ready for " .. player.Name)
	end)
end

local function onPlayerRemoving(player: Player)
	if combatServerInstance then
		combatServerInstance:UnregisterPlayer(player.UserId)
	end
	practiceRangePlayers[player.UserId] = nil

	local profile = playerProfiles[player.UserId]
	if profile then
		pcall(function()
			if profile.SaveAsync then
				profile:SaveAsync()
			end
			if profile.ReleaseAsync then
				profile:ReleaseAsync()
			end
		end)
		pcall(function()
			ProfileServiceWrapper.UnregisterActiveProfile(player.UserId)
		end)
		playerProfiles[player.UserId] = nil
	end
end

-- 7. Match return + Practice Range remotes
local function returnPlayerToLobby(player: Player)
	practiceRangePlayers[player.UserId] = nil
	player:SetAttribute("IsPracticeRange", nil)
	if DirectChallengeService then
		DirectChallengeService.SetPlayerStatus(player, "In Lobby")
	end
	if combatServerInstance then
		combatServerInstance:RegisterPlayer(player.UserId)
	end
	if SpawnService then
		SpawnService.SpawnPlayer(player, "Lobby")
	end
	pcall(function()
		RemoteEvents.GetReliable("MatchPhaseTransition"):FireClient(player, { phase = "Lobby" })
	end)
end

-- Practice Range spawn helper — Roblox dev: must guarantee teleport, map exists, status consistent
local function spawnPlayerInPracticeRange(player: Player)
	-- Ensure map exists synchronously BEFORE spawn (async BuildMap may not have finished)
	local ws = Workspace
	if not ws:FindFirstChild("PracticeRangeMap") and PracticeRangeMapLayout and PracticeRangeMapLayout.BuildMap then
		local ok, folder = pcall(function()
			return PracticeRangeMapLayout.BuildMap(ws)
		end)
		if ok and folder then
			print("[BOOT] PracticeRangeMap built on-demand for " .. player.Name)
		end
		task.wait(0.1)
	end

	practiceRangePlayers[player.UserId] = true
	player:SetAttribute("IsPracticeRange", true)
	if DirectChallengeService then
		DirectChallengeService.SetPlayerStatus(player, "Practice Range")
	end
	-- Also set combat phase so damage works in range
	if combatServerInstance and combatServerInstance.SetMatchPhase then
		combatServerInstance:SetMatchPhase("PracticeRange")
	end
	local spawned = false
	if SpawnService then
		spawned = SpawnService.SpawnPlayer(player, "PracticeRange")
		print(("[PRACTICE] SpawnPlayer for %s -&gt; %s"):format(player.Name, tostring(spawned)))
		if not spawned then
			-- Retry once after lock clears
			task.wait(0.6)
			spawned = SpawnService.SpawnPlayer(player, "PracticeRange")
			print(("[PRACTICE] Retry SpawnPlayer for %s -&gt; %s"):format(player.Name, tostring(spawned)))
		end
		-- Force teleport again after character loads (covers PivotTo race)
		task.delay(0.35, function()
			if player.Parent and SpawnService.GetPlayerLocation(player) == "PracticeRange" then
				local dest = SpawnService.GetPlayerLocation(player) -- forces re-eval via Teleport
				-- Direct teleport to practice CFrame as safety net
				local ok, cf = pcall(function()
					-- reuse internal logic: build CFrame via PracticeRange fallback
					local layout = PracticeRangeMapLayout
					if layout and layout.GetSpawnPoints then
						local pts = layout.GetSpawnPoints()
						if #pts &gt; 0 then
							return CFrame.new(pts[1] + Vector3.new(0, 5, 0))
						end
					end
					return CFrame.new(500, 105, 60)
				end)
				if ok and cf then
					SpawnService.TeleportCharacter(player, cf)
				end
			end
		end)
	end
	if combatServerInstance then
		combatServerInstance:RegisterPlayer(player.UserId)
		if combatServerInstance.SetMatchPhase then
			combatServerInstance:SetMatchPhase("PracticeRange")
		end
	end
end

-- Death remote
pcall(function()
	RemoteEvents.GetReliable("PlayerDeath").OnServerEvent:Connect(function(player: Player, data: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if typeof(data) == "table" and data.returnToLobby == true then
			returnPlayerToLobby(player)
		end
	end)
end)

-- Match phase return
pcall(function()
	RemoteEvents.GetReliable("MatchPhaseTransition").OnServerEvent:Connect(function(player: Player, data: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if typeof(data) == "table" and data.action == "ReturnToLobby" then
			returnPlayerToLobby(player)
		end
	end)
end)

-- Enter Practice Range
pcall(function()
	RemoteEvents.GetReliable("EnterPracticeRange").OnServerEvent:Connect(function(player: Player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkRate(player, "EnterPracticeRange", 3, 1) then
			return
		end
		if DirectChallengeService and DirectChallengeService.GetPlayerStatus(player) ~= "In Lobby" then
			return
		end
		spawnPlayerInPracticeRange(player)
		pcall(function()
			RemoteEvents.GetReliable("MatchPhaseTransition"):FireClient(player, { phase = "PracticeRange" })
		end)
		pcall(function()
			if BotService and BotService.OnPlayerEnterRange then
				BotService.OnPlayerEnterRange(player)
			end
		end)
	end)
end)

-- Leave Practice Range
pcall(function()
	RemoteEvents.GetReliable("LeavePracticeRange").OnServerEvent:Connect(function(player: Player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		pcall(function()
			if BotService and BotService.OnPlayerLeaveRange then
				BotService.OnPlayerLeaveRange(player)
			end
		end)
		returnPlayerToLobby(player)
	end)
end)

-- Queue request
pcall(function()
	RemoteEvents.GetReliable("RequestQueue").OnServerEvent:Connect(function(player: Player, mode: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkRate(player, "RequestQueue", 3, 1) then
			return
		end
		if typeof(mode) ~= "string" or (mode ~= "1v1" and mode ~= "2v2") then
			return
		end
		if DirectChallengeService and DirectChallengeService.GetPlayerStatus(player) ~= "In Lobby" then
			return
		end
		pcall(function()
			QueueMatchmakingService.EnterQueue(player, mode)
		end)
	end)
end)

-- Cancel queue
pcall(function()
	RemoteEvents.GetReliable("CancelQueue").OnServerEvent:Connect(function(player: Player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		pcall(function()
			QueueMatchmakingService.LeaveQueue(player)
		end)
	end)
end)

-- Agent select
pcall(function()
	RemoteEvents.GetReliable("SelectAgent").OnServerEvent:Connect(function(player: Player, operativeId: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if typeof(operativeId) ~= "string" or #operativeId == 0 or #operativeId &gt; 50 then
			return
		end
		if not checkRate(player, "SelectAgent", 5, 2) then
			return
		end
		pcall(function()
			if OperativeService and OperativeService.SelectOperative then
				OperativeService.SelectOperative(player, operativeId)
			end
		end)
		-- Broadcast lock
		pcall(function()
			RemoteEvents.GetReliable("AgentLocked")
				:FireAllClients({ operativeId = operativeId, playerId = player.UserId })
		end)
	end)
end)

-- Ability usage
pcall(function()
	RemoteEvents.GetReliable("UseAbility").OnServerEvent:Connect(function(player: Player, data: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkRate(player, "UseAbility", 10, 8) then
			return
		end
		if typeof(data) ~= "table" then
			return
		end
		if
			typeof(data.slot) ~= "string" or (data.slot ~= "Basic" and data.slot ~= "Paid" and data.slot ~= "Ultimate")
		then
			return
		end
		pcall(function()
			if OperativeService and OperativeService.UseAbility then
				OperativeService.UseAbility(player, data.slot, data.targetPosition)
			end
		end)
	end)
end)

-- Weapon switching in practice range
pcall(function()
	RemoteEvents.GetReliable("SwitchWeapon").OnServerEvent:Connect(function(player: Player, weaponId: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkRate(player, "SwitchWeapon", 10, 5) then
			return
		end
		if typeof(weaponId) ~= "string" or #weaponId == 0 or #weaponId &gt; 50 then
			return
		end
		if not practiceRangePlayers[player.UserId] then
			return
		end
		pcall(function()
			RemoteEvents.GetReliable("EquipWeapon"):FireClient(player, weaponId)
		end)
	end)
end)

-- Operative switching in practice range
pcall(function()
	RemoteEvents.GetReliable("SwitchOperative").OnServerEvent:Connect(function(player: Player, operativeId: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkRate(player, "SwitchOperative", 10, 5) then
			return
		end
		if typeof(operativeId) ~= "string" or #operativeId == 0 or #operativeId &gt; 50 then
			return
		end
		if not practiceRangePlayers[player.UserId] then
			return
		end
		pcall(function()
			if OperativeService and OperativeService.SelectOperative then
				OperativeService.SelectOperative(player, operativeId)
			end
		end)
		pcall(function()
			RemoteEvents.GetReliable("SwitchOperative"):FireClient(player, operativeId)
		end)
	end)
end)

-- Purchase validation
pcall(function()
	RemoteEvents.GetReliable("RequestPurchase").OnServerEvent:Connect(function(player: Player, itemId: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkRate(player, "RequestPurchase", 10, 5) then
			return
		end
		if typeof(itemId) ~= "string" or #itemId == 0 or #itemId &gt; 50 then
			return
		end
		local success, reason, balance = false, "Invalid", 0
		pcall(function()
			if EconomyService and EconomyService.ProcessPurchaseRequest then
				success, reason, balance = EconomyService.ProcessPurchaseRequest(player, itemId)
			end
		end)
		pcall(function()
			RemoteEvents.GetReliable("PurchaseResult"):FireClient(player, {
				success = success,
				reason = reason,
				balance = balance,
				itemId = itemId,
			})
		end)
	end)
end)

-- Reset range stats
pcall(function()
	RemoteEvents.GetReliable("ResetRangeStats").OnServerEvent:Connect(function(player: Player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not practiceRangePlayers[player.UserId] then
			return
		end
		pcall(function()
			if BotService and BotService.ResetPlayerStats then
				BotService.ResetPlayerStats(player)
			end
		end)
	end)
end)

-- ProximityPrompt triggers (Lobby gates + Ammo Resupply Station) — production queue via gates
pcall(function()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return
		end
		local stationType = prompt:GetAttribute("StationType")
			or (prompt.Parent and prompt.Parent:GetAttribute("StationType"))
		if stationType == "AmmoResupply" then
			pcall(function()
				RemoteEvents.GetReliable("ResupplyAmmo"):FireClient(player)
			end)
			return
		end
		local triggerType = prompt:GetAttribute("TriggerType")
			or (prompt.Parent and prompt.Parent:GetAttribute("TriggerType"))
		if triggerType == "Play" then
			if DirectChallengeService and DirectChallengeService.GetPlayerStatus(player) ~= "In Lobby" then
				return
			end
			if not checkRate(player, "GatePlay", 3, 1) then
				return
			end
			pcall(function()
				QueueMatchmakingService.EnterQueue(player, "1v1")
			end)
		elseif triggerType == "Challenge" then
			-- Open challenge UI — FireClient to show player list (gate press)
			pcall(function()
				RemoteEvents.GetReliable("ChallengeReceive"):FireClient(player, { action = "OpenChallengeUI" })
			end)
		elseif triggerType == "Loadout" then
			pcall(function()
				RemoteEvents.GetReliable("ProfileSync"):FireClient(player, { action = "OpenLoadout" })
			end)
		elseif triggerType == "Settings" then
			pcall(function()
				RemoteEvents.GetReliable("ProfileSync"):FireClient(player, { action = "OpenSettings" })
			end)
		end
	end)
end)

-- 8. Connect player events
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in Players:GetPlayers() do
	onPlayerAdded(p)
end

print("[BOOT] 6/6 Server ready")
]]&gt;</ProtectedString></Properties></Item><Item class="Folder" referent="RBX88"><Properties><string name="Name">Diagnostics</string></Properties><Item class="ModuleScript" referent="RBX89"><Properties><string name="Name">SmokeTest</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: SmokeTest
    R6 Startup Smoke Test — Automatically verifies that all core dependencies,
    remotes, map folders, and services initialize without throwing errors.
    Runs 3 seconds after boot to let all safeInit tasks complete.
]=]

task.wait(3) -- Wait for Boot sequence in ServerMain to finish

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local totalTests = 0
local passedTests = 0
local failedTests: { string } = {}

local function check(label: string, condition: boolean, errMsg: string?)
	totalTests += 1
	if condition then
		passedTests += 1
	else
		table.insert(failedTests, label .. ": " .. (errMsg or "FAILED"))
	end
end

local function safeRequire(parent: Instance, childName: string): (boolean, any)
	local child = parent:FindFirstChild(childName)
	if not child then
		return false, "Module not found: " .. childName
	end
	return pcall(require, child)
end

local function runTests()
	print("[SMOKE TEST] Starting OVERCLOCK Server Smoke Test...")

	-- ========================================
	-- 1. Core Folder Structure
	-- ========================================
	local Services = ServerScriptService:FindFirstChild("Services")
	check("Services folder exists", Services ~= nil)

	local Combat = ServerScriptService:FindFirstChild("Combat")
	check("Combat folder exists", Combat ~= nil)

	local NetworkFolder = ReplicatedStorage:FindFirstChild("Network")
	check("Network folder exists", NetworkFolder ~= nil)

	local MapFolder = ReplicatedStorage:FindFirstChild("Map")
	check("Map folder exists", MapFolder ~= nil)

	local DataFolder = ReplicatedStorage:FindFirstChild("Data")
	check("Data folder exists", DataFolder ~= nil)

	-- ========================================
	-- 2. Critical Server Modules
	-- ========================================
	if Services then
		local criticalServices = {
			"SpawnService", "ProfileServiceWrapper", "DirectChallengeService",
			"QueueMatchmakingService", "OperativeService", "RoundService",
			"EconomyService", "BotService",
		}
		for _, name in criticalServices do
			local ok, err = safeRequire(Services, name)
			check("Require " .. name, ok, tostring(err))
		end
	end

	if Combat then
		local ok, err = safeRequire(Combat, "CombatServer")
		check("Require CombatServer", ok, tostring(err))
	end

	-- ========================================
	-- 3. Network Remotes
	-- ========================================
	if NetworkFolder then
		local ok, RemoteEvents = safeRequire(NetworkFolder, "RemoteEvents")
		check("Require RemoteEvents", ok, tostring(RemoteEvents))

		if ok and RemoteEvents then
			-- Verify the Remotes folder was created
			local remotesFolder = NetworkFolder:FindFirstChild("Remotes")
			check("[NETWORK] Remotes folder exists", remotesFolder ~= nil)

			if remotesFolder then
				local reliableFolder = remotesFolder:FindFirstChild("Reliable")
				local unreliableFolder = remotesFolder:FindFirstChild("Unreliable")
				local functionsFolder = remotesFolder:FindFirstChild("Functions")
				check("[NETWORK] Reliable subfolder exists", reliableFolder ~= nil)
				check("[NETWORK] Unreliable subfolder exists", unreliableFolder ~= nil)
				check("[NETWORK] Functions subfolder exists", functionsFolder ~= nil)

				-- Spot-check critical remotes
				if reliableFolder then
					local criticalRemotes = {
						"DamageDealt", "PlayerDeath", "MatchPhaseTransition",
						"EnterPracticeRange", "LeavePracticeRange",
						"RequestQueue", "CancelQueue", "SelectAgent",
					}
					for _, rName in criticalRemotes do
						check("[NETWORK] Remote: " .. rName, reliableFolder:FindFirstChild(rName) ~= nil)
					end
				end

				if unreliableFolder then
					check("[NETWORK] Remote: BulletTracer", unreliableFolder:FindFirstChild("BulletTracer") ~= nil)
				end
			end
		end
	end

	-- ========================================
	-- 4. Map System
	-- ========================================
	if MapFolder then
		local criticalMaps = { "MapRegistry", "LobbyFolder", "MapSafety", "PracticeRangeMapLayout" }
		for _, name in criticalMaps do
			local ok, err = safeRequire(MapFolder, name)
			check("Require " .. name, ok, tostring(err))
		end
	end

	-- Verify lobby map was built in Workspace
	local lobbyInWorkspace = Workspace:FindFirstChild("LobbyFolder")
	check("[MAP] LobbyFolder built in Workspace", lobbyInWorkspace ~= nil)

	-- Verify lobby has spawn locations
	if lobbyInWorkspace then
		local spawnLocations = lobbyInWorkspace:FindFirstChild("SpawnLocations")
		check("[MAP] LobbyFolder has SpawnLocations", spawnLocations ~= nil)
		if spawnLocations then
			local count = 0
			for _, child in spawnLocations:GetChildren() do
				if child:IsA("SpawnLocation") then count += 1 end
			end
			check("[MAP] Lobby has at least 1 SpawnLocation", count &gt; 0, "Found " .. count)
		end
	end

	-- Verify practice range was built
	local practiceRange = Workspace:FindFirstChild("PracticeRangeMap")
	check("[MAP] PracticeRangeMap built in Workspace", practiceRange ~= nil)

	-- ========================================
	-- 5. SpawnService Single Authority Check
	-- ========================================
	check("[SPAWN] CharacterAutoLoads is false", game:GetService("Players").CharacterAutoLoads == false)

	-- ========================================
	-- Results
	-- ========================================
	print(("[SMOKE TEST] Completed: %d/%d tests passed"):format(passedTests, totalTests))

	if #failedTests == 0 then
		print("[OVERCLOCK] ✅ Server Boot Sequence: PASSED (All systems nominal)")
	else
		warn("[OVERCLOCK] ❌ Server Boot Sequence: FAILED")
		for i, err in failedTests do
			warn(("  [FAIL %d] %s"):format(i, err))
		end
	end
end

runTests()
]]&gt;</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX20"><Properties /><Item class="Folder" referent="RBX21"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX22"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX90"><Properties><string name="Name">AnimationController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Procedural Animation &amp; Camera Controller
    Manages procedural camera recoil, weapon mouse sway, movement walk bobbing,
    and Aim-Down-Sights (ADS) camera FOV &amp; viewmodel transitions using damped spring physics
    and exponential decay Lerp math.
]=]

local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Spring = require(game:GetService("ReplicatedStorage"):WaitForChild("Physics"):WaitForChild("Spring"))

export type AnimationState = {
    isAiming: boolean,
    targetFov: number,
    currentFov: number,
    baseFov: number,
    adsAlpha: number, -- 0.0 (Hipfire) to 1.0 (ADS)
    walkSpeed: number,
    isGrounded: boolean,
}

local AnimationController = {}

local isInitialized = false

local loadedTracks: { [string]: AnimationTrack } = {}

-- Springs
local recoilSpring = Spring.new(0.2, 90.0, 12.0)
local swaySpring = Spring.new(0.2, 140.0, 14.0)
local bobbingSpring = Spring.new(0.25, 120.0, 12.0)

-- State
local state: AnimationState = {
    isAiming = false,
    targetFov = 70.0,
    currentFov = 70.0,
    baseFov = 70.0,
    adsAlpha = 0.0,
    walkSpeed = 0.0,
    isGrounded = true,
}

local bobPhase = 0.0

--[=[
    Exponential Decay Lerp utility function:
    current = Lerp(current, target, 1 - math.exp(-lambda * dt))
]=]
local function ExpDecayLerpNumber(current: number, target: number, lambda: number, dt: number): number
    local alpha = 1.0 - math.exp(-lambda * dt)
    return current + (target - current) * alpha
end

function AnimationController.Init(baseFov: number?): ()
    if isInitialized then
        return
    end

    local fov = baseFov or 70.0
    state.baseFov = fov
    state.targetFov = fov
    state.currentFov = fov
    state.adsAlpha = 0.0

    recoilSpring:Reset()
    swaySpring:Reset()
    bobbingSpring:Reset()

    local localPlayer = game:GetService("Players").LocalPlayer
    if localPlayer then
        localPlayer.CharacterAdded:Connect(function()
            AnimationController.ClearTracks()
        end)
    end

    isInitialized = true
end

function AnimationController.LoadTrack(humanoid: Humanoid, animationId: string, name: string): AnimationTrack?
    if loadedTracks[name] then
        return loadedTracks[name]
    end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = animationId
    local track = animator:LoadAnimation(anim)
    loadedTracks[name] = track
    return track
end

function AnimationController.PlayTrack(name: string)
    local track = loadedTracks[name]
    if track and not track.IsPlaying then
        track:Play()
    end
end

function AnimationController.StopTrack(name: string)
    local track = loadedTracks[name]
    if track and track.IsPlaying then
        track:Stop()
    end
end

function AnimationController.ClearTracks()
    for _, track in loadedTracks do
        track:Stop()
        track:Destroy()
    end
    table.clear(loadedTracks)
end

--[=[
    Triggers visual camera and viewmodel recoil impulse.
    compounds directly with existing momentum via Spring:Impulse.
]=]
function AnimationController.AddRecoil(impulse: Vector3): ()
    recoilSpring:Impulse(impulse)
end

--[=[
    Sets Aim-Down-Sights state and target FOV.
]=]
function AnimationController.SetADS(isAiming: boolean, targetAdsFov: number?): ()
    state.isAiming = isAiming
    state.targetFov = if isAiming then (targetAdsFov or 55.0) else state.baseFov
end

--[=[
    Updates movement status for procedural walk bobbing calculations.
]=]
function AnimationController.UpdateMovementState(humanoid: Humanoid): ()
    if not humanoid then return end
    state.walkSpeed = humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed
    state.isGrounded = humanoid:GetState() ~= Enum.HumanoidStateType.Freefall and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping
end

--[=[
    Performs frame physics update for procedural springs, sway, bobbing, and camera transitions.
]=]
function AnimationController.Update(dt: number): ()
    if not isInitialized then
        AnimationController.Init()
    end

    -- 1. Mouse Sway Update
    local mouseDelta = UserInputService:GetMouseDelta()
    if mouseDelta.Magnitude &gt; 0 then
        local swayMultiplier = if state.isAiming then 0.0003 else 0.001
        local swayImpulse = Vector3.new(
            -mouseDelta.Y * swayMultiplier,
            -mouseDelta.X * swayMultiplier,
            -mouseDelta.X * swayMultiplier * 0.5
        )
        swaySpring:Impulse(swayImpulse)
    end

    -- 2. Walk Bobbing Update
    if state.isGrounded and state.walkSpeed &gt; 1.0 then
        local bobFrequency = if state.isAiming then 8.0 else 12.0
        local bobIntensity = if state.isAiming then 0.05 else 0.15
        bobPhase = (bobPhase + dt * bobFrequency * (state.walkSpeed / 16.0)) % (2 * math.pi)

        local targetBobX = math.sin(bobPhase) * bobIntensity * 0.5
        local targetBobY = math.abs(math.cos(bobPhase)) * bobIntensity
        bobbingSpring:SetTarget(Vector3.new(targetBobX, targetBobY, 0))
    else
        bobbingSpring:SetTarget(Vector3.zero)
    end

    -- Update all springs
    recoilSpring:Update(dt)
    swaySpring:Update(dt)
    bobbingSpring:Update(dt)

    -- 3. Exponential Decay Lerp for ADS transitions
    local adsLambda = 14.0
    state.currentFov = ExpDecayLerpNumber(state.currentFov, state.targetFov, adsLambda, dt)

    local targetAdsAlpha = if state.isAiming then 1.0 else 0.0
    state.adsAlpha = ExpDecayLerpNumber(state.adsAlpha, targetAdsAlpha, adsLambda, dt)

    -- 4. Apply FOV to Current Camera
    local camera = Workspace.CurrentCamera
    if camera then
        camera.FieldOfView = state.currentFov
    end
end

--[=[
    Returns the procedural camera offset CFrame (recoil pitch/yaw/roll + camera bobbing).
]=]
function AnimationController.GetCameraOffset(): CFrame
    local recoilPos = recoilSpring.Position
    local bobPos = bobbingSpring.Position

    return CFrame.Angles(recoilPos.X, recoilPos.Y, recoilPos.Z)
        * CFrame.new(bobPos.X * 0.3, bobPos.Y * 0.3, 0)
end

--[=[
    Returns procedural viewmodel offset CFrame combining sway, bobbing, recoil kick, and ADS lerp.
]=]
function AnimationController.GetViewmodelOffset(): CFrame
    local recoilPos = recoilSpring.Position
    local swayPos = swaySpring.Position
    local bobPos = bobbingSpring.Position

    -- Viewmodel kickback from Z recoil
    local kickCFrame = CFrame.new(0, 0, recoilPos.Z * 0.5)
    local swayCFrame = CFrame.Angles(swayPos.X, swayPos.Y, swayPos.Z) * CFrame.new(swayPos.Y * 0.2, -swayPos.X * 0.2, 0)
    local bobbingCFrame = CFrame.new(bobPos.X, bobPos.Y, 0)

    -- Combine hipfire procedural offsets
    local combinedHipfire = swayCFrame * bobbingCFrame * kickCFrame

    -- Lerp towards ADS centered CFrame (reduced sway and bobbing in ADS)
    local adsReducedHipfire = CFrame.new():Lerp(combinedHipfire, 1.0 - state.adsAlpha * 0.7)

    return adsReducedHipfire
end

function AnimationController.GetADSAlpha(): number
    return state.adsAlpha
end

function AnimationController.GetState(): AnimationState
    return state
end

return AnimationController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX91"><Properties><string name="Name">CrosshairController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Dynamic Crosshair Controller
    Translates mathematical bullet spread (in degrees) into precise 2D screen pixel offsets,
    guaranteeing exact mapping between 2D UI reticle and 3D unit raycast direction vectors.
]=]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

export type DynamicCrosshairSettings = {
    color: Color3,
    lineLength: number,
    lineThickness: number,
    centerDot: boolean,
    hitmarkerColorBody: Color3,
    hitmarkerColorHead: Color3,
}

local DEFAULT_SETTINGS: DynamicCrosshairSettings = {
    color = Color3.fromRGB(0, 255, 150), -- A nice cyan/green color that stands out
    lineLength = 6,
    lineThickness = 2,
    centerDot = true,
    hitmarkerColorBody = Color3.fromRGB(255, 255, 255),
    hitmarkerColorHead = Color3.fromRGB(255, 50, 50),
}

local CrosshairController = {}

local isInitialized = false
local currentPixelGap = 4
local targetPixelGap = 4
local hitmarkerTimer = 0
local isHitmarkerHeadshot = false

-- UI Element references
local screenGui: ScreenGui? = nil
local centerFrame: Frame? = nil
local topArm: Frame? = nil
local bottomArm: Frame? = nil
local leftArm: Frame? = nil
local rightArm: Frame? = nil
local centerDotArm: Frame? = nil
local hitmarkerGuiFrame: Frame? = nil

--[=[
    Calculates exact 2D pixel gap from mathematical 3D cone spread angle (in degrees).
    Uses camera perspective projection: Radius_px = FocalLength_px * tan(SpreadAngle)
]=]
function CrosshairController.CalculateSpreadPixelOffset(
    spreadDegrees: number,
    cameraFov: number,
    viewportSize: Vector2
): number
    if spreadDegrees &lt;= 0 or cameraFov &lt;= 0 or viewportSize.Y &lt;= 0 then
        return 2 -- Minimum base offset
    end

    local halfFovRad = math.rad(cameraFov / 2)
    local focalLengthPx = viewportSize.Y / (2 * math.tan(halfFovRad))
    local spreadRad = math.rad(spreadDegrees)
    local radiusPx = focalLengthPx * math.tan(spreadRad)

    return math.clamp(radiusPx, 2, math.max(2, viewportSize.Y * 0.4))
end

--[=[
    Maps 3D camera CFrame and mathematical spread (in degrees) to a 3D unit direction vector.
    Guarantees exact geometric parity between the 2D visual crosshair and 3D raycast spread cone.
]=]
function CrosshairController.GetSpreadDirection(
    camCFrame: CFrame,
    spreadDegrees: number,
    randomSeed: number?
): Vector3
    if spreadDegrees &lt;= 0 then
        return camCFrame.LookVector
    end

    local rng = if randomSeed then Random.new(randomSeed) else Random.new()
    local spreadRad = math.rad(spreadDegrees / 2)
    local maxRadius = math.tan(spreadRad)

    -- Uniform random distribution within spread disc
    local theta = rng:NextNumber(0, 2 * math.pi)
    local r = math.sqrt(rng:NextNumber(0, 1)) * maxRadius

    local offsetX = r * math.cos(theta)
    local offsetY = r * math.sin(theta)

    -- Camera local direction (-Z is forward)
    local localDirection = Vector3.new(offsetX, offsetY, -1).Unit
    return camCFrame:VectorToWorldSpace(localDirection)
end

local function BuildUI()
    local localPlayer = Players.LocalPlayer
    if not localPlayer then
        return
    end

    local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then
        return
    end

    -- Clean up prior instance if existing
    local existing = playerGui:FindFirstChild("OverclockCrosshairGui") or playerGui:FindFirstChild("RivalsCrosshairGui")
    if existing then
        existing:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "OverclockCrosshairGui"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "CenterContainer"
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.BackgroundTransparency = 1
    mainFrame.Parent = gui

    -- Reticle center container
    local center = Instance.new("Frame")
    center.Name = "Reticle"
    center.Size = UDim2.new(0, 0, 0, 0)
    center.Position = UDim2.new(0.5, 0, 0.5, 0)
    center.BackgroundTransparency = 1
    center.Parent = mainFrame
    centerFrame = center

    local function addStroke(parent: Instance)
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.new(0, 0, 0)
        stroke.Thickness = 1
        stroke.Transparency = 0.5
        stroke.Parent = parent
    end

    -- Top Arm
    topArm = Instance.new("Frame")
    topArm.Name = "Top"
    topArm.AnchorPoint = Vector2.new(0.5, 1)
    topArm.Size = UDim2.new(0, DEFAULT_SETTINGS.lineThickness, 0, DEFAULT_SETTINGS.lineLength)
    topArm.BackgroundColor3 = DEFAULT_SETTINGS.color
    topArm.BorderSizePixel = 0
    topArm.Parent = center
    addStroke(topArm)

    -- Bottom Arm
    bottomArm = Instance.new("Frame")
    bottomArm.Name = "Bottom"
    bottomArm.AnchorPoint = Vector2.new(0.5, 0)
    bottomArm.Size = UDim2.new(0, DEFAULT_SETTINGS.lineThickness, 0, DEFAULT_SETTINGS.lineLength)
    bottomArm.BackgroundColor3 = DEFAULT_SETTINGS.color
    bottomArm.BorderSizePixel = 0
    bottomArm.Parent = center
    addStroke(bottomArm)

    -- Left Arm
    leftArm = Instance.new("Frame")
    leftArm.Name = "Left"
    leftArm.AnchorPoint = Vector2.new(1, 0.5)
    leftArm.Size = UDim2.new(0, DEFAULT_SETTINGS.lineLength, 0, DEFAULT_SETTINGS.lineThickness)
    leftArm.BackgroundColor3 = DEFAULT_SETTINGS.color
    leftArm.BorderSizePixel = 0
    leftArm.Parent = center
    addStroke(leftArm)

    -- Right Arm
    rightArm = Instance.new("Frame")
    rightArm.Name = "Right"
    rightArm.AnchorPoint = Vector2.new(0, 0.5)
    rightArm.Size = UDim2.new(0, DEFAULT_SETTINGS.lineLength, 0, DEFAULT_SETTINGS.lineThickness)
    rightArm.BackgroundColor3 = DEFAULT_SETTINGS.color
    rightArm.BorderSizePixel = 0
    rightArm.Parent = center
    addStroke(rightArm)

    -- Center Dot
    centerDotArm = Instance.new("Frame")
    centerDotArm.Name = "CenterDot"
    centerDotArm.AnchorPoint = Vector2.new(0.5, 0.5)
    centerDotArm.Size = UDim2.new(0, DEFAULT_SETTINGS.lineThickness + 2, 0, DEFAULT_SETTINGS.lineThickness + 2)
    centerDotArm.Position = UDim2.new(0, 0, 0, 0)
    centerDotArm.BackgroundColor3 = DEFAULT_SETTINGS.color
    centerDotArm.BorderSizePixel = 0
    centerDotArm.Visible = DEFAULT_SETTINGS.centerDot
    centerDotArm.Parent = center
    addStroke(centerDotArm)

    -- Hitmarker Container
    hitmarkerGuiFrame = Instance.new("Frame")
    hitmarkerGuiFrame.Name = "Hitmarker"
    hitmarkerGuiFrame.Size = UDim2.new(0, 16, 0, 16)
    hitmarkerGuiFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    hitmarkerGuiFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    hitmarkerGuiFrame.BackgroundTransparency = 1
    hitmarkerGuiFrame.Visible = false
    hitmarkerGuiFrame.Parent = mainFrame

    -- Create 4 diagonal hitmarker arms
    for i = 1, 4 do
        local arm = Instance.new("Frame")
        arm.Name = "Arm" .. i
        arm.Size = UDim2.new(0, 6, 0, 2)
        arm.AnchorPoint = Vector2.new(0.5, 0.5)
        arm.Position = UDim2.new(0.5, 0, 0.5, 0)
        arm.Rotation = (i - 1) * 90 + 45
        arm.BackgroundColor3 = DEFAULT_SETTINGS.hitmarkerColorBody
        arm.BorderSizePixel = 0
        arm.Parent = hitmarkerGuiFrame
    end

    gui.Parent = playerGui
    screenGui = gui
end

function CrosshairController.Init(): ()
    if isInitialized then
        return
    end

    BuildUI()
    isInitialized = true
end

function CrosshairController.ShowHitmarker(isHeadshot: boolean): ()
    hitmarkerTimer = 0.15 -- Active for 150ms
    isHitmarkerHeadshot = isHeadshot

    if hitmarkerGuiFrame then
        local color = if isHeadshot
            then DEFAULT_SETTINGS.hitmarkerColorHead
            else DEFAULT_SETTINGS.hitmarkerColorBody
        for _, child in ipairs(hitmarkerGuiFrame:GetChildren()) do
            if child:IsA("Frame") then
                child.BackgroundColor3 = color
            end
        end
        hitmarkerGuiFrame.Visible = true
    end
end

function CrosshairController.Update(dt: number, currentSpreadDegrees: number): ()
    if not isInitialized then
        CrosshairController.Init()
    end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    -- 1. Compute target pixel gap from current 3D spread angle
    targetPixelGap = CrosshairController.CalculateSpreadPixelOffset(
        currentSpreadDegrees,
        camera.FieldOfView,
        camera.ViewportSize
    )

    -- Exponential decay Lerp transition for smooth dynamic crosshair spread expansion/contraction
    local lambda = 25.0
    currentPixelGap += (targetPixelGap - currentPixelGap) * (1 - math.exp(-lambda * dt))

    local gapInt = math.max(2, math.floor(currentPixelGap + 0.5))

    -- Update arm positions
    if topArm then
        topArm.Position = UDim2.new(0, 0, 0, -gapInt)
    end
    if bottomArm then
        bottomArm.Position = UDim2.new(0, 0, 0, gapInt)
    end
    if leftArm then
        leftArm.Position = UDim2.new(0, -gapInt, 0, 0)
    end
    if rightArm then
        rightArm.Position = UDim2.new(0, gapInt, 0, 0)
    end

    -- 2. Update hitmarker countdown animation
    if hitmarkerTimer &gt; 0 then
        hitmarkerTimer -= dt
        if hitmarkerTimer &lt;= 0 then
            if hitmarkerGuiFrame then
                hitmarkerGuiFrame.Visible = false
            end
        end
    end
end

function CrosshairController.SetVisible(visible: boolean): ()
    if screenGui then
        screenGui.Enabled = visible
    end
end

return CrosshairController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX92"><Properties><string name="Name">LobbyTransitionController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: LobbyTransitionController
    Strict Luau controller managing smooth screen fade and blur transitions
    between Lobby and Match states, including camera mode management.
]=]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

export type TransitionState = "Lobby" | "TransitioningToMatch" | "Match" | "TransitioningToLobby"

type TransitionCallback = () -&gt; ()

local LobbyTransitionController = {}

local currentState: TransitionState = "Lobby"
local isBusy: boolean = false

local screenGui: ScreenGui? = nil
local fadeOverlay: CanvasGroup? = nil
local blurEffect: BlurEffect? = nil
local activeTweens = {}

local function cancelActiveTweens()
	for _, tw in ipairs(activeTweens) do
		pcall(function() tw:Cancel() end)
	end
	table.clear(activeTweens)
end

local function getOrCreateBlur(): BlurEffect
	if blurEffect and blurEffect.Parent then
		return blurEffect
	end

	local existing = Lighting:FindFirstChild("LobbyBlurEffect")
	if existing and existing:IsA("BlurEffect") then
		blurEffect = existing
		return existing
	end

	local blur = Instance.new("BlurEffect")
	blur.Name = "LobbyBlurEffect"
	blur.Size = 0
	blur.Enabled = true
	blur.Parent = Lighting
	blurEffect = blur
	return blur
end

function LobbyTransitionController.Init(parentGui: PlayerGui?)
	local pGui = parentGui or Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

	local existing = pGui:FindFirstChild("LobbyTransitionGui")
	if existing then
		existing:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "LobbyTransitionGui"
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = pGui
	screenGui = gui

	local canvas = Instance.new("CanvasGroup")
	canvas.Name = "FadeCanvasGroup"
	canvas.Size = UDim2.new(1, 0, 1, 0)
	canvas.Position = UDim2.new(0, 0, 0, 0)
	canvas.BackgroundColor3 = Color3.fromRGB(8, 10, 15)
	canvas.GroupTransparency = 1
	canvas.Visible = false
	canvas.Parent = gui
	fadeOverlay = canvas

	local innerFrame = Instance.new("Frame")
	innerFrame.Name = "Fill"
	innerFrame.Size = UDim2.new(1, 0, 1, 0)
	innerFrame.BackgroundColor3 = Color3.fromRGB(8, 10, 15)
	innerFrame.BorderSizePixel = 0
	innerFrame.Parent = canvas

	getOrCreateBlur()
end

function LobbyTransitionController.IsTransitioning(): boolean
	return isBusy
end

function LobbyTransitionController.GetState(): TransitionState
	return currentState
end

function LobbyTransitionController.TransitionToMatch(
	duration: number?,
	onMidpoint: TransitionCallback?,
	onComplete: TransitionCallback?
)
	if isBusy then
		warn("[LobbyTransitionController] Transition already in progress!")
		return
	end

	isBusy = true
	currentState = "TransitioningToMatch"

	local totalDuration = duration or 1.2
	local halfDuration = totalDuration / 2
	local blur = getOrCreateBlur()

	if not fadeOverlay then
		if screenGui then
			LobbyTransitionController.Init(screenGui.Parent :: PlayerGui)
		end
	end

	local overlay = fadeOverlay
	if not overlay then
		isBusy = false
		return
	end

	overlay.Visible = true
	overlay.GroupTransparency = 1

	-- 1. Fade to Black &amp; Increase Blur
	local tweenInfo = TweenInfo.new(halfDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	cancelActiveTweens()
	local fadeOutTween = TweenService:Create(overlay, tweenInfo, { GroupTransparency = 0 })
	local blurUpTween = TweenService:Create(blur, tweenInfo, { Size = 28 })
	table.insert(activeTweens, fadeOutTween)
	table.insert(activeTweens, blurUpTween)

	fadeOutTween:Play()
	blurUpTween:Play()

	fadeOutTween.Completed:Connect(function()
		-- Midpoint reached: screen fully obscured
		local player = Players.LocalPlayer
		local char = player.Character
		local camera = Workspace.CurrentCamera

		if camera and char then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraType = Enum.CameraType.Custom
				camera.CameraSubject = humanoid
			end
		end

		if camera and camera.CameraType == Enum.CameraType.Scriptable then
			local conn
			conn = player.CharacterAdded:Connect(function()
				camera.CameraType = Enum.CameraType.Custom
				if conn then conn:Disconnect() end
			end)
			task.delay(10, function()
				if camera and camera.CameraType == Enum.CameraType.Scriptable then
					camera.CameraType = Enum.CameraType.Custom
				end
				if conn then conn:Disconnect() end
			end)
		end

		if onMidpoint then
			onMidpoint()
		end

		-- 2. Fade in from Black to Game View &amp; Clear Blur
		local tweenInInfo = TweenInfo.new(halfDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local fadeInTween = TweenService:Create(overlay, tweenInInfo, { GroupTransparency = 1 })
		local blurDownTween = TweenService:Create(blur, tweenInInfo, { Size = 0 })
		table.insert(activeTweens, fadeInTween)
		table.insert(activeTweens, blurDownTween)

		fadeInTween:Play()
		blurDownTween:Play()

		fadeInTween.Completed:Connect(function()
			overlay.Visible = false
			currentState = "Match"
			isBusy = false

			if onComplete then
				onComplete()
			end
		end)
	end)
end

function LobbyTransitionController.TransitionToLobby(
	duration: number?,
	onMidpoint: TransitionCallback?,
	onComplete: TransitionCallback?
)
	if isBusy then
		warn("[LobbyTransitionController] Transition already in progress!")
		return
	end

	isBusy = true
	currentState = "TransitioningToLobby"

	local totalDuration = duration or 1.2
	local halfDuration = totalDuration / 2
	local blur = getOrCreateBlur()

	if not fadeOverlay then
		if screenGui then
			LobbyTransitionController.Init(screenGui.Parent :: PlayerGui)
		end
	end

	local overlay = fadeOverlay
	if not overlay then
		isBusy = false
		return
	end

	overlay.Visible = true
	overlay.GroupTransparency = 1

	-- 1. Fade to Black
	local tweenInfo = TweenInfo.new(halfDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	cancelActiveTweens()
	local fadeOutTween = TweenService:Create(overlay, tweenInfo, { GroupTransparency = 0 })
	table.insert(activeTweens, fadeOutTween)

	fadeOutTween:Play()

	fadeOutTween.Completed:Connect(function()
		-- Midpoint reached
		local camera = Workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Scriptable
		end

		if onMidpoint then
			onMidpoint()
		end

		-- 2. Fade in to Lobby View &amp; Set Lobby Ambient Blur
		local tweenInInfo = TweenInfo.new(halfDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local fadeInTween = TweenService:Create(overlay, tweenInInfo, { GroupTransparency = 1 })
		local blurTween = TweenService:Create(blur, tweenInInfo, { Size = 12 })
		table.insert(activeTweens, fadeInTween)
		table.insert(activeTweens, blurTween)

		fadeInTween:Play()
		blurTween:Play()

		fadeInTween.Completed:Connect(function()
			overlay.Visible = false
			currentState = "Lobby"
			isBusy = false

			if onComplete then
				onComplete()
			end
		end)
	end)
end

return LobbyTransitionController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX93"><Properties><string name="Name">MobileControlsController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: MobileControlsController
    Ergonomic mobile interface controller with floating combat buttons,
    a persistent menu toggle button, and scope/ADS visual feedback.
    Uses ContextActionService combat action binding with dynamic bind/unbind support.
    Maintains UI ergonomics by enforcing ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
    and positioning touch buttons with UDim2 Scale and a 1:1 UIAspectRatioConstraint.
]=]

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Spring = require(ReplicatedStorage:WaitForChild("Physics"):WaitForChild("Spring") :: any)

export type ActionHandler = (actionName: string, inputState: Enum.UserInputState, inputObject: InputObject) -&gt; Enum.ContextActionResult?

export type CombatActionCallbacks = {
	onFire: ActionHandler?,
	onReload: ActionHandler?,
	onAim: ActionHandler?,
	onCrouch: ActionHandler?,
	onJump: ActionHandler?,
}

export type MobileControlsControllerImpl = {
	Init: (targetPlayerGui: PlayerGui?) -&gt; (),
	BindCombatActions: (callbacks: CombatActionCallbacks) -&gt; (),
	UnbindCombatActions: () -&gt; (),
	SetActionEnabled: (actionName: string, enabled: boolean) -&gt; (),
	SetCombatVisible: (visible: boolean) -&gt; (),
	SetMenuButtonVisible: (visible: boolean) -&gt; (),
	IsMobile: () -&gt; boolean,
	GetTouchGui: () -&gt; ScreenGui?,
}

local MobileControlsController = {} :: MobileControlsControllerImpl

local touchScreenGui: ScreenGui? = nil
local boundActions: { [string]: boolean } = {}

-- Custom touch button references for styling
local customButtons: { [string]: Frame } = {}
local buttonSprings: { [string]: any } = {}
local combatContainer: Frame? = nil
local menuToggleButton: TextButton? = nil
local aimButtonRef: Frame? = nil
local isAimActive = false
local renderConnection: RBXScriptConnection? = nil

-- ============================================================
-- Custom Button Factory (much better than ContextActionService defaults)
-- ============================================================
local function createTouchButton(
	parent: Instance,
	name: string,
	label: string,
	position: UDim2,
	size: UDim2,
	color: Color3,
	iconText: string?
): Frame
	local container = Instance.new("Frame")
	container.Name = name .. "Container"
	container.Size = size
	container.Position = position
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
	container.BackgroundTransparency = 0.3
	container.BorderSizePixel = 0
	container.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)  -- Fully circular
	corner.Parent = container

	local stroke = Instance.new("UIStroke")
	stroke.Name = "ButtonStroke"
	stroke.Color = color
	stroke.Thickness = 2
	stroke.Transparency = 0.3
	stroke.Parent = container

	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1.0
	aspect.DominantAxis = Enum.DominantAxis.Width
	aspect.Parent = container

	-- Icon/Text label
	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "ButtonLabel"
	textLabel.Size = UDim2.new(1, 0, 0.4, 0)
	textLabel.Position = UDim2.new(0, 0, 0.55, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = label
	textLabel.TextColor3 = Color3.fromRGB(200, 210, 225)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 10
	textLabel.TextScaled = true
	textLabel.Parent = container

	local textSizeConstraint = Instance.new("UITextSizeConstraint")
	textSizeConstraint.MaxTextSize = 12
	textSizeConstraint.Parent = textLabel

	if iconText then
		local icon = Instance.new("TextLabel")
		icon.Name = "Icon"
		icon.Size = UDim2.new(0.6, 0, 0.4, 0)
		icon.Position = UDim2.new(0.2, 0, 0.1, 0)
		icon.BackgroundTransparency = 1
		icon.Text = iconText
		icon.TextColor3 = color
		icon.Font = Enum.Font.GothamBold
		icon.TextSize = 18
		icon.TextScaled = true
		icon.Parent = container

		local iconConstraint = Instance.new("UITextSizeConstraint")
		iconConstraint.MaxTextSize = 22
		iconConstraint.Parent = icon
	end

	-- Inner glow
	local glow = Instance.new("Frame")
	glow.Name = "InnerGlow"
	glow.Size = UDim2.new(0.85, 0, 0.85, 0)
	glow.Position = UDim2.new(0.5, 0, 0.5, 0)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.BackgroundColor3 = color
	glow.BackgroundTransparency = 0.85
	glow.BorderSizePixel = 0
	glow.Parent = container

	local glowCorner = Instance.new("UICorner")
	glowCorner.CornerRadius = UDim.new(1, 0)
	glowCorner.Parent = glow

	-- Invisible input capture button on top
	local inputBtn = Instance.new("TextButton")
	inputBtn.Name = "InputCapture"
	inputBtn.Size = UDim2.new(1, 0, 1, 0)
	inputBtn.BackgroundTransparency = 1
	inputBtn.Text = ""
	inputBtn.ZIndex = 10
	inputBtn.Parent = container

	local scale = Instance.new("UIScale")
	scale.Name = "UIScale"
	scale.Parent = container

	-- Initialize physics spring for this button
	local spring = Spring.new(1.0)
	spring.Speed = 25
	spring.Damper = 0.55
	buttonSprings[name] = spring

	inputBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			buttonSprings[name].Target = 0.85
		end
	end)
	
	inputBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			buttonSprings[name].Target = 1.0
		end
	end)

	customButtons[name] = container
	return container
end

-- ============================================================
-- Init
-- ============================================================
function MobileControlsController.Init(targetPlayerGui: PlayerGui?)
	local pGui = targetPlayerGui or Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

	-- Remove old GUI
	local existing = pGui:FindFirstChild("MobileTouchGui")
	if existing then existing:Destroy() end

	local touchGui = Instance.new("ScreenGui")
	touchGui.Name = "MobileTouchGui"
	touchGui.DisplayOrder = 100
	touchGui.ResetOnSpawn = false
	touchGui.ScreenInsets = Enum.ScreenInsets.None
	touchGui.Parent = pGui
	touchScreenGui = touchGui

	-- Combat buttons container (hidden until combat mode)
	local combatFrame = Instance.new("Frame")
	combatFrame.Name = "CombatButtonsFrame"
	combatFrame.Size = UDim2.new(1, 0, 1, 0)
	combatFrame.BackgroundTransparency = 1
	combatFrame.Visible = false
	combatFrame.Parent = touchGui
	combatContainer = combatFrame

	-- Create the menu toggle button (always visible on mobile)
	local menuBtn = Instance.new("TextButton")
	menuBtn.Name = "MenuToggleButton"
	menuBtn.Size = UDim2.new(0, 44, 0, 44)
	menuBtn.Position = UDim2.new(0, 12, 0, 12)
	menuBtn.BackgroundColor3 = Color3.fromRGB(20, 24, 35)
	menuBtn.BackgroundTransparency = 0.2
	menuBtn.Text = "☰"
	menuBtn.TextColor3 = Color3.fromRGB(0, 220, 255)
	menuBtn.Font = Enum.Font.GothamBold
	menuBtn.TextSize = 22
	menuBtn.BorderSizePixel = 0
	menuBtn.ZIndex = 50
	menuBtn.Parent = touchGui

	local menuCorner = Instance.new("UICorner")
	menuCorner.CornerRadius = UDim.new(0, 10)
	menuCorner.Parent = menuBtn

	local menuStroke = Instance.new("UIStroke")
	menuStroke.Color = Color3.fromRGB(0, 180, 255)
	menuStroke.Thickness = 1.5
	menuStroke.Transparency = 0.4
	menuStroke.Parent = menuBtn

	menuToggleButton = menuBtn

	if renderConnection then renderConnection:Disconnect() end
	renderConnection = RunService.RenderStepped:Connect(function(dt)
		for btnName, spring in pairs(buttonSprings) do
			local btn = customButtons[btnName]
			if btn then
				local scale = btn:FindFirstChild("UIScale") :: UIScale?
				if scale then
					scale.Scale = spring.Position
				end
			end
		end
	end)
end

function MobileControlsController.IsMobile(): boolean
	return UserInputService.TouchEnabled
end

-- ============================================================
-- Combat Action Binding
-- ============================================================
function MobileControlsController.BindCombatActions(callbacks: CombatActionCallbacks)
	if not combatContainer then return end
	local container = combatContainer :: Frame

	-- Clear old custom buttons
	for name, btn in customButtons do
		btn:Destroy()
	end
	table.clear(customButtons)

	-- FIRE button — large, right side
	local fireBtn = createTouchButton(
		container, "CombatFire", "FIRE",
		UDim2.new(0.87, 0, 0.65, 0),
		UDim2.new(0.16, 0, 0.16, 0),
		Color3.fromRGB(255, 60, 60),
		"🔥"
	)
	local fireInput = fireBtn:FindFirstChild("InputCapture") :: TextButton
	if fireInput and callbacks.onFire then
		local handler = callbacks.onFire
		local activeTouchId = nil
		fireInput.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				local currentId = input.UserInputType == Enum.UserInputType.Touch and input.UserInputIndex or Enum.UserInputType.MouseButton1
				if activeTouchId == nil then
					activeTouchId = currentId
					handler("CombatFire", Enum.UserInputState.Begin, input)
				end
			end
		end)
		fireInput.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				local currentId = input.UserInputType == Enum.UserInputType.Touch and input.UserInputIndex or Enum.UserInputType.MouseButton1
				if activeTouchId == currentId then
					activeTouchId = nil
					handler("CombatFire", Enum.UserInputState.End, input)
				end
			end
		end)
	end

	-- AIM / SCOPE button — right side, above fire
	local aimBtn = createTouchButton(
		container, "CombatAim", "AIM",
		UDim2.new(0.72, 0, 0.45, 0),
		UDim2.new(0.12, 0, 0.12, 0),
		Color3.fromRGB(0, 200, 255),
		"🎯"
	)
	aimButtonRef = aimBtn
	local aimInput = aimBtn:FindFirstChild("InputCapture") :: TextButton
	if aimInput and callbacks.onAim then
		local handler = callbacks.onAim
		aimInput.MouseButton1Click:Connect(function()
			isAimActive = not isAimActive
			if isAimActive then
				handler("CombatAim", Enum.UserInputState.Begin, {} :: any)
				-- Visual feedback: glow the AIM button
				local stroke = aimBtn:FindFirstChild("ButtonStroke") :: UIStroke?
				local glow = aimBtn:FindFirstChild("InnerGlow") :: Frame?
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0, Thickness = 3 }):Play()
				end
				if glow then
					TweenService:Create(glow, TweenInfo.new(0.15), { BackgroundTransparency = 0.5 }):Play()
				end
			else
				handler("CombatAim", Enum.UserInputState.End, {} :: any)
				local stroke = aimBtn:FindFirstChild("ButtonStroke") :: UIStroke?
				local glow = aimBtn:FindFirstChild("InnerGlow") :: Frame?
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.3, Thickness = 2 }):Play()
				end
				if glow then
					TweenService:Create(glow, TweenInfo.new(0.15), { BackgroundTransparency = 0.85 }):Play()
				end
			end
		end)
	end

	-- RELOAD button — right side, below fire
	local reloadBtn = createTouchButton(
		container, "CombatReload", "RELOAD",
		UDim2.new(0.72, 0, 0.82, 0),
		UDim2.new(0.11, 0, 0.11, 0),
		Color3.fromRGB(255, 200, 0),
		"🔄"
	)
	local reloadInput = reloadBtn:FindFirstChild("InputCapture") :: TextButton
	if reloadInput and callbacks.onReload then
		local handler = callbacks.onReload
		reloadInput.MouseButton1Click:Connect(function()
			handler("CombatReload", Enum.UserInputState.Begin, {} :: any)
		end)
	end

	-- CROUCH button — bottom right area
	local crouchBtn = createTouchButton(
		container, "CombatCrouch", "CROUCH",
		UDim2.new(0.87, 0, 0.35, 0),
		UDim2.new(0.09, 0, 0.09, 0),
		Color3.fromRGB(180, 100, 255),
		"⬇"
	)
	local crouchInput = crouchBtn:FindFirstChild("InputCapture") :: TextButton
	if crouchInput and callbacks.onCrouch then
		local handler = callbacks.onCrouch
		crouchInput.MouseButton1Click:Connect(function()
			handler("CombatCrouch", Enum.UserInputState.Begin, {} :: any)
		end)
	end

	-- JUMP button — bottom right
	local jumpBtn = createTouchButton(
		container, "CombatJump", "JUMP",
		UDim2.new(0.87, 0, 0.18, 0),
		UDim2.new(0.09, 0, 0.09, 0),
		Color3.fromRGB(80, 255, 120),
		"⬆"
	)
	local jumpInput = jumpBtn:FindFirstChild("InputCapture") :: TextButton
	if jumpInput and callbacks.onJump then
		local handler = callbacks.onJump
		jumpInput.MouseButton1Down:Connect(function()
			handler("CombatJump", Enum.UserInputState.Begin, {} :: any)
		end)
		jumpInput.MouseButton1Up:Connect(function()
			handler("CombatJump", Enum.UserInputState.End, {} :: any)
		end)
	end

	-- Mark all as bound
	for name, _ in customButtons do
		boundActions[name] = true
	end
end

function MobileControlsController.UnbindCombatActions()
	for name, btn in customButtons do
		btn:Destroy()
	end
	table.clear(customButtons)
	table.clear(boundActions)
	table.clear(buttonSprings)
	isAimActive = false
end

function MobileControlsController.SetCombatVisible(visible: boolean)
	if combatContainer then
		combatContainer.Visible = visible
	end
	-- Reset aim state when hiding
	if not visible then
		isAimActive = false
	end
end

function MobileControlsController.SetMenuButtonVisible(visible: boolean)
	if menuToggleButton then
		menuToggleButton.Visible = visible
	end
end

function MobileControlsController.SetActionEnabled(actionName: string, enabled: boolean)
	local btn = customButtons[actionName]
	if btn then
		btn.Visible = enabled
	end
end

function MobileControlsController.GetTouchGui(): ScreenGui?
	return touchScreenGui
end

function MobileControlsController.GetMenuButton(): TextButton?
	return menuToggleButton
end

return MobileControlsController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX94"><Properties><string name="Name">MovementController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: MovementController
    Handles custom momentum (acceleration/friction) and walk/sprint states.
]=]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents"))
local BufferSerializer = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("BufferSerializer") :: any)

local LocalPlayer = Players.LocalPlayer
local PlayerModule = nil

-- Attempt to load PlayerModule safely
task.spawn(function()
    local pm = LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
    PlayerModule = require(pm)
end)

local MovementController = {}

-- Config
local BASE_RUN_SPEED = 18.0
local WALK_SPEED = 9.0
local ACCELERATION = 14.0
local FRICTION = 10.0

local isWalking = false
local crouchActive = false
local CROUCH_SPEED = 8

function MovementController.SetCrouching(active)
    crouchActive = active
end
local currentSmoothedDir = Vector3.zero
local connection: RBXScriptConnection? = nil
local inputBeganConn = nil
local inputEndedConn = nil
local syncTimer = 0
local SYNC_RATE = 1 / 20 -- Send state 20 times a second

function MovementController.Init()
    inputBeganConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.LeftShift then
            isWalking = true
        end
    end)
    
    inputEndedConn = UserInputService.InputEnded:Connect(function(input, processed)
        if input.KeyCode == Enum.KeyCode.LeftShift then
            isWalking = false
        end
    end)

    connection = RunService.RenderStepped:Connect(function(dt)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health &lt;= 0 then return end
        
        -- Get raw input from PlayerModule (supports mobile/console/PC)
        local rawMoveVector = Vector3.zero
        if PlayerModule then
            local controls = PlayerModule:GetControls()
            if controls then
                rawMoveVector = controls:GetMoveVector()
            end
        end
        
        -- The move vector is local to the camera on PC, so we convert it to world space
        local camera = workspace.CurrentCamera
        local targetDir = Vector3.zero
        if rawMoveVector.Magnitude &gt; 0.01 and camera then
            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector
            look = Vector3.new(look.X, 0, look.Z).Unit
            right = Vector3.new(right.X, 0, right.Z).Unit
            
            targetDir = (look * -rawMoveVector.Z) + (right * rawMoveVector.X)
            if targetDir.Magnitude &gt; 1 then
                targetDir = targetDir.Unit
            end
        end

        -- Calculate speed
        local targetSpeed = crouchActive and CROUCH_SPEED or (isWalking and WALK_SPEED or BASE_RUN_SPEED)
        
        -- Lerp the direction for momentum/friction
        local lerpFactor = targetDir.Magnitude &gt; 0.1 and ACCELERATION or FRICTION
        currentSmoothedDir = currentSmoothedDir:Lerp(targetDir, math.min(dt * lerpFactor, 1))

        -- Override humanoid movement
        humanoid.WalkSpeed = targetSpeed
        humanoid:Move(currentSmoothedDir, false) 
        
        -- Network Sync
        syncTimer += dt
        if syncTimer &gt;= SYNC_RATE then
            syncTimer = 0
            local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
            if hrp then
                local spatialSyncRemote = RemoteEvents.GetUnreliable("SpatialStateSync")
                if spatialSyncRemote then
                    local buf = BufferSerializer.SerializeSpatialState(os.clock(), hrp.Position, hrp.AssemblyLinearVelocity)
                    spatialSyncRemote:FireServer(buf)
                end
            end
        end
    end)
end

function MovementController.Destroy()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    if inputBeganConn then
        inputBeganConn:Disconnect()
        inputBeganConn = nil
    end
    if inputEndedConn then
        inputEndedConn:Disconnect()
        inputEndedConn = nil
    end
end

return MovementController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX95"><Properties><string name="Name">OperativeController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Client Operative Controller
    Manages keybindings (E, C, X), placement preview gizmos for deployable abilities,
    instant agent selection for Practice Range, client-side particle/visual replication,
    enemy highlight outlines (wallhacks), and HUD state getters.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local DataFolder = ReplicatedStorage:WaitForChild("Data")
local OperativeStats = require(DataFolder:WaitForChild("OperativeStats") :: any)

local NetworkFolder = ReplicatedStorage:WaitForChild("Network")
local RemoteEvents = require(NetworkFolder:WaitForChild("RemoteEvents") :: any)

type AbilitySlot = OperativeStats.AbilitySlot
type OperativeData = OperativeStats.OperativeData
type AbilityData = OperativeStats.AbilityData

local OperativeController = {}

local localPlayer = Players.LocalPlayer
local mouse = localPlayer:GetMouse()

-- Client-side state prediction &amp; sync
local currentOperativeId = "Vex"
local ultCharge = 0
local cooldownRemaining = {
	Basic = 0,
	Paid = 0,
	Ultimate = 0,
}
local isSilenced = false
local overshieldAmount = 0
local damageReductionAmount = 0

local activeVFX: { BasePart } = {}

-- Placement Preview Gizmo state
local isPreviewActive = false
local pendingSlot: AbilitySlot? = nil
local previewGizmo: BasePart? = nil
local renderConnection: RBXScriptConnection? = nil

-- List of deployable abilities that require placement preview
local DEPLOYABLE_ABILITIES: { [string]: { size: Vector3, color: Color3, shape: Enum.PartType? } } = {
	Vex_Trap = { size = Vector3.new(4, 0.4, 4), color = Color3.fromRGB(255, 170, 0) },
	Warden_Wall = { size = Vector3.new(12, 8, 1), color = Color3.fromRGB(0, 170, 255) },
	Fray_Smoke = { size = Vector3.new(15, 15, 15), color = Color3.fromRGB(180, 180, 200), shape = Enum.PartType.Ball },
	Choke_Static = { size = Vector3.new(12, 6, 12), color = Color3.fromRGB(180, 100, 255), shape = Enum.PartType.Cylinder },
	Choke_Incendiary = { size = Vector3.new(10, 0.4, 10), color = Color3.fromRGB(255, 60, 0) },
	Choke_Zero = { size = Vector3.new(30, 2, 30), color = Color3.fromRGB(100, 220, 255), shape = Enum.PartType.Cylinder },
	Pulse_Beacon = { size = Vector3.new(1.5, 1.5, 1.5), color = Color3.fromRGB(255, 220, 0) },
	Bastion_Turret = { size = Vector3.new(3, 4, 3), color = Color3.fromRGB(220, 50, 50) },
	Bastion_Mine = { size = Vector3.new(2, 0.4, 2), color = Color3.fromRGB(255, 100, 0) },
}

--- Returns currently selected Operative statistics
function OperativeController.GetSelectedOperative(): OperativeData?
	return OperativeStats.Get(currentOperativeId)
end

--- Returns current ultimate charge percentage (0-100)
function OperativeController.GetUltCharge(): number
	return ultCharge
end

--- Returns remaining cooldown seconds for given ability slot
function OperativeController.GetCooldownRemaining(slot: AbilitySlot): number
	return cooldownRemaining[slot] or 0
end

--- Returns whether local player is silenced by EMP
function OperativeController.IsSilenced(): boolean
	return isSilenced
end

--- Selects an operative on demand (Practice Range or Lobby)
function OperativeController.SelectOperative(opId: string)
	local opData = OperativeStats.Get(opId)
	if not opData then
		return
	end

	currentOperativeId = opId
	pcall(function()
		local selectRemote = RemoteEvents.GetReliable("SelectAgent" :: any)
		if selectRemote then
			selectRemote:FireServer(opId)
		end
	end)
end

--- Cancels placement preview gizmo
function OperativeController.CancelPreview()
	isPreviewActive = false
	pendingSlot = nil

	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	if previewGizmo then
		previewGizmo:Destroy()
		previewGizmo = nil
	end
end

--- Gets raycast ground target position for placement preview
local function getTargetCFrame(): CFrame
	local camera = Workspace.CurrentCamera
	if not camera then
		return CFrame.new(mouse.Hit.Position)
	end

	local unitRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local rayParams = RaycastParams.new()
	if localPlayer.Character then
		rayParams.FilterDescendantsInstances = { localPlayer.Character }
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
	end

	local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 200, rayParams)
	if result then
		return CFrame.new(result.Position, result.Position + unitRay.Direction)
	else
		local targetPos = unitRay.Origin + (unitRay.Direction * 30)
		return CFrame.new(targetPos)
	end
end

--- Starts placement preview mode for deployables
local function startPreview(slot: AbilitySlot, abilityData: AbilityData)
	OperativeController.CancelPreview()

	local deploySpec = DEPLOYABLE_ABILITIES[abilityData.id]
	if not deploySpec then
		-- Fallback gizmo spec if not defined explicitly
		deploySpec = { size = Vector3.new(4, 4, 4), color = Color3.fromRGB(0, 255, 200) }
	end

	isPreviewActive = true
	pendingSlot = slot

	local gizmo = Instance.new("Part")
	gizmo.Name = "AbilityPlacementGizmo"
	gizmo.Size = deploySpec.size
	gizmo.Color = deploySpec.color
	gizmo.Material = Enum.Material.Neon
	gizmo.Transparency = 0.5
	gizmo.Anchored = true
	gizmo.CanCollide = false
	if deploySpec.shape then
		gizmo.Shape = deploySpec.shape
	end
	gizmo.Parent = Workspace
	previewGizmo = gizmo

	renderConnection = RunService.RenderStepped:Connect(function()
		if not isPreviewActive or not previewGizmo then
			return
		end
		local cf = getTargetCFrame()
		previewGizmo.CFrame = cf
	end)
end

--- Triggers an ability execution by slot
function OperativeController.UseAbility(slot: AbilitySlot)
	if isSilenced then
		return
	end

	local opData = OperativeController.GetSelectedOperative()
	if not opData then
		return
	end

	local abilityData = opData.abilities[slot]
	if not abilityData then
		return
	end

	-- If on cooldown, ignore
	if (cooldownRemaining[slot] or 0) &gt; 0 then
		return
	end

	-- Check if ability is a deployable requiring placement preview
	if DEPLOYABLE_ABILITIES[abilityData.id] then
		if not isPreviewActive or pendingSlot ~= slot then
			startPreview(slot, abilityData)
			return
		end
	end

	-- Confirm and fire ability request to server
	local targetCF = getTargetCFrame()
	OperativeController.CancelPreview()

	pcall(function()
		local useRemote = RemoteEvents.GetReliable("UseAbility" :: any)
		if useRemote then
			useRemote:FireServer(slot, targetCF)
		end
	end)
end

--- Confirms current pending placement preview
local function confirmPlacement()
	if isPreviewActive and pendingSlot then
		local slot = pendingSlot
		local targetCF = getTargetCFrame()
		OperativeController.CancelPreview()

		pcall(function()
			local useRemote = RemoteEvents.GetReliable("UseAbility" :: any)
			if useRemote then
				useRemote:FireServer(slot, targetCF)
			end
		end)
	end
end

--- Replicates visual effects locally for triggered abilities
local function handleAbilityReplicated(data: any)
	if typeof(data) ~= "table" or not data.abilityId then
		return
	end

	local abilityId = data.abilityId
	local targetCF = data.targetCFrame or CFrame.new()

	if abilityId == "Vex_EMP" then
		-- Expanding EMP shockwave effect
		local empPart = Instance.new("Part")
		empPart.Name = "EMP_Visual"
		empPart.Shape = Enum.PartType.Ball
		empPart.Size = Vector3.new(2, 2, 2)
		empPart.CFrame = targetCF
		empPart.Color = Color3.fromRGB(0, 220, 255)
		empPart.Material = Enum.Material.Neon
		empPart.Transparency = 0.2
		empPart.Anchored = true
		empPart.CanCollide = false
		empPart.Parent = Workspace

		local tween = TweenService:Create(empPart, tweenInfo, {
			Size = Vector3.new(70, 70, 70),
			Transparency = 1,
		})
		tween:Play()
		Debris:AddItem(empPart, 0.7)
		table.insert(activeVFX, empPart)

	elseif abilityId == "Fray_Blink" then
		-- Dash particle line / trail effect
		local dashPart = Instance.new("Part")
		dashPart.Size = Vector3.new(0.5, 0.5, 25)
		dashPart.CFrame = targetCF
		dashPart.Color = Color3.fromRGB(255, 255, 255)
		dashPart.Material = Enum.Material.Neon
		dashPart.Transparency = 0.3
		dashPart.Anchored = true
		dashPart.CanCollide = false
		dashPart.Parent = Workspace

		TweenService:Create(dashPart, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		Debris:AddItem(dashPart, 0.4)
		table.insert(activeVFX, dashPart)

	elseif abilityId == "Choke_Static" then
		-- Static field visual energy cloud
		local staticPart = Instance.new("Part")
		staticPart.Shape = Enum.PartType.Cylinder
		staticPart.Size = Vector3.new(12, 24, 24)
		staticPart.CFrame = targetCF * CFrame.Angles(0, 0, math.rad(90))
		staticPart.Color = Color3.fromRGB(180, 100, 255)
		staticPart.Material = Enum.Material.Neon
		staticPart.Transparency = 0.6
		staticPart.Parent = Workspace

		Debris:AddItem(staticPart, 7)
		table.insert(activeVFX, staticPart)
	end
end

--- Attaches temporary highlight outline (wallhack effect)
local function handleEnemyRevealed(data: any)
	if typeof(data) ~= "table" then
		return
	end

	local targetChar = data.targetCharacter :: Model?
	local duration = data.duration or 3
	local color = data.outlineColor or Color3.fromRGB(255, 50, 50)

	if targetChar and targetChar:IsA("Model") then
		local existing = targetChar:FindFirstChild("RevealHighlight")
		if existing then
			existing:Destroy()
		end

		local highlight = Instance.new("Highlight")
		highlight.Name = "RevealHighlight"
		highlight.FillColor = color
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0.0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Adornee = targetChar
		highlight.Parent = targetChar

		Debris:AddItem(highlight, duration)
	end
end

--- Initializes client input bindings and remote event listeners
function OperativeController.Init()
	local function clearVFX()
		for _, vfx in activeVFX do
			if vfx.Parent then
				vfx:Destroy()
			end
		end
		table.clear(activeVFX)
	end

	localPlayer.CharacterAdded:Connect(function(char)
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(clearVFX)
	end)
	if localPlayer.Character then
		local hum = localPlayer.Character:FindFirstChild("Humanoid")
		if hum then
			hum.Died:Connect(clearVFX)
		end
	end

	-- 1. State Sync Listener
	pcall(function()
		local syncRemote = RemoteEvents.GetReliable("OperativeStateSync" :: any)
		if syncRemote then
			syncRemote.OnClientEvent:Connect(function(data: any)
				if typeof(data) == "table" then
					if data.selectedOperative then
						currentOperativeId = data.selectedOperative
					end
					if type(data.ultCharge) == "number" then
						ultCharge = data.ultCharge
					end
					if typeof(data.cooldowns) == "table" then
						cooldownRemaining.Basic = data.cooldowns.Basic or 0
						cooldownRemaining.Paid = data.cooldowns.Paid or 0
						cooldownRemaining.Ultimate = data.cooldowns.Ultimate or 0
					end
					if type(data.isSilenced) == "boolean" then
						isSilenced = data.isSilenced
					end
				end
			end)
		end

		local repRemote = RemoteEvents.GetReliable("AbilityReplicated" :: any)
		if repRemote then
			repRemote.OnClientEvent:Connect(handleAbilityReplicated)
		end

		local revealRemote = RemoteEvents.GetReliable("EnemyRevealed" :: any)
		if revealRemote then
			revealRemote.OnClientEvent:Connect(handleEnemyRevealed)
		end
	end)

	-- 2. Local Cooldown Decay Loop
	RunService.RenderStepped:Connect(function(dt: number)
		if cooldownRemaining.Basic &gt; 0 then
			cooldownRemaining.Basic = math.max(0, cooldownRemaining.Basic - dt)
		end
		if cooldownRemaining.Paid &gt; 0 then
			cooldownRemaining.Paid = math.max(0, cooldownRemaining.Paid - dt)
		end
		if cooldownRemaining.Ultimate &gt; 0 then
			cooldownRemaining.Ultimate = math.max(0, cooldownRemaining.Ultimate - dt)
		end
	end)

	-- 3. Input Key Bindings (E -&gt; Basic, C -&gt; Paid, X -&gt; Ultimate)
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if isPreviewActive then
				confirmPlacement()
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			if isPreviewActive then
				OperativeController.CancelPreview()
			end
		elseif input.KeyCode == Enum.KeyCode.Escape then
			if isPreviewActive then
				OperativeController.CancelPreview()
			end
		elseif input.KeyCode == Enum.KeyCode.E then
			OperativeController.UseAbility("Basic")
		elseif input.KeyCode == Enum.KeyCode.C then
			OperativeController.UseAbility("Paid")
		elseif input.KeyCode == Enum.KeyCode.X then
			OperativeController.UseAbility("Ultimate")
		end
	end)

	print("[OperativeController] Initialized successfully.")
end

return OperativeController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX96"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Client Weapon Controller
    Handles local weapon prediction, high-frequency fixed time-step physics accumulation,
    exponential decay stat transitions, instant visual recoil, muzzle flash, raycast tracer
    rendering, and client-server combat network synchronization.
]=]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local PhysicsFolder = ReplicatedStorage:WaitForChild("Physics")
local DataFolder = ReplicatedStorage:WaitForChild("Data")

local WeaponStats = require(DataFolder:WaitForChild("WeaponStats") :: any)
local ObjectPool = require(ReplicatedStorage:WaitForChild("Utils"):WaitForChild("ObjectPool"))
local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents"))
local BufferSerializer = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("BufferSerializer") :: any)
local BallisticPhysics = require(ReplicatedStorage:WaitForChild("Physics"):WaitForChild("BallisticPhysics") :: any)

local ControllersFolder = script.Parent
local CrosshairController = require(ControllersFolder:WaitForChild("CrosshairController") :: any)
local AnimationController = require(ControllersFolder:WaitForChild("AnimationController") :: any)
local HUDController = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("HUDController") :: any)
local ScopeOverlayController = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("ScopeOverlayController") :: any)

export type WeaponState = {
    weaponId: string,
    currentAmmo: number,
    reserveAmmo: number,
    isReloading: boolean,
    isFiring: boolean,
    isAiming: boolean,
    currentSpread: number,
    lastFireTimestamp: number,
    burstShotsRemaining: number,
}

local WeaponController = {}

local isInitialized = false
local currentWeaponState: WeaponState? = nil
local activeStats: WeaponStats.WeaponData? = nil
local savedFOV = 70
local originalSensitivity = 1.0
local currentWeaponModel: Model? = nil
local isCombatPhase = false

local localLoadout = {
    Primary = "AssaultRifle",
    Secondary = "Pistol",
    Grenade = "Grenade"
}
local currentWeaponModel: Model? = nil
local shotSequenceId = 0
local rng = Random.new()

-- Fixed time-step accumulator state
local dtAccumulator = 0.0
local FIXED_DT = 1.0 / 60.0 -- 60 Hz fixed physics tick

-- Network remote references (optional connection for server validation)
local remoteEvent: RemoteEvent? = nil

-- Raycast filter parameters
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

--[=[
    Exponential Decay Lerp Helper function:
    current = Lerp(current, target, 1 - math.exp(-lambda * dt))
]=]
local function ExpDecayLerpNumber(current: number, target: number, lambda: number, dt: number): number
    local alpha = 1.0 - math.exp(-lambda * dt)
    return current + (target - current) * alpha
end

local muzzleFlashPool: any = nil
local tracerPool: any = nil

local function initPools()
    -- Create template for muzzle flash (tiny, brief flash)
    local flashTemplate = Instance.new("Part")
    flashTemplate.Size = Vector3.new(0.15, 0.15, 0.15)
    flashTemplate.Material = Enum.Material.Neon
    flashTemplate.Color = Color3.fromRGB(255, 220, 100)
    flashTemplate.Anchored = true
    flashTemplate.CanCollide = false
    flashTemplate.CanQuery = false
    flashTemplate.Transparency = 0.5
    flashTemplate.Shape = Enum.PartType.Ball
    local light = Instance.new("PointLight")
    light.Brightness = 2
    light.Range = 6
    light.Color = Color3.fromRGB(255, 200, 80)
    light.Parent = flashTemplate
    muzzleFlashPool = ObjectPool.new(flashTemplate, 10)
    
    -- Create template for tracer (thin beam)
    local tracerTemplate = Instance.new("Part")
    tracerTemplate.Size = Vector3.new(0.04, 0.04, 4)
    tracerTemplate.Material = Enum.Material.Neon
    tracerTemplate.Color = Color3.fromRGB(0, 220, 255)
    tracerTemplate.Anchored = true
    tracerTemplate.CanCollide = false
    tracerTemplate.CanQuery = false
    tracerTemplate.Transparency = 0.4
    tracerPool = ObjectPool.new(tracerTemplate, 20)
end

--[=[
    Renders an instant local muzzle flash effect at the specified origin.
]=]
local function RenderMuzzleFlash(originCFrame: CFrame): ()
    local flashPart = muzzleFlashPool:Get()
    flashPart.CFrame = originCFrame
    flashPart.Parent = Workspace

    task.delay(0.03, function()
        if flashPart and flashPart.Parent then
            flashPart.Parent = nil
        end
        muzzleFlashPool:Return(flashPart)
    end)
end

--[=[
    Renders a moving local bullet tracer projectile from muzzle origin to target hit position (Evostrike style).
]=]
local function RenderTracer(originPos: Vector3, targetPos: Vector3): ()
    local distance = (targetPos - originPos).Magnitude
    if distance &lt; 1 then
        return
    end

    local tracerPart = tracerPool:Get()
    -- Create a long streak for the tracer so it's visible at high speeds
    local tracerLength = math.clamp(distance / 2, 5, 40)
    tracerPart.Size = Vector3.new(0.2, 0.2, tracerLength)
    tracerPart.CFrame = CFrame.lookAt(originPos, targetPos) * CFrame.new(0, 0, -tracerLength / 2)
    tracerPart.Transparency = 0.2
    tracerPart.Color = Color3.fromRGB(255, 255, 100)
    tracerPart.Parent = Workspace

    -- Calculate travel time at ~900 studs/sec
    local speed = 900
    local travelTime = distance / speed
    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    
    local tween = TweenService:Create(tracerPart, tweenInfo, {
        Position = targetPos,
    })
    
    tween.Completed:Connect(function()
        tracerPool:Return(tracerPart)
    end)
    
    tween:Play()
end

local function updateRaycastFilter(): ()
	local filterList = {}
	local localPlayer = Players.LocalPlayer
	if localPlayer and localPlayer.Character then
		table.insert(filterList, localPlayer.Character)
	end
	if currentWeaponModel then
		table.insert(filterList, currentWeaponModel)
	end
	local camera = Workspace.CurrentCamera
	if camera then
		table.insert(filterList, camera)
	end
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = filterList
end

-- Camera-relative muzzle offsets per weapon class (first-person fallback).
-- Right +X, Down -Y, Forward -Z in camera local space.
local MUZZLE_OFFSETS: { [string]: Vector3 } = {
	Pistol       = Vector3.new(0.35, -0.30, -0.5),
	AssaultRifle = Vector3.new(0.40, -0.35, -0.8),
	SniperRifle  = Vector3.new(0.40, -0.35, -1.0),
	Shotgun      = Vector3.new(0.40, -0.35, -0.8),
	LightSMG     = Vector3.new(0.35, -0.30, -0.6),
	HeavySMG     = Vector3.new(0.35, -0.30, -0.6),
	SMG          = Vector3.new(0.35, -0.30, -0.6),
	Carbine      = Vector3.new(0.40, -0.35, -0.8),
	BurstRifle   = Vector3.new(0.40, -0.35, -0.8),
}
local DEFAULT_MUZZLE_OFFSET = Vector3.new(0.35, -0.30, -0.6)

-- Threshold: if camera is within this many studs of the head, treat as first-person.
local FIRST_PERSON_THRESHOLD = 2.0

local function getMuzzleOrigin(camCFrame: CFrame): Vector3
	if currentWeaponModel then
		local firePoint = currentWeaponModel:FindFirstChild("FirePoint", true)
		if firePoint and firePoint:IsA("Attachment") then
			return firePoint.WorldPosition
		end
	end
	
	-- Fallback
	local weaponId = if currentWeaponState then currentWeaponState.weaponId else nil
	local offset = if weaponId then (MUZZLE_OFFSETS[weaponId] or DEFAULT_MUZZLE_OFFSET) else DEFAULT_MUZZLE_OFFSET
	return (camCFrame * CFrame.new(offset)).Position
end

--[=[
    Executes instant local prediction for firing a weapon shot.
]=]
local function FireShot(isAccumulated: boolean?): ()
	if not currentWeaponState or not activeStats then return end

	local now = os.clock()
	local fireInterval = 60.0 / activeStats.fireRate
	if not isAccumulated then
		if now - currentWeaponState.lastFireTimestamp &lt; fireInterval then
			return
		end
		currentWeaponState.lastFireTimestamp = now
	end

	local camera = Workspace.CurrentCamera
	if not camera then return end

	if currentWeaponState.currentAmmo &lt;= 0 then
		WeaponController.ReloadWeapon()
		return
	end

	currentWeaponState.currentAmmo -= 1

	local isAiming = currentWeaponState.isAiming
	local spreadDeg = currentWeaponState.currentSpread * (if isAiming then 0.5 else 1.0)
	local camCFrame = camera.CFrame
	local rayDirection = CrosshairController.GetSpreadDirection(camCFrame, spreadDeg)

	currentWeaponState.currentSpread = math.min(
		activeStats.spreadMax,
		currentWeaponState.currentSpread + activeStats.spreadIncreasePerShot
	)

	updateRaycastFilter()

	local aimOrigin = camCFrame.Position

	-- Visual muzzle origin
	local muzzleOrigin = getMuzzleOrigin(camCFrame)
	local camForward = camCFrame.LookVector
	local targetHitPos = aimOrigin + (rayDirection * activeStats.maxRange) -- default visual tracer target

	local velocityMod = activeStats.bulletVelocity or 2000
	BallisticPhysics.FireProjectile({
		shooterId = Players.LocalPlayer.UserId,
		weaponId = activeStats.id,
		origin = aimOrigin,
		direction = rayDirection,
		velocityMod = velocityMod,
		gravityMult = 1.0,
		maxRange = activeStats.maxRange,
		damage = activeStats.damage,
		raycastParams = raycastParams,
		onHit = function(hitResult, proj)
			local hitInstance = hitResult.Instance
			local hitPos = hitResult.Position
			local isHeadshot = false
			if hitInstance then
				if hitInstance.Name == "Head" then isHeadshot = true end
				local character = hitInstance:FindFirstAncestorOfClass("Model")
				if character and character:FindFirstChildOfClass("Humanoid") then
					CrosshairController.ShowHitmarker(isHeadshot)
				elseif hitInstance:GetAttribute("IsTarget") == true or string.find(hitInstance.Name, "Target") ~= nil or hitInstance.Name == "Bullseye" or string.find(hitInstance.Name, "TargetRing_") ~= nil then
					CrosshairController.ShowHitmarker(false)
				end
			end

			local combatRemote = RemoteEvents.GetReliable("ReliableCombat")
			if combatRemote and hitInstance then
				local targetModel = hitInstance:FindFirstAncestorOfClass("Model")
				local victimPlayer = if targetModel then Players:GetPlayerFromCharacter(targetModel) else nil
				combatRemote:FireServer({
					action = "ReportHit",
					payload = {
						victimUserId = if victimPlayer then victimPlayer.UserId else 0,
						hitData = {
							origin = proj.origin,
							direction = proj.velocity.Unit,
							hitPosition = hitPos,
							distance = (hitPos - proj.origin).Magnitude,
							clientTimestamp = os.clock(),
							sequenceId = shotSequenceId,
							weaponId = activeStats.id,
							targetInstance = hitInstance,
						}
					}
				})
			end
		end,
	})

	local baseRecoil = if isAiming then activeStats.recoilImpulseADS else activeStats.recoilImpulse
	local yawVariation = rng:NextNumber(-0.6, 0.6) * baseRecoil.Y
	AnimationController.AddRecoil(Vector3.new(baseRecoil.X, yawVariation, baseRecoil.Z))

	RenderMuzzleFlash(CFrame.lookAt(muzzleOrigin, targetHitPos))
	RenderTracer(muzzleOrigin, targetHitPos)

	local unreliableCombat = RemoteEvents.GetUnreliable("UnreliableCombat")
	if unreliableCombat then
		shotSequenceId += 1
		local bufferData = BufferSerializer.SerializeFireIntent(aimOrigin, rayDirection)
		unreliableCombat:FireServer(bufferData)
	end
end

--[=[
    Fixed time-step physics update logic (executed at exact 60Hz intervals).
    Guarantees deterministic physics execution regardless of client FPS (30 FPS to 240+ FPS).
]=]
function WeaponController.FixedUpdate(fixedDt: number): ()
    if not currentWeaponState or not activeStats then
        return
    end

    -- Spread recovery logic using exponential decay towards min spread
    local targetSpread = activeStats.spreadMin
    currentWeaponState.currentSpread = ExpDecayLerpNumber(
        currentWeaponState.currentSpread,
        targetSpread,
        activeStats.spreadRecoveryRate,
        fixedDt
    )
end

--[=[
    Render frame update logic (runs every frame on RenderStepped).
    Handles fixed timestep accumulator polling and smooth exponential decay lerping.
]=]
function WeaponController.RenderUpdate(dt: number): ()
    if not currentWeaponState or not activeStats then
        return
    end

    -- 1. Fixed Time-Step Accumulator Pattern
    local frameTime = math.min(dt, 0.1)
    dtAccumulator += frameTime

    while dtAccumulator &gt;= FIXED_DT do
        WeaponController.FixedUpdate(FIXED_DT)
        dtAccumulator -= FIXED_DT
    end

    -- Auto-Shoot Logic
    local camera = Workspace.CurrentCamera
    if UserInputService.TouchEnabled and camera and not currentWeaponState.isReloading then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local char = Players.LocalPlayer.Character
        if char then
            rayParams.FilterDescendantsInstances = { char, Workspace:FindFirstChild("Ignore") }
        end
        local hit = Workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * activeStats.maxRange, rayParams)
        local shouldFire = false
        if hit and hit.Instance then
            local hitModel = hit.Instance:FindFirstAncestorOfClass("Model")
            local hitHum = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
            if hitHum and hitHum.Health &gt; 0 and hitModel ~= char then
                shouldFire = true
            end
        end
        
        if shouldFire and not currentWeaponState.isFiring then
            WeaponController.StartFiring()
        elseif not shouldFire and currentWeaponState.isFiring then
            WeaponController.StopFiring()
        end
    end

    -- 2. Automatic Fire Loop Handler
    local now = os.clock()
    local fireInterval = 60.0 / activeStats.fireRate

    if currentWeaponState.isFiring and not currentWeaponState.isReloading then
        if now - currentWeaponState.lastFireTimestamp &gt; fireInterval * 3 then
            currentWeaponState.lastFireTimestamp = now - fireInterval
        end
        while currentWeaponState.isFiring and not currentWeaponState.isReloading and (now - currentWeaponState.lastFireTimestamp) &gt;= fireInterval do
            currentWeaponState.lastFireTimestamp += fireInterval
            FireShot(true)
            if activeStats.fireMode == "Semi" then
                currentWeaponState.isFiring = false
                break
            elseif activeStats.fireMode == "Burst" then
                currentWeaponState.burstShotsRemaining -= 1
                if currentWeaponState.burstShotsRemaining &lt;= 0 then
                    currentWeaponState.isFiring = false
                    break
                end
            end
        end
    end

    -- 3. Update Sub-Controllers
    CrosshairController.Update(dt, currentWeaponState.currentSpread)
    AnimationController.Update(dt)

    if currentWeaponModel and currentWeaponModel.PrimaryPart then
        local camera = Workspace.CurrentCamera
        if camera then
            local weaponId = currentWeaponState.weaponId
            local offset = MUZZLE_OFFSETS[weaponId] or DEFAULT_MUZZLE_OFFSET
            
            -- Calculate hipfire vs ADS position
            local adsAlpha = AnimationController.GetADSAlpha and AnimationController.GetADSAlpha() or (currentWeaponState.isAiming and 1 or 0)
            local hipfireOffset = CFrame.new(offset.X + 0.65, offset.Y - 0.7, offset.Z - 1.0)
            local adsOffset = CFrame.new(0, offset.Y - 0.35, offset.Z - 0.5)
            local baseOffset = hipfireOffset:Lerp(adsOffset, adsAlpha)
            
            -- Scope Integration: Hide viewmodel when fully aimed with 2D optic
            if activeStats and activeStats.scopeConfig and activeStats.scopeConfig.ScopeImageId then
                if adsAlpha &gt; 0.8 then
                    baseOffset = CFrame.new(0, -100, 0)
                end
            end

            local animOffset = AnimationController.GetViewmodelOffset()
            currentWeaponModel:PivotTo(camera.CFrame * animOffset * baseOffset)
        end
    end
end


local function build3DWeaponModel(weaponId: string): Model
	local model = Instance.new("Model")
	model.Name = "HeldWeaponModel"

	-- Base handle (PrimaryPart)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.18, 0.55, 0.30)
	handle.Material = Enum.Material.SmoothPlastic
	handle.Color = Color3.fromRGB(22, 24, 30)
	handle.CanCollide = false
	handle.Parent = model
	model.PrimaryPart = handle

	-- Block weld helper
	local function createPart(name: string, size: Vector3, relativeCFrame: CFrame, color: Color3, material: Enum.Material, parentPart: BasePart): Part
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = material
		part.CanCollide = false
		part.CFrame = parentPart.CFrame * relativeCFrame
		part.Parent = model

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = parentPart
		weld.Part1 = part
		weld.Parent = part

		return part
	end

	-- Round weld helper for barrel/tube accents. The cylinder's length always ends up
	-- running along local -Z of relativeCFrame (matching createPart's forward convention),
	-- so it should only be used for parts that point straight forward/backward with no
	-- extra rotation baked into relativeCFrame.
	local function createCylinder(name: string, length: number, diameter: number, relativeCFrame: CFrame, color: Color3, material: Enum.Material, parentPart: BasePart): Part
		local part = Instance.new("Part")
		part.Name = name
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(length, diameter, diameter)
		part.Color = color
		part.Material = material
		part.CanCollide = false
		part.CFrame = (parentPart.CFrame * relativeCFrame) * CFrame.Angles(0, math.rad(90), 0)
		part.Parent = model

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = parentPart
		weld.Part1 = part
		weld.Parent = part

		return part
	end

	-- Default design attributes (AssaultRifle, Carbine, BurstRifle, Vanguard)
	local accentColor = Color3.fromRGB(255, 130, 0) -- Cyber orange
	local bodySize = Vector3.new(0.34, 0.48, 2.0)
	local bodyOffset = CFrame.new(0, 0.44, -0.3)

	local barrelLength = 1.2
	local barrelRad = 0.075

	local hasStock = true
	local stockSize = Vector3.new(0.24, 0.4, 1.0)
	local stockOffset = CFrame.new(0, -0.06, 0.88)
	local hasCheekRiser = false

	local magSize: Vector3? = Vector3.new(0.22, 0.5, 0.34)
	local magOffset = CFrame.new(0, -0.4, -0.5)
	local magAngles = CFrame.Angles(math.rad(12), 0, 0)

	local hasScope = true
	local scopeSize = Vector3.new(0.15, 0.19, 0.7)
	local scopeOffset = CFrame.new(0, 0.34, -0.15)

	local underBarrelPump = false
	local isSMG = false
	local isPistol = false
	local hasForegrip = true
	local hasBipod = false
	local hasVentRib = false
	local hasSlide = false

	if weaponId == "Pistol" then
		accentColor = Color3.fromRGB(80, 255, 120) -- Neon green sidearm
		isPistol = true
		bodySize = Vector3.new(0.28, 0.32, 0.75)
		bodyOffset = CFrame.new(0, 0.36, -0.1)
		barrelLength = 0.4
		barrelRad = 0.06
		hasStock = false
		hasForegrip = false
		hasSlide = true
		magSize = Vector3.new(0.18, 0.14, 0.28)
		magOffset = CFrame.new(0, -0.36, 0.03)
		magAngles = CFrame.new()
		scopeSize = Vector3.new(0.07, 0.1, 0.13) -- Tiny reflex optic
		scopeOffset = CFrame.new(0, 0.2, -0.18)
	elseif weaponId == "LightSMG" or weaponId == "HeavySMG" or weaponId == "SMG" then
		accentColor = Color3.fromRGB(0, 200, 255) -- Neon cyan SMG
		isSMG = true
		bodySize = Vector3.new(0.3, 0.46, 1.55)
		bodyOffset = CFrame.new(0, 0.42, -0.2)
		barrelLength = 0.62
		barrelRad = 0.065
		hasStock = true
		stockSize = Vector3.new(0.16, 0.3, 0.8)
		stockOffset = CFrame.new(0, -0.05, 0.68)
		magSize = Vector3.new(0.18, 0.8, 0.26)
		magOffset = CFrame.new(0, -0.44, -0.36)
		magAngles = CFrame.Angles(math.rad(18), 0, 0)
		scopeSize = Vector3.new(0.2, 0.24, 0.46) -- Holo casing
		scopeOffset = CFrame.new(0, 0.32, -0.1)
	elseif weaponId == "SniperRifle" then
		accentColor = Color3.fromRGB(255, 190, 70) -- Neon gold sniper
		bodySize = Vector3.new(0.36, 0.6, 3.0)
		bodyOffset = CFrame.new(0, 0.44, -0.4)
		barrelLength = 2.2
		barrelRad = 0.07
		hasStock = true
		hasCheekRiser = true
		stockSize = Vector3.new(0.3, 0.5, 1.25)
		stockOffset = CFrame.new(0, -0.1, 0.98)
		magSize = Vector3.new(0.28, 0.45, 0.46)
		magOffset = CFrame.new(0, -0.42, -0.6)
		magAngles = CFrame.Angles(math.rad(4), 0, 0)
		hasScope = true
		scopeSize = Vector3.new(0.22, 0.22, 1.3) -- Massive sniper scope
		scopeOffset = CFrame.new(0, 0.42, -0.3)
		hasForegrip = false
		hasBipod = true
	elseif weaponId == "Shotgun" then
		accentColor = Color3.fromRGB(255, 70, 70) -- Crimson red shotgun
		bodySize = Vector3.new(0.36, 0.54, 2.35)
		bodyOffset = CFrame.new(0, 0.44, -0.3)
		barrelLength = 1.5
		barrelRad = 0.1
		hasStock = true
		stockSize = Vector3.new(0.3, 0.46, 1.1)
		stockOffset = CFrame.new(0, -0.06, 0.92)
		magSize = nil -- Uses under-barrel reload tube instead
		hasScope = true
		scopeSize = Vector3.new(0.14, 0.18, 0.4) -- Blocky iron casing
		scopeOffset = CFrame.new(0, 0.32, -0.25)
		underBarrelPump = true
		hasForegrip = false
		hasVentRib = true
	end

	-- 1. Main receiver body, split into two tones so it doesn't read as one flat block
	local body = createPart(
		"Body",
		bodySize,
		bodyOffset,
		Color3.fromRGB(34, 38, 47),
		Enum.Material.Metal,
		handle
	)
	if not isPistol then
		createPart(
			"ReceiverCap",
			Vector3.new(bodySize.X + 0.02, bodySize.Y * 0.22, bodySize.Z),
			CFrame.new(0, bodySize.Y / 2 - 0.02, 0),
			Color3.fromRGB(46, 50, 60),
			Enum.Material.Metal,
			body
		)
	end

	-- 2. Barrel — kept as a slim Block (same Size/CFrame convention as before) so the
	-- raycast muzzle-origin math in FireShot, which reads Barrel.Size.Z as the barrel
	-- length, keeps working unchanged. A round cosmetic jacket gives it the visible
	-- cylindrical barrel shape instead of a stubby rectangular rod.
	local barrel = createPart(
		"Barrel",
		Vector3.new(barrelRad, barrelRad, barrelLength),
		CFrame.new(0, bodySize.Y / 4, -(bodySize.Z / 2) - (barrelLength / 2)),
		Color3.fromRGB(50, 55, 65),
		Enum.Material.Metal,
		body
	)
	createCylinder(
		"BarrelJacket",
		barrelLength,
		barrelRad * 2.6,
		CFrame.new(),
		Color3.fromRGB(44, 48, 58),
		Enum.Material.Metal,
		barrel
	)

	-- Rounded neon muzzle device
	local muzzleTip = createCylinder(
		"MuzzleTip",
		0.16,
		barrelRad * 2.9,
		CFrame.new(0, 0, -(barrelLength / 2) - 0.08),
		accentColor,
		Enum.Material.Neon,
		barrel
	)

	local firePoint = Instance.new("Attachment")
	firePoint.Name = "FirePoint"
	-- Cylinder's local X axis points forward along the barrel (-Z) due to the 90 degree Y rotation
	firePoint.Position = Vector3.new(0.08, 0, 0)
	firePoint.Parent = muzzleTip

	-- 3. Cyber neon stripes on receiver sides
	createPart(
		"CyberStripeLeft",
		Vector3.new(0.015, 0.06, bodySize.Z * 0.7),
		CFrame.new(-(bodySize.X / 2) - 0.01, 0.04, 0),
		accentColor,
		Enum.Material.Neon,
		body
	)
	createPart(
		"CyberStripeRight",
		Vector3.new(0.015, 0.06, bodySize.Z * 0.7),
		CFrame.new((bodySize.X / 2) + 0.01, 0.04, 0),
		accentColor,
		Enum.Material.Neon,
		body
	)

	-- Ejection port (pistol gets one on its slide instead, added further below)
	if not isPistol then
		createPart(
			"EjectionPort",
			Vector3.new(0.02, bodySize.Y * 0.3, bodySize.Z * 0.18),
			CFrame.new((bodySize.X / 2) + 0.011, bodySize.Y * 0.08, bodySize.Z * 0.1),
			Color3.fromRGB(10, 10, 12),
			Enum.Material.SmoothPlastic,
			body
		)
	end

	-- Selector switch
	createPart(
		"SelectorSwitch",
		Vector3.new(0.05, 0.09, 0.05),
		CFrame.new(-(bodySize.X / 2) - 0.02, -bodySize.Y * 0.05, bodySize.Z * 0.28),
		Color3.fromRGB(60, 64, 74),
		Enum.Material.Metal,
		body
	)

	-- Trigger guard + trigger
	local guardBottom = createPart(
		"TriggerGuardBottom",
		Vector3.new(0.05, 0.05, 0.34),
		CFrame.new(0, -bodySize.Y / 2 - 0.16, bodySize.Z * 0.28),
		Color3.fromRGB(26, 28, 34),
		Enum.Material.SmoothPlastic,
		body
	)
	createPart(
		"TriggerGuardFront",
		Vector3.new(0.05, 0.16, 0.05),
		CFrame.new(0, 0.08, -0.145),
		Color3.fromRGB(26, 28, 34),
		Enum.Material.SmoothPlastic,
		guardBottom
	)
	createPart(
		"Trigger",
		Vector3.new(0.04, 0.1, 0.03),
		CFrame.new(0, 0.11, -0.02),
		Color3.fromRGB(16, 17, 20),
		Enum.Material.SmoothPlastic,
		guardBottom
	)

	-- 4. Buttstock assembly (skipped on pistols)
	if hasStock then
		createCylinder(
			"BufferTube",
			0.22,
			0.1,
			CFrame.new(0, 0, (bodySize.Z / 2) + 0.11),
			Color3.fromRGB(40, 43, 52),
			Enum.Material.Metal,
			body
		)
		local stock = createPart(
			"Stock",
			stockSize,
			stockOffset,
			Color3.fromRGB(24, 26, 32),
			Enum.Material.SmoothPlastic,
			body
		)
		-- Neon stock pad cushion
		createPart(
			"StockPad",
			Vector3.new(stockSize.X + 0.03, stockSize.Y + 0.05, 0.09),
			CFrame.new(0, 0, (stockSize.Z / 2) + 0.045),
			accentColor,
			Enum.Material.Neon,
			stock
		)
		if hasCheekRiser then
			createPart(
				"CheekRiser",
				Vector3.new(stockSize.X * 0.7, 0.08, stockSize.Z * 0.5),
				CFrame.new(0, stockSize.Y / 2 + 0.03, -stockSize.Z * 0.1),
				Color3.fromRGB(20, 22, 28),
				Enum.Material.SmoothPlastic,
				stock
			)
		end
	end

	-- 5. Magazine, with a base plate and accent line to break up the block silhouette
	if magSize then
		local mag = createPart(
			"Magazine",
			magSize,
			magOffset * magAngles,
			Color3.fromRGB(18, 20, 24),
			Enum.Material.SmoothPlastic,
			body
		)
		createPart(
			"MagBasePlate",
			Vector3.new(magSize.X + 0.03, magSize.Y * 0.08, magSize.Z + 0.03),
			CFrame.new(0, -magSize.Y / 2 - 0.01, 0),
			Color3.fromRGB(10, 11, 14),
			Enum.Material.SmoothPlastic,
			mag
		)
		createPart(
			"MagAccentLine",
			Vector3.new(magSize.X + 0.005, magSize.Y * 0.6, 0.02),
			CFrame.new(0, magSize.Y * 0.05, -(magSize.Z / 2) - 0.005),
			accentColor,
			Enum.Material.Neon,
			mag
		)
	end

	-- 6. Handguard + rail + sights + foregrip, or shotgun pump tube
	if underBarrelPump then
		local tube = createCylinder(
			"UnderTube",
			barrelLength - 0.1,
			barrelRad * 1.7,
			CFrame.new(0, -barrelRad * 2.2, 0.05),
			Color3.fromRGB(30, 32, 40),
			Enum.Material.Metal,
			barrel
		)
		createPart(
			"PumpHandle",
			Vector3.new(barrelRad * 2.6, barrelRad * 2.6, 0.65),
			CFrame.new(0, 0, 0.12),
			Color3.fromRGB(20, 22, 28),
			Enum.Material.SmoothPlastic,
			tube
		)
		if hasVentRib then
			createPart(
				"VentRib",
				Vector3.new(0.035, 0.02, barrelLength * 0.9),
				CFrame.new(0, barrelRad * 1.3, 0),
				Color3.fromRGB(24, 26, 32),
				Enum.Material.Metal,
				barrel
			)
		end
	elseif not isPistol then
		local handguardLength = bodySize.Z * (if isSMG then 0.3 else 0.42)
		local handguard = createPart(
			"Handguard",
			Vector3.new(bodySize.X + 0.03, bodySize.Y * 0.8, handguardLength),
			CFrame.new(0, -bodySize.Y / 10, -(bodySize.Z / 2) + (handguardLength / 2)),
			Color3.fromRGB(28, 30, 38),
			Enum.Material.SmoothPlastic,
			body
		)
		createPart(
			"TopRail",
			Vector3.new(bodySize.X * 0.4, 0.03, handguardLength * 0.85),
			CFrame.new(0, handguard.Size.Y / 2 + 0.015, 0),
			Color3.fromRGB(20, 22, 28),
			Enum.Material.Metal,
			handguard
		)
		local frontSight = createPart(
			"FrontSight",
			Vector3.new(0.03, 0.14, 0.03),
			CFrame.new(0, 0.09, -handguardLength / 2 + 0.08),
			Color3.fromRGB(20, 22, 28),
			Enum.Material.Metal,
			handguard
		)
		createPart(
			"FrontSightTip",
			Vector3.new(0.035, 0.02, 0.035),
			CFrame.new(0, 0.08, 0),
			accentColor,
			Enum.Material.Neon,
			frontSight
		)
		if hasForegrip then
			createPart(
				"Foregrip",
				Vector3.new(0.14, 0.3, 0.14),
				CFrame.new(0, -bodySize.Y * 0.55, -handguardLength * 0.28) * CFrame.Angles(math.rad(-8), 0, 0),
				Color3.fromRGB(22, 24, 30),
				Enum.Material.SmoothPlastic,
				handguard
			)
		end
	end

	-- Rear sight on top of the receiver (long guns only, skipped on the pump shotgun
	-- which relies on its vent rib instead)
	if not isPistol and not underBarrelPump then
		createPart(
			"RearSight",
			Vector3.new(0.03, 0.1, 0.05),
			CFrame.new(0, bodySize.Y / 2 + 0.05, bodySize.Z * 0.32),
			Color3.fromRGB(20, 22, 28),
			Enum.Material.Metal,
			body
		)
	end

	-- 7. Optics: casing, mount risers, and glowing lenses
	if hasScope then
		local scope = createPart(
			"Scope",
			scopeSize,
			scopeOffset,
			Color3.fromRGB(20, 22, 28),
			Enum.Material.SmoothPlastic,
			body
		)
		if not isPistol then
			createPart(
				"ScopeMountFront",
				Vector3.new(scopeSize.X * 0.5, 0.06, 0.05),
				CFrame.new(0, -scopeSize.Y / 2 - 0.03, scopeSize.Z * 0.3),
				Color3.fromRGB(30, 32, 40),
				Enum.Material.Metal,
				scope
			)
			createPart(
				"ScopeMountRear",
				Vector3.new(scopeSize.X * 0.5, 0.06, 0.05),
				CFrame.new(0, -scopeSize.Y / 2 - 0.03, -scopeSize.Z * 0.3),
				Color3.fromRGB(30, 32, 40),
				Enum.Material.Metal,
				scope
			)
		end
		-- Neon lenses glow feedback
		createPart(
			"ScopeLensFront",
			Vector3.new(scopeSize.X - 0.04, scopeSize.Y - 0.04, 0.05),
			CFrame.new(0, 0, -(scopeSize.Z / 2) - 0.02),
			accentColor,
			Enum.Material.Neon,
			scope
		)
		createPart(
			"ScopeLensBack",
			Vector3.new(scopeSize.X - 0.04, scopeSize.Y - 0.04, 0.05),
			CFrame.new(0, 0, (scopeSize.Z / 2) + 0.02),
			accentColor,
			Enum.Material.Neon,
			scope
		)
	end

	-- Bipod (sniper rifle)
	if hasBipod then
		for _, sign in ipairs({ -1, 1 }) do
			local leg = createPart(
				"BipodLeg" .. tostring(sign),
				Vector3.new(0.035, 0.035, 0.42),
				CFrame.new(sign * 0.08, -barrelRad * 2.6, -barrelLength * 0.3)
					* CFrame.Angles(math.rad(65), 0, math.rad(sign * 20)),
				Color3.fromRGB(30, 32, 40),
				Enum.Material.Metal,
				barrel
			)
			createPart(
				"BipodFoot" .. tostring(sign),
				Vector3.new(0.05, 0.05, 0.05),
				CFrame.new(0, 0, leg.Size.Z / 2),
				accentColor,
				Enum.Material.Neon,
				leg
			)
		end
	end

	-- Pistol slide, with front/rear sights and grip serrations
	if hasSlide then
		local slide = createPart(
			"Slide",
			Vector3.new(bodySize.X + 0.02, bodySize.Y * 0.6, bodySize.Z * 0.88),
			CFrame.new(0, bodySize.Y * 0.5 + 0.01, -bodySize.Z * 0.04),
			Color3.fromRGB(30, 32, 40),
			Enum.Material.Metal,
			body
		)
		createPart(
			"SlideRearSight",
			Vector3.new(0.03, 0.05, 0.04),
			CFrame.new(0, slide.Size.Y / 2 + 0.02, slide.Size.Z / 2 - 0.05),
			Color3.fromRGB(16, 17, 20),
			Enum.Material.SmoothPlastic,
			slide
		)
		createPart(
			"SlideFrontSight",
			Vector3.new(0.025, 0.045, 0.03),
			CFrame.new(0, slide.Size.Y / 2 + 0.02, -slide.Size.Z / 2 + 0.06),
			accentColor,
			Enum.Material.Neon,
			slide
		)
		for i = 0, 2 do
			createPart(
				"SlideSerration" .. tostring(i),
				Vector3.new(0.01, slide.Size.Y * 0.7, 0.015),
				CFrame.new(slide.Size.X / 2 + 0.005, 0, slide.Size.Z / 2 - 0.09 - (i * 0.035)),
				accentColor,
				Enum.Material.Neon,
				slide
			)
		end
		createPart(
			"EjectionPortSlide",
			Vector3.new(0.02, slide.Size.Y * 0.35, slide.Size.Z * 0.2),
			CFrame.new(slide.Size.X / 2 + 0.011, slide.Size.Y * 0.05, 0),
			Color3.fromRGB(10, 10, 12),
			Enum.Material.SmoothPlastic,
			slide
		)
	end

	return model
end

local function attachWeaponToCharacter(weaponId: string)
	if currentWeaponModel then
		currentWeaponModel:Destroy()
		currentWeaponModel = nil
	end

	local localPlayer = Players.LocalPlayer
	if not localPlayer then return end

	local model = build3DWeaponModel(weaponId)
	model.Parent = Workspace.CurrentCamera
	currentWeaponModel = model

	updateRaycastFilter()
end

function WeaponController.UnequipWeapon()
    WeaponController.CancelADS()
    if currentWeaponState then currentWeaponState.isReloading = false end
    if currentWeaponModel then
        currentWeaponModel:Destroy()
        currentWeaponModel = nil
    end
    currentWeaponState = nil
    HUDController.SetScopeVisible(false)
end

function WeaponController.EquipWeapon(weaponId: string): ()
    if not isCombatPhase then return end
    
    WeaponController.CancelADS()
    if currentWeaponState then currentWeaponState.isReloading = false end

    local stats = WeaponStats.Get(weaponId)
    if not stats then
        warn("[WeaponController] Failed to equip invalid weaponId: " .. tostring(weaponId))
        return
    end

    activeStats = stats
	
    -- Update local loadout tracker if it's a primary/secondary
    if weaponId == "AssaultRifle" or weaponId == "SniperRifle" or weaponId == "Shotgun" then
        localLoadout.Primary = weaponId
    elseif weaponId == "Pistol" then
        localLoadout.Secondary = weaponId
    elseif weaponId == "Grenade" then
        localLoadout.Grenade = weaponId
    end
    currentWeaponState = {
        weaponId = weaponId,
        currentAmmo = stats.magazineCapacity,
        reserveAmmo = stats.reserveCapacity,
        isReloading = false,
        isFiring = false,
        isAiming = false,
        currentSpread = stats.spreadMin,
        lastFireTimestamp = 0,
        burstShotsRemaining = 0,
    }

    updateRaycastFilter()

    task.spawn(function()
        attachWeaponToCharacter(weaponId)
    end)
end

-- Production gun skins — tint viewmodel parts with SkinSpec primary/secondary/material
function WeaponController.ApplySkin(skinId: string): ()
    local skin = WeaponStats.SKINS_DATA[skinId]
    if not skin then
        warn("[WeaponController] Unknown skinId: " .. tostring(skinId))
        return
    end
    if not currentWeaponModel then return end
    for _, inst in currentWeaponModel:GetDescendants() do
        if inst:IsA("BasePart") then
            -- primary tint for main body, secondary for details
            if string.find(inst.Name, "Detail") or string.find(inst.Name, "Secondary") then
                (inst :: BasePart).Color = skin.secondaryColor
            else
                (inst :: BasePart).Color = skin.primaryColor
            end
            (inst :: BasePart).Material = skin.material
        end
    end
end

function WeaponController.GetCurrentSkin(): string?
    return (currentWeaponModel and currentWeaponModel:GetAttribute("AppliedSkin") :: string?) or nil
end

function WeaponController.ResupplyAmmo(): ()
	if not currentWeaponState or not activeStats then return end
	currentWeaponState.currentAmmo = activeStats.magazineCapacity
	currentWeaponState.reserveAmmo = activeStats.reserveCapacity
	currentWeaponState.isReloading = false
end

function WeaponController.StartFiring(): ()
	if not currentWeaponState or not activeStats or currentWeaponState.isReloading then
		return
	end
	currentWeaponState.isFiring = true

	if activeStats.fireMode == "Burst" then
		currentWeaponState.burstShotsRemaining = activeStats.burstCount or 3
	end

	local now = os.clock()
	local fireInterval = 60.0 / activeStats.fireRate
	if now - currentWeaponState.lastFireTimestamp &gt;= fireInterval then
		currentWeaponState.lastFireTimestamp = now
		FireShot(true)
	end

	if activeStats.fireMode == "Semi" then
		currentWeaponState.isFiring = false
	end
end

function WeaponController.StopFiring(): ()
    if currentWeaponState then
        currentWeaponState.isFiring = false
        currentWeaponState.burstShotsRemaining = 0
    end
end

function WeaponController.CancelADS()
    if currentWeaponState then currentWeaponState.isReloading = false end
    if currentWeaponState and currentWeaponState.isAiming then
        WeaponController.SetAiming(false)
    end
end

function WeaponController.SetAiming(isAiming: boolean): ()
    if not currentWeaponState or not activeStats then return end
    if currentWeaponState.isReloading then return end -- Cannot aim while reloading

    currentWeaponState.isAiming = isAiming
    AnimationController.SetADS(isAiming, activeStats.adsFov)
    
    local camera = Workspace.CurrentCamera
    if isAiming then
        savedFOV = camera.FieldOfView
        originalSensitivity = UserInputService.MouseDeltaSensitivity
    end
    local dofEffect = camera:FindFirstChild("ScopeDoF") :: DepthOfFieldEffect
    if not dofEffect then
        dofEffect = Instance.new("DepthOfFieldEffect")
        dofEffect.Name = "ScopeDoF"
        dofEffect.Parent = camera
    end

    if isAiming then
        -- Apply Advanced ADS Logic if configured
        if activeStats.scopeConfig then
            local config = activeStats.scopeConfig
            
            -- FOV Tween
            local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            TweenService:Create(camera, tweenInfo, {FieldOfView = config.FieldOfView}):Play()
            
            -- Sensitivity Scaling
            UserInputService.MouseDeltaSensitivity = config.SensitivityScalar
            
            -- Post-Processing DoF
            dofEffect.Enabled = true
            dofEffect.FocusDistance = config.FocusDistance
            dofEffect.InFocusRadius = 15
            dofEffect.NearIntensity = 0.1
            dofEffect.FarIntensity = 0.8
            
            -- UI Overlay
            if config.ScopeImageId then
                ScopeOverlayController.EnableOverlay(config.ScopeImageId)
            end
        else
            -- Legacy Iron Sights
            local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            TweenService:Create(camera, tweenInfo, {FieldOfView = activeStats.adsFov}):Play()
        end
    else
        -- Revert ALL ADS State
        local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        TweenService:Create(camera, tweenInfo, {FieldOfView = savedFOV}):Play()
        
        -- Prevent Memory Leaks on Sensitivity
        UserInputService.MouseDeltaSensitivity = originalSensitivity
        
        dofEffect.Enabled = false
        ScopeOverlayController.DisableOverlay()
    end
end

local function handleAimInput(actionName: string, inputState: Enum.UserInputState, inputObject: InputObject)
    if inputState == Enum.UserInputState.Begin then
        WeaponController.SetAiming(true)
    elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
        WeaponController.SetAiming(false)
    end
    return Enum.ContextActionResult.Pass
end

function WeaponController.ReloadWeapon(): ()
    if not currentWeaponState or not activeStats or currentWeaponState.isReloading then
        return
    end

    if currentWeaponState.currentAmmo &gt;= activeStats.magazineCapacity or currentWeaponState.reserveAmmo &lt;= 0 then
        return
    end

    currentWeaponState.isReloading = true
    currentWeaponState.isFiring = false

    local reloadWeaponId = currentWeaponState.weaponId
    task.delay(activeStats.reloadDuration, function()
        if currentWeaponState and activeStats and currentWeaponState.isReloading and currentWeaponState.weaponId == reloadWeaponId then
            local needed = activeStats.magazineCapacity - currentWeaponState.currentAmmo
            local reloadedAmount = math.min(needed, currentWeaponState.reserveAmmo)

            currentWeaponState.currentAmmo += reloadedAmount
            currentWeaponState.reserveAmmo -= reloadedAmount
            currentWeaponState.isReloading = false
        end
    end)
end

function WeaponController.Init(): ()
    if isInitialized then
        return
    end

    initPools()

    CrosshairController.Init()
    AnimationController.Init()
    BallisticPhysics.Initialize()

    local lastCameraOffset = CFrame.identity
    -- Bind RenderStepped loop using BindToRenderStep for Camera priority
    RunService:BindToRenderStep("WeaponControllerUpdate", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
        local camera = Workspace.CurrentCamera
        if camera then
            -- Apply camera recoil (delta approach)
            local currentCameraOffset = AnimationController.GetCameraOffset()
            local delta = lastCameraOffset:Inverse() * currentCameraOffset
            camera.CFrame = camera.CFrame * delta
            lastCameraOffset = currentCameraOffset
        end
        WeaponController.RenderUpdate(dt)
    end)

    local localPlayer = Players.LocalPlayer
    if localPlayer then
        localPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.2)
            if currentWeaponState then
                attachWeaponToCharacter(currentWeaponState.weaponId)
            else
                attachWeaponToCharacter(localLoadout.Primary)
            end
        end)
    end

    -- Bind ADS cross-platform
    ContextActionService:BindAction("AimWeaponAction", handleAimInput, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
    
    -- Cleanup on death
    local function onCharacterAdded(char)
        local hum = char:WaitForChild("Humanoid") :: Humanoid
        hum.Died:Connect(function()
            WeaponController.CancelADS()
    if currentWeaponState then currentWeaponState.isReloading = false end
        end)
    end
    
    if Players.LocalPlayer.Character then
        onCharacterAdded(Players.LocalPlayer.Character)
    end
    Players.LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

    local phaseTransitionRemote = RemoteEvents.GetReliable("MatchPhaseTransition")
    if phaseTransitionRemote then
        phaseTransitionRemote.OnClientEvent:Connect(function(payload)
            local phase = payload.phase
            if phase == "Combat" or phase == "Starting" or phase == "Buy" or phase == "PracticeRange" then
                isCombatPhase = true
                if not currentWeaponState then
                    WeaponController.EquipWeapon(localLoadout.Primary)
                end
            else
                isCombatPhase = false
                WeaponController.UnequipWeapon()
            end
        end)
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or not isCombatPhase then return end
        if input.KeyCode == Enum.KeyCode.One then
            WeaponController.EquipWeapon(localLoadout.Primary)
        elseif input.KeyCode == Enum.KeyCode.Two then
            WeaponController.EquipWeapon(localLoadout.Secondary)
        elseif input.KeyCode == Enum.KeyCode.Three then
            WeaponController.EquipWeapon(localLoadout.Grenade)
        end
    end)

    isInitialized = true
end

function WeaponController.RenderExternalTracer(origin: Vector3, direction: Vector3): ()
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then return end
	local maxDistance = 300
	local targetPos = origin + direction * maxDistance

	updateRaycastFilter()
	local result = Workspace:Raycast(origin, direction * maxDistance, raycastParams)
	if result then
		targetPos = result.Position
	end

	RenderMuzzleFlash(CFrame.lookAt(origin, targetPos))
	RenderTracer(origin, targetPos)
end

function WeaponController.GetState(): WeaponState?
    return currentWeaponState
end

function WeaponController.GetActiveStats(): WeaponStats.WeaponData?
    return activeStats
end

return WeaponController
]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX23"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX97"><Properties><string name="Name">AgentSelectUI</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v3: AgentSelectUI (Legendary Edition)

    Pre-round operative select — Valorant-style agent pick:
    - Fullscreen cinematic select with countdown
    - Agent cards + live detail panel (role, kit, passive)
    - Hover / select / locked / banned visual states
    - Teammate pick strip + lock confirm
    - Auto-pick on timeout, server sync via RemoteEvents
    - UITheme integration, CanvasGroup fades, connection cleanup
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local LocalPlayer = Players.LocalPlayer
local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local UIFolder = script.Parent
local UITheme = require(UIFolder:WaitForChild("UITheme") :: ModuleScript)
local OperativeStats = require(ReplicatedStorage:WaitForChild("Data"):WaitForChild("OperativeStats") :: ModuleScript)
local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents") :: ModuleScript)

export type AgentLockPayload = {
	operativeId: string,
	playerId: number?,
	playerName: string?,
	team: string?,
	allLocked: boolean?,
	banned: boolean?,
}

export type TeammatePick = {
	playerId: number,
	playerName: string,
	operativeId: string?,
	locked: boolean,
}

local AgentSelectUI = {}

-- ============================================================================
-- CONFIG
-- ============================================================================

local OPERATIVES = { "Vex", "Warden", "Fray", "Choke", "Pulse", "Bastion" }
local DEFAULT_LOCK_TIME = 30

local ROLE_COLORS: { [string]: Color3 } = {
	Duelist = Color3.fromRGB(255, 90, 90),
	Controller = Color3.fromRGB(160, 100, 255),
	Sentinel = Color3.fromRGB(80, 200, 255),
	Initiator = Color3.fromRGB(255, 190, 70),
	Support = Color3.fromRGB(80, 220, 140),
	Tank = Color3.fromRGB(100, 180, 255),
}

local ABILITY_KEYS = { "C", "Q", "E", "X" }

-- ============================================================================
-- STATE
-- ============================================================================

local isInitialized = false
local screenGui: ScreenGui? = nil
local rootGroup: CanvasGroup? = nil
local mainFrame: Frame? = nil

local selectedOp: string? = nil
local lockedIn = false
local lockedOps: { [string]: boolean } = {}
local bannedOps: { [string]: boolean } = {}
local teammatePicks: { [number]: TeammatePick } = {}

local timerLabel: TextLabel? = nil
local timerRing: Frame? = nil
local phaseLabel: TextLabel? = nil
local lockBtn: TextButton? = nil
local lockBtnLabel: TextLabel? = nil
local detailName: TextLabel? = nil
local detailRole: TextLabel? = nil
local detailDesc: TextLabel? = nil
local detailPassive: TextLabel? = nil
local abilityContainer: Frame? = nil
local teamStrip: Frame? = nil
local statusLabel: TextLabel? = nil

local cardFrames: { [string]: TextButton } = {}
local cardStrokes: { [string]: UIStroke } = {}
local abilityFrames: { Frame } = {}

local timerConn: RBXScriptConnection? = nil
local connections: { RBXScriptConnection } = {}
local activeTweens: { Tween } = {}
local lockTimeTotal = DEFAULT_LOCK_TIME
local lockTimeRemaining = DEFAULT_LOCK_TIME
local timerToken = 0

local C = UITheme.Colors

-- ============================================================================
-- UTILS
-- ============================================================================

local function trackConn(c: RBXScriptConnection): RBXScriptConnection
	table.insert(connections, c)
	return c
end

local function trackTween(t: Tween): Tween
	table.insert(activeTweens, t)
	t.Completed:Once(function()
		local i = table.find(activeTweens, t)
		if i then
			table.remove(activeTweens, i)
		end
	end)
	return t
end

local function cancelTweens()
	for _, t in activeTweens do
		t:Cancel()
	end
	table.clear(activeTweens)
end

local function disconnectRuntime()
	if timerConn then
		timerConn:Disconnect()
		timerConn = nil
	end
end

local function disconnectAll()
	disconnectRuntime()
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
end

local function playUi(name: string, vol: number?)
	local s = SoundService:FindFirstChild(name)
	if s and s:IsA("Sound") then
		local cl = s:Clone()
		cl.Volume = vol or s.Volume
		cl.Parent = SoundService
		cl:Play()
		cl.Ended:Once(function()
			cl:Destroy()
		end)
	end
end

local function roleColor(role: string?): Color3
	if role and ROLE_COLORS[role] then
		return ROLE_COLORS[role]
	end
	return C.Accent
end

local function getOpData(opId: string): any?
	local ok, data = pcall(function()
		return OperativeStats.Get(opId)
	end)
	if ok then
		return data
	end
	return nil
end

local function fireSelect(opId: string, locked: boolean?)
	pcall(function()
		RemoteEvents.GetReliable("SelectAgent"):FireServer({
			operativeId = opId,
			locked = locked == true,
		})
	end)
	-- Back-compat: some servers expect a plain string
	pcall(function()
		if locked then
			RemoteEvents.GetReliable("SelectAgent"):FireServer(opId)
		end
	end)
end

-- ============================================================================
-- VISUAL STATE
-- ============================================================================

local function setCardVisual(opId: string)
	local card = cardFrames[opId]
	local stroke = cardStrokes[opId]
	if not card then
		return
	end

	local isBanned = bannedOps[opId] == true
	local isTaken = lockedOps[opId] == true
	local isSelected = selectedOp == opId

	if isBanned then
		card.BackgroundColor3 = Color3.fromRGB(28, 18, 18)
		card.BackgroundTransparency = 0.35
		if stroke then
			stroke.Color = Color3.fromRGB(120, 40, 40)
			stroke.Transparency = 0.2
		end
	elseif isTaken and not isSelected then
		card.BackgroundColor3 = Color3.fromRGB(36, 22, 22)
		card.BackgroundTransparency = 0.4
		if stroke then
			stroke.Color = Color3.fromRGB(140, 50, 50)
			stroke.Transparency = 0.35
		end
	elseif isSelected then
		card.BackgroundColor3 = C.PanelLight or Color3.fromRGB(32, 42, 58)
		card.BackgroundTransparency = 0.05
		if stroke then
			stroke.Color = C.Accent
			stroke.Transparency = 0
			stroke.Thickness = 2.5
		end
	else
		card.BackgroundColor3 = C.Panel
		card.BackgroundTransparency = 0.1
		if stroke then
			stroke.Color = C.Border
			stroke.Transparency = 0.35
			stroke.Thickness = 1.5
		end
	end

	local takenTag = card:FindFirstChild("TakenOverlay") :: Frame?
	if takenTag then
		takenTag.Visible = isTaken or isBanned
		local tl = takenTag:FindFirstChild("Label") :: TextLabel?
		if tl then
			tl.Text = if isBanned then "BANNED" else "LOCKED"
		end
	end
end

local function refreshAllCards()
	for _, opId in OPERATIVES do
		setCardVisual(opId)
	end
end

local function clearAbilityCards()
	for _, f in abilityFrames do
		f:Destroy()
	end
	table.clear(abilityFrames)
end

local function populateAbilities(opId: string)
	if not abilityContainer then
		return
	end
	clearAbilityCards()
	local data = getOpData(opId)
	if not data then
		return
	end

	-- Support several OperativeStats shapes
	local kit: { any } = {}
	if typeof(data.abilities) == "table" then
		kit = data.abilities
	elseif typeof(data.kit) == "table" then
		kit = data.kit
	else
		-- Fallback placeholders from known fields
		local names = {
			data.abilityC or data.util or "Utility",
			data.abilityQ or data.tactical or "Tactical",
			data.abilityE or data.signature or "Signature",
			data.abilityX or data.ultimate or "Ultimate",
		}
		for i, n in names do
			table.insert(kit, {
				key = ABILITY_KEYS[i] or "?",
				name = tostring(n),
				description = "",
			})
		end
	end

	for i, ab in kit do
		if i &gt; 4 then
			break
		end
		local key = tostring(ab.key or ABILITY_KEYS[i] or "?")
		local name = tostring(ab.name or ab.id or "Ability")
		local desc = tostring(ab.description or ab.desc or "")

		local cell = Instance.new("Frame")
		cell.Name = "Ability_" .. key
		cell.Size = UDim2.new(0.24, -6, 1, 0)
		cell.BackgroundColor3 = C.Background or Color3.fromRGB(12, 14, 18)
		cell.BackgroundTransparency = 0.25
		cell.BorderSizePixel = 0
		cell.Parent = abilityContainer
		if UITheme.applyCorner then
			UITheme.applyCorner(cell)
		else
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 8)
			c.Parent = cell
		end

		local keyL = Instance.new("TextLabel")
		keyL.Size = UDim2.new(1, 0, 0, 18)
		keyL.Position = UDim2.new(0, 0, 0, 6)
		keyL.BackgroundTransparency = 1
		keyL.Font = Enum.Font.GothamBlack
		keyL.TextSize = 14
		keyL.TextColor3 = if key == "X" then C.AccentGold or Color3.fromRGB(255, 190, 70) else C.Accent
		keyL.Text = key
		keyL.Parent = cell

		local nameL = Instance.new("TextLabel")
		nameL.Size = UDim2.new(1, -10, 0, 16)
		nameL.Position = UDim2.new(0, 5, 0, 26)
		nameL.BackgroundTransparency = 1
		nameL.Font = Enum.Font.GothamBold
		nameL.TextSize = 12
		nameL.TextColor3 = C.TextPrimary or C.Text or Color3.new(1, 1, 1)
		nameL.Text = string.upper(name)
		nameL.TextTruncate = Enum.TextTruncate.AtEnd
		nameL.Parent = cell

		local descL = Instance.new("TextLabel")
		descL.Size = UDim2.new(1, -12, 1, -48)
		descL.Position = UDim2.new(0, 6, 0, 46)
		descL.BackgroundTransparency = 1
		descL.Font = Enum.Font.Gotham
		descL.TextSize = 10
		descL.TextColor3 = C.TextSecondary or Color3.fromRGB(140, 150, 165)
		descL.Text = desc
		descL.TextWrapped = true
		descL.TextYAlignment = Enum.TextYAlignment.Top
		descL.TextXAlignment = Enum.TextXAlignment.Left
		descL.Parent = cell

		table.insert(abilityFrames, cell)
	end
end

local function updateDetail(opId: string?)
	if not opId then
		if detailName then
			detailName.Text = "SELECT AN OPERATIVE"
		end
		if detailRole then
			detailRole.Text = ""
		end
		if detailDesc then
			detailDesc.Text = "Choose your operative before the timer expires."
		end
		if detailPassive then
			detailPassive.Text = ""
		end
		clearAbilityCards()
		return
	end

	local data = getOpData(opId)
	local role = data and tostring(data.role or "Operative") or "Operative"
	local desc = data and tostring(data.description or data.bio or "") or ""
	local passive = data and tostring(data.passive or data.passiveDescription or "") or ""

	if detailName then
		detailName.Text = string.upper(opId)
	end
	if detailRole then
		detailRole.Text = string.upper(role)
		detailRole.TextColor3 = roleColor(role)
	end
	if detailDesc then
		detailDesc.Text = desc
	end
	if detailPassive then
		detailPassive.Text = if passive ~= "" then ("PASSIVE  ·  " .. passive) else ""
	end
	populateAbilities(opId)
end

local function updateLockButton()
	if not lockBtn then
		return
	end
	if lockedIn then
		lockBtn.BackgroundColor3 = Color3.fromRGB(40, 80, 50)
		if lockBtnLabel then
			lockBtnLabel.Text = "LOCKED IN"
		else
			lockBtn.Text = "LOCKED IN"
		end
		lockBtn.Active = false
		lockBtn.AutoButtonColor = false
	elseif selectedOp and not lockedOps[selectedOp] and not bannedOps[selectedOp] then
		lockBtn.BackgroundColor3 = C.Accent
		if lockBtnLabel then
			lockBtnLabel.Text = "LOCK IN  ·  " .. string.upper(selectedOp)
		else
			lockBtn.Text = "LOCK IN"
		end
		lockBtn.Active = true
	else
		lockBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
		if lockBtnLabel then
			lockBtnLabel.Text = "SELECT AN OPERATIVE"
		else
			lockBtn.Text = "SELECT AN OPERATIVE"
		end
		lockBtn.Active = false
	end
end

local function rebuildTeamStrip()
	if not teamStrip then
		return
	end
	for _, ch in teamStrip:GetChildren() do
		if ch:IsA("Frame") then
			ch:Destroy()
		end
	end

	local list: { TeammatePick } = {}
	for _, p in teammatePicks do
		table.insert(list, p)
	end
	table.sort(list, function(a, b)
		return a.playerName &lt; b.playerName
	end)

	for i, p in list do
		local cell = Instance.new("Frame")
		cell.Name = "Mate_" .. p.playerId
		cell.Size = UDim2.new(0, if IS_MOBILE then 100 else 130, 1, 0)
		cell.BackgroundColor3 = C.Panel
		cell.BackgroundTransparency = 0.2
		cell.BorderSizePixel = 0
		cell.LayoutOrder = i
		cell.Parent = teamStrip
		if UITheme.applyCorner then
			UITheme.applyCorner(cell)
		end

		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(1, -8, 0, 16)
		name.Position = UDim2.new(0, 4, 0, 4)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBold
		name.TextSize = 11
		name.TextColor3 = if p.playerId == LocalPlayer.UserId then C.Accent else (C.TextPrimary or Color3.new(1, 1, 1))
		name.Text = p.playerName
		name.TextTruncate = Enum.TextTruncate.AtEnd
		name.Parent = cell

		local op = Instance.new("TextLabel")
		op.Size = UDim2.new(1, -8, 0, 14)
		op.Position = UDim2.new(0, 4, 0, 22)
		op.BackgroundTransparency = 1
		op.Font = Enum.Font.GothamMedium
		op.TextSize = 11
		op.TextColor3 = if p.locked then (C.AccentGold or Color3.fromRGB(255, 190, 70)) else (C.TextSecondary or Color3.fromRGB(140, 150, 165))
		op.Text = if p.operativeId then string.upper(p.operativeId) else "…"
		op.Parent = cell
	end
end

-- ============================================================================
-- SELECTION / LOCK
-- ============================================================================

local function selectOperative(opId: string, silent: boolean?)
	if lockedIn then
		return
	end
	if lockedOps[opId] or bannedOps[opId] then
		return
	end
	selectedOp = opId
	if not silent then
		playUi("UI_Click", 0.35)
	end
	refreshAllCards()
	updateDetail(opId)
	updateLockButton()
	if statusLabel then
		statusLabel.Text = "Selected  " .. string.upper(opId) .. "  —  lock in to confirm"
	end
	-- Soft hover select to server (pre-lock)
	pcall(function()
		RemoteEvents.GetReliable("HoverAgent"):FireServer(opId)
	end)
end

local function lockIn()
	if lockedIn or not selectedOp then
		return
	end
	if lockedOps[selectedOp] or bannedOps[selectedOp] then
		return
	end
	lockedIn = true
	playUi("UI_LockIn", 0.55)
	updateLockButton()
	if statusLabel then
		statusLabel.Text = "LOCKED  ·  " .. string.upper(selectedOp)
		statusLabel.TextColor3 = C.AccentGold or Color3.fromRGB(255, 190, 70)
	end
	-- Pulse lock button
	if lockBtn then
		trackTween(TweenService:Create(lockBtn, TweenInfo.new(0.15), {
			Size = lockBtn.Size + UDim2.new(0, 8, 0, 4),
		})):Play()
		task.delay(0.15, function()
			if lockBtn then
				TweenService:Create(lockBtn, TweenInfo.new(0.2), {
					Size = UDim2.new(if IS_MOBILE then 0.5 else 0.22, 0, 0, 52),
				}):Play()
			end
		end)
	end
	fireSelect(selectedOp, true)
end

local function autoPick()
	if lockedIn then
		return
	end
	local available = {}
	for _, id in OPERATIVES do
		if not lockedOps[id] and not bannedOps[id] then
			table.insert(available, id)
		end
	end
	if not selectedOp or lockedOps[selectedOp] or bannedOps[selectedOp] then
		selectedOp = available[math.random(1, math.max(#available, 1))] or OPERATIVES[1]
	end
	if selectedOp then
		selectOperative(selectedOp, true)
		lockIn()
	end
end

-- ============================================================================
-- TIMER
-- ============================================================================

local function stopTimer()
	disconnectRuntime()
	timerToken += 1
end

local function startTimer(seconds: number)
	stopTimer()
	lockTimeTotal = seconds
	lockTimeRemaining = seconds
	local token = timerToken
	local acc = 0

	if timerLabel then
		timerLabel.Text = tostring(seconds)
		timerLabel.TextColor3 = C.Accent
	end

	timerConn = RunService.Heartbeat:Connect(function(dt)
		if token ~= timerToken then
			return
		end
		acc += dt
		if acc &lt; 1 then
			return
		end
		acc -= 1
		lockTimeRemaining -= 1
		local left = math.max(0, lockTimeRemaining)
		if timerLabel then
			timerLabel.Text = string.format("%02d", left)
			if left &lt;= 5 then
				timerLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
				-- punch
				trackTween(TweenService:Create(timerLabel, TweenInfo.new(0.12), {
					TextSize = 40,
				})):Play()
				task.delay(0.12, function()
					if timerLabel then
						TweenService:Create(timerLabel, TweenInfo.new(0.12), { TextSize = 34 }):Play()
					end
				end)
				playUi("UI_Tick", 0.25)
			elseif left &lt;= 10 then
				timerLabel.TextColor3 = C.AccentGold or Color3.fromRGB(255, 190, 70)
			end
		end
		if left &lt;= 0 then
			stopTimer()
			if not lockedIn then
				autoPick()
			end
		end
	end)
end

-- ============================================================================
-- BUILD UI
-- ============================================================================

local function createCard(opId: string, parent: Instance): TextButton
	local data = getOpData(opId)
	local role = data and tostring(data.role or "") or ""
	local desc = data and tostring(data.description or "") or ""
	local rc = roleColor(role)

	local card = Instance.new("TextButton")
	card.Name = opId
	card.BackgroundColor3 = C.Panel
	card.BackgroundTransparency = 0.1
	card.BorderSizePixel = 0
	card.Text = ""
	card.AutoButtonColor = false
	card.ClipsDescendants = true
	card.Parent = parent
	if UITheme.applyCorner then
		UITheme.applyCorner(card)
	else
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 10)
		c.Parent = card
	end
	local stroke = if UITheme.applyStroke
		then UITheme.applyStroke(card, C.Border, 1.5)
		else (function()
			local s = Instance.new("UIStroke")
			s.Color = C.Border
			s.Thickness = 1.5
			s.Parent = card
			return s
		end)()
	cardStrokes[opId] = stroke

	-- Top role accent bar
	local accent = Instance.new("Frame")
	accent.Name = "RoleAccent"
	accent.Size = UDim2.new(1, 0, 0, 4)
	accent.BackgroundColor3 = rc
	accent.BorderSizePixel = 0
	accent.Parent = card

	-- Portrait placeholder block
	local portrait = Instance.new("Frame")
	portrait.Name = "Portrait"
	portrait.Size = UDim2.new(1, -16, 0.38, 0)
	portrait.Position = UDim2.new(0, 8, 0, 16)
	portrait.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
	portrait.BorderSizePixel = 0
	portrait.Parent = card
	if UITheme.applyCorner then
		UITheme.applyCorner(portrait)
	end
	local monogram = Instance.new("TextLabel")
	monogram.Size = UDim2.fromScale(1, 1)
	monogram.BackgroundTransparency = 1
	monogram.Font = Enum.Font.GothamBlack
	monogram.TextSize = if IS_MOBILE then 28 else 36
	monogram.TextColor3 = rc
	monogram.TextTransparency = 0.15
	monogram.Text = string.sub(opId, 1, 1)
	monogram.Parent = portrait

	local nameL = Instance.new("TextLabel")
	nameL.Name = "Name"
	nameL.Size = UDim2.new(1, -12, 0, 22)
	nameL.Position = UDim2.new(0, 6, 0.55, 0)
	nameL.BackgroundTransparency = 1
	nameL.Font = Enum.Font.GothamBlack
	nameL.TextSize = if IS_MOBILE then 14 else 18
	nameL.TextColor3 = C.TextPrimary or Color3.new(1, 1, 1)
	nameL.Text = string.upper(opId)
	nameL.Parent = card

	local roleL = Instance.new("TextLabel")
	roleL.Name = "Role"
	roleL.Size = UDim2.new(1, -12, 0, 16)
	roleL.Position = UDim2.new(0, 6, 0.55, 22)
	roleL.BackgroundTransparency = 1
	roleL.Font = Enum.Font.GothamBold
	roleL.TextSize = 12
	roleL.TextColor3 = rc
	roleL.Text = string.upper(role)
	roleL.Parent = card

	local descL = Instance.new("TextLabel")
	descL.Name = "Desc"
	descL.Size = UDim2.new(1, -14, 0.22, 0)
	descL.Position = UDim2.new(0, 7, 0.72, 0)
	descL.BackgroundTransparency = 1
	descL.Font = Enum.Font.Gotham
	descL.TextSize = 10
	descL.TextColor3 = C.TextSecondary or Color3.fromRGB(140, 150, 165)
	descL.Text = desc
	descL.TextWrapped = true
	descL.TextYAlignment = Enum.TextYAlignment.Top
	descL.Parent = card

	local taken = Instance.new("Frame")
	taken.Name = "TakenOverlay"
	taken.Size = UDim2.fromScale(1, 1)
	taken.BackgroundColor3 = Color3.new(0, 0, 0)
	taken.BackgroundTransparency = 0.45
	taken.Visible = false
	taken.ZIndex = 5
	taken.Parent = card
	local takenL = Instance.new("TextLabel")
	takenL.Name = "Label"
	takenL.Size = UDim2.fromScale(1, 1)
	takenL.BackgroundTransparency = 1
	takenL.Font = Enum.Font.GothamBlack
	takenL.TextSize = 16
	takenL.TextColor3 = Color3.fromRGB(255, 120, 120)
	takenL.Text = "LOCKED"
	takenL.ZIndex = 6
	takenL.Parent = taken

	trackConn(card.MouseEnter:Connect(function()
		if lockedIn or lockedOps[opId] or bannedOps[opId] then
			return
		end
		TweenService:Create(card, TweenInfo.new(0.12), {
			BackgroundColor3 = C.PanelLight or Color3.fromRGB(36, 46, 62),
		}):Play()
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.12), { Transparency = 0.1 }):Play()
		end
		playUi("UI_Hover", 0.15)
	end))
	trackConn(card.MouseLeave:Connect(function()
		setCardVisual(opId)
	end))
	trackConn(card.MouseButton1Click:Connect(function()
		selectOperative(opId)
	end))

	local lastClick = 0
	trackConn(card.Activated:Connect(function()
		local now = os.clock()
		if selectedOp == opId and (now - lastClick) &lt; 0.35 then
			lockIn()
		end
		lastClick = now
	end))

	cardFrames[opId] = card
	return card
end

function AgentSelectUI.Init(playerGui: PlayerGui)
	if isInitialized then
		AgentSelectUI.Destroy()
	end

	local existing = playerGui:FindFirstChild("AgentSelectGui")
	if existing then
		existing:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "AgentSelectGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.Enabled = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	screenGui = gui

	local root = Instance.new("CanvasGroup")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.GroupTransparency = 1
	root.Parent = gui
	rootGroup = root

	local main = Instance.new("Frame")
	main.Name = "Main"
	main.Size = UDim2.fromScale(1, 1)
	main.BackgroundColor3 = C.Background
	main.BackgroundTransparency = 0.05
	main.BorderSizePixel = 0
	main.Parent = root
	mainFrame = main

	-- Vignette edges
	local topGrad = Instance.new("Frame")
	topGrad.Size = UDim2.new(1, 0, 0.18, 0)
	topGrad.BackgroundColor3 = Color3.new(0, 0, 0)
	topGrad.BorderSizePixel = 0
	topGrad.Parent = main
	local tg = Instance.new("UIGradient")
	tg.Rotation = 90
	tg.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	tg.Parent = topGrad

	-- Title
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.6, 0, 0, 32)
	title.Position = UDim2.new(0.2, 0, 0.03, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextSize = if IS_MOBILE then 22 else 28
	title.TextColor3 = C.TextPrimary or Color3.new(1, 1, 1)
	title.Text = "SELECT YOUR OPERATIVE"
	title.Parent = main

	phaseLabel = Instance.new("TextLabel")
	phaseLabel.Size = UDim2.new(0.4, 0, 0, 16)
	phaseLabel.Position = UDim2.new(0.3, 0, 0.03, 34)
	phaseLabel.BackgroundTransparency = 1
	phaseLabel.Font = Enum.Font.GothamMedium
	phaseLabel.TextSize = 12
	phaseLabel.TextColor3 = C.TextSecondary or Color3.fromRGB(140, 150, 165)
	phaseLabel.Text = "AGENT SELECT  ·  LOCK IN BEFORE TIME EXPIRES"
	phaseLabel.Parent = main

	-- Timer
	timerLabel = Instance.new("TextLabel")
	timerLabel.Name = "Timer"
	timerLabel.Size = UDim2.new(0, 80, 0, 40)
	timerLabel.Position = UDim2.new(0.5, 0, 0.095, 0)
	timerLabel.AnchorPoint = Vector2.new(0.5, 0)
	timerLabel.BackgroundTransparency = 1
	timerLabel.Font = Enum.Font.GothamBlack
	timerLabel.TextSize = 34
	timerLabel.TextColor3 = C.Accent
	timerLabel.Text = "30"
	timerLabel.Parent = main

	-- Team strip
	teamStrip = Instance.new("Frame")
	teamStrip.Name = "TeamStrip"
	teamStrip.Size = UDim2.new(0.7, 0, 0, 48)
	teamStrip.Position = UDim2.new(0.15, 0, 0.145, 0)
	teamStrip.BackgroundTransparency = 1
	teamStrip.Parent = main
	local tsList = Instance.new("UIListLayout")
	tsList.FillDirection = Enum.FillDirection.Horizontal
	tsList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	tsList.Padding = UDim.new(0, 8)
	tsList.Parent = teamStrip

	-- Card grid
	local grid = Instance.new("Frame")
	grid.Name = "Grid"
	grid.Size = UDim2.new(0.92, 0, if IS_MOBILE then 0.38 else 0.42, 0)
	grid.Position = UDim2.new(0.04, 0, 0.22, 0)
	grid.BackgroundTransparency = 1
	grid.Parent = main

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = if IS_MOBILE
		then UDim2.new(0.3, -8, 0.48, -8)
		else UDim2.new(0.15, -12, 0.95, 0)
	layout.CellPadding = UDim2.new(0.01, 0, 0.02, 0)
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid

	for i, opId in OPERATIVES do
		local card = createCard(opId, grid)
		card.LayoutOrder = i
	end

	-- Detail panel
	local detail = Instance.new("Frame")
	detail.Name = "Detail"
	detail.Size = UDim2.new(0.92, 0, if IS_MOBILE then 0.22 else 0.2, 0)
	detail.Position = UDim2.new(0.04, 0, if IS_MOBILE then 0.62 else 0.66, 0)
	detail.BackgroundColor3 = C.Panel
	detail.BackgroundTransparency = 0.15
	detail.BorderSizePixel = 0
	detail.Parent = main
	if UITheme.applyCorner then
		UITheme.applyCorner(detail)
	end
	if UITheme.applyStroke then
		UITheme.applyStroke(detail, C.Border, 1)
	end

	detailName = Instance.new("TextLabel")
	detailName.Size = UDim2.new(0.35, 0, 0, 28)
	detailName.Position = UDim2.new(0, 18, 0, 12)
	detailName.BackgroundTransparency = 1
	detailName.Font = Enum.Font.GothamBlack
	detailName.TextSize = 22
	detailName.TextColor3 = C.TextPrimary or Color3.new(1, 1, 1)
	detailName.TextXAlignment = Enum.TextXAlignment.Left
	detailName.Text = "SELECT AN OPERATIVE"
	detailName.Parent = detail

	detailRole = Instance.new("TextLabel")
	detailRole.Size = UDim2.new(0.3, 0, 0, 18)
	detailRole.Position = UDim2.new(0, 18, 0, 40)
	detailRole.BackgroundTransparency = 1
	detailRole.Font = Enum.Font.GothamBold
	detailRole.TextSize = 13
	detailRole.TextColor3 = C.Accent
	detailRole.TextXAlignment = Enum.TextXAlignment.Left
	detailRole.Text = ""
	detailRole.Parent = detail

	detailDesc = Instance.new("TextLabel")
	detailDesc.Size = UDim2.new(0.36, 0, 0.45, 0)
	detailDesc.Position = UDim2.new(0, 18, 0, 62)
	detailDesc.BackgroundTransparency = 1
	detailDesc.Font = Enum.Font.Gotham
	detailDesc.TextSize = 12
	detailDesc.TextColor3 = C.TextSecondary or Color3.fromRGB(140, 150, 165)
	detailDesc.TextXAlignment = Enum.TextXAlignment.Left
	detailDesc.TextYAlignment = Enum.TextYAlignment.Top
	detailDesc.TextWrapped = true
	detailDesc.Text = "Choose your operative before the timer expires."
	detailDesc.Parent = detail

	detailPassive = Instance.new("TextLabel")
	detailPassive.Size = UDim2.new(0.36, 0, 0, 16)
	detailPassive.Position = UDim2.new(0, 18, 1, -24)
	detailPassive.BackgroundTransparency = 1
	detailPassive.Font = Enum.Font.GothamMedium
	detailPassive.TextSize = 11
	detailPassive.TextColor3 = C.AccentGold or Color3.fromRGB(255, 190, 70)
	detailPassive.TextXAlignment = Enum.TextXAlignment.Left
	detailPassive.Text = ""
	detailPassive.Parent = detail

	abilityContainer = Instance.new("Frame")
	abilityContainer.Name = "Abilities"
	abilityContainer.Size = UDim2.new(0.42, 0, 0, 10)
	abilityContainer.Position = UDim2.new(0.42, 0, 0, 10)
	abilityContainer.BackgroundTransparency = 1
	abilityContainer.Parent = detail
	local abList = Instance.new("UIListLayout")
	abList.FillDirection = Enum.FillDirection.Horizontal
	abList.Padding = UDim.new(0, 8)
	abList.Parent = abilityContainer

	-- Lock button
	lockBtn = Instance.new("TextButton")
	lockBtn.Name = "LockIn"
	lockBtn.Size = UDim2.new(if IS_MOBILE then 0.5 else 0.22, 0, 0, 52)
	lockBtn.Position = UDim2.new(0.5, 0, if IS_MOBILE then 0.9 else 0.9, 0)
	lockBtn.AnchorPoint = Vector2.new(0.5, 0.5)
	lockBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
	lockBtn.Text = ""
	lockBtn.AutoButtonColor = false
	lockBtn.Parent = main
	if UITheme.applyCorner then
		UITheme.applyCorner(lockBtn)
	else
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 10)
		c.Parent = lockBtn
	end
	if UITheme.applyStroke then
		UITheme.applyStroke(lockBtn, C.Accent, 2)
	end

	lockBtnLabel = Instance.new("TextLabel")
	lockBtnLabel.Size = UDim2.fromScale(1, 1)
	lockBtnLabel.BackgroundTransparency = 1
	lockBtnLabel.Font = Enum.Font.GothamBlack
	lockBtnLabel.TextSize = 18
	lockBtnLabel.TextColor3 = Color3.fromRGB(10, 14, 20)
	lockBtnLabel.Text = "SELECT AN OPERATIVE"
	lockBtnLabel.Parent = lockBtn

	trackConn(lockBtn.MouseButton1Click:Connect(function()
		if lockBtn and lockBtn.Active then
			lockIn()
		end
	end))

	statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(0.5, 0, 0, 18)
	statusLabel.Position = UDim2.new(0.25, 0, 0.955, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.TextSize = 12
	statusLabel.TextColor3 = C.TextSecondary or Color3.fromRGB(140, 150, 165)
	statusLabel.Text = "Double-click an operative to quick lock"
	statusLabel.Parent = main

	-- Keyboard: 1-6 select, Enter lock
	trackConn(UserInputService.InputBegan:Connect(function(input, gp)
		if gp or not AgentSelectUI.IsVisible() or lockedIn then
			return
		end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			lockIn()
			return
		end
		local map = {
			[Enum.KeyCode.One] = 1,
			[Enum.KeyCode.Two] = 2,
			[Enum.KeyCode.Three] = 3,
			[Enum.KeyCode.Four] = 4,
			[Enum.KeyCode.Five] = 5,
			[Enum.KeyCode.Six] = 6,
		}
		local idx = map[input.KeyCode]
		if idx and OPERATIVES[idx] then
			selectOperative(OPERATIVES[idx])
		end
	end))

	-- Server events
	pcall(function()
		trackConn(RemoteEvents.GetReliable("AgentLocked").OnClientEvent:Connect(function(data: any)
			AgentSelectUI.ApplyLockUpdate(data)
		end))
	end)
	pcall(function()
		trackConn(RemoteEvents.GetReliable("AgentSelectState").OnClientEvent:Connect(function(data: any)
			if typeof(data) ~= "table" then
				return
			end
			if typeof(data.banned) == "table" then
				table.clear(bannedOps)
				for _, id in data.banned do
					bannedOps[tostring(id)] = true
				end
			end
			if typeof(data.locked) == "table" then
				table.clear(lockedOps)
				for _, id in data.locked do
					lockedOps[tostring(id)] = true
				end
			end
			if typeof(data.teammates) == "table" then
				table.clear(teammatePicks)
				for _, t in data.teammates do
					if typeof(t) == "table" and t.playerId then
						teammatePicks[t.playerId] = {
							playerId = t.playerId,
							playerName = tostring(t.playerName or "Player"),
							operativeId = t.operativeId,
							locked = t.locked == true,
						}
					end
				end
				rebuildTeamStrip()
			end
			if typeof(data.timeLeft) == "number" then
				lockTimeRemaining = data.timeLeft
				if timerLabel then
					timerLabel.Text = string.format("%02d", math.max(0, data.timeLeft))
				end
			end
			refreshAllCards()
			updateLockButton()
		end))
	end)

	isInitialized = true
end

-- ============================================================================
-- PUBLIC API
-- ============================================================================

function AgentSelectUI.ApplyLockUpdate(data: any)
	if typeof(data) ~= "table" then
		-- plain string operative id
		if typeof(data) == "string" then
			lockedOps[data] = true
			refreshAllCards()
		end
		return
	end

	local opId = data.operativeId or data.agentId or data.id
	if typeof(opId) == "string" then
		if data.banned then
			bannedOps[opId] = true
		else
			lockedOps[opId] = true
		end
	end

	if data.playerId and data.playerName then
		teammatePicks[data.playerId] = {
			playerId = data.playerId,
			playerName = tostring(data.playerName),
			operativeId = typeof(opId) == "string" and opId or nil,
			locked = true,
		}
		rebuildTeamStrip()
	end

	-- If our pick was stolen
	if selectedOp and lockedOps[selectedOp] and not lockedIn then
		if statusLabel then
			statusLabel.Text = string.upper(selectedOp) .. " was taken — pick another"
			statusLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
		end
		selectedOp = nil
		updateDetail(nil)
	end

	refreshAllCards()
	updateLockButton()

	if data.allLocked then
		task.delay(0.6, function()
			AgentSelectUI.Hide()
		end)
	end
end

function AgentSelectUI.Show(mode: string?, playersInfo: any?, duration: number?)
	if not isInitialized or not screenGui or not rootGroup then
		return
	end

	selectedOp = nil
	lockedIn = false
	table.clear(lockedOps)
	table.clear(bannedOps)
	table.clear(teammatePicks)

	-- Seed local player into strip
	teammatePicks[LocalPlayer.UserId] = {
		playerId = LocalPlayer.UserId,
		playerName = LocalPlayer.DisplayName,
		operativeId = nil,
		locked = false,
	}
	if typeof(playersInfo) == "table" then
		for _, p in playersInfo do
			if typeof(p) == "table" and p.playerId then
				teammatePicks[p.playerId] = {
					playerId = p.playerId,
					playerName = tostring(p.playerName or "Player"),
					operativeId = p.operativeId,
					locked = p.locked == true,
				}
			end
		end
	end

	if phaseLabel then
		phaseLabel.Text = string.upper(tostring(mode or "RANKED")) .. "  ·  AGENT SELECT"
	end
	if statusLabel then
		statusLabel.Text = "Double-click an operative to quick lock  ·  Keys 1-6  ·  Enter"
		statusLabel.TextColor3 = C.TextSecondary or Color3.fromRGB(140, 150, 165)
	end

	refreshAllCards()
	updateDetail(nil)
	updateLockButton()
	rebuildTeamStrip()

	screenGui.Enabled = true
	rootGroup.GroupTransparency = 1
	trackTween(TweenService:Create(rootGroup, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		GroupTransparency = 0,
	})):Play()

	startTimer(duration or DEFAULT_LOCK_TIME)
	playUi("UI_AgentSelectOpen", 0.4)
end

function AgentSelectUI.Hide()
	stopTimer()
	if rootGroup and screenGui and screenGui.Enabled then
		local tw = TweenService:Create(rootGroup, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			GroupTransparency = 1,
		})
		trackTween(tw)
		tw:Play()
		tw.Completed:Once(function()
			if screenGui then
				screenGui.Enabled = false
			end
		end)
	elseif screenGui then
		screenGui.Enabled = false
	end
end

function AgentSelectUI.IsVisible(): boolean
	return screenGui ~= nil and screenGui.Enabled
end

function AgentSelectUI.GetSelected(): string?
	return selectedOp
end

function AgentSelectUI.IsLockedIn(): boolean
	return lockedIn
end

function AgentSelectUI.Destroy()
	stopTimer()
	cancelTweens()
	disconnectAll()
	clearAbilityCards()
	if screenGui then
		screenGui:Destroy()
	end
	screenGui, rootGroup, mainFrame = nil, nil, nil
	timerLabel, lockBtn, lockBtnLabel = nil, nil, nil
	detailName, detailRole, detailDesc, detailPassive = nil, nil, nil, nil
	abilityContainer, teamStrip, statusLabel, phaseLabel = nil, nil, nil, nil
	table.clear(cardFrames)
	table.clear(cardStrokes)
	table.clear(lockedOps)
	table.clear(bannedOps)
	table.clear(teammatePicks)
	isInitialized = false
end

return AgentSelectUI
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX98"><Properties><string name="Name">BuyMenuController</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[ OVERCLOCK: Buy Menu Controller ]=]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UIFolder = script.Parent
local UITheme = require(UIFolder:WaitForChild("UITheme") :: any)
local WeaponStats = require(ReplicatedStorage:WaitForChild("Data"):WaitForChild("WeaponStats") :: any)
local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents") :: any)

local BuyMenuController = {}
local screenGui: ScreenGui? = nil
local creditsLabel: TextLabel? = nil
local currentCredits = 0
local purchased: { [string]: boolean } = {}

local CATALOG = {
	{id = "Pistol", price = 0, cat = "Sidearm"},
	{id = "LightSMG", price = 1000, cat = "SMG"},
	{id = "HeavySMG", price = 1500, cat = "SMG"},
	{id = "Carbine", price = 2500, cat = "Rifle"},
	{id = "AssaultRifle", price = 2900, cat = "Rifle"},
	{id = "BurstRifle", price = 2500, cat = "Rifle"},
	{id = "SniperRifle", price = 4500, cat = "Sniper"},
	{id = "Shotgun", price = 1800, cat = "Shotgun"},
	{id = "LightArmor", price = 400, cat = "Armor"},
	{id = "HeavyArmor", price = 1000, cat = "Armor"},
}

local isInitialized = false

function BuyMenuController.Init(playerGui: PlayerGui)
	if isInitialized then return end
	isInitialized = true
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "BuyMenuGui"
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = 14
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.Size = UDim2.new(0.65, 0, 0.75, 0)
	panel.Position = UDim2.new(0.175, 0, 0.125, 0)
	panel.BackgroundColor3 = UITheme.Colors.Background
	panel.BackgroundTransparency = 0.05
	panel.BorderSizePixel = 0
	panel.Parent = screenGui
	UITheme.applyCorner(panel)
	UITheme.applyStroke(panel, UITheme.Colors.Border, 2)

	local title = UITheme.createLabel(panel, "BUY MENU", UDim2.new(0.3, 0, 0, 30), UDim2.new(0.05, 0, 0.02, 0))
	title.TextSize = 22

	creditsLabel = UITheme.createLabel(panel, "CREDITS: 0", UDim2.new(0.3, 0, 0, 30), UDim2.new(0.65, 0, 0.02, 0))
	creditsLabel.TextSize = 20
	creditsLabel.TextColor3 = UITheme.Colors.Gold
	creditsLabel.TextXAlignment = Enum.TextXAlignment.Right

	local grid = Instance.new("Frame")
	grid.Size = UDim2.new(0.92, 0, 0.82, 0)
	grid.Position = UDim2.new(0.04, 0, 0.12, 0)
	grid.BackgroundTransparency = 1
	grid.Parent = panel

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.18, -8, 0.28, -8)
	layout.CellPadding = UDim2.new(0.01, 0, 0.02, 0)
	layout.Parent = grid

	for _, item in CATALOG do
		local card = Instance.new("TextButton")
		card.Name = item.id
		card.BackgroundColor3 = UITheme.Colors.Panel
		card.BorderSizePixel = 0
		card.Text = ""
		card.AutoButtonColor = false
		card.Parent = grid
		UITheme.applyCorner(card)
		UITheme.applyStroke(card, UITheme.Colors.Border)

		local wData = WeaponStats.Get(item.id)
		local displayName = if wData then wData.displayName else item.id

		local nameL = UITheme.createLabel(card, displayName, UDim2.new(0.9, 0, 0, 16), UDim2.new(0.05, 0, 0.05, 0))
		nameL.TextSize = 12
		nameL.TextXAlignment = Enum.TextXAlignment.Center

		local catL = UITheme.createLabel(card, item.cat, UDim2.new(0.9, 0, 0, 14), UDim2.new(0.05, 0, 0.25, 0))
		catL.TextSize = 10
		catL.TextColor3 = UITheme.Colors.TextSecondary
		catL.TextXAlignment = Enum.TextXAlignment.Center

		local priceL = UITheme.createLabel(card, if item.price == 0 then "FREE" else "$" .. tostring(item.price), UDim2.new(0.9, 0, 0, 18), UDim2.new(0.05, 0, 0.55, 0))
		priceL.TextSize = 14
		priceL.TextColor3 = if item.price == 0 then UITheme.Colors.Success else UITheme.Colors.Gold
		priceL.TextXAlignment = Enum.TextXAlignment.Center

		if wData then
			local statL = UITheme.createLabel(card, "DMG:" .. tostring(wData.damage) .. " RPM:" .. tostring(wData.fireRate), UDim2.new(0.9, 0, 0, 12), UDim2.new(0.05, 0, 0.78, 0))
			statL.TextSize = 9
			statL.TextColor3 = UITheme.Colors.TextSecondary
			statL.TextXAlignment = Enum.TextXAlignment.Center
		end

		UITheme.addHoverFeedback(card)

		card.MouseButton1Click:Connect(function()
			if purchased[item.id] then return end
			pcall(function()
				RemoteEvents.GetReliable("RequestPurchase"):FireServer(item.id)
			end)
		end)
	end

	-- Listen for purchase results
	pcall(function()
		RemoteEvents.GetReliable("PurchaseResult").OnClientEvent:Connect(function(data: any)
			if typeof(data) ~= "table" then return end
			if data.success then
				purchased[data.itemId] = true
				currentCredits = data.balance or currentCredits
				if creditsLabel then creditsLabel.Text = "CREDITS: " .. tostring(currentCredits) end
				local card = grid:FindFirstChild(data.itemId)
				if card then
					TweenService:Create(card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 60, 30)}):Play()
				end
			else
				local card = grid:FindFirstChild(data.itemId)
				if card then
					TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = UITheme.Colors.Danger}):Play()
					task.delay(0.3, function()
						TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = UITheme.Colors.Panel}):Play()
					end)
				end
			end
		end)
	end)

	-- Close on B key
	local UIS = game:GetService("UserInputService")
	UIS.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.B and screenGui and screenGui.Enabled then
			BuyMenuController.Hide()
		end
	end)
end

function BuyMenuController.Show(credits: number?)
	if not screenGui then return end
	purchased = {}
	currentCredits = credits or 0
	if creditsLabel then creditsLabel.Text = "CREDITS: " .. tostring(currentCredits) end
	screenGui.Enabled = true
end

function BuyMenuController.Hide()
	if screenGui then screenGui.Enabled = false end
end

function BuyMenuController.IsVisible(): boolean
	return screenGui ~= nil and screenGui.Enabled
end

return BuyMenuController
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX99"><Properties><string name="Name">ChallengeInviteModal</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: ChallengeInviteModal
    Client-side modal popup UI for incoming 1v1 duel challenges, featuring
    Accept/Decline action buttons and a 15-second radial/countdown timer bar.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ChallengeEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("ChallengeEvents"))

local TOTAL_TIMEOUT_SECONDS = 15

local ChallengeInviteModal = {}

local screenGui: ScreenGui? = nil
local modalFrame: Frame? = nil
local challengerNameLabel: TextLabel? = nil
local countdownTextLabel: TextLabel? = nil
local timerProgressBar: Frame? = nil
local acceptButton: TextButton? = nil
local declineButton: TextButton? = nil

local isUIInitialized = false
local currentActiveChallengeId: string? = nil
local timerThread: thread? = nil

--- Hides and resets the invite modal popup.
function ChallengeInviteModal.Hide()
	if timerThread then
		task.cancel(timerThread)
		timerThread = nil
	end

	currentActiveChallengeId = nil

	if modalFrame then
		TweenService:Create(modalFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 10, 0, 10),
			Position = UDim2.new(0.5, -5, 0.5, -5),
		}):Play()

		task.delay(0.2, function()
			if modalFrame then
				modalFrame.Visible = false
			end
		end)
	end
end

--- Shows the challenge invitation modal with challenger info and 15s timer.
function ChallengeInviteModal.ShowInvite(data: ChallengeEvents.ChallengeRequestData)
	currentActiveChallengeId = data.challengeId

	if challengerNameLabel then
		challengerNameLabel.Text = string.format("%s (@%s)", data.challenger.displayName, data.challenger.username)
	end

	if timerProgressBar then
		timerProgressBar.Size = UDim2.new(1, 0, 1, 0)
	end

	if modalFrame then
		modalFrame.Visible = true
		modalFrame.Size = UDim2.new(0, 10, 0, 10)
		modalFrame.Position = UDim2.new(0.5, -5, 0.5, -5)

		TweenService:Create(modalFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 440, 0, 260),
			Position = UDim2.new(0.5, -220, 0.5, -130),
		}):Play()
	end

	-- Start 15s Radial/Countdown Timer
	if timerThread then
		task.cancel(timerThread)
	end

	timerThread = task.spawn(function()
		local startTime = os.clock()
		local duration = TOTAL_TIMEOUT_SECONDS

		while true do
			local elapsed = os.clock() - startTime
			local remaining = math.max(0, duration - elapsed)
			local fraction = math.clamp(remaining / duration, 0, 1)

			if countdownTextLabel then
				countdownTextLabel.Text = string.format("Auto-declines in: %.1fs", remaining)
			end

			if timerProgressBar then
				timerProgressBar.Size = UDim2.new(fraction, 0, 1, 0)
				timerProgressBar.BackgroundColor3 = Color3.fromRGB(
					math.floor(255 * (1 - fraction)),
					math.floor(220 * fraction),
					100
				)
			end

			if remaining &lt;= 0 then
				break
			end

			task.wait(0.05)
		end

		ChallengeInviteModal.Hide()
	end)
end

local function respondToChallenge(accept: boolean)
	if not currentActiveChallengeId then
		return
	end

	local challengeId = currentActiveChallengeId
	ChallengeInviteModal.Hide()

	local respondRemote = ChallengeEvents.GetRemoteEvent("ChallengeRespond")
	respondRemote:FireServer(challengeId, accept)
end

local function createUIElements(targetParent: Instance)
	local gui = Instance.new("ScreenGui")
	gui.Name = "ChallengeInviteModalGui"
	gui.ResetOnSpawn = false
	gui.Parent = targetParent
	screenGui = gui

	-- Centered Modal Frame
	local frame = Instance.new("Frame")
	frame.Name = "InviteModalFrame"
	frame.Size = UDim2.new(0, 440, 0, 260)
	frame.Position = UDim2.new(0.5, -220, 0.5, -130)
	frame.BackgroundColor3 = Color3.fromRGB(22, 25, 34)
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = gui
	modalFrame = frame

	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 12)
	frameCorner.Parent = frame

	local frameStroke = Instance.new("UIStroke")
	frameStroke.Color = Color3.fromRGB(0, 162, 255)
	frameStroke.Thickness = 2
