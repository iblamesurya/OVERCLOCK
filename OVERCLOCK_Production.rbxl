]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">DirectChallengeService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: DirectChallengeService
    Server-side service managing direct player-to-player 1v1 lobby challenges,
    challenge state machine (Pending, Accepted, Declined, Expired, Canceled),
    15-second auto-expiration timer, status tracking ("In Lobby", "In Queue", "In Match"),
    and duel arena map instantiation &amp; player teleportation upon challenge acceptance.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ChallengeEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("ChallengeEvents") :: any)
local GreyboxArenaMap = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("GreyboxArenaMap") :: any)
local MapRegistry = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("MapRegistry") :: any)
local SpawnService = require(script.Parent:WaitForChild("SpawnService") :: any)

local CHALLENGE_TIMEOUT_SECONDS = 15

local function waitForCharacterWithTimeout(player: Player, timeout: number): Model?
	if player.Character then
		return player.Character
	end
	local char: Model? = nil
	local thread = coroutine.running()
	local conn: RBXScriptConnection
	local disconnectConn: RBXScriptConnection
	local resolved = false

	local function resolve()
		if resolved then
			return
		end
		resolved = true
		if conn then
			conn:Disconnect()
		end
		if disconnectConn then
			disconnectConn:Disconnect()
		end
		task.spawn(thread)
	end

	conn = player.CharacterAdded:Connect(function(c)
		char = c
		resolve()
	end)
	-- Also handle disconnect
	disconnectConn = game:GetService("Players").PlayerRemoving:Connect(function(p)
		if p == player then
			resolve()
		end
	end)
	task.delay(timeout, function()
		resolve()
	end)
	coroutine.yield()
	return char
end

export type PlayerLobbyStatus = "In Lobby" | "In Queue" | "In Match"

export type ActiveChallenge = {
	challengeId: string,
	challengerUserId: number,
	targetUserId: number,
	state: ChallengeEvents.ChallengeState,
	createdAt: number,
	expiresAt: number,
	expireThread: thread?,
}

local DirectChallengeService = {}

local activeChallenges: { [string]: ActiveChallenge } = {}
local playerChallengeMap: { [number]: string } = {}
local playerStatuses: { [number]: PlayerLobbyStatus } = {}

local isInitialized = false

local function getPlayerInfo(player: Player): ChallengeEvents.PlayerInfo
	return {
		userId = player.UserId,
		username = player.Name,
		displayName = player.DisplayName,
	}
end

--- Returns the current status of a player ("In Lobby", "In Queue", "In Match").
function DirectChallengeService.GetPlayerStatus(player: Player): PlayerLobbyStatus
	return playerStatuses[player.UserId] or "In Lobby"
end

--- Updates the status of a player.
function DirectChallengeService.SetPlayerStatus(player: Player, status: PlayerLobbyStatus)
	playerStatuses[player.UserId] = status
end

--- Retrieves an active challenge record by ID.
function DirectChallengeService.GetChallenge(challengeId: string): ActiveChallenge?
	return activeChallenges[challengeId]
end

--- Retrieves the active challenge ID associated with a player UserId.
function DirectChallengeService.GetActiveChallengeForPlayer(player: Player): ActiveChallenge?
	local challengeId = playerChallengeMap[player.UserId]
	if not challengeId then
		return nil
	end
	return activeChallenges[challengeId]
end

local function cleanupChallenge(challengeId: string)
	local challenge = activeChallenges[challengeId]
	if not challenge then
		return
	end

	if challenge.expireThread then
		task.cancel(challenge.expireThread)
		challenge.expireThread = nil
	end

	playerChallengeMap[challenge.challengerUserId] = nil
	playerChallengeMap[challenge.targetUserId] = nil
	activeChallenges[challengeId] = nil
end

--- Instantiates duel arena map and teleports accepted 1v1 combatants to spawn points.
local function spawnDuelArenaAndTeleport(challenger: Player, targetPlayer: Player)
	DirectChallengeService.SetPlayerStatus(challenger, "In Match")
	DirectChallengeService.SetPlayerStatus(targetPlayer, "In Match")

	local arenaFolder: Folder? = nil
	if MapRegistry.IsMapRegistered("GreyboxArena") then
		arenaFolder = MapRegistry.LoadMapInstance("GreyboxArena", Workspace)
	else
		arenaFolder = GreyboxArenaMap.BuildMap(Workspace)
	end

	if arenaFolder then
		arenaFolder.Name = "DuelArenaInstance_" .. tostring(os.time())
	end

	local redSpawns = GreyboxArenaMap.GetSpawnPoints("Red")
	local blueSpawns = GreyboxArenaMap.GetSpawnPoints("Blue")

	local redPos = if #redSpawns &gt; 0 then redSpawns[1] else Vector3.new(-12, 102, -100)
	local bluePos = if #blueSpawns &gt; 0 then blueSpawns[1] else Vector3.new(12, 102, 100)

	local redCFrame = CFrame.new(redPos + Vector3.new(0, 3, 0))
	local blueCFrame = CFrame.new(bluePos + Vector3.new(0, 3, 0))

	local challengerChar = waitForCharacterWithTimeout(challenger, 10)
	if challengerChar then
		pcall(function()
			return SpawnService.SpawnPlayer(challenger, "Match", redCFrame)
		end)
		SpawnService.SetPlayerLocation(challenger, "Match")
	end

	local targetChar = waitForCharacterWithTimeout(targetPlayer, 10)
	if targetChar then
		pcall(function()
			return SpawnService.SpawnPlayer(targetPlayer, "Match", blueCFrame)
		end)
		SpawnService.SetPlayerLocation(targetPlayer, "Match")
	end

	-- Initialize state machine via RoundService
	local matchId = "Duel_"
		.. tostring(challenger.UserId)
		.. "_"
		.. tostring(targetPlayer.UserId)
		.. "_"
		.. tostring(os.time())
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	if servicesFolder then
		local rsMod = servicesFolder:FindFirstChild("RoundService")
		if rsMod then
			local RoundService = require(rsMod :: any)
			RoundService.StartMatch(matchId, "1v1", { challenger }, { targetPlayer })
		end
	end
end

--- Sends a direct 1v1 challenge from challenger to target player.
function DirectChallengeService.SendChallenge(challenger: Player, targetPlayer: Player): (boolean, string?)
	if challenger == targetPlayer then
		return false, "Cannot challenge yourself."
	end

	if DirectChallengeService.GetPlayerStatus(challenger) ~= "In Lobby" then
		return false, "You are currently busy."
	end

	if DirectChallengeService.GetPlayerStatus(targetPlayer) ~= "In Lobby" then
		return false, "Target player is currently busy or in a match."
	end

	if playerChallengeMap[challenger.UserId] ~= nil then
		cleanupChallenge(playerChallengeMap[challenger.UserId])
	end

	if playerChallengeMap[targetPlayer.UserId] ~= nil then
		return false, "Target player already has a challenge pending."
	end

	local now = os.time()
	local expiresAt = now + CHALLENGE_TIMEOUT_SECONDS
	local challengeId = "Challenge_"
		.. tostring(challenger.UserId)
		.. "_"
		.. tostring(targetPlayer.UserId)
		.. "_"
		.. tostring(now)

	local challenge: ActiveChallenge = {
		challengeId = challengeId,
		challengerUserId = challenger.UserId,
		targetUserId = targetPlayer.UserId,
		state = "Pending",
		createdAt = now,
		expiresAt = expiresAt,
		expireThread = nil,
	}

	-- Schedule 15-second auto-expiration timer
	challenge.expireThread = task.delay(CHALLENGE_TIMEOUT_SECONDS, function()
		if activeChallenges[challengeId] and activeChallenges[challengeId].state == "Pending" then
			activeChallenges[challengeId].state = "Expired"

			local expiredRemote = ChallengeEvents.GetRemoteEvent("ChallengeExpired")
			local payload: ChallengeEvents.ChallengeExpiredData = {
				challengeId = challengeId,
				challengerUserId = challenger.UserId,
				targetUserId = targetPlayer.UserId,
			}

			local cPlayer = Players:GetPlayerByUserId(challenger.UserId)
			local tPlayer = Players:GetPlayerByUserId(targetPlayer.UserId)

			if cPlayer then
				expiredRemote:FireClient(cPlayer, payload)
			end
			if tPlayer then
				expiredRemote:FireClient(tPlayer, payload)
			end

			cleanupChallenge(challengeId)
		end
	end)

	activeChallenges[challengeId] = challenge
	playerChallengeMap[challenger.UserId] = challengeId
	playerChallengeMap[targetPlayer.UserId] = challengeId

	local requestData: ChallengeEvents.ChallengeRequestData = {
		challengeId = challengeId,
		challenger = getPlayerInfo(challenger),
		target = getPlayerInfo(targetPlayer),
		timestamp = now,
		expiresAt = expiresAt,
	}

	local receiveRemote = ChallengeEvents.GetRemoteEvent("ChallengeReceive")
	receiveRemote:FireClient(targetPlayer, requestData)

	return true, nil
end

--- Responds to a direct 1v1 challenge (Accept / Decline).
function DirectChallengeService.RespondChallenge(
	targetPlayer: Player,
	challengeId: string,
	accept: boolean
): (boolean, string?)
	local challenge = activeChallenges[challengeId]
	if not challenge then
		return false, "Challenge not found or already expired."
	end

	if challenge.targetUserId ~= targetPlayer.UserId then
		return false, "Unauthorized challenge response."
	end

	if challenge.state ~= "Pending" then
		return false, "Challenge is no longer pending."
	end

	local challenger = Players:GetPlayerByUserId(challenge.challengerUserId)
	if not challenger then
		cleanupChallenge(challengeId)
		return false, "Challenger is no longer in the server."
	end

	local now = os.time()
	local responsePayload: ChallengeEvents.ChallengeResponseData = {
		challengeId = challengeId,
		challengerUserId = challenge.challengerUserId,
		targetUserId = targetPlayer.UserId,
		accepted = accept,
		timestamp = now,
	}

	local respondRemote = ChallengeEvents.GetRemoteEvent("ChallengeRespond")

	if accept then
		challenge.state = "Accepted"
		if challenge.expireThread then
			task.cancel(challenge.expireThread)
			challenge.expireThread = nil
		end
		respondRemote:FireClient(challenger, responsePayload)
		respondRemote:FireClient(targetPlayer, responsePayload)

		spawnDuelArenaAndTeleport(challenger, targetPlayer)
		cleanupChallenge(challengeId)
	else
		challenge.state = "Declined"
		respondRemote:FireClient(challenger, responsePayload)
		respondRemote:FireClient(targetPlayer, responsePayload)
		cleanupChallenge(challengeId)
	end

	return true, nil
end

--- Cancels an outgoing pending 1v1 challenge.
function DirectChallengeService.CancelChallenge(challenger: Player, challengeId: string): (boolean, string?)
	local challenge = activeChallenges[challengeId]
	if not challenge then
		return false, "Challenge not found."
	end

	if challenge.challengerUserId ~= challenger.UserId then
		return false, "Unauthorized challenge cancellation."
	end

	if challenge.state ~= "Pending" then
		return false, "Challenge is no longer pending."
	end

	challenge.state = "Canceled"

	local cancelRemote = ChallengeEvents.GetRemoteEvent("ChallengeCancel")
	local cancelPayload: ChallengeEvents.ChallengeCancelData = {
		challengeId = challengeId,
		challengerUserId = challenger.UserId,
		targetUserId = challenge.targetUserId,
		reason = "Challenger canceled request.",
	}

	local targetPlayer = Players:GetPlayerByUserId(challenge.targetUserId)
	if targetPlayer then
		cancelRemote:FireClient(targetPlayer, cancelPayload)
	end
	cancelRemote:FireClient(challenger, cancelPayload)

	cleanupChallenge(challengeId)
	return true, nil
end

--- Initializes DirectChallengeService remote listeners and player state lifecycle.
-- Simple per-player token bucket for challenge spam
local challengeRateBuckets: { [number]: { tokens: number, last: number } } = {}
local function checkChallengeRateLimit(userId: number): boolean
	local now = os.clock()
	local b = challengeRateBuckets[userId]
	if not b then
		b = { tokens = 3, last = now }
		challengeRateBuckets[userId] = b
	end
	local elapsed = math.max(0, now - b.last)
	b.tokens = math.min(3, b.tokens + elapsed * 1)
	b.last = now
	if b.tokens &gt;= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

function DirectChallengeService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	ChallengeEvents.Initialize()

	local sendRemote = ChallengeEvents.GetRemoteEvent("ChallengeSend")
	sendRemote.OnServerEvent:Connect(function(player: Player, targetUserId: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if not checkChallengeRateLimit(player.UserId) then
			return
		end
		if typeof(targetUserId) ~= "number" or targetUserId &lt;= 0 or targetUserId ~= math.floor(targetUserId) then
			return
		end
		if player.UserId == targetUserId then
			return
		end
		if DirectChallengeService.GetPlayerStatus(player) ~= "In Lobby" then
			return
		end

		local targetPlayer = Players:GetPlayerByUserId(targetUserId)
		if targetPlayer and targetPlayer:IsDescendantOf(Players) then
			if DirectChallengeService.GetPlayerStatus(targetPlayer) ~= "In Lobby" then
				return
			end
			DirectChallengeService.SendChallenge(player, targetPlayer)
		end
	end)

	local respondRemote = ChallengeEvents.GetRemoteEvent("ChallengeRespond")
	respondRemote.OnServerEvent:Connect(function(player: Player, challengeId: any, accept: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if
			typeof(challengeId) ~= "string"
			or #challengeId == 0
			or #challengeId &gt; 100
			or typeof(accept) ~= "boolean"
		then
			return
		end

		local challenge = activeChallenges[challengeId]
		if not challenge or challenge.targetUserId ~= player.UserId or challenge.state ~= "Pending" then
			return
		end

		DirectChallengeService.RespondChallenge(player, challengeId, accept)
	end)

	local cancelRemote = ChallengeEvents.GetRemoteEvent("ChallengeCancel")
	cancelRemote.OnServerEvent:Connect(function(player: Player, challengeId: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return
		end
		if typeof(challengeId) ~= "string" or #challengeId == 0 or #challengeId &gt; 100 then
			return
		end

		local challenge = activeChallenges[challengeId]
		if not challenge or challenge.challengerUserId ~= player.UserId or challenge.state ~= "Pending" then
			return
		end

		DirectChallengeService.CancelChallenge(player, challengeId)
	end)

	Players.PlayerAdded:Connect(function(player: Player)
		playerStatuses[player.UserId] = "In Lobby"
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		local challengeId = playerChallengeMap[player.UserId]
		if challengeId then
			local challenge = activeChallenges[challengeId]
			if challenge and challenge.state == "Pending" then
				if challenge.challengerUserId == player.UserId then
					local targetPlayer = Players:GetPlayerByUserId(challenge.targetUserId)
					if targetPlayer then
						local cancelRemote = ChallengeEvents.GetRemoteEvent("ChallengeCancel")
						cancelRemote:FireClient(targetPlayer, {
							challengeId = challengeId,
							challengerUserId = player.UserId,
							targetUserId = challenge.targetUserId,
							reason = "Challenger left the server.",
						})
					end
				else
					local challenger = Players:GetPlayerByUserId(challenge.challengerUserId)
					if challenger then
						local cancelRemote = ChallengeEvents.GetRemoteEvent("ChallengeCancel")
						cancelRemote:FireClient(challenger, {
							challengeId = challengeId,
							challengerUserId = challenge.challengerUserId,
							targetUserId = player.UserId,
							reason = "Target player left the server.",
						})
					end
				end
			end
			cleanupChallenge(challengeId)
		end

		playerStatuses[player.UserId] = nil
	end)
end

return DirectChallengeService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">DirectChallengeService.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for DirectChallengeService
    Verifies challenge state transitions, status tracking, auto-expiration,
    and validation constraints for 1v1 direct player challenges.
]=]

local ServerScriptService = game:GetService("ServerScriptService")
local DirectChallengeService = require(ServerScriptService:WaitForChild("Services"):WaitForChild("DirectChallengeService"))

local function runTests()
	DirectChallengeService.Init()

	local p1 = Instance.new("Player")
	p1.Name = "ChallengerPlayer"

	local p2 = Instance.new("Player")
	p2.Name = "TargetPlayer"

	-- 1. Test Player Status Initialization
	assert(DirectChallengeService.GetPlayerStatus(p1) == "In Lobby", "Player 1 status should default to 'In Lobby'")
	assert(DirectChallengeService.GetPlayerStatus(p2) == "In Lobby", "Player 2 status should default to 'In Lobby'")

	-- 2. Test Self-Challenge Rejection
	local selfSuccess, selfErr = DirectChallengeService.SendChallenge(p1, p1)
	assert(not selfSuccess, "Player should not be able to challenge themselves")
	assert(selfErr ~= nil, "Expected error message for self challenge")

	-- 3. Test Successful Challenge Creation
	local sendSuccess, sendErr = DirectChallengeService.SendChallenge(p1, p2)
	assert(sendSuccess, "SendChallenge should succeed between two lobby players: " .. tostring(sendErr))

	local activeChallenge = DirectChallengeService.GetActiveChallengeForPlayer(p1)
	assert(activeChallenge ~= nil, "Active challenge should exist for player 1")
	assert(activeChallenge and activeChallenge.state == "Pending", "Challenge state should be 'Pending'")

	-- 4. Test Busy Status Rejection
	local p3 = Instance.new("Player")
	p3.Name = "ThirdPlayer"

	local busySuccess, busyErr = DirectChallengeService.SendChallenge(p3, p1)
	assert(not busySuccess, "Should not be able to challenge a player with an active pending challenge")
	assert(busyErr ~= nil, "Expected error for busy target")

	-- 5. Test Challenge Cancellation
	if activeChallenge then
		local cancelSuccess, cancelErr = DirectChallengeService.CancelChallenge(p1, activeChallenge.challengeId)
		assert(cancelSuccess, "Challenger should be able to cancel pending challenge: " .. tostring(cancelErr))
		assert(DirectChallengeService.GetActiveChallengeForPlayer(p1) == nil, "Active challenge should be cleared after cancellation")
	end

	-- 6. Test Challenge Acceptance and Status Transition
	local sendSuccess2, _ = DirectChallengeService.SendChallenge(p1, p2)
	assert(sendSuccess2, "SendChallenge should succeed again after cancellation")

	local challenge2 = DirectChallengeService.GetActiveChallengeForPlayer(p1)
	assert(challenge2 ~= nil, "Challenge 2 should be active")

	if challenge2 then
		local respondSuccess, respondErr = DirectChallengeService.RespondChallenge(p2, challenge2.challengeId, true)
		assert(respondSuccess, "Target should be able to accept challenge: " .. tostring(respondErr))
		assert(DirectChallengeService.GetPlayerStatus(p1) == "In Match", "Challenger status should transition to 'In Match'")
		assert(DirectChallengeService.GetPlayerStatus(p2) == "In Match", "Target status should transition to 'In Match'")
	end

	-- Reset player statuses
	DirectChallengeService.SetPlayerStatus(p1, "In Lobby")
	DirectChallengeService.SetPlayerStatus(p2, "In Lobby")

	p1:Destroy()
	p2:Destroy()
	p3:Destroy()

	print("[DirectChallengeService.spec] All unit tests passed successfully!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX58"><Properties><string name="Name">DynamicSpawnService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: DynamicSpawnService
    Selects the optimal, safest spawn point based on a weighted distance 
    algorithm and Line-of-Sight (LoS) validations.
    Prevents spawn camping and ensures fair restarts during matches.
]=]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local DynamicSpawnService = {}

export type SpawnScore = {
    cframe: CFrame,
    score: number,
}

-- Weights and thresholds
local LOS_PENALTY = 50000 -- Massive penalty if an enemy can see the spawn point
local MIN_SAFE_DISTANCE = 40 -- Studs
local PROXIMITY_PENALTY = 10000

--- Evaluates a list of CFrames and returns the safest one based on enemy locations
function DynamicSpawnService.GetOptimalSpawn(candidateSpawns: {CFrame}, enemies: {Player}): CFrame
    if not candidateSpawns or #candidateSpawns == 0 then
        return CFrame.new(0, 100, 0)
    end
    
    if not enemies or #enemies == 0 then
        -- No enemies, pick a random spawn
        return candidateSpawns[math.random(1, #candidateSpawns)]
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    -- Filter out all character models so we only raycast against static map geometry
    local allCharacters = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(allCharacters, p.Character) end
    end
    local spawnFolder = Workspace:FindFirstChild("Spawns") or Workspace:FindFirstChild("SpawnLocations")
    if spawnFolder then
        table.insert(allCharacters, spawnFolder)
    end
    raycastParams.FilterDescendantsInstances = allCharacters

    local bestSpawn: CFrame? = nil
    local bestScore = -math.huge

    for _, spawnCF in ipairs(candidateSpawns) do
        local score = 0
        local spawnPos = spawnCF.Position
        
        local minEnemyDist = math.huge
        local hasLOS = false

        for _, enemy in ipairs(enemies) do
            if enemy.Character then
                local hrp = enemy.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                local head = enemy.Character:FindFirstChild("Head") :: BasePart?
                
                if hrp and head then
                    local dist = (hrp.Position - spawnPos).Magnitude
                    if dist &lt; minEnemyDist then
                        minEnemyDist = dist
                    end
                    
                    -- Check Line of Sight from Enemy Head to Spawn Point
                    local targetPos = spawnPos + Vector3.new(0, 3, 0)
                    local dir = (targetPos - head.Position)
                    local hit = Workspace:Raycast(head.Position, dir, raycastParams)
                    
                    -- If the ray hits nothing, it means there are no walls blocking the view
                    if not hit then
                        hasLOS = true
                    end
                end
            end
        end

        -- Base score is the distance to the CLOSEST enemy (we want to maximize this distance)
        if minEnemyDist == math.huge then
            score = 1000 -- Safe
        else
            score = minEnemyDist
        end
        
        -- Penalties
        if minEnemyDist &lt; MIN_SAFE_DISTANCE then
            score -= PROXIMITY_PENALTY
        end
        
        if hasLOS then
            score -= LOS_PENALTY
        end

        if score &gt; bestScore then
            bestScore = score
            bestSpawn = spawnCF
        end
    end

    return bestSpawn or candidateSpawns[math.random(1, #candidateSpawns)]
end

return DynamicSpawnService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: EconomyService
    Server-authoritative credit economy system for 1v1 and 2v2 PvP matches.
    Manages player credit balances, pistol round starting credits (800), sudden-death (5000),
    win bonus (+3000), scaling loss streak bonus (+1900, +2400, +2900 max), kill rewards (+200),
    and buy phase server validation.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local NetworkFolder = ReplicatedStorage:WaitForChild("Network")
local RemoteEvents = require(NetworkFolder:WaitForChild("RemoteEvents") :: any)

export type CatalogItem = {
	price: number,
	category: string,
	armorValue: number?,
}

local EconomyService = {}

-- Constants
EconomyService.PISTOL_ROUND_CREDITS = 800
EconomyService.SUDDEN_DEATH_CREDITS = 5000
EconomyService.WIN_BONUS = 3000
EconomyService.LOSS_STREAK_TIER_1 = 1900
EconomyService.LOSS_STREAK_TIER_2 = 2400
EconomyService.LOSS_STREAK_TIER_MAX = 2900
EconomyService.KILL_REWARD = 200

-- Shop item catalog definition
EconomyService.SHOP_CATALOG = {
	["Pistol"] = { price = 0, category = "Weapon" },
	["LightSMG"] = { price = 1000, category = "Weapon" },
	["HeavySMG"] = { price = 1500, category = "Weapon" },
	["AssaultRifle"] = { price = 2900, category = "Weapon" },
	["Carbine"] = { price = 2500, category = "Weapon" },
	["BurstRifle"] = { price = 2500, category = "Weapon" },
	["Shotgun"] = { price = 1800, category = "Weapon" },
	["SniperRifle"] = { price = 4500, category = "Weapon" },
	["LightArmor"] = { price = 400, category = "Armor", armorValue = 25 },
	["HeavyArmor"] = { price = 1000, category = "Armor", armorValue = 50 },
}

-- Internal balance storage (UserId -&gt; Credits)
local playerBalances: { [number]: number } = {}
local transactionLocks: { [number]: boolean } = {}

-- Optional service references (set during Init or resolved lazily)
local _roundServiceRef: any = nil
local _combatServerRef: any = nil
local _directChallengeServiceRef: any = nil

local function getDirectChallengeService()
	if not _directChallengeServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local dcs = servicesFolder:FindFirstChild("DirectChallengeService")
			if dcs then
				_directChallengeServiceRef = require(dcs :: any)
			end
		end
	end
	return _directChallengeServiceRef
end

local function getRoundService()
	if not _roundServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local rs = servicesFolder:FindFirstChild("RoundService")
			if rs then
				_roundServiceRef = require(rs :: any)
			end
		end
	end
	return _roundServiceRef
end

--- Set external service references if needed
function EconomyService.SetServiceReferences(roundService: any?, combatServer: any?)
	if roundService then
		_roundServiceRef = roundService
	end
	if combatServer then
		_combatServerRef = combatServer
	end
end

--- Initializes a player's credit balance for a match session.
function EconomyService.InitializePlayer(player: Player, startingCredits: number?): number
	local initial = startingCredits or EconomyService.PISTOL_ROUND_CREDITS
	local clamped = math.max(0, initial)
	playerBalances[player.UserId] = clamped

	EconomyService.NotifyBalanceUpdate(player, clamped)
	return clamped
end

--- Returns current credit balance for a player.
function EconomyService.GetCredits(player: Player): number
	return playerBalances[player.UserId] or 0
end

--- Sets a player's credit balance directly (clamped &gt;= 0).
function EconomyService.SetCredits(player: Player, amount: number): number
	local clamped = math.max(0, amount)
	playerBalances[player.UserId] = clamped
	EconomyService.NotifyBalanceUpdate(player, clamped)
	return clamped
end

--- Notifies client of their current balance.
function EconomyService.NotifyBalanceUpdate(player: Player, newBalance: number)
	pcall(function()
		local syncRemote = RemoteEvents.GetReliable("ProfileSync" :: any)
		if syncRemote then
			syncRemote:FireClient(player, {
				credits = newBalance,
			})
		end
	end)
end

--- Awards kill reward credits (+200) to killer player.
function EconomyService.AwardKillReward(killerPlayer: Player): number
	local current = playerBalances[killerPlayer.UserId] or 0
	local updated = current + EconomyService.KILL_REWARD
	playerBalances[killerPlayer.UserId] = updated

	pcall(function()
		local noticeRemote = RemoteEvents.GetReliable("KillRewardNotice" :: any)
		if noticeRemote then
			noticeRemote:FireClient(killerPlayer, {
				amount = EconomyService.KILL_REWARD,
				newBalance = updated,
			})
		end
	end)

	EconomyService.NotifyBalanceUpdate(killerPlayer, updated)
	return updated
end

--- Calculates loss streak credit bonus.
function EconomyService.CalculateLossBonus(lossStreak: number): number
	if lossStreak &lt;= 1 then
		return EconomyService.LOSS_STREAK_TIER_1 -- 1900
	elseif lossStreak == 2 then
		return EconomyService.LOSS_STREAK_TIER_2 -- 2400
	else
		return EconomyService.LOSS_STREAK_TIER_MAX -- 2900
	end
end

--- Processes end of round credit distribution to winning and losing teams.
function EconomyService.ProcessRoundEnd(winners: { Player }, losers: { Player }, loserLossStreak: number): { winnerBonus: number, loserBonus: number }
	local winBonus = EconomyService.WIN_BONUS
	local lossBonus = EconomyService.CalculateLossBonus(loserLossStreak)

	for _, winner in winners do
		if winner and winner.Parent then
			local current = playerBalances[winner.UserId] or 0
			local newBal = current + winBonus
			playerBalances[winner.UserId] = newBal
			EconomyService.NotifyBalanceUpdate(winner, newBal)
		end
	end

	for _, loser in losers do
		if loser and loser.Parent then
			local current = playerBalances[loser.UserId] or 0
			local newBal = current + lossBonus
			playerBalances[loser.UserId] = newBal
			EconomyService.NotifyBalanceUpdate(loser, newBal)
		end
	end

	return {
		winnerBonus = winBonus,
		loserBonus = lossBonus,
	}
end

--- Allocates 5000 credits to all players for Sudden Death rounds.
function EconomyService.SetSuddenDeathCredits(players: { Player })
	for _, player in players do
		if player and player.Parent then
			playerBalances[player.UserId] = EconomyService.SUDDEN_DEATH_CREDITS
			EconomyService.NotifyBalanceUpdate(player, EconomyService.SUDDEN_DEATH_CREDITS)
		end
	end
end

--- Server authority purchase request validation logic.
function EconomyService.ProcessPurchaseRequest(player: Player, itemId: string): (boolean, string, number)
	if transactionLocks[player.UserId] then
		return false, "TransactionInProgress", playerBalances[player.UserId] or 0
	end
	transactionLocks[player.UserId] = true

	local ok, success, reason, balance = pcall(function()
		local currentBalance = playerBalances[player.UserId] or 0

		-- 1. Check Shop Catalog item validity
		local catalogItem = EconomyService.SHOP_CATALOG[itemId]
		if not catalogItem then
			return false, "InvalidItem", currentBalance
		end
		local item = { price = catalogItem.price, category = catalogItem.category, armorValue = catalogItem.armorValue }

		-- 2. Check Practice Range status for free bypass
		local isPractice = false
		local dcs = getDirectChallengeService()
		if dcs then
			local status = dcs.GetPlayerStatus(player)
			if status == "Practice Range" then
				isPractice = true
				item.price = 0
			end
		end

		if not isPractice then
			-- 3. Check Match Buy Phase constraint if player is in an active match
			local rs = getRoundService()
			if rs then
				local playerMatch = rs.GetPlayerMatch(player)
				if playerMatch then
					local phase = rs.GetPlayerPhase(player)
					if phase ~= "Buy" then
						return false, "NotInBuyPhase", currentBalance
					end
				end
			end
		end

		-- 4. Check Credit Balance
		if currentBalance &lt; item.price then
			return false, "InsufficientCredits", currentBalance
		end

		-- 5. Execute Purchase
		local newBalance = currentBalance - item.price
		playerBalances[player.UserId] = newBalance

		-- Apply Item Effects
		if item.category == "Armor" and item.armorValue then
			if _combatServerRef then
				pcall(function()
					_combatServerRef:RegisterPlayer(player.UserId, 100, item.armorValue)
				end)
			end
			local char = player.Character
			if char then
				char:SetAttribute("Armor", item.armorValue)
				char:SetAttribute("ArmorType", itemId)
			end
		elseif item.category == "Weapon" then
			local char = player.Character
			if char then
				char:SetAttribute("Equipped" .. item.category, itemId)
			end
		end

		EconomyService.NotifyBalanceUpdate(player, newBalance)
		return true, "PurchaseSuccess", newBalance
	end)

	transactionLocks[player.UserId] = nil

	if ok then
		return success, reason, balance
	else
		warn("Error processing purchase:", success)
		return false, "Error", playerBalances[player.UserId] or 0
	end
end

--- Removes a player from balance tracking upon disconnect.
function EconomyService.RemovePlayer(player: Player)
	playerBalances[player.UserId] = nil
end

--- Initializes EconomyService listeners and RemoteEvents.
function EconomyService.Init(roundServiceRef: any?, combatServerRef: any?)
	if roundServiceRef then
		_roundServiceRef = roundServiceRef
	end
	if combatServerRef then
		_combatServerRef = combatServerRef
	end

	Players.PlayerRemoving:Connect(function(player)
		EconomyService.RemovePlayer(player)
	end)

	-- NOTE: RequestPurchase remote is handled exclusively by ServerMain to avoid duplicate handlers.

	print("[EconomyService] Initialized successfully.")
end

return EconomyService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX60"><Properties><string name="Name">EconomyService.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for EconomyService
    Validates starting credit initialization, win/loss streak scaling arithmetic,
    kill rewards, sudden-death credit allocations, and server buy validation logic.
]=]

local ServerScriptService = game:GetService("ServerScriptService")
local EconomyService = require(ServerScriptService:WaitForChild("Services"):WaitForChild("EconomyService") :: any)

local function runTests()
	EconomyService.Init()

	local p1 = Instance.new("Player")
	p1.Name = "TestPlayer1"

	local p2 = Instance.new("Player")
	p2.Name = "TestPlayer2"

	-- 1. Test Starting Credit Initialization (Pistol Round = 800)
	local initBal1 = EconomyService.InitializePlayer(p1)
	assert(initBal1 == 800, "Pistol round starting credits should be 800, got: " .. tostring(initBal1))
	assert(EconomyService.GetCredits(p1) == 800, "GetCredits should return 800")

	-- 2. Test Direct Credit Manipulation
	EconomyService.SetCredits(p1, 1500)
	assert(EconomyService.GetCredits(p1) == 1500, "SetCredits should update balance to 1500")

	-- 3. Test Kill Reward (+200)
	local afterKill = EconomyService.AwardKillReward(p1)
	assert(afterKill == 1700, "Kill reward should add 200, expected 1700, got: " .. tostring(afterKill))

	-- 4. Test Sudden Death Credits Allocation (5000)
	EconomyService.SetSuddenDeathCredits({ p1, p2 })
	assert(EconomyService.GetCredits(p1) == 5000, "Sudden death credits for p1 should be 5000")
	assert(EconomyService.GetCredits(p2) == 5000, "Sudden death credits for p2 should be 5000")

	-- 5. Test Loss Streak Scaling Arithmetic
	assert(EconomyService.CalculateLossBonus(1) == 1900, "1st loss streak bonus should be 1900")
	assert(EconomyService.CalculateLossBonus(2) == 2400, "2nd loss streak bonus should be 2400")
	assert(EconomyService.CalculateLossBonus(3) == 2900, "3rd loss streak bonus should be 2900")
	assert(EconomyService.CalculateLossBonus(5) == 2900, "5th loss streak bonus should cap at 2900")

	-- 6. Test ProcessRoundEnd Credit Distribution
	EconomyService.SetCredits(p1, 100)
	EconomyService.SetCredits(p2, 100)

	-- p1 wins (+3000), p2 loses with lossStreak = 2 (+2400)
	local endResult = EconomyService.ProcessRoundEnd({ p1 }, { p2 }, 2)
	assert(endResult.winnerBonus == 3000, "Winner bonus should be 3000")
	assert(endResult.loserBonus == 2400, "Loser bonus should be 2400")

	assert(EconomyService.GetCredits(p1) == 3100, "Winner balance should be 100 + 3000 = 3100")
	assert(EconomyService.GetCredits(p2) == 2500, "Loser balance should be 100 + 2400 = 2500")

	-- 7. Test Buy Validation: Invalid Item Rejection
	EconomyService.SetCredits(p1, 5000)
	local invSuccess, invReason, _ = EconomyService.ProcessPurchaseRequest(p1, "NonExistentItem999")
	assert(invSuccess == false, "Invalid item purchase should fail, got success=" .. tostring(invSuccess))
	assert(invReason == "InvalidItem", "Invalid item reason should be 'InvalidItem', got: " .. tostring(invReason))

	-- 8. Test Buy Validation: Insufficient Credits Rejection
	EconomyService.SetCredits(p1, 100) -- Only 100 credits
	local lowSuccess, lowReason, lowBal = EconomyService.ProcessPurchaseRequest(p1, "AssaultRifle")
	assert(lowSuccess == false, "Insufficient credits purchase should fail, got success=" .. tostring(lowSuccess))
	assert(lowReason == "InsufficientCredits", "Failure reason should be 'InsufficientCredits', got: " .. tostring(lowReason))
	assert(lowBal == 100, "Balance should remain 100 after failed purchase, got: " .. tostring(lowBal))

	-- 9. Test Buy Validation: Successful Purchase Execution
	EconomyService.SetCredits(p1, 3000)
	local buySuccess, buyReason, buyBal = EconomyService.ProcessPurchaseRequest(p1, "AssaultRifle")
	assert(buySuccess == true, "Purchase with sufficient credits should succeed, got success=" .. tostring(buySuccess))
	assert(buyReason == "PurchaseSuccess", "Reason should be 'PurchaseSuccess', got: " .. tostring(buyReason))
	assert(buyBal == 100, "Balance should be 3000 - 2900 = 100, got: " .. tostring(buyBal))
	assert(EconomyService.GetCredits(p1) == 100, "GetCredits(p1) should be 100 after purchase")

	p1:Destroy()
	p2:Destroy()

	print("[EconomyService.spec] All unit tests passed successfully!")
	return true
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX61"><Properties><string name="Name">FTUEAnalytics</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: FTUEAnalytics
    First-Time User Experience (FTUE) funnel tracking module.
    Logs onboarding milestones using AnalyticsWrapper.LogFunnelStepEvent.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AnalyticsWrapper = require(ReplicatedStorage:WaitForChild("Analytics"):WaitForChild("AnalyticsWrapper"))

local FTUEAnalytics = {}

export type StepInfo = {
	stepNumber: number,
	stepName: string,
}

local FUNNEL_NAME = "FTUE_Onboarding_Funnel"

FTUEAnalytics.Steps = {
	TUTORIAL_STARTED = "Tutorial_Started",
	TUTORIAL_COMPLETED = "Tutorial_Completed",
	FIRST_MATCH_JOINED = "First_Match_Joined",
	FIRST_MATCH_COMPLETED = "First_Match_Completed",
	FIRST_VICTORY = "First_Victory",
}

local STEP_DEFINITIONS: { [string]: number } = {
	[FTUEAnalytics.Steps.TUTORIAL_STARTED] = 1,
	[FTUEAnalytics.Steps.TUTORIAL_COMPLETED] = 2,
	[FTUEAnalytics.Steps.FIRST_MATCH_JOINED] = 3,
	[FTUEAnalytics.Steps.FIRST_MATCH_COMPLETED] = 4,
	[FTUEAnalytics.Steps.FIRST_VICTORY] = 5,
}

local _playerHighestStep: { [Player]: number } = {}
local _playerCompletedSteps: { [Player]: { [string]: boolean } } = {}

function FTUEAnalytics.GetStepNumber(stepName: string): number
	return STEP_DEFINITIONS[stepName] or 0
end

function FTUEAnalytics.GetPlayerStep(player: Player): number
	return _playerHighestStep[player] or 0
end

function FTUEAnalytics.HasCompletedStep(player: Player, stepName: string): boolean
	local completed = _playerCompletedSteps[player]
	if not completed then
		return false
	end
	return completed[stepName] == true
end

function FTUEAnalytics.TrackStep(
	player: Player,
	stepName: string,
	customData: { [string]: string }?
): (boolean, string?)
	local stepNumber = FTUEAnalytics.GetStepNumber(stepName)
	if stepNumber == 0 then
		warn("[FTUEAnalytics] Unknown step name: " .. tostring(stepName))
		return false, "Unknown step name"
	end

	if not _playerCompletedSteps[player] then
		_playerCompletedSteps[player] = {}
	end

	-- Track highest step reached
	local currentHighest = _playerHighestStep[player] or 0
	if stepNumber &gt; currentHighest then
		_playerHighestStep[player] = stepNumber
	end

	_playerCompletedSteps[player][stepName] = true

	local success, err = AnalyticsWrapper.LogFunnelStepEvent(
		player,
		FUNNEL_NAME,
		stepNumber,
		stepName,
		customData
	)

	-- Basic integration point: when completing a step, also store it in the player's profile data
	-- (via a reference to ProfileServiceWrapper) so steps aren't re-triggered on rejoin.
	-- local ProfileServiceWrapper = require(script.Parent:WaitForChild("ProfileServiceWrapper"))
	-- local profile = ProfileServiceWrapper.GetProfile(player.UserId) -- Requires a getter in ProfileServiceWrapper
	-- if profile and profile.Data.FTUE then
	--     profile.Data.FTUE[stepName] = true
	-- end

	return success, err
end

function FTUEAnalytics.ResetPlayerProgress(player: Player)
	_playerHighestStep[player] = nil
	_playerCompletedSteps[player] = nil
end

-- Clean up on player disconnect
Players.PlayerRemoving:Connect(function(player: Player)
	FTUEAnalytics.ResetPlayerProgress(player)
end)

return FTUEAnalytics
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX62"><Properties><string name="Name">FTUEAnalytics.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for FTUEAnalytics
]=]

local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FTUEAnalytics = require(ServerScriptService:WaitForChild("Services"):WaitForChild("FTUEAnalytics"))
local AnalyticsWrapper = require(ReplicatedStorage:WaitForChild("Analytics"):WaitForChild("AnalyticsWrapper"))

local function runTests()
	AnalyticsWrapper.SetTestMode(true)

	-- Mock Player Instance for testing
	local mockPlayer = Instance.new("Player")
	mockPlayer.Name = "TestFTUEPlayer"

	-- 1. Test Step Numbers
	assert(FTUEAnalytics.GetStepNumber("Tutorial_Started") == 1, "Tutorial_Started step number must be 1")
	assert(FTUEAnalytics.GetStepNumber("First_Match_Joined") == 3, "First_Match_Joined step number must be 3")
	assert(FTUEAnalytics.GetStepNumber("Invalid_Step") == 0, "Invalid step should return 0")

	-- 2. Test Step Tracking
	local success, err = FTUEAnalytics.TrackStep(mockPlayer, FTUEAnalytics.Steps.TUTORIAL_STARTED)
	assert(success, "TrackStep failed: " .. tostring(err))
	assert(FTUEAnalytics.GetPlayerStep(mockPlayer) == 1, "Player step should be 1")
	assert(FTUEAnalytics.HasCompletedStep(mockPlayer, FTUEAnalytics.Steps.TUTORIAL_STARTED), "Player should have completed Tutorial_Started")

	local success2, _ = FTUEAnalytics.TrackStep(mockPlayer, FTUEAnalytics.Steps.FIRST_MATCH_COMPLETED)
	assert(success2, "TrackStep for Step 4 failed")
	assert(FTUEAnalytics.GetPlayerStep(mockPlayer) == 4, "Player highest step should be 4")

	-- 3. Test Progress Reset
	FTUEAnalytics.ResetPlayerProgress(mockPlayer)
	assert(FTUEAnalytics.GetPlayerStep(mockPlayer) == 0, "Player step after reset should be 0")
	assert(not FTUEAnalytics.HasCompletedStep(mockPlayer, FTUEAnalytics.Steps.TUTORIAL_STARTED), "Completed step should be false after reset")

	mockPlayer:Destroy()
	print("[FTUEAnalytics.spec] All tests passed!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX63"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Leaderboard Service
    Manages Global Leaderboards utilizing OrderedDataStores to rank players.
]=]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local LeaderboardService = {}

local KillsLeaderboard: OrderedDataStore? = nil
local pendingUpdates: { [number]: number } = {}

local function getLeaderboard(): OrderedDataStore?
    if not KillsLeaderboard then
        pcall(function()
            KillsLeaderboard = DataStoreService:GetOrderedDataStore("GlobalKills_v1")
        end)
    end
    return KillsLeaderboard
end

local UPDATE_INTERVAL = 300 -- 5 minutes

local TopKillsCache: {{UserId: number, Kills: number}} = {}

-- Poll the OrderedDataStore to get top 10
function LeaderboardService.RefreshLeaderboard()
    local success, errorMessage = pcall(function()
        local lb = getLeaderboard()
        if not lb then return end
        local pages = lb:GetSortedAsync(false, 10)
        local topTen = pages:GetCurrentPage()
        
        table.clear(TopKillsCache)
        
        for rank, data in ipairs(topTen) do
            local userId = tonumber(data.key)
            if userId then
                table.insert(TopKillsCache, {
                    UserId = userId,
                    Kills = data.value
                })
            end
        end
    end)
    
    if not success then
        warn("[LeaderboardService] Failed to refresh leaderboard: " .. tostring(errorMessage))
    end
end

function LeaderboardService.GetTopKills()
    return TopKillsCache
end

function LeaderboardService.UpdatePlayerScore(userId: number, kills: number)
    pendingUpdates[userId] = kills
end

local function flushUpdates()
    local lb = getLeaderboard()
    if not lb then return end
    for userId, kills in pairs(pendingUpdates) do
        pendingUpdates[userId] = nil
        task.spawn(function()
            local success, errorMessage = pcall(function()
                lb:SetAsync(tostring(userId), kills)
            end)
            if not success then
                warn("[LeaderboardService] Failed to update score for " .. userId .. ": " .. tostring(errorMessage))
            end
        end)
    end
end

-- Setup periodic refresh
task.spawn(function()
    while true do
        flushUpdates()
        LeaderboardService.RefreshLeaderboard()
        task.wait(UPDATE_INTERVAL)
    end
end)

return LeaderboardService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64"><Properties><string name="Name">M1_TestRunner</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Milestone 1 Stress Test Harness &amp; Verification Runner
    Empirical test runner for SpawnService and Practice Range Teleport Authority.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local ServicesFolder = ServerScriptService:WaitForChild("Services")
local SpawnService = require(ServicesFolder:WaitForChild("SpawnService") :: any)
local PracticeRangeMapLayout = require(ReplicatedStorage:WaitForChild("Map"):WaitForChild("PracticeRangeMapLayout") :: any)

local M1_TestRunner = {}

function M1_TestRunner.RunAllTests(): (boolean, number, number, { string })
	local passed = 0
	local failed = 0
	local errors: { string } = {}

	local function assertTest(condition: boolean, testName: string, detail: string?)
		if condition then
			passed += 1
			print(`[PASS] {testName}`)
		else
			failed += 1
			local msg = `[FAIL] {testName}` .. (detail and `: {detail}` or "")
			table.insert(errors, msg)
			warn(msg)
		end
	end

	print("==================================================")
	print("RUNNING MILESTONE 1 ADVERSARIAL TEST SUITE")
	print("==================================================")

	-- Mock Player setup
	local mockPlayer = Instance.new("Player")
	mockPlayer.Name = "TestPlayer_M1"

	-- Test 1: Rapid Consecutive Spawn Calls (&lt;0.5s Mutex Lock Check)
	do
		print("\n--- Test 1: Rapid Mutex Lock Verification ---")
		-- Call 1
		local success1, cf1 = pcall(function()
			return SpawnService.SpawnPlayer(mockPlayer, "Lobby")
		end)

		-- Immediate Call 2 (&lt;0.01s)
		local success2, cf2 = pcall(function()
			return SpawnService.SpawnPlayer(mockPlayer, "PracticeRange")
		end)

		-- Check location state
		local currentLoc = SpawnService.GetPlayerLocation(mockPlayer)
		print(`Current Player Location after rapid calls: {currentLoc}`)

		-- Mutex lock should reject or queue call 2 if call 1 is busy, OR reject rapid spam.
		-- If line 248 in SpawnService unlocks and bypasses the mutex, we log the flaw.
		assertTest(success1, "SpawnPlayer Call 1 Succeeded")
	end

	-- Test 2: Character Missing Parts / Health 0 Fallback
	do
		print("\n--- Test 2: Broken Character / Health 0 Fallback ---")
		-- Create dummy character without HumanoidRootPart
		local charBroken = Instance.new("Model")
		charBroken.Name = "BrokenChar"
		local hum = Instance.new("Humanoid")
		hum.Health = 100
		hum.Parent = charBroken
		charBroken.Parent = Workspace

		mockPlayer.Character = charBroken

		-- Try spawning player with broken character (missing HumanoidRootPart)
		local ok, destCF = pcall(function()
			return SpawnService.SpawnPlayer(mockPlayer, "Lobby")
		end)

		-- Check if it detected missing HumanoidRootPart or if it treated broken model as valid alive player
		local rootExists = charBroken:FindFirstChild("HumanoidRootPart") ~= nil
		assertTest(rootExists == false, "Character correctly lacks HumanoidRootPart for test setup")

		charBroken:Destroy()
	end

	-- Test 3: Missing Practice Range Map Fallback
	do
		print("\n--- Test 3: Missing Practice Range Map Fallback ---")
		local prMap = Workspace:FindFirstChild("PracticeRangeMap")
		if prMap then
			prMap.Parent = nil -- Temporarily unparent to test missing map scenario
		end

		local locType = SpawnService.GetPlayerLocation(mockPlayer)
		local isMapInWorkspace = Workspace:FindFirstChild("PracticeRangeMap") ~= nil

		assertTest(isMapInWorkspace == false, "PracticeRangeMap correctly absent from Workspace for fallback test")

		if prMap then
			prMap.Parent = Workspace -- Restore map
		end
	end

	print("\n==================================================")
	print(`MILESTONE 1 SUITE COMPLETED: {passed} PASSED, {failed} FAILED`)
	print("==================================================")

	return failed == 0, passed, failed, errors
end

return M1_TestRunner
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX65"><Properties><string name="Name">MatchmakingCoordinator</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: MatchmakingCoordinator
    Implements MemoryStoreService SortedMap matchmaking queues,
    coordinator server election via atomic control key writes,
    and deterministic user ID sharding across parallel queue maps.
]=]

local MemoryStoreService = game:GetService("MemoryStoreService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local MessagingService = game:GetService("MessagingService")

-- Configuration Constants
local NUM_SHARDS = 4
local CONTROL_MAP_NAME = "MMControlMap"
local LEADER_CONTROL_KEY = "CoordinatorLeader"
local QUEUE_SHARD_PREFIX = "MMQueue_Shard_"
local LEADER_LEASE_TTL_SECONDS = 15
local ELECTION_HEARTBEAT_SECONDS = 5
local MATCHMAKING_TICK_SECONDS = 5
local DEFAULT_QUEUE_EXPIRATION_SECONDS = 600 -- 10 minutes
local MATCH_TEAM_SIZE = 5
local TOTAL_MATCH_PLAYERS = MATCH_TEAM_SIZE * 2 -- 10 players for 5v5
local TARGET_PLACE_ID = game.PlaceId -- Configurable target match place ID

export type QueueTicket = {
	userId: number,
	mmr: number,
	joinTime: number,
	partySize: number,
	partyMembers: { number },
	selectedMode: string,
}

export type LeaderRecord = {
	jobId: string,
	timestamp: number,
	term: number,
}

export type MatchLobby = {
	matchId: string,
	teamA: { QueueTicket },
	teamB: { QueueTicket },
	averageMMR: number,
}

local MatchmakingCoordinator = {}
MatchmakingCoordinator.__index = MatchmakingCoordinator

local isCoordinatorLeader = false
local electionThread: thread? = nil
local matchmakingThread: thread? = nil

--[=[
    Deterministic Shard Calculation
    Distributes queue load evenly across NUM_SHARDS MemoryStore SortedMaps.
]=]
function MatchmakingCoordinator.GetShardIndex(userId: number): number
	return math.abs(userId) % NUM_SHARDS
end

function MatchmakingCoordinator.GetShardMap(shardIndex: number): MemoryStoreSortedMap?
	local mapName = QUEUE_SHARD_PREFIX .. tostring(shardIndex)
	local ok, map = pcall(function()
		return MemoryStoreService:GetSortedMap(mapName)
	end)
	if ok then return map end
	return nil
end

function MatchmakingCoordinator.GetControlMap(): MemoryStoreSortedMap?
	local ok, map = pcall(function()
		return MemoryStoreService:GetSortedMap(CONTROL_MAP_NAME)
	end)
	if ok then return map end
	return nil
end

--[=[
    Adds a player or party leader to the matchmaking queue.
    Uses deterministic sharding to route request to the target SortedMap.
]=]
function MatchmakingCoordinator.AddPlayerToQueueAsync(
	userId: number,
	mmr: number,
	partyMembers: { number }?,
	selectedMode: string?
): boolean
	local shardIndex = MatchmakingCoordinator.GetShardIndex(userId)
	local shardMap = MatchmakingCoordinator.GetShardMap(shardIndex)
	local ticketKey = tostring(userId)

	local members = partyMembers or { userId }
	local ticket: QueueTicket = {
		userId = userId,
		mmr = mmr,
		joinTime = os.time(),
		partySize = #members,
		partyMembers = members,
		selectedMode = selectedMode or "Standard5v5",
	}

	-- Priority score: inverse of join time or MMR (using MMR as main sort value)
	local priorityScore = math.floor(mmr)

	local success, err = pcall(function()
		shardMap:SetAsync(ticketKey, ticket, DEFAULT_QUEUE_EXPIRATION_SECONDS, priorityScore)
	end)

	if not success then
		warn("[MatchmakingCoordinator] AddPlayerToQueueAsync failed for userId " .. tostring(userId) .. ": " .. tostring(err))
		return false
	end

	return true
end

--[=[
    Removes a player from the matchmaking queue.
]=]
function MatchmakingCoordinator.RemovePlayerFromQueueAsync(userId: number): boolean
	local shardIndex = MatchmakingCoordinator.GetShardIndex(userId)
	local shardMap = MatchmakingCoordinator.GetShardMap(shardIndex)
	local ticketKey = tostring(userId)

	local success, err = pcall(function()
		shardMap:RemoveAsync(ticketKey)
	end)

	if not success then
		warn("[MatchmakingCoordinator] RemovePlayerFromQueueAsync failed for userId " .. tostring(userId) .. ": " .. tostring(err))
		return false
	end

	return true
end

--[=[
    Coordinator Election Protocol
    Atomically writes/updates control key in MemoryStore control map.
    Only one server in the cluster becomes leader and runs the matchmaker loop.
]=]
function MatchmakingCoordinator.TryElectCoordinatorAsync(): boolean
	local currentJobId = game.JobId ~= "" and game.JobId or "StudioLocalServer"
	local now = os.time()
	local elected = false

	local ok, controlMap = pcall(function()
		return MemoryStoreService:GetHashMap(CONTROL_MAP_NAME)
	end)
	if not ok or not controlMap then
		return false
	end

	local success, err = pcall(function()
		controlMap:UpdateAsync(LEADER_CONTROL_KEY, function(existing: any): LeaderRecord?
			if not existing then
				local newRecord: LeaderRecord = {
					jobId = currentJobId,
					timestamp = now,
					term = 1,
				}
				return newRecord
			else
				local record = existing :: LeaderRecord
				local elapsed = now - record.timestamp

				if record.jobId == currentJobId then
					record.timestamp = now
					return record
				elseif elapsed &gt;= LEADER_LEASE_TTL_SECONDS then
					local newRecord: LeaderRecord = {
						jobId = currentJobId,
						timestamp = now,
						term = record.term + 1,
					}
					return newRecord
				else
					return record
				end
			end
		end, LEADER_LEASE_TTL_SECONDS + 5)
	end)

	if success then
		local checkSuccess, currentRecord = pcall(function()
			return controlMap:GetAsync(LEADER_CONTROL_KEY) :: LeaderRecord?
		end)

		if checkSuccess and currentRecord and currentRecord.jobId == currentJobId then
			elected = true
		end
	end

	return elected
end

--[=[
    Queries all sharded maps to collect active queue tickets.
    Used exclusively by the elected Coordinator server.
]=]
function MatchmakingCoordinator.CollectAllQueueTicketsAsync(): { QueueTicket }
	local allTickets: { QueueTicket } = {}

	for shardIndex = 0, NUM_SHARDS - 1 do
		local shardMap = MatchmakingCoordinator.GetShardMap(shardIndex)
		local success, items = pcall(function()
			return shardMap:GetRangeAsync(Enum.SortDirection.Ascending, 200)
		end)

		if success and items then
			for _, item in ipairs(items) do
				local ticket = item.value :: QueueTicket
				table.insert(allTickets, ticket)
			end
		end
	end

	return allTickets
end

--[=[
    Forms balanced 5v5 lobbies from candidate tickets.
]=]
function MatchmakingCoordinator.FormLobbies(tickets: { QueueTicket }): { MatchLobby }
	local lobbies: { MatchLobby } = {}

	-- Sort tickets by joinTime (FIFO priority with MMR weighting)
	table.sort(tickets, function(a, b)
		return a.joinTime &lt; b.joinTime
	end)

	local remaining = table.clone(tickets)

	while #remaining &gt;= TOTAL_MATCH_PLAYERS do
		local selected: { QueueTicket } = {}
		local totalMMR = 0

		for i = 1, TOTAL_MATCH_PLAYERS do
			local ticket = table.remove(remaining, 1) :: QueueTicket
			table.insert(selected, ticket)
			totalMMR += ticket.mmr
		end

		-- Split into 2 teams of 5
		table.sort(selected, function(a, b)
			return a.mmr &gt; b.mmr
		end)

		local teamA: { QueueTicket } = {}
		local teamB: { QueueTicket } = {}
		local mmrA = 0
		local mmrB = 0

		-- Snake draft allocation for balanced MMR teams
		for idx, t in ipairs(selected) do
			if (idx % 2 == 1 and mmrA &lt;= mmrB) or (mmrA &lt; mmrB) then
				table.insert(teamA, t)
				mmrA += t.mmr
			else
				table.insert(teamB, t)
				mmrB += t.mmr
			end
		end

		local lobby: MatchLobby = {
			matchId = "Match_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999)),
			teamA = teamA,
			teamB = teamB,
			averageMMR = totalMMR / TOTAL_MATCH_PLAYERS,
		}
		table.insert(lobbies, lobby)
	end

	return lobbies
end

--[=[
    Processes formed match lobbies:
    - Reserves private server place.
    - Removes matched tickets from sharded MemoryStores.
    - Teleports present players.
]=]
function MatchmakingCoordinator.ProcessLobbyAsync(lobby: MatchLobby): boolean
	-- 1. Reserve server
	local reserveSuccess, accessCode, reservedServerId = pcall(function()
		return TeleportService:ReserveServer(TARGET_PLACE_ID)
	end)

	if not reserveSuccess or not accessCode then
		warn("[MatchmakingCoordinator] Failed to reserve server for lobby " .. lobby.matchId)
		return false
	end

	-- 2. Remove tickets from MemoryStore sharded maps
	local matchedPlayers: { Player } = {}
	local allLobbyTickets: { QueueTicket } = {}
	local allUserIds: { number } = {}

	for _, ticket in ipairs(lobby.teamA) do
		table.insert(allLobbyTickets, ticket)
		table.insert(allUserIds, ticket.userId)
	end
	for _, ticket in ipairs(lobby.teamB) do
		table.insert(allLobbyTickets, ticket)
		table.insert(allUserIds, ticket.userId)
	end

	for _, ticket in ipairs(allLobbyTickets) do
		local shardIndex = MatchmakingCoordinator.GetShardIndex(ticket.userId)
		local shardMap = MatchmakingCoordinator.GetShardMap(shardIndex)
		pcall(function()
			shardMap:RemoveAsync(tostring(ticket.userId))
		end)

		local player = Players:GetPlayerByUserId(ticket.userId)
		if player then
			table.insert(matchedPlayers, player)
		end
	end

	-- Publish to MessagingService for remote players
	pcall(function()
		MessagingService:PublishAsync("MatchAssignment", {
			userIds = allUserIds,
			accessCode = accessCode,
			mapId = TARGET_PLACE_ID,
			serverId = reservedServerId,
		})
	end)

	-- 3. Teleport local players if present on this server instance
	if #matchedPlayers &gt; 0 then
		local teleportSuccess, teleportErr = pcall(function()
			TeleportService:TeleportToPrivateServer(TARGET_PLACE_ID, accessCode, matchedPlayers)
		end)

		if not teleportSuccess then
			warn("[MatchmakingCoordinator] Teleport failed for lobby " .. lobby.matchId .. ": " .. tostring(teleportErr))
			return false
		end
	end

	return true
end

--[=[
    Starts background election and matchmaking worker loops.
]=]
function MatchmakingCoordinator.StartService(): ()
	if electionThread ~= nil then
		return
	end
	
	pcall(function()
		MessagingService:SubscribeAsync("MatchAssignment", function(message)
			local data = message.Data
			if type(data) ~= "table" then return end
			local userIds = data.userIds
			local accessCode = data.accessCode
			if not userIds or type(userIds) ~= "table" then return end
			
			local localPlayers = {}
			for _, uid in ipairs(userIds) do
				local p = Players:GetPlayerByUserId(uid)
				if p then
					table.insert(localPlayers, p)
				end
			end
			
			if #localPlayers &gt; 0 then
				pcall(function()
					TeleportService:TeleportToPrivateServer(TARGET_PLACE_ID, accessCode, localPlayers)
				end)
			end
		end)
	end)

	-- Heartbeat election loop
	electionThread = task.spawn(function()
		while true do
			local becameLeader = MatchmakingCoordinator.TryElectCoordinatorAsync()
			isCoordinatorLeader = becameLeader
			task.wait(ELECTION_HEARTBEAT_SECONDS)
		end
	end)

	-- Matchmaking processing loop (Only executes if leader)
	matchmakingThread = task.spawn(function()
		while true do
			task.wait(MATCHMAKING_TICK_SECONDS)
			if isCoordinatorLeader then
				local tickets = MatchmakingCoordinator.CollectAllQueueTicketsAsync()
				if #tickets &gt;= TOTAL_MATCH_PLAYERS then
					local lobbies = MatchmakingCoordinator.FormLobbies(tickets)
					for _, lobby in ipairs(lobbies) do
						MatchmakingCoordinator.ProcessLobbyAsync(lobby)
					end
				end
			end
		end
	end)
end

function MatchmakingCoordinator.IsCoordinator(): boolean
	return isCoordinatorLeader
end

return MatchmakingCoordinator
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX66"><Properties><string name="Name">MatchmakingCoordinator.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
-- Test EZ / Unit Test specification for MatchmakingCoordinator

local MatchmakingCoordinator = require(script.Parent.MatchmakingCoordinator)

return function()
	describe("MatchmakingCoordinator", function()
		it("should deterministically shard user IDs across available shards", function()
			local shard1 = MatchmakingCoordinator.GetShardIndex(1001)
			local shard2 = MatchmakingCoordinator.GetShardIndex(1001)
			expect(shard1).to.equal(shard2)

			local shardA = MatchmakingCoordinator.GetShardIndex(1000)
			local shardB = MatchmakingCoordinator.GetShardIndex(1004)
			-- With 4 shards (0,1,2,3), 1000 % 4 == 0 and 1004 % 4 == 0
			expect(shardA).to.equal(0)
			expect(shardB).to.equal(0)
		end)

		it("should correctly form balanced 5v5 lobbies from 10 tickets", function()
			local tickets = {}
			for i = 1, 10 do
				table.insert(tickets, {
					userId = i,
					mmr = 1000 + (i * 50),
					joinTime = os.time() - i,
					partySize = 1,
					partyMembers = { i },
					selectedMode = "Standard5v5",
				})
			end

			local lobbies = MatchmakingCoordinator.FormLobbies(tickets)
			expect(#lobbies).to.equal(1)
			expect(#lobbies[1].teamA).to.equal(5)
			expect(#lobbies[1].teamB).to.equal(5)
		end)
	end)
end
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX67"><Properties><string name="Name">MatchService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: MatchService
    Service wrapper uniting MatchmakingCoordinator and DirectChallengeService.
]=]

local MatchmakingCoordinator = require(script.Parent:WaitForChild("MatchmakingCoordinator") :: any)
local DirectChallengeService = require(script.Parent:WaitForChild("DirectChallengeService") :: any)

local MatchService = {}

function MatchService.Init()
	if MatchmakingCoordinator and MatchmakingCoordinator.StartService then
		MatchmakingCoordinator.StartService()
	end
	if DirectChallengeService and DirectChallengeService.Init then
		DirectChallengeService.Init()
	end
end

function MatchService.GetPlayerStatus(player: Player): string
	return DirectChallengeService.GetPlayerStatus(player)
end

function MatchService.SetPlayerStatus(player: Player, status: string)
	DirectChallengeService.SetPlayerStatus(player, status)
end

return MatchService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX68"><Properties><string name="Name">OperativeService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: OperativeService
    Server-authoritative engine for Operative selection, ultimate accumulation math,
    cooldown management, credit cost validation, status debuffs, deployable entity management,
    Practice Range sandbox overrides, and remote state replication.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local DataFolder = ReplicatedStorage:WaitForChild("Data")
local OperativeStats = require(DataFolder:WaitForChild("OperativeStats") :: any)

local NetworkFolder = ReplicatedStorage:WaitForChild("Network")
local RemoteEvents = require(NetworkFolder:WaitForChild("RemoteEvents") :: any)

type AbilitySlot = OperativeStats.AbilitySlot
type OperativeData = OperativeStats.OperativeData
type AbilityData = OperativeStats.AbilityData

export type PlayerOperativeState = {
	selectedOperative: string,
	ultCharge: number, -- 0 to 100
	cooldownEndTimestamps: {
		Basic: number,
		Paid: number,
		Ultimate: number,
	},
	silencedUntil: number,
	overshield: number,
	overshieldExpire: number,
	damageReduction: number,
	damageReductionExpire: number,
	hyperdriveExpire: number,
	siegeTurretExpire: number,
}

export type DeployableEntity = {
	id: string,
	owner: Player,
	opId: string,
	abilityId: string,
	deployableType: string,
	instance: Instance,
	hp: number,
	maxHp: number,
	position: Vector3,
	radius: number,
	durationEnd: number,
	lastTick: number,
}

local OperativeService = {}

-- Internal Player State Tracking (UserId -&gt; PlayerOperativeState)
local playerStates: { [number]: PlayerOperativeState } = {}

-- Internal Deployable Entities (deployableId -&gt; DeployableEntity)
local activeDeployables: { [string]: DeployableEntity } = {}
local deployableCounter = 0

-- External Service References
local _combatServerRef: any = nil
local _roundServiceRef: any = nil
local _economyServiceRef: any = nil
local _directChallengeServiceRef: any = nil
local _spawnServiceRef: any = nil

local function getSpawnService(): any
	if not _spawnServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local ssMod = servicesFolder:FindFirstChild("SpawnService")
			if ssMod then
				_spawnServiceRef = require(ssMod :: any)
			end
		end
	end
	return _spawnServiceRef
end

local function getDirectChallengeService()
	if not _directChallengeServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local dcs = servicesFolder:FindFirstChild("DirectChallengeService")
			if dcs then
				_directChallengeServiceRef = require(dcs :: any)
			end
		end
	end
	return _directChallengeServiceRef
end

local function getEconomyService()
	if not _economyServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local es = servicesFolder:FindFirstChild("EconomyService")
			if es then
				_economyServiceRef = require(es :: any)
			end
		end
	end
	return _economyServiceRef
end

local function getRoundService()
	if not _roundServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local rs = servicesFolder:FindFirstChild("RoundService")
			if rs then
				_roundServiceRef = require(rs :: any)
			end
		end
	end
	return _roundServiceRef
end

--- Returns default state for a player
local function createDefaultState(opId: string?): PlayerOperativeState
	return {
		selectedOperative = opId or "Vex",
		ultCharge = 0,
		cooldownEndTimestamps = {
			Basic = 0,
			Paid = 0,
			Ultimate = 0,
		},
		silencedUntil = 0,
		overshield = 0,
		overshieldExpire = 0,
		damageReduction = 0,
		damageReductionExpire = 0,
		hyperdriveExpire = 0,
		siegeTurretExpire = 0,
	}
end

--- Gets or creates player state
function OperativeService.GetPlayerState(player: Player): PlayerOperativeState
	local st = playerStates[player.UserId]
	if not st then
		st = createDefaultState("Vex")
		playerStates[player.UserId] = st
	end
	return st
end

--- Sets CombatServer reference
function OperativeService.SetCombatServer(combatServer: any)
	_combatServerRef = combatServer
end

--- Sets RoundService reference
function OperativeService.SetRoundService(roundService: any)
	_roundServiceRef = roundService
end

--- Checks if player is in Practice Range mode
function OperativeService.IsPracticeRange(player: Player): boolean
	local dcs = getDirectChallengeService()
	if dcs then
		local status = dcs.GetPlayerStatus(player)
		if status == "Practice Range" then
			return true
		end
	end
	if player:GetAttribute("IsPracticeRange") == true then
		return true
	end
	if _combatServerRef and _combatServerRef:GetMatchPhase() == "PracticeRange" then
		return true
	end
	return false
end

--- Syncs state to client via RemoteEvent
function OperativeService.NotifyStateSync(player: Player)
	local st = OperativeService.GetPlayerState(player)
	local isRange = OperativeService.IsPracticeRange(player)

	pcall(function()
		local syncRemote = RemoteEvents.GetReliable("OperativeStateSync" :: any)
		if syncRemote then
			syncRemote:FireClient(player, {
				selectedOperative = st.selectedOperative,
				ultCharge = if isRange then 100 else st.ultCharge,
				cooldowns = {
					Basic = if isRange then 0 else math.max(0, st.cooldownEndTimestamps.Basic - os.clock()),
					Paid = if isRange then 0 else math.max(0, st.cooldownEndTimestamps.Paid - os.clock()),
					Ultimate = if isRange then 0 else math.max(0, st.cooldownEndTimestamps.Ultimate - os.clock()),
				},
				isSilenced = os.clock() &lt; st.silencedUntil,
				overshield = if os.clock() &lt; st.overshieldExpire then st.overshield else 0,
				damageReduction = if os.clock() &lt; st.damageReductionExpire then st.damageReduction else 0,
			})
		end
	end)
end

--- Selects an operative for a player
function OperativeService.SelectOperative(player: Player, opId: string): (boolean, string)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
		return false, "InvalidPlayer"
	end
	if typeof(opId) ~= "string" or #opId == 0 or #opId &gt; 50 then
		return false, "InvalidOperative"
	end

	local opData = OperativeStats.Get(opId)
	if not opData then
		return false, "InvalidOperative"
	end

	local isRange = OperativeService.IsPracticeRange(player)
	local rs = getRoundService()
	if rs and not isRange then
		local match = rs.GetPlayerMatch(player)
		if match and match.phase == "Live" then
			return false, "CannotSwitchMidRound"
		end
	end

	local st = OperativeService.GetPlayerState(player)
	st.selectedOperative = opId

	-- Apply default character visuals/attributes if needed
	local char = player.Character
	if char then
		char:SetAttribute("OperativeId", opId)
	end

	OperativeService.NotifyStateSync(player)
	print("[OperativeService] Player " .. player.Name .. " selected Operative: " .. opId)
	return true, "Success"
end

--- Ultimate Accumulation Math
--- 100 damage dealt = +10% ult charge (0.1% per 1 damage)
--- 1 kill = +20% ult charge
function OperativeService.AddUltCharge(player: Player, amount: number): number
	local st = OperativeService.GetPlayerState(player)
	local oldCharge = st.ultCharge
	st.ultCharge = math.clamp(st.ultCharge + amount, 0, 100)
	if st.ultCharge ~= oldCharge then
		OperativeService.NotifyStateSync(player)
	end
	return st.ultCharge
end

function OperativeService.OnDamageDealt(attackerPlayer: Player, damageAmount: number)
	if damageAmount &gt; 0 then
		local chargeGain = damageAmount * 0.1 -- 100 dmg = 10%
		OperativeService.AddUltCharge(attackerPlayer, chargeGain)
	end
end

function OperativeService.OnKill(killerPlayer: Player)
	OperativeService.AddUltCharge(killerPlayer, 20) -- 1 kill = 20%
end

--- Round Cooldown Resets
function OperativeService.ResetRoundCooldowns(player: Player)
	local st = OperativeService.GetPlayerState(player)
	st.cooldownEndTimestamps.Basic = 0
	st.cooldownEndTimestamps.Paid = 0
	st.silencedUntil = 0
	st.overshield = 0
	st.damageReduction = 0

	local char = player.Character
	if char then
		char:SetAttribute("Silenced", nil)
		char:SetAttribute("SpeedMultiplier", nil)
		char:SetAttribute("CCImmune", nil)
		char:SetAttribute("SiegeTurret", nil)
	end

	OperativeService.NotifyStateSync(player)
end

function OperativeService.ResetAllMatchCooldowns(players: { Player })
	for _, p in players do
		if p and p.Parent then
			OperativeService.ResetRoundCooldowns(p)
		end
	end
end

--- Active Deployables Registry Access
function OperativeService.GetActiveDeployables(): { [string]: DeployableEntity }
	return activeDeployables
end

function OperativeService.DestroyDeployable(deployableId: string)
	local dep = activeDeployables[deployableId]
	if dep then
		if dep.instance and dep.instance.Parent then
			dep.instance:Destroy()
		end
		activeDeployables[deployableId] = nil
	end
end

function OperativeService.ClearAllDeployables()
	for id, _ in activeDeployables do
		OperativeService.DestroyDeployable(id)
	end
end

--- Spawns deployable helper
local function createDeployableInstance(
	owner: Player,
	opId: string,
	abilityId: string,
	deployableType: string,
	cframe: CFrame,
	size: Vector3,
	color: Color3,
	hp: number,
	duration: number,
	radius: number
): DeployableEntity
	deployableCounter += 1
	local id = "Deployable_" .. tostring(deployableCounter)

	local part = Instance.new("Part")
	part.Name = deployableType .. "_" .. id
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = (deployableType == "EnergyWall")
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = if deployableType == "EnergyWall" then 0.3 else 0.5
	part.Parent = Workspace

	part:SetAttribute("DeployableId", id)
	part:SetAttribute("OwnerUserId", owner.UserId)
	part:SetAttribute("DeployableType", deployableType)
	part:SetAttribute("Health", hp)

	local entity: DeployableEntity = {
		id = id,
		owner = owner,
		opId = opId,
		abilityId = abilityId,
		deployableType = deployableType,
		instance = part,
		hp = hp,
		maxHp = hp,
		position = cframe.Position,
		radius = radius,
		durationEnd = os.clock() + duration,
		lastTick = os.clock(),
	}

	activeDeployables[id] = entity
	return entity
end

--- Main Ability Execution Engine
function OperativeService.UseAbility(player: Player, slot: AbilitySlot, targetData: any): (boolean, string)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
		return false, "InvalidPlayer"
	end
	if typeof(slot) ~= "string" or (slot ~= "Basic" and slot ~= "Paid" and slot ~= "Ultimate") then
		return false, "InvalidSlot"
	end

	local st = OperativeService.GetPlayerState(player)
	local now = os.clock()

	-- 1. Check Silence status
	if now &lt; st.silencedUntil then
		return false, "Silenced"
	end

	-- 2. Check Player Alive status
	local char = player.Character
	if not char or not char:FindFirstChild("Humanoid") or (char.Humanoid :: Humanoid).Health &lt;= 0 then
		return false, "PlayerDead"
	end
	if _combatServerRef and not _combatServerRef:IsPlayerAlive(player.UserId) then
		return false, "PlayerDead"
	end

	-- 3. Fetch Operative and Ability Data
	local opData = OperativeStats.Get(st.selectedOperative)
	if not opData then
		return false, "InvalidOperative"
	end
	local abilityData = OperativeStats.GetAbility(st.selectedOperative, slot)
	if not abilityData then
		return false, "InvalidAbility"
	end

	local isRange = OperativeService.IsPracticeRange(player)

	-- 4. Cooldown Check
	if not isRange and now &lt; (st.cooldownEndTimestamps[slot] or 0) then
		return false, "OnCooldown"
	end

	-- 5. Economy Check (Paid Slot)
	local es = getEconomyService()
	if slot == "Paid" and not isRange then
		local cost = abilityData.creditCost
		local balance = es and es.GetCredits(player) or 0
		if balance &lt; cost then
			return false, "InsufficientCredits"
		end
	end

	-- 6. Ultimate Charge Check (Ultimate Slot)
	if slot == "Ultimate" and not isRange then
		if st.ultCharge &lt; 100 then
			return false, "UltNotReady"
		end
	end

	-- 7. Deduct Costs &amp; Update Cooldowns
	if slot == "Paid" and not isRange and es then
		local balance = es.GetCredits(player)
		es.SetCredits(player, balance - abilityData.creditCost)
	end

	if slot == "Ultimate" and not isRange then
		st.ultCharge = 0
	end

	if not isRange then
		st.cooldownEndTimestamps[slot] = now + abilityData.cooldown
	end

	-- Decode target position / CFrame — validate bounds to prevent teleport exploit
	local rootPart = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local originCFrame = if rootPart then rootPart.CFrame else CFrame.new(0, 100, 0)
	local targetCFrame = originCFrame

	local function isValidCFrame(cf: CFrame): boolean
		local p = cf.Position
		return p.X == p.X
			and p.Y == p.Y
			and p.Z == p.Z
			and math.abs(p.X) &lt; 1e4
			and math.abs(p.Y) &lt; 1e4
			and math.abs(p.Z) &lt; 1e4
	end
	if typeof(targetData) == "CFrame" and isValidCFrame(targetData) then
		targetCFrame = targetData
	elseif typeof(targetData) == "Vector3" and targetData.X == targetData.X and math.abs(targetData.X) &lt; 1e4 then
		targetCFrame = CFrame.new(targetData)
	elseif
		typeof(targetData) == "table"
		and typeof(targetData.cframe) == "CFrame"
		and isValidCFrame(targetData.cframe)
	then
		targetCFrame = targetData.cframe
	elseif
		typeof(targetData) == "table"
		and typeof(targetData.position) == "Vector3"
		and targetData.position.X == targetData.position.X
	then
		targetCFrame = CFrame.new(targetData.position)
	end
	-- Clamp target to within ability range of origin (prevents client sending far coords)
	local dist = (targetCFrame.Position - originCFrame.Position).Magnitude
	local maxDist = (abilityData.range or 50) + 10
	if dist &gt; maxDist then
		targetCFrame = originCFrame
	end

	-- 8. Execute Operative Ability Logic (18 functional abilities)
	local abilityId = abilityData.id

	if abilityId == "Vex_Dart" then
		-- Tracking Dart: Raycast forward 200 studs, reveal hit target for 5s
		local direction = targetCFrame.LookVector * (abilityData.range or 200)
		local rayParams = RaycastParams.new()
		rayParams.FilterAncestorsCasesPrune = { char }
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local result = Workspace:Raycast(originCFrame.Position, direction, rayParams)
		if result and result.Instance then
			local targetModel = result.Instance:FindFirstAncestorOfClass("Model")
			if targetModel then
				local targetPlayer = Players:GetPlayerFromCharacter(targetModel)
				local targetHum = targetModel:FindFirstChildOfClass("Humanoid")
				if targetPlayer or targetHum then
					pcall(function()
						local revealRemote = RemoteEvents.GetReliable("EnemyRevealed" :: any)
						if revealRemote then
							revealRemote:FireClient(player, {
								targetCharacter = targetModel,
								duration = abilityData.duration or 5,
								outlineColor = Color3.fromRGB(255, 50, 50),
							})
						end
					end)
				end
			end
		end
	elseif abilityId == "Vex_Trap" then
		-- Shock Trap: Proximity trap (8-stud radius). 40 dmg &amp; 40% slow (SpeedMultiplier = 0.6) for 3s
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"ShockTrap",
			targetCFrame,
			Vector3.new(2, 0.4, 2),
			Color3.fromRGB(255, 170, 0),
			50,
			20,
			abilityData.radius or 8
		)
	elseif abilityId == "Vex_EMP" then
		-- Null Void EMP: 35-stud shockwave. Destroys active deployables &amp; silences enemies for 8s
		local empPos = originCFrame.Position
		local empRadius = abilityData.radius or 35
		local empDuration = abilityData.duration or 8

		-- Destroy enemy deployables within EMP radius
		for depId, dep in activeDeployables do
			if dep.owner ~= player and (dep.position - empPos).Magnitude &lt;= empRadius then
				OperativeService.DestroyDeployable(depId)
			end
		end

		-- Silence enemy players &amp; bots within EMP radius
		for _, otherPlayer in Players:GetPlayers() do
			if otherPlayer ~= player then
				local otherChar = otherPlayer.Character
				if otherChar and otherChar:FindFirstChild("HumanoidRootPart") then
					local dist = ((otherChar.HumanoidRootPart :: BasePart).Position - empPos).Magnitude
					if dist &lt;= empRadius then
						local otherSt = OperativeService.GetPlayerState(otherPlayer)
						otherSt.silencedUntil = now + empDuration
						otherChar:SetAttribute("Silenced", true)
						task.delay(empDuration, function()
							if otherChar.Parent and os.clock() &gt;= otherSt.silencedUntil then
								otherChar:SetAttribute("Silenced", nil)
							end
						end)
						OperativeService.NotifyStateSync(otherPlayer)
					end
				end
			end
		end
	elseif abilityId == "Warden_Wall" then
		-- Energy Wall: Deploys 12x8x1 wall (300 HP, 10s) blocking bullets &amp; sightlines
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"EnergyWall",
			targetCFrame,
			Vector3.new(12, 8, 1),
			Color3.fromRGB(0, 170, 255),
			300,
			abilityData.duration or 10,
			6
		)
	elseif abilityId == "Warden_Fortify" then
		-- Fortify Barrier: Repairs nearby friendly EnergyWall or grants +30 Overshield for 8s
		local repairedWall = false
		for _, dep in activeDeployables do
			if
				dep.owner == player
				and dep.deployableType == "EnergyWall"
				and (dep.position - originCFrame.Position).Magnitude &lt;= 20
			then
				dep.hp = dep.maxHp
				dep.durationEnd += 5
				if dep.instance then
					dep.instance:SetAttribute("Health", dep.hp)
				end
				repairedWall = true
				break
			end
		end

		if not repairedWall then
			st.overshield = 30
			st.overshieldExpire = now + (abilityData.duration or 8)
			char:SetAttribute("Overshield", 30)
		end
	elseif abilityId == "Warden_Shield" then
		-- Aegis Shield: Personal 50% damage reduction + CC immunity for 8s
		st.damageReduction = 0.5
		st.damageReductionExpire = now + (abilityData.duration or 8)
		char:SetAttribute("DamageReduction", 0.5)
		char:SetAttribute("CCImmune", true)

		task.delay(abilityData.duration or 8, function()
			if char.Parent and os.clock() &gt;= st.damageReductionExpire then
				char:SetAttribute("DamageReduction", nil)
				char:SetAttribute("CCImmune", nil)
			end
		end)
	elseif abilityId == "Fray_Blink" then
		-- Blink Dash: Blinks 25 studs forward (raycast obstacle check)
		local blinkDist = abilityData.range or 25
		local lookDir = originCFrame.LookVector
		local rayParams = RaycastParams.new()
		rayParams.FilterAncestorsCasesPrune = { char }
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local result = Workspace:Raycast(originCFrame.Position, lookDir * blinkDist, rayParams)
		local finalPos = if result
			then result.Position - (lookDir * 2)
			else originCFrame.Position + (lookDir * blinkDist)
		local targetCFrame = CFrame.new(finalPos, finalPos + lookDir)

		local ss = getSpawnService()
		if ss then
			ss.TeleportCharacter(player, targetCFrame)
		elseif rootPart then
			rootPart.CFrame = targetCFrame
		end
	elseif abilityId == "Fray_Smoke" then
		-- Smoke Screen: 15-stud volumetric smoke sphere lasting 10s
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"SmokeScreen",
			targetCFrame,
			Vector3.new(30, 30, 30),
			Color3.fromRGB(150, 150, 160),
			1000,
			abilityData.duration or 10,
			abilityData.radius or 15
		)
	elseif abilityId == "Fray_Hyperdrive" then
		-- Hyperdrive: +30% fire rate, +50% reload speed, +20% move speed for 10s
		st.hyperdriveExpire = now + (abilityData.duration or 10)
		char:SetAttribute("FireRateMultiplier", 1.3)
		char:SetAttribute("ReloadSpeedMultiplier", 0.5)
		char:SetAttribute("SpeedMultiplier", 1.2)

		task.delay(abilityData.duration or 10, function()
			if char.Parent and os.clock() &gt;= st.hyperdriveExpire then
				char:SetAttribute("FireRateMultiplier", nil)
				char:SetAttribute("ReloadSpeedMultiplier", nil)
				char:SetAttribute("SpeedMultiplier", nil)
			end
		end)
	elseif abilityId == "Choke_Static" then
		-- Static Field Grenade: 12-stud static field for 7s obscuring vision &amp; HUD
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"StaticField",
			targetCFrame,
			Vector3.new(24, 12, 24),
			Color3.fromRGB(180, 100, 255),
			1000,
			abilityData.duration or 7,
			abilityData.radius or 12
		)
	elseif abilityId == "Choke_Incendiary" then
		-- Incendiary: 10-stud fire pool for 6s dealing 15 DPS (7.5 dmg per 0.5s tick)
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"Incendiary",
			targetCFrame,
			Vector3.new(20, 1, 20),
			Color3.fromRGB(255, 60, 0),
			1000,
			abilityData.duration or 6,
			abilityData.radius or 10
		)
	elseif abilityId == "Choke_Zero" then
		-- Absolute Zero: 30-stud cryogenic zone for 8s (-60% speed, -30% fire rate, 5 DPS freeze)
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"AbsoluteZero",
			targetCFrame,
			Vector3.new(60, 15, 60),
			Color3.fromRGB(100, 220, 255),
			1000,
			abilityData.duration or 8,
			abilityData.radius or 30
		)
	elseif abilityId == "Pulse_Sonar" then
		-- Sonar Pulse: 40-stud sonar wave revealing moving enemies for 4s
		local sonarPos = originCFrame.Position
		local sonarRadius = abilityData.radius or 40
		local sonarDuration = abilityData.duration or 4

		for _, otherPlayer in Players:GetPlayers() do
			if otherPlayer ~= player then
				local otherChar = otherPlayer.Character
				if otherChar and otherChar:FindFirstChild("HumanoidRootPart") then
					local dist = ((otherChar.HumanoidRootPart :: BasePart).Position - sonarPos).Magnitude
					if dist &lt;= sonarRadius then
						pcall(function()
							local revealRemote = RemoteEvents.GetReliable("EnemyRevealed" :: any)
							if revealRemote then
								revealRemote:FireClient(player, {
									targetCharacter = otherChar,
									duration = sonarDuration,
									outlineColor = Color3.fromRGB(255, 50, 50),
								})
							end
						end)
					end
				end
			end
		end
	elseif abilityId == "Pulse_Beacon" then
		-- Sensor Beacon: 50 HP sticky beacon (20-stud radius), highlights enemies red for 3s
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"SensorBeacon",
			targetCFrame,
			Vector3.new(1.5, 1.5, 1.5),
			Color3.fromRGB(255, 220, 0),
			50,
			60,
			abilityData.radius or 20
		)
	elseif abilityId == "Pulse_Scan" then
		-- Global Scan: 3 map-wide radar pulses at 1.5s intervals highlighting enemies for 3s per wave
		task.spawn(function()
			for wave = 1, 3 do
				for _, otherPlayer in Players:GetPlayers() do
					if otherPlayer ~= player then
						local otherChar = otherPlayer.Character
						if otherChar then
							pcall(function()
								local revealRemote = RemoteEvents.GetReliable("EnemyRevealed" :: any)
								if revealRemote then
									revealRemote:FireClient(player, {
										targetCharacter = otherChar,
										duration = 3,
										outlineColor = Color3.fromRGB(255, 0, 0),
									})
								end
							end)
						end
					end
				end
				if wave &lt; 3 then
					task.wait(1.5)
				end
			end
		end)
	elseif abilityId == "Bastion_Turret" then
		-- Auto-Turret: 150 HP mini-turret (40-stud range, 300 RPM, 8 dmg/shot) lasting 20s
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"AutoTurret",
			targetCFrame,
			Vector3.new(3, 4, 3),
			Color3.fromRGB(220, 50, 50),
			150,
			abilityData.duration or 20,
			abilityData.range or 40
		)
	elseif abilityId == "Bastion_Mine" then
		-- Repulsor Mine: 25 dmg &amp; 50 studs/sec outward knockback impulse in 6-stud blast
		createDeployableInstance(
			player,
			st.selectedOperative,
			abilityId,
			"RepulsorMine",
			targetCFrame,
			Vector3.new(1.5, 0.4, 1.5),
			Color3.fromRGB(255, 100, 0),
			50,
			30,
			abilityData.radius or 6
		)
	elseif abilityId == "Bastion_Siege" then
		-- Siege Turret: Transform Bastion into stationary Siege Turret for 12s (+100 shield, minigun state)
		st.siegeTurretExpire = now + (abilityData.duration or 12)
		char:SetAttribute("SiegeTurret", true)
		if _combatServerRef then
			local stHealth = _combatServerRef:GetPlayerHealth(player.UserId)
			if stHealth then
				_combatServerRef:RegisterPlayer(player.UserId, stHealth.health, stHealth.shield + 100)
			end
		end

		task.delay(abilityData.duration or 12, function()
			if char.Parent and os.clock() &gt;= st.siegeTurretExpire then
				char:SetAttribute("SiegeTurret", nil)
			end
		end)
	end

	-- 9. Replicate Visual Effects to Clients
	pcall(function()
		local repRemote = RemoteEvents.GetReliable("AbilityReplicated" :: any)
		if repRemote then
			repRemote:FireAllClients({
				player = player,
				userId = player.UserId,
				opId = st.selectedOperative,
				slot = slot,
				abilityId = abilityId,
				targetCFrame = targetCFrame,
			})
		end
	end)

	OperativeService.NotifyStateSync(player)
	return true, "Success"
end

--- Heartbeat loop to manage active deployables and periodic ability ticking
RunService.Heartbeat:Connect(function(dt: number)
	local now = os.clock()

	for depId, dep in activeDeployables do
		-- Expiry check
		if now &gt;= dep.durationEnd or not dep.instance or not dep.instance.Parent then
			OperativeService.DestroyDeployable(depId)
			continue
		end

		-- Periodic tick processing (every 0.5 seconds)
		if now - dep.lastTick &gt;= 0.5 then
			dep.lastTick = now

			if dep.deployableType == "Incendiary" then
				-- Deal 7.5 dmg to enemies standing inside 10-stud radius
				for _, enemyPlayer in Players:GetPlayers() do
					if enemyPlayer ~= dep.owner then
						local enemyChar = enemyPlayer.Character
						if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
							local dist = ((enemyChar.HumanoidRootPart :: BasePart).Position - dep.position).Magnitude
							if dist &lt;= dep.radius then
								if _combatServerRef then
									_combatServerRef:ProcessHitReport(dep.owner.UserId, enemyPlayer.UserId, {
										origin = dep.position,
										direction = Vector3.new(0, -1, 0),
										hitPosition = (enemyChar.HumanoidRootPart :: BasePart).Position,
										distance = dist,
										clientTimestamp = now,
										sequenceId = 1,
										weaponId = "Ability_Incendiary",
									}, 100, 7.5)
								end
							end
						end
					end
				end
			elseif dep.deployableType == "AbsoluteZero" then
				-- Apply slow (SpeedMultiplier = 0.4) and 2.5 damage per 0.5s tick to enemies inside 30-stud radius
				for _, enemyPlayer in Players:GetPlayers() do
					if enemyPlayer ~= dep.owner then
						local enemyChar = enemyPlayer.Character
						if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
							local dist = ((enemyChar.HumanoidRootPart :: BasePart).Position - dep.position).Magnitude
							if dist &lt;= dep.radius then
								enemyChar:SetAttribute("SpeedMultiplier", 0.4)
								if _combatServerRef then
									_combatServerRef:ProcessHitReport(dep.owner.UserId, enemyPlayer.UserId, {
										origin = dep.position,
										direction = Vector3.new(0, -1, 0),
										hitPosition = (enemyChar.HumanoidRootPart :: BasePart).Position,
										distance = dist,
										clientTimestamp = now,
										sequenceId = 1,
										weaponId = "Ability_AbsoluteZero",
									}, 100, 2.5)
								end
							end
						end
					end
				end
			elseif dep.deployableType == "ShockTrap" then
				-- Proximity check (8-stud radius): 40 damage + 40% slow for 3s, then destroy trap
				for _, enemyPlayer in Players:GetPlayers() do
					if enemyPlayer ~= dep.owner then
						local enemyChar = enemyPlayer.Character
						if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
							local dist = ((enemyChar.HumanoidRootPart :: BasePart).Position - dep.position).Magnitude
							if dist &lt;= dep.radius then
								enemyChar:SetAttribute("SpeedMultiplier", 0.6)
								task.delay(3, function()
									if enemyChar.Parent then
										enemyChar:SetAttribute("SpeedMultiplier", nil)
									end
								end)
								if _combatServerRef then
									_combatServerRef:ProcessHitReport(dep.owner.UserId, enemyPlayer.UserId, {
										origin = dep.position,
										direction = Vector3.new(0, -1, 0),
										hitPosition = (enemyChar.HumanoidRootPart :: BasePart).Position,
										distance = dist,
										clientTimestamp = now,
										sequenceId = 1,
										weaponId = "Ability_ShockTrap",
									}, 100, 40)
								end
								OperativeService.DestroyDeployable(depId)
								break
							end
						end
					end
				end
			elseif dep.deployableType == "RepulsorMine" then
				-- Proximity check (6-stud radius): 25 damage + 50 studs/sec knockback impulse
				for _, enemyPlayer in Players:GetPlayers() do
					if enemyPlayer ~= dep.owner then
						local enemyChar = enemyPlayer.Character
						local root = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") :: BasePart?
						if root then
							local diff = root.Position - dep.position
							if diff.Magnitude &lt;= dep.radius then
								local knockDir = if diff.Magnitude &gt; 0.1 then diff.Unit else Vector3.new(0, 1, 0)
								root.AssemblyLinearVelocity = knockDir * 50
								if _combatServerRef then
									_combatServerRef:ProcessHitReport(dep.owner.UserId, enemyPlayer.UserId, {
										origin = dep.position,
										direction = knockDir,
										hitPosition = root.Position,
										distance = diff.Magnitude,
										clientTimestamp = now,
										sequenceId = 1,
										weaponId = "Ability_RepulsorMine",
									}, 100, 25)
								end
								OperativeService.DestroyDeployable(depId)
								break
							end
						end
					end
				end
			elseif dep.deployableType == "AutoTurret" then
				-- Auto-Turret targeting: scans nearest enemy within 40 studs and fires
				for _, enemyPlayer in Players:GetPlayers() do
					if enemyPlayer ~= dep.owner then
						local enemyChar = enemyPlayer.Character
						local root = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") :: BasePart?
						if root then
							local dist = (root.Position - dep.position).Magnitude
							if dist &lt;= dep.radius then
								if _combatServerRef then
									_combatServerRef:ProcessHitReport(dep.owner.UserId, enemyPlayer.UserId, {
										origin = dep.position,
										direction = (root.Position - dep.position).Unit,
										hitPosition = root.Position,
										distance = dist,
										clientTimestamp = now,
										sequenceId = 1,
										weaponId = "Ability_AutoTurret",
									}, 100, 8)
								end
								break
							end
						end
					end
				end
			end
		end
	end
end)

--- Player Lifecycle Listeners
function OperativeService.Init(combatServerRef: any?)
	if combatServerRef then
		_combatServerRef = combatServerRef
	end

	Players.PlayerAdded:Connect(function(player)
		playerStates[player.UserId] = createDefaultState("Vex")
		OperativeService.NotifyStateSync(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		playerStates[player.UserId] = nil
		-- Clean up active deployables owned by leaving player
		for depId, dep in activeDeployables do
			if dep.owner == player then
				OperativeService.DestroyDeployable(depId)
			end
		end
	end)

	-- NOTE: UseAbility and SelectAgent remotes are handled exclusively by ServerMain to avoid duplicate handlers.

	print("[OperativeService] Initialized successfully.")
end

return OperativeService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX69"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Player Data Service
    Central hub for loading, manipulating, and saving player statistics
    utilizing ProfileServiceWrapper for robust session-locking.
]=]

local Players = game:GetService("Players")
local ProfileServiceWrapper = require(script.Parent:WaitForChild("ProfileServiceWrapper") :: any)
local LeaderboardService = require(script.Parent:WaitForChild("LeaderboardService") :: any)

local PlayerDataService = {}

export type PlayerData = {
    Kills: number,
    Deaths: number,
    Coins: number,
    MMR: number,
}

local DataStoreName = "PlayerData_Prod_v1"

local ProfileTemplate: PlayerData = {
    Kills = 0,
    Deaths = 0,
    Coins = 100,
    MMR = 1000,
}

local Profiles: { [player]: ProfileServiceWrapper.Profile } = {}

function PlayerDataService.GetProfile(player: Player): ProfileServiceWrapper.Profile?
    return Profiles[player]
end

function PlayerDataService.AddKill(player: Player)
    local profile = Profiles[player]
        if profile and profile:IsActive() then
            profile.Data.Kills += 1
            
            -- Very basic Elo simulation
            profile.Data.MMR += 15
            
            -- Update UI
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
                local killsObj = leaderstats:FindFirstChild("Kills") :: IntValue
                if killsObj then killsObj.Value = profile.Data.Kills end
            end
            
            -- Update Leaderboard
            LeaderboardService.UpdatePlayerScore(player.UserId, profile.Data.Kills)
        end
end

function PlayerDataService.AddDeath(player: Player)
    local profile = Profiles[player]
    if profile and profile:IsActive() then
        profile.Data.Deaths += 1
        
        profile.Data.MMR = math.max(0, profile.Data.MMR - 10)
        
        -- Update UI
        local leaderstats = player:FindFirstChild("leaderstats")
        if leaderstats then
            local deathsObj = leaderstats:FindFirstChild("Deaths") :: IntValue
            if deathsObj then deathsObj.Value = profile.Data.Deaths end
        end
    end
end

local function onPlayerAdded(player: Player)
    local profile = ProfileServiceWrapper.LoadProfileAsync(
        player.UserId,
        ProfileTemplate
    )
    
    if profile then
        profile.OnSessionEnded:Connect(function()
            Profiles[player] = nil
            player:Kick("Your data session was locked by another server. Please rejoin.")
        end)
        
        if player:IsDescendantOf(Players) then
            Profiles[player] = profile
            
            -- Hook up leaderstats for UI display
            local leaderstats = Instance.new("Folder")
            leaderstats.Name = "leaderstats"
            leaderstats.Parent = player
            
            local killsObj = Instance.new("IntValue")
            killsObj.Name = "Kills"
            killsObj.Value = profile.Data.Kills
            killsObj.Parent = leaderstats
            
            local deathsObj = Instance.new("IntValue")
            deathsObj.Name = "Deaths"
            deathsObj.Value = profile.Data.Deaths
            deathsObj.Parent = leaderstats
            
            -- We update leaderstats periodically in a loop or via signals.
            -- For simplicity, let's just keep the master data in Profile.
        else
            -- Player left before profile finished loading
            profile:ReleaseAsync()
        end
    else
        player:Kick("Could not load data. Please try again later.")
    end
end

local function onPlayerRemoving(player: Player)
    local profile = Profiles[player]
    if profile then
        profile:ReleaseAsync()
        Profiles[player] = nil
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Handle players already in server (Studio edge case)
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, player)
end

return PlayerDataService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX70"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: ProfileService
    Service wrapper delegating to ProfileServiceWrapper.
]=]

local ProfileServiceWrapper = require(script.Parent:WaitForChild("ProfileServiceWrapper") :: any)

local ProfileService = {}

function ProfileService.LoadProfileAsync(userId: number)
	return ProfileServiceWrapper.LoadProfileAsync(userId)
end

function ProfileService.GetDefaultProfile(userId: number, username: string?)
	return ProfileServiceWrapper.GetDefaultProfile(userId, username)
end

function ProfileService.CreateInMemoryFallback(userId: number, defaultData: any)
	return ProfileServiceWrapper.CreateInMemoryFallback(userId, defaultData)
end

function ProfileService.RegisterActiveProfile(userId: number, profile: any)
	ProfileServiceWrapper.RegisterActiveProfile(userId, profile)
end

function ProfileService.UnregisterActiveProfile(userId: number)
	ProfileServiceWrapper.UnregisterActiveProfile(userId)
end

return ProfileService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX71"><Properties><string name="Name">ProfileServiceWrapper</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: ProfileServiceWrapper
    Provides session-locked DataStore persistence (ProfileService pattern),
    atomic UpdateAsync transactions with exponential backoff retry logic,
    JobId session locking with 60s heartbeat autosave, 30-minute lease deadlock resolution,
    in-memory non-blocking join fallback, and shutdown save (BindToClose).
]=]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

-- Configuration Constants
local DEFAULT_DATASTORE_NAME = "PlayerData_v1"
local HEARTBEAT_INTERVAL_SECONDS = 60
local DEADLOCK_LEASE_TIMEOUT_SECONDS = 1800 -- 30 minutes
local MAX_RETRY_ATTEMPTS = 5
local BASE_RETRY_DELAY_SECONDS = 1

-- Session Lock Data Structure
export type SessionLock = {
	JobId: string,
	SessionId: string,
	Timestamp: number,
}

-- Envelope stored inside Roblox DataStore
export type ProfileEnvelope = {
	Data: { [string]: any },
	Lock: SessionLock?,
	SchemaVersion: number,
	LastSaved: number,
}

-- Internal Profile Interface
export type Profile = {
	UserId: number,
	Data: { [string]: any },
	SessionId: string,
	IsActive: (self: Profile) -&gt; boolean,
	SaveAsync: (self: Profile) -&gt; boolean,
	ReleaseAsync: (self: Profile) -&gt; (),
	OnSessionEnded: {
		Connect: (self: any, callback: () -&gt; ()) -&gt; { Disconnect: (self: any) -&gt; () },
	},
	_active: boolean,
	_lockThread: thread?,
	_bindableEvent: BindableEvent,
}

local ProfileServiceWrapper = {}
ProfileServiceWrapper.__index = ProfileServiceWrapper

-- Data Store Handle
local dataStore: DataStore? = nil

-- Registry of active player profiles for shutdown save handler
local activeProfiles: { [number]: Profile } = {}

local function getDataStore(): DataStore
	if not dataStore then
		dataStore = DataStoreService:GetDataStore(DEFAULT_DATASTORE_NAME)
	end
	return dataStore :: DataStore
end

-- Track active profiles upon load
function ProfileServiceWrapper.RegisterActiveProfile(userId: number, profile: Profile)
	activeProfiles[userId] = profile
end

function ProfileServiceWrapper.UnregisterActiveProfile(userId: number)
	activeProfiles[userId] = nil
end

-- Default profile template containing all required M7 top-level fields and legacy aliases
function ProfileServiceWrapper.GetDefaultProfile(userId: number, username: string?): { [string]: any }
	return {
		userId = userId,
		username = username or ("Player_" .. tostring(userId)),

		-- M7 Required Top-Level Schema Fields
		Level = 1,
		XP = 0,
		Credits = 500,
		OwnedCosmetics = { "DefaultSkin_AR", "DefaultSkin_Pistol" },
		EquippedSkins = {
			["AssaultRifle"] = "DefaultSkin_AR",
			["Sidearm"] = "DefaultSkin_Pistol",
		},
		SelectedOperative = "Vex",
		MatchStats = {
			Kills = 0,
			Deaths = 0,
			Wins = 0,
			Losses = 0,
			Assists = 0,
			Headshots = 0,
			MatchesPlayed = 0,
		},

		-- Supplementary / Backward Compatibility Fields
		level = 1,
		experience = 0,
		rankRating = 1000,
		rankTier = "Bronze I",
		currencies = {
			credits = 500,
			gems = 0,
			eventTokens = 0,
		},
		stats = {
			kills = 0,
			deaths = 0,
			assists = 0,
			wins = 0,
			losses = 0,
			headshots = 0,
			totalDamageDealt = 0,
			playtimeSeconds = 0,
			matchesPlayed = 0,
			accuracyRatio = 0,
		},
		equippedLoadout = {
			primaryWeaponId = "AssaultRifle",
			secondaryWeaponId = "Pistol",
			meleeWeaponId = "Knife_Tactical_01",
			tacticalGadgetId = "Smoke_Grenade",
			lethalGadgetId = "Frag_Grenade",
			perkIds = {},
			weaponSkins = {},
		},
		inventory = {
			["AssaultRifle"] = true,
			["Pistol"] = true,
			["Knife_Tactical_01"] = true,
		},
		unlockedClasses = { "Assault", "Recon" },
		settings = {
			mouseSensitivity = 1.0,
			fov = 90,
			crosshairColor = "#FFFFFF",
			soundVolume = 1.0,
			musicVolume = 0.8,
		},
		schemaVersion = 1,
		lastLoginTimestamp = os.time(),
	}
end

--[=[
    Recursively sanitizes data before writing to DataStore.
    - Strips NaN values (replaces with 0).
    - Converts Vector3 to plain array {x, y, z}.
    - Rejects mixed-type keys (e.g. dictionary with both string and number keys).
    - Rejects cyclic references.
    - Rejects non-serializable Roblox types (Instances, Threads, Functions, Signals).
]=]
function ProfileServiceWrapper.SanitizeData(
	value: any,
	visitedStack: { [any]: boolean }?
): (boolean, any, string?)
	local stack = visitedStack or {}
	local valueType = typeof(value)

	if valueType == "number" then
		-- Strip NaN or Infinite values
		if value ~= value then
			return true, 0, nil
		elseif value == math.huge or value == -math.huge then
			return true, 0, nil
		end
		return true, value, nil
	elseif valueType == "string" or valueType == "boolean" then
		return true, value, nil
	elseif valueType == "Vector3" then
		local vec = value :: Vector3
		return true, { vec.X, vec.Y, vec.Z }, nil
	elseif valueType == "table" then
		local tbl = value :: { [any]: any }

		-- Cyclic reference check
		if stack[tbl] then
			return false, nil, "Cyclic reference detected in table"
		end
		stack[tbl] = true

		local hasStringKeys = false
		local hasNumberKeys = false
		local hasInvalidKeys = false

		for k, _ in pairs(tbl) do
			local kType = typeof(k)
			if kType == "string" then
				hasStringKeys = true
			elseif kType == "number" then
				hasNumberKeys = true
			else
				hasInvalidKeys = true
			end
		end

		if hasInvalidKeys then
			stack[tbl] = nil
			return false, nil, "Invalid key type detected in table"
		end

		-- Mixed-type key rejection
		if hasStringKeys and hasNumberKeys then
			stack[tbl] = nil
			return false, nil, "Mixed-type keys rejected (table has both string and number keys)"
		end

		local sanitizedTable: { [any]: any } = {}
		for k, v in pairs(tbl) do
			local ok, sanitizedVal, err = ProfileServiceWrapper.SanitizeData(v, stack)
			if not ok then
				stack[tbl] = nil
				return false, nil, err
			end
			sanitizedTable[k] = sanitizedVal
		end

		stack[tbl] = nil
		return true, sanitizedTable, nil
	else
		return false, nil, "Non-serializable data type: " .. valueType
	end
end

--[=[
    Creates an in-memory fallback profile object for non-blocking player join when DataStore is unavailable.
]=]
function ProfileServiceWrapper.CreateInMemoryFallback(
	userId: number,
	defaultData: { [string]: any }?
): Profile
	local sessionId = HttpService:GenerateGUID(false)
	local bindable = Instance.new("BindableEvent")
	local rawData = defaultData or ProfileServiceWrapper.GetDefaultProfile(userId)
	local ok, sanitized, _ = ProfileServiceWrapper.SanitizeData(rawData)
	local finalData = if ok then sanitized else rawData

	local selfObj: Profile = {
		UserId = userId,
		Data = finalData,
		SessionId = sessionId,
		_active = true,
		_lockThread = nil,
		_bindableEvent = bindable,

		IsActive = function(p: Profile): boolean
			return p._active
		end,

		SaveAsync = function(_: Profile): boolean
			return true
		end,

		ReleaseAsync = function(p: Profile): ()
			if not p._active then
				return
			end
			p._active = false
			ProfileServiceWrapper.UnregisterActiveProfile(p.UserId)
			p._bindableEvent:Fire()
		end,

		OnSessionEnded = {
			Connect = function(_, callback: () -&gt; ())
				local connection = bindable.Event:Connect(callback)
				return {
					Disconnect = function(_)
						connection:Disconnect()
					end,
				}
			end,
		},
	}

	ProfileServiceWrapper.RegisterActiveProfile(userId, selfObj)
	return selfObj
end

--[=[
    Loads a profile for the given userId with session locking and exponential backoff retry logic.
    Retries up to MAX_RETRY_ATTEMPTS using math.pow(2, attempt - 1) backoff delay.
]=]
function ProfileServiceWrapper.LoadProfileAsync(
	userId: number,
	defaultData: { [string]: any }?
): Profile?
	local key = "Player_" .. tostring(userId)
	local sessionId = HttpService:GenerateGUID(false)
	local currentJobId = game.JobId ~= "" and game.JobId or "Studio_Session"

	local store = getDataStore()
	local loadedEnvelope: ProfileEnvelope? = nil

	for attempt = 1, MAX_RETRY_ATTEMPTS do
		local success, resultErr = pcall(function()
			store:UpdateAsync(key, function(existingValue: any)
				local envelope: ProfileEnvelope
				local now = os.time()

				if existingValue == nil then
					local initialData = defaultData or ProfileServiceWrapper.GetDefaultProfile(userId)
					local ok, sanitized, err = ProfileServiceWrapper.SanitizeData(initialData)
					if not ok then
						error("Failed to sanitize initial default data: " .. tostring(err))
					end

					envelope = {
						Data = sanitized,
						Lock = {
							JobId = currentJobId,
							SessionId = sessionId,
							Timestamp = now,
						},
						SchemaVersion = 1,
						LastSaved = now,
					}
					return envelope
				else
					envelope = existingValue :: ProfileEnvelope

					if envelope.Lock ~= nil then
						local lock = envelope.Lock
						local isOwnLock = (lock.JobId == currentJobId)
						local elapsedSeconds = now - lock.Timestamp

						-- 30-minute lease deadlock resolution
						local isDeadlocked = (elapsedSeconds &gt;= DEADLOCK_LEASE_TIMEOUT_SECONDS)

						if not isOwnLock and not isDeadlocked then
							-- Profile is locked by an active external session. Reject claim.
							return nil
						end
					end

					-- Lock is absent, owned by this server, or deadlock lease expired. Acquire lock!
					local ok, sanitized, err = ProfileServiceWrapper.SanitizeData(envelope.Data)
					if not ok then
						error("Failed to sanitize envelope data: " .. tostring(err))
					end

					envelope.Data = sanitized
					envelope.Lock = {
						JobId = currentJobId,
						SessionId = sessionId,
						Timestamp = now,
					}
					envelope.LastSaved = now
					return envelope
				end
			end)
		end)

		if success then
			-- Verification read to check if we succeeded in acquiring the lock
			local getSuccess, verifyEnvelope = pcall(function()
				return store:GetAsync(key) :: ProfileEnvelope?
			end)

			if getSuccess and verifyEnvelope and verifyEnvelope.Lock and verifyEnvelope.Lock.SessionId == sessionId then
				loadedEnvelope = verifyEnvelope
				break
			end
		else
			local delay = math.min(16, BASE_RETRY_DELAY_SECONDS * math.pow(2, attempt - 1))
			warn(string.format("[ProfileServiceWrapper] Attempt %d/%d failed for userId %d: %s. Retrying in %ds...", 
				attempt, MAX_RETRY_ATTEMPTS, userId, tostring(resultErr), delay))
		end

		if attempt &lt; MAX_RETRY_ATTEMPTS then
			local delay = math.min(16, BASE_RETRY_DELAY_SECONDS * math.pow(2, attempt - 1))
			task.wait(delay)
		end
	end

	if not loadedEnvelope then
		warn("[ProfileServiceWrapper] DataStore unavailable or session lock failed for userId " .. tostring(userId) .. ". Utilizing in-memory fallback profile.")
		return ProfileServiceWrapper.CreateInMemoryFallback(userId, defaultData)
	end

	local Players = game:GetService("Players")
	if not Players:GetPlayerByUserId(userId) then
		warn("[ProfileServiceWrapper] Player disconnected during profile load. Releasing lock for userId " .. tostring(userId))
		ProfileServiceWrapper.ReleaseProfileLock({ UserId = userId, SessionId = sessionId, Data = loadedEnvelope.Data } :: any)
		return nil
	end

	local bindable = Instance.new("BindableEvent")

	local selfObj: Profile = {
		UserId = userId,
		Data = loadedEnvelope.Data,
		SessionId = sessionId,
		_active = true,
		_lockThread = nil,
		_bindableEvent = bindable,

		IsActive = function(p: Profile): boolean
			return p._active
		end,

		SaveAsync = function(p: Profile): boolean
			if not p._active then
				return false
			end
			return ProfileServiceWrapper.SaveProfileData(p)
		end,

		ReleaseAsync = function(p: Profile): ()
			if not p._active then
				return
			end
			p._active = false
			if p._lockThread then
				task.cancel(p._lockThread)
				p._lockThread = nil
			end
			ProfileServiceWrapper.ReleaseProfileLock(p)
			ProfileServiceWrapper.UnregisterActiveProfile(p.UserId)
			p._bindableEvent:Fire()
		end,

		OnSessionEnded = {
			Connect = function(_, callback: () -&gt; ())
				local connection = bindable.Event:Connect(callback)
				return {
					Disconnect = function(_)
						connection:Disconnect()
					end,
				}
			end,
		},
	}

	ProfileServiceWrapper.RegisterActiveProfile(userId, selfObj)

	-- Spawn 60-second Heartbeat Refresh Loop
	selfObj._lockThread = task.spawn(function()
		while selfObj._active do
			task.wait(HEARTBEAT_INTERVAL_SECONDS)
			if not selfObj._active then
				break
			end

			local now = os.time()
			local ok, _ = pcall(function()
				store:UpdateAsync(key, function(current: any)
					if current == nil then
						return nil
					end
					local env = current :: ProfileEnvelope
					if env.Lock == nil or env.Lock.SessionId ~= sessionId then
						error("SESSION_LOCK_MISMATCH")
					end

					local sanitizeOk, sanitizedData, sErr = ProfileServiceWrapper.SanitizeData(selfObj.Data)
					if not sanitizeOk then
						warn("[ProfileServiceWrapper] Heartbeat sanitization warning: " .. tostring(sErr))
						sanitizedData = env.Data
					end

					env.Data = sanitizedData
					env.Lock.Timestamp = now
					env.LastSaved = now
					return env
				end)
			end)

			if not ok then
				warn("[ProfileServiceWrapper] Heartbeat update failed for userId " .. tostring(userId))
			end

			-- Check if lock is still ours
			local checkOk, verifyEnv = pcall(function()
				return store:GetAsync(key) :: ProfileEnvelope?
			end)

			if checkOk and (not verifyEnv or not verifyEnv.Lock or verifyEnv.Lock.SessionId ~= sessionId) then
				warn("[ProfileServiceWrapper] Session lock stolen for userId " .. tostring(userId) .. ". Terminating session.")
				selfObj._active = false
				ProfileServiceWrapper.UnregisterActiveProfile(userId)
				selfObj._bindableEvent:Fire()
				break
			end
		end
	end)

	return selfObj
end

-- Saves profile data atomically to DataStore
function ProfileServiceWrapper.SaveProfileData(profile: Profile): boolean
	local key = "Player_" .. tostring(profile.UserId)
	local store = getDataStore()
	
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(current: any)
			if current == nil then
				return nil
			end
			local env = current :: ProfileEnvelope
			if env.Lock == nil or env.Lock.SessionId ~= profile.SessionId then
				error("SESSION_LOCK_MISMATCH")
			end

			local sanitizeOk, sanitizedData, sErr = ProfileServiceWrapper.SanitizeData(profile.Data)
			if not sanitizeOk then
				error("Sanitization error: " .. tostring(sErr))
			end

			env.Data = sanitizedData
			env.Lock.Timestamp = os.time()
			env.LastSaved = os.time()
			return env
		end)
	end)

	if not ok then
		warn("[ProfileServiceWrapper] SaveProfileData failed: " .. tostring(err))
		return false
	end
	return true
end

-- Releases profile session lock in DataStore
function ProfileServiceWrapper.ReleaseProfileLock(profile: Profile): ()
	local key = "Player_" .. tostring(profile.UserId)
	local store = getDataStore()

	pcall(function()
		store:UpdateAsync(key, function(current: any)
			if current == nil then
				return nil
			end
			local env = current :: ProfileEnvelope
			if env.Lock == nil or env.Lock.SessionId ~= profile.SessionId then
				return nil
			end

			local sanitizeOk, sanitizedData, _ = ProfileServiceWrapper.SanitizeData(profile.Data)
			if sanitizeOk then
				env.Data = sanitizedData
			end

			env.Lock = nil
			env.LastSaved = os.time()
			return env
		end)
	end)
end

-- Register game:BindToClose shutdown flush handler to guarantee data safety on server termination
game:BindToClose(function()
	print("[ProfileServiceWrapper] Server shutting down. Saving all active player profiles...")
	local threads = {}
	for _, profile in pairs(activeProfiles) do
		table.insert(
			threads,
			task.spawn(function()
				pcall(function()
					profile:SaveAsync()
					profile:ReleaseAsync()
				end)
			end)
		)
	end

	local start = os.clock()
	while next(activeProfiles) ~= nil and (os.clock() - start &lt; 10) do
		task.wait(0.1)
	end
	print("[ProfileServiceWrapper] Shutdown save complete.")
end)

return ProfileServiceWrapper
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX72"><Properties><string name="Name">ProfileServiceWrapper.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for ProfileServiceWrapper
    Validates data sanitization (NaN stripping, Vector3 conversion, cyclic/mixed key rejection),
    default profile template schema (Level, XP, Credits, OwnedCosmetics, EquippedSkins, SelectedOperative, MatchStats),
    exponential backoff retry calculation math, non-blocking in-memory fallback profile creation,
    and active profile registration/deregistration tracking.
]=]

local ServerScriptService = game:GetService("ServerScriptService")
local ProfileServiceWrapper = require(ServerScriptService:WaitForChild("Services"):WaitForChild("ProfileServiceWrapper") :: any)

local function runTests()
	print("[ProfileServiceWrapper.spec] Starting unit test execution...")

	-- 1. Test Data Sanitization - NaN &amp; Infinity stripping
	local nanOk, nanResult = ProfileServiceWrapper.SanitizeData(0 / 0)
	assert(nanOk == true, "NaN sanitization should succeed")
	assert(nanResult == 0, "NaN should be replaced with 0")

	local infOk, infResult = ProfileServiceWrapper.SanitizeData(math.huge)
	assert(infOk == true, "Infinity sanitization should succeed")
	assert(infResult == 0, "Infinity should be replaced with 0")

	-- 2. Test Data Sanitization - Vector3 conversion
	local vec = Vector3.new(10, 20, 30)
	local vecOk, vecResult = ProfileServiceWrapper.SanitizeData(vec)
	assert(vecOk == true, "Vector3 sanitization should succeed")
	assert(type(vecResult) == "table", "Vector3 should convert to table")
	assert(vecResult[1] == 10 and vecResult[2] == 20 and vecResult[3] == 30, "Vector3 elements should match {10, 20, 30}")

	-- 3. Test Data Sanitization - Rejection of mixed-type keys
	local mixedTable = {
		[1] = "numeric key",
		foo = "string key",
	}
	local mixedOk, _, mixedErr = ProfileServiceWrapper.SanitizeData(mixedTable)
	assert(mixedOk == false, "Mixed-type keys should be rejected")
	assert(mixedErr ~= nil and string.find(mixedErr, "Mixed%-type keys") ~= nil, "Should return mixed keys error message")

	-- 4. Test Data Sanitization - Rejection of cyclic references
	local parent: { [string]: any } = { name = "parent" }
	local child: { [string]: any } = { name = "child", parent = parent }
	parent.child = child

	local cyclicOk, _, cyclicErr = ProfileServiceWrapper.SanitizeData(parent)
	assert(cyclicOk == false, "Cyclic references should be rejected")
	assert(cyclicErr ~= nil and string.find(cyclicErr, "Cyclic reference") ~= nil, "Should return cyclic reference error message")

	-- 5. Test Default Profile Template Schema (M7 Top-Level Fields)
	local defaultProfile = ProfileServiceWrapper.GetDefaultProfile(9999, "TestUser9999")
	assert(defaultProfile.userId == 9999, "userId should match")
	assert(defaultProfile.username == "TestUser9999", "username should match")
	assert(defaultProfile.Level == 1, "Level should default to 1")
	assert(defaultProfile.XP == 0, "XP should default to 0")
	assert(defaultProfile.Credits == 500, "Credits should default to 500")
	assert(type(defaultProfile.OwnedCosmetics) == "table", "OwnedCosmetics should be a table")
	assert(table.find(defaultProfile.OwnedCosmetics, "DefaultSkin_AR") ~= nil, "OwnedCosmetics should contain DefaultSkin_AR")
	assert(type(defaultProfile.EquippedSkins) == "table", "EquippedSkins should be a table")
	assert(defaultProfile.EquippedSkins["AssaultRifle"] == "DefaultSkin_AR", "EquippedSkins.AssaultRifle should match DefaultSkin_AR")
	assert(defaultProfile.SelectedOperative == "Vex", "SelectedOperative should default to Vex")

	assert(type(defaultProfile.MatchStats) == "table", "MatchStats should be a table")
	assert(defaultProfile.MatchStats.Kills == 0, "MatchStats.Kills should be 0")
	assert(defaultProfile.MatchStats.Deaths == 0, "MatchStats.Deaths should be 0")
	assert(defaultProfile.MatchStats.Wins == 0, "MatchStats.Wins should be 0")
	assert(defaultProfile.MatchStats.Losses == 0, "MatchStats.Losses should be 0")

	-- Test Backward Compatibility Fields
	assert(defaultProfile.level == 1, "legacy level alias should be 1")
	assert(defaultProfile.experience == 0, "legacy experience alias should be 0")
	assert(defaultProfile.currencies.credits == 500, "legacy currencies.credits should be 500")

	-- 6. Test Exponential Backoff Retry Math Calculation
	local baseDelay = 1
	local expectedDelays = { 1, 2, 4, 8, 16 }
	for attempt = 1, 5 do
		local calculatedDelay = math.min(16, baseDelay * math.pow(2, attempt - 1))
		assert(calculatedDelay == expectedDelays[attempt], string.format("Attempt %d backoff delay expected %d, got %d", attempt, expectedDelays[attempt], calculatedDelay))
	end

	-- 7. Test In-Memory Fallback Profile Creation &amp; Lifecycle
	local testUserId = 77777
	local fallbackProfile = ProfileServiceWrapper.CreateInMemoryFallback(testUserId, defaultProfile)

	assert(fallbackProfile ~= nil, "CreateInMemoryFallback should return profile instance")
	assert(fallbackProfile.UserId == testUserId, "Fallback profile UserId should match")
	assert(fallbackProfile:IsActive() == true, "Fallback profile should be active initially")
	assert(fallbackProfile.Data.Level == 1, "Fallback profile Data.Level should be 1")
	assert(fallbackProfile.Data.Credits == 500, "Fallback profile Data.Credits should be 500")

	local saveResult = fallbackProfile:SaveAsync()
	assert(saveResult == true, "SaveAsync on fallback profile should return true")

	fallbackProfile:ReleaseAsync()
	assert(fallbackProfile:IsActive() == false, "ReleaseAsync should set profile IsActive to false")

	print("[ProfileServiceWrapper.spec] All unit tests passed successfully!")
	return true
end

-- Execute tests in standalone mode
runTests()

-- Return TestEZ runner compatible function
return function()
	describe("ProfileServiceWrapper", function()
		it("should pass all ProfileServiceWrapper unit tests", function()
			expect(runTests()).to.equal(true)
		end)
	end)
end
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX73"><Properties><string name="Name">QueueMatchmakingService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK v2: QueueMatchmakingService
    Server-side service managing 1v1 (2 players) and 2v2 (4 players) matchmaking queues,
    player pairing logic, 5-map voting tallying, spawn point allocation, and match session initialization.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local QueueEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("QueueEvents") :: any)
local SpawnService = require(script.Parent:WaitForChild("SpawnService") :: any)

export type QueueMode = QueueEvents.QueueMode

export type QueueEntry = {
	player: Player,
	userId: number,
	joinTime: number,
	mode: QueueMode,
}

export type MatchPlayer = {
	player: Player,
	userId: number,
	username: string,
	displayName: string,
	teamId: number,
	spawnPosition: Vector3,
}

export type MatchSession = {
	matchId: string,
	mode: QueueMode,
	team1: { MatchPlayer },
	team2: { MatchPlayer },
	allPlayers: { [number]: MatchPlayer },
	votes: { [number]: string }, -- userId -&gt; mapName
	mapTallies: { [string]: number },
	selectedMap: string?,
	status: "Voting" | "Starting" | "InGame" | "Ended",
	votingEndTime: number,
	creationTime: number,
}

local ALLOWED_MAPS: { string } = {
	"GreyboxArena",
	"CyberCity",
	"DesertOutpost",
	"NeonSubway",
	"Hangar18",
}

local VOTING_DURATION_SECONDS = 10
local QUEUE_PROCESS_INTERVAL = 1.0

local queues: { [QueueMode]: { QueueEntry } } = {
	["1v1"] = {},
	["2v2"] = {},
}

local playerQueueState: { [number]: QueueMode } = {}
local playerQueueJoinTime: { [number]: number } = {}
local activeMatchSessions: { [string]: MatchSession } = {}
local playerActiveMatch: { [number]: string } = {}
local processingQueue: { [number]: boolean } = {}

local isInitialized = false

local QueueMatchmakingService = {}

local function isMapAllowed(mapName: string): boolean
	for _, allowed in ipairs(ALLOWED_MAPS) do
		if allowed == mapName then
			return true
		end
	end
	return false
end

local function generateMatchId(mode: QueueMode): string
	return "MATCH_" .. mode .. "_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
end

local function notifyQueueStatus(player: Player)
	local userId = player.UserId
	local mode = playerQueueState[userId]
	local inQueue = mode ~= nil
	local queueTime = 0
	local queueLen = 0

	if inQueue and mode then
		queueTime = os.time() - (playerQueueJoinTime[userId] or os.time())
		queueLen = #queues[mode]
	end

	local statusEvent = QueueEvents.GetRemoteEvent("QueueStatusUpdate")
	local payload: QueueEvents.QueueStatusData = {
		inQueue = inQueue,
		mode = mode,
		queueTimeSeconds = queueTime,
		playersInQueue = queueLen,
	}
	statusEvent:FireClient(player, payload)
end

--- Adds a player to the specified queue mode (1v1 or 2v2).
function QueueMatchmakingService.EnterQueue(player: Player, mode: QueueMode): (boolean, string)
	local userId = player.UserId

	if processingQueue[userId] then return false, "Processing" end
	processingQueue[userId] = true

	if mode ~= "1v1" and mode ~= "2v2" then
		processingQueue[userId] = nil
		return false, "Invalid queue mode specified"
	end

	if playerActiveMatch[userId] then
		processingQueue[userId] = nil
		return false, "Player is currently in an active match"
	end

	if playerQueueState[userId] then
		if playerQueueState[userId] == mode then
			processingQueue[userId] = nil
			return false, "Player is already in this queue"
		else
			processingQueue[userId] = nil
			QueueMatchmakingService.LeaveQueue(player)
			processingQueue[userId] = true
		end
	end

	local entry: QueueEntry = {
		player = player,
		userId = userId,
		joinTime = os.time(),
		mode = mode,
	}

	table.insert(queues[mode], entry)
	playerQueueState[userId] = mode
	playerQueueJoinTime[userId] = entry.joinTime

	notifyQueueStatus(player)
	processingQueue[userId] = nil
	return true, "Enqueued successfully"
end

--- Removes a player from their active queue.
function QueueMatchmakingService.LeaveQueue(player: Player): (boolean, string)
	local userId = player.UserId

	if processingQueue[userId] then return false, "Processing" end
	processingQueue[userId] = true

	local mode = playerQueueState[userId]

	if not mode then
		processingQueue[userId] = nil
		return false, "Player is not in any queue"
	end

	local targetQueue = queues[mode]
	if targetQueue then
		for idx, entry in ipairs(targetQueue) do
			if entry.userId == userId then
				table.remove(targetQueue, idx)
				break
			end
		end
	end

	playerQueueState[userId] = nil
	playerQueueJoinTime[userId] = nil

	notifyQueueStatus(player)
	processingQueue[userId] = nil
	return true, "Left queue successfully"
end

local function computeSpawnPosition(teamId: number, memberIndex: number): Vector3
	local basePos: Vector3
	if teamId == 1 then
		basePos = Vector3.new(-40, 105, (memberIndex - 1) * 6)
	else
		basePos = Vector3.new(40, 105, (memberIndex - 1) * 6)
	end

	local spawnFolder = Workspace:FindFirstChild("Spawns") or Workspace:FindFirstChild("SpawnLocations")
	if spawnFolder then
		local teamFolderName = "Team" .. tostring(teamId)
		local teamSpawnDir = spawnFolder:FindFirstChild(teamFolderName)
		if teamSpawnDir then
			local spawns = teamSpawnDir:GetChildren()
			if #spawns &gt;= memberIndex then
				local targetSpawn = spawns[memberIndex]
				if targetSpawn:IsA("BasePart") then
					return targetSpawn.Position + Vector3.new(0, 3, 0)
				end
			end
		end
	end

	return basePos
end

local function finalizeMapVoting(matchId: string)
	local session = activeMatchSessions[matchId]
	if not session or session.status ~= "Voting" then
		return
	end

	session.status = "Starting"

	local highestVotes = -1
	local winningMap = ALLOWED_MAPS[1]
	local candidateMaps: { string } = {}

	for _, mapName in ipairs(ALLOWED_MAPS) do
		local count = session.mapTallies[mapName] or 0
		if count &gt; highestVotes then
			highestVotes = count
			candidateMaps = { mapName }
		elseif count == highestVotes then
			table.insert(candidateMaps, mapName)
		end
	end

	if #candidateMaps &gt; 0 then
		winningMap = candidateMaps[math.random(1, #candidateMaps)]
	end

	session.selectedMap = winningMap

	local voteUpdateRemote = QueueEvents.GetRemoteEvent("MapVoteUpdate")
	local voteResult: QueueEvents.MapVoteResult = {
		matchId = matchId,
		mapVotes = session.mapTallies,
		winningMap = winningMap,
		votingEnded = true,
	}

	for _, matchPlayer in pairs(session.allPlayers) do
		if matchPlayer.player and matchPlayer.player:IsDescendantOf(Players) then
			voteUpdateRemote:FireClient(matchPlayer.player, voteResult)
		end
	end

	task.delay(2.0, function()
		QueueMatchmakingService.StartMatchSession(matchId)
	end)
end

--- Submits a vote for a map during the match session voting phase.
function QueueMatchmakingService.SubmitMapVote(player: Player, matchId: string, mapName: string): (boolean, string)
	local userId = player.UserId
	local session = activeMatchSessions[matchId]

	if not session then
		return false, "Match session not found"
	end

	if session.status ~= "Voting" then
		return false, "Map voting is no longer active for this match"
	end

	if not session.allPlayers[userId] then
		return false, "Player is not part of this match session"
	end

	if not isMapAllowed(mapName) then
		return false, "Invalid map name specified"
	end

	local previousVote = session.votes[userId]
	if previousVote then
		if session.mapTallies[previousVote] then
			session.mapTallies[previousVote] = math.max(0, session.mapTallies[previousVote] - 1)
		end
	end

	session.votes[userId] = mapName
	session.mapTallies[mapName] = (session.mapTallies[mapName] or 0) + 1

	local voteUpdateRemote = QueueEvents.GetRemoteEvent("MapVoteUpdate")
	local voteResult: QueueEvents.MapVoteResult = {
		matchId = matchId,
		mapVotes = session.mapTallies,
		winningMap = nil,
		votingEnded = false,
	}

	for _, matchPlayer in pairs(session.allPlayers) do
		if matchPlayer.player and matchPlayer.player:IsDescendantOf(Players) then
			voteUpdateRemote:FireClient(matchPlayer.player, voteResult)
		end
	end

	local totalVotes = 0
	for _, _ in pairs(session.votes) do
		totalVotes += 1
	end

	local requiredVotes = 0
	for _, _ in pairs(session.allPlayers) do
		requiredVotes += 1
	end

	if totalVotes &gt;= requiredVotes then
		finalizeMapVoting(matchId)
	end

	return true, "Vote recorded successfully"
end

local function initializeMatchSession(mode: QueueMode, matchedEntries: { QueueEntry })
	local matchId = generateMatchId(mode)
	local team1: { MatchPlayer } = {}
	local team2: { MatchPlayer } = {}
	local allPlayers: { [number]: MatchPlayer } = {}

	local halfCount = math.floor(#matchedEntries / 2)

	for idx, entry in ipairs(matchedEntries) do
		local teamId = idx &lt;= halfCount and 1 or 2
		local memberIdx = teamId == 1 and idx or (idx - halfCount)
		local spawnPos = computeSpawnPosition(teamId, memberIdx)

		local matchPlayer: MatchPlayer = {
			player = entry.player,
			userId = entry.userId,
			username = entry.player.Name,
			displayName = entry.player.DisplayName,
			teamId = teamId,
			spawnPosition = spawnPos,
		}

		if teamId == 1 then
			table.insert(team1, matchPlayer)
		else
			table.insert(team2, matchPlayer)
		end

		allPlayers[entry.userId] = matchPlayer
		playerActiveMatch[entry.userId] = matchId
		playerQueueState[entry.userId] = nil
		playerQueueJoinTime[entry.userId] = nil
	end

	local initialTallies: { [string]: number } = {}
	for _, mapName in ipairs(ALLOWED_MAPS) do
		initialTallies[mapName] = 0
	end

	local session: MatchSession = {
		matchId = matchId,
		mode = mode,
		team1 = team1,
		team2 = team2,
		allPlayers = allPlayers,
		votes = {},
		mapTallies = initialTallies,
		selectedMap = nil,
		status = "Voting",
		votingEndTime = os.time() + VOTING_DURATION_SECONDS,
		creationTime = os.time(),
	}

	activeMatchSessions[matchId] = session

	local matchFoundRemote = QueueEvents.GetRemoteEvent("QueueMatchFound")

	for _, matchPlayer in pairs(allPlayers) do
		local teammatesInfo: { QueueEvents.PlayerInfo } = {}
		local opponentsInfo: { QueueEvents.PlayerInfo } = {}

		local myTeam = matchPlayer.teamId == 1 and team1 or team2
		local oppTeam = matchPlayer.teamId == 1 and team2 or team1

		for _, tm in ipairs(myTeam) do
			table.insert(teammatesInfo, {
				userId = tm.userId,
				username = tm.username,
				displayName = tm.displayName,
			})
		end

		for _, op in ipairs(oppTeam) do
			table.insert(opponentsInfo, {
				userId = op.userId,
				username = op.username,
				displayName = op.displayName,
			})
		end

		local matchPayload: QueueEvents.MatchFoundData = {
			matchId = matchId,
			mode = mode,
			teamId = matchPlayer.teamId,
			teammates = teammatesInfo,
			opponents = opponentsInfo,
			votingDurationSeconds = VOTING_DURATION_SECONDS,
			availableMaps = ALLOWED_MAPS,
		}

		if matchPlayer.player and matchPlayer.player:IsDescendantOf(Players) then
			matchFoundRemote:FireClient(matchPlayer.player, matchPayload)
		end
	end

	task.delay(VOTING_DURATION_SECONDS, function()
		if activeMatchSessions[matchId] and activeMatchSessions[matchId].status == "Voting" then
			finalizeMapVoting(matchId)
		end
	end)
end

--- Teleports match participants to arena spawn positions and initializes match play.
function QueueMatchmakingService.StartMatchSession(matchId: string)
	local session = activeMatchSessions[matchId]
	if not session then
		return
	end

	session.status = "InGame"

	local team1Players: { Player } = {}
	local team2Players: { Player } = {}

	for _, mp in ipairs(session.team1) do
		if mp.player and mp.player:IsDescendantOf(Players) then
			table.insert(team1Players, mp.player)
		end
	end
	for _, mp in ipairs(session.team2) do
		if mp.player and mp.player:IsDescendantOf(Players) then
			table.insert(team2Players, mp.player)
		end
	end

	for _, matchPlayer in pairs(session.allPlayers) do
		local player = matchPlayer.player
		if player and player:IsDescendantOf(Players) then
			local spawnCFrame = CFrame.new(matchPlayer.spawnPosition)
			local ok = pcall(function()
				return SpawnService.SpawnPlayer(player, "Match", spawnCFrame)
			end)
			if not ok then
				pcall(function()
					if SpawnService.TeleportCharacter(player, spawnCFrame) then
						SpawnService.SetPlayerLocation(player, "Match")
					end
				end)
			end
		end
	end

	-- Initialize state machine via RoundService
	local servicesFolder = ServerScriptService:FindFirstChild("Services")
	if servicesFolder then
		local rsMod = servicesFolder:FindFirstChild("RoundService")
		if rsMod then
			local RoundService = require(rsMod :: any)
			RoundService.StartMatch(matchId, session.mode, team1Players, team2Players)
		end
	end
end

local function processQueuePairings()
	-- 1v1 Queue: requires 2 players
	local queue1v1 = queues["1v1"]
	while #queue1v1 &gt;= 2 do
		local candidate1 = table.remove(queue1v1, 1)
		local candidate2 = table.remove(queue1v1, 1)

		if candidate1 and candidate2 and candidate1.player:IsDescendantOf(Players) and candidate2.player:IsDescendantOf(Players) then
			initializeMatchSession("1v1", { candidate1, candidate2 })
		else
			if candidate1 and candidate1.player:IsDescendantOf(Players) then
				table.insert(queue1v1, 1, candidate1)
			end
			if candidate2 and candidate2.player:IsDescendantOf(Players) then
				table.insert(queue1v1, 1, candidate2)
			end
			break
		end
	end

	-- 2v2 Queue: requires 4 players
	local queue2v2 = queues["2v2"]
	while #queue2v2 &gt;= 4 do
		local validGroup: { QueueEntry } = {}
		local removeIndices: { number } = {}

		for idx, entry in ipairs(queue2v2) do
			if entry.player:IsDescendantOf(Players) then
				table.insert(validGroup, entry)
				table.insert(removeIndices, idx)
				if #validGroup == 4 then
					break
				end
			end
		end

		if #validGroup == 4 then
			for i = #removeIndices, 1, -1 do
				table.remove(queue2v2, removeIndices[i])
			end
			initializeMatchSession("2v2", validGroup)
		else
			break
		end
	end

	-- Periodically update queue timer status for all players in queue
	for modeName, modeQueue in pairs(queues) do
		for _, entry in ipairs(modeQueue) do
			if entry.player and entry.player:IsDescendantOf(Players) then
				notifyQueueStatus(entry.player)
			end
		end
	end
end

local function onPlayerRemoving(player: Player)
	local userId = player.UserId

	QueueMatchmakingService.LeaveQueue(player)

	local matchId = playerActiveMatch[userId]
	if matchId then
		playerActiveMatch[userId] = nil
		local session = activeMatchSessions[matchId]
		if session then
			session.allPlayers[userId] = nil

			local remainingCount = 0
			for _, _ in pairs(session.allPlayers) do
				remainingCount += 1
			end

			if remainingCount == 0 then
				activeMatchSessions[matchId] = nil
			else
				if session.status == "Voting" then
					local totalVotes = 0
					for _, _ in pairs(session.votes) do
						totalVotes += 1
					end
					if totalVotes &gt;= remainingCount then
						finalizeMapVoting(matchId)
					end
				end
			end
		end
	end
end

--- Initializes QueueMatchmakingService, binding Remote Functions &amp; Events.
function QueueMatchmakingService.Initialize()
	if isInitialized then
		return
	end
	isInitialized = true

	QueueEvents.Initialize()

	local enterFn = QueueEvents.GetRemoteFunction("QueueEnter")
	enterFn.OnServerInvoke = function(player: Player, mode: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return false, "Invalid player"
		end
		if typeof(mode) ~= "string" or (mode ~= "1v1" and mode ~= "2v2") then
			return false, "Invalid queue mode specified"
		end
		if playerActiveMatch[player.UserId] ~= nil then
			return false, "Player is currently in an active match"
		end
		return QueueMatchmakingService.EnterQueue(player, mode :: QueueMode)
	end

	local leaveFn = QueueEvents.GetRemoteFunction("QueueLeave")
	leaveFn.OnServerInvoke = function(player: Player)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return false, "Invalid player"
		end
		return QueueMatchmakingService.LeaveQueue(player)
	end

	local voteFn = QueueEvents.GetRemoteFunction("MapVoteSubmit")
	voteFn.OnServerInvoke = function(player: Player, matchId: any, mapName: any)
		if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
			return false, "Invalid player"
		end
		if typeof(matchId) ~= "string" or #matchId == 0 or #matchId &gt; 100 then
			return false, "Invalid match ID"
		end
		if typeof(mapName) ~= "string" or not isMapAllowed(mapName) then
			return false, "Invalid map name specified"
		end

		local session = activeMatchSessions[matchId]
		if not session or session.status ~= "Voting" then
			return false, "Map voting is no longer active for this match"
		end
		if not session.allPlayers[player.UserId] then
			return false, "Player is not part of this match session"
		end

		return QueueMatchmakingService.SubmitMapVote(player, matchId, mapName)
	end

	Players.PlayerRemoving:Connect(onPlayerRemoving)

	task.spawn(function()
		while true do
			task.wait(QUEUE_PROCESS_INTERVAL)
			processQueuePairings()
		end
	end)
end

function QueueMatchmakingService.GetQueueLength(mode: QueueMode): number
	return #queues[mode]
end

function QueueMatchmakingService.GetActiveSessions(): { [string]: MatchSession }
	return activeMatchSessions
end

return QueueMatchmakingService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX74"><Properties><string name="Name">QueueService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: QueueService
    Service wrapper delegating to QueueMatchmakingService.
]=]

local QueueMatchmakingService = require(script.Parent:WaitForChild("QueueMatchmakingService") :: any)

local QueueService = {}

function QueueService.Initialize()
	QueueMatchmakingService.Initialize()
end

function QueueService.EnterQueue(player: Player, mode: string)
	QueueMatchmakingService.EnterQueue(player, mode)
end

function QueueService.LeaveQueue(player: Player)
	QueueMatchmakingService.LeaveQueue(player)
end

function QueueService.GetQueueStatus(player: Player)
	return QueueMatchmakingService.GetQueueStatus(player)
end

return QueueService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX75"><Properties><string name="Name">ReceiptProcessor</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: ReceiptProcessor
    Handles Developer Product purchases via MarketplaceService.ProcessReceipt with:
    - Player presence verification.
    - Idempotency via atomic DataStore checking of `UserId_PurchaseId` hash.
    - Strict return of ProductPurchaseDecision (PurchaseGranted vs NotProcessedYet).
]=]

local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local PURCHASE_DATASTORE_NAME = "PurchaseHistory_v1"

export type ReceiptInfo = {
	PlayerId: number,
	PlaceIdWherePurchased: number,
	PurchaseId: string,
	ProductId: number,
	CurrencySpent: number,
	CurrencyType: Enum.CurrencyType,
}

export type PurchaseRecord = {
	Granted: boolean,
	UserId: number,
	ProductId: number,
	PurchaseId: string,
	Timestamp: number,
	CurrencySpent: number,
}

export type ProductHandler = (player: Player, receiptInfo: ReceiptInfo) -&gt; boolean

local ReceiptProcessor = {}
ReceiptProcessor.__index = ReceiptProcessor

local purchaseDataStore: DataStore? = nil
local productHandlers: { [number]: ProductHandler } = {}
local defaultHandler: ProductHandler? = nil

local function getPurchaseDataStore(): DataStore
	if not purchaseDataStore then
		purchaseDataStore = DataStoreService:GetDataStore(PURCHASE_DATASTORE_NAME)
	end
	return purchaseDataStore :: DataStore
end

--[=[
    Registers a custom product grant handler for a specific ProductId.
]=]
function ReceiptProcessor.RegisterProductHandler(productId: number, handler: ProductHandler): ()
	productHandlers[productId] = handler
end

--[=[
    Sets a default product grant handler for unhandled product IDs.
]=]
function ReceiptProcessor.SetDefaultHandler(handler: ProductHandler): ()
	defaultHandler = handler
end

--[=[
    Default fallback grant handler if none registered for a specific ProductId.
    Integrates with player leaderstats or currency profile if present.
]=]
local function fallbackGrantHandler(player: Player, receiptInfo: ReceiptInfo): boolean
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local credits = leaderstats:FindFirstChild("Credits") or leaderstats:FindFirstChild("Gems")
		if credits and credits:IsA("IntValue") then
			credits.Value += math.floor(receiptInfo.CurrencySpent * 10)
			return true
		end
	end
	-- Default success to prevent blocking valid test purchases if no custom handler bound
	return true
end

--[=[
    Global ProcessReceipt Callback
    Verified player presence, enforces idempotency using DataStore UpdateAsync with
    UserId_PurchaseId hash key, and returns ProductPurchaseDecision.
]=]
function ReceiptProcessor.ProcessReceipt(receiptInfo: ReceiptInfo): Enum.ProductPurchaseDecision
	if typeof(receiptInfo) ~= "table" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if typeof(receiptInfo.PlayerId) ~= "number" or receiptInfo.PlayerId &lt;= 0 or receiptInfo.PlayerId ~= math.floor(receiptInfo.PlayerId) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if typeof(receiptInfo.PurchaseId) ~= "string" or #receiptInfo.PurchaseId == 0 or #receiptInfo.PurchaseId &gt; 200 then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if typeof(receiptInfo.ProductId) ~= "number" or receiptInfo.ProductId &lt;= 0 or receiptInfo.ProductId ~= math.floor(receiptInfo.ProductId) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if typeof(receiptInfo.CurrencySpent) ~= "number" or receiptInfo.CurrencySpent &lt; 0 or receiptInfo.CurrencySpent ~= receiptInfo.CurrencySpent then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- 1. Player Presence Verification
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player or not player:IsA("Player") then
		warn("[ReceiptProcessor] Player " .. tostring(receiptInfo.PlayerId) .. " is not present on server. Deferring purchase processing.")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- 2. Idempotency Key Formulation: `UserId_PurchaseId`
	local purchaseKey = string.format("%d_%s", receiptInfo.PlayerId, receiptInfo.PurchaseId)
	local store = getPurchaseDataStore()
	local purchaseGrantedSuccessfully = false

	-- 3. Atomic DataStore Check &amp; Process
	local alreadyGranted = false
	local storeOk = pcall(function()
		store:UpdateAsync(purchaseKey, function(existingRecord: any)
			if existingRecord ~= nil then
				local record = existingRecord :: PurchaseRecord
				if record.Granted == true then
					alreadyGranted = true
					return existingRecord
				end
			end

			-- Mark as granted atomically in DataStore BEFORE granting item in session
			local newRecord: PurchaseRecord = {
				Granted = true,
				UserId = receiptInfo.PlayerId,
				ProductId = receiptInfo.ProductId,
				PurchaseId = receiptInfo.PurchaseId,
				Timestamp = os.time(),
				CurrencySpent = receiptInfo.CurrencySpent,
			}
			return newRecord
		end)
	end)

	if alreadyGranted then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	if not storeOk then
		-- DataStore failed/throttled; defer so Roblox retries safely without duplicate grant
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Execute handler now that record is safely marked
	local handler = productHandlers[receiptInfo.ProductId] or defaultHandler or fallbackGrantHandler
	local grantOk = handler(player, receiptInfo)
	if not grantOk then
		-- Handler failed; clear key so it can be retried
		pcall(function() store:RemoveAsync(purchaseKey) end)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

--[=[
    Initializes ReceiptProcessor and binds callback to MarketplaceService.
]=]
function ReceiptProcessor.Init(): ()
	MarketplaceService.ProcessReceipt = function(receiptInfo)
		return ReceiptProcessor.ProcessReceipt(receiptInfo :: ReceiptInfo)
	end
end

return ReceiptProcessor
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX76"><Properties><string name="Name">ReceiptProcessor.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
-- Test EZ / Unit Test specification for ReceiptProcessor

local ReceiptProcessor = require(script.Parent.ReceiptProcessor)

return function()
	describe("ReceiptProcessor", function()
		it("should defer processing if player is not online", function()
			local dummyReceipt = {
				PlayerId = 99999999,
				PlaceIdWherePurchased = 123456,
				PurchaseId = "test_purchase_id_123",
				ProductId = 5555,
				CurrencySpent = 100,
				CurrencyType = Enum.CurrencyType.Robux,
			}

			local result = ReceiptProcessor.ProcessReceipt(dummyReceipt)
			expect(result).to.equal(Enum.ProductPurchaseDecision.NotProcessedYet)
		end)
	end)
end
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX77"><Properties><string name="Name">RoundService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: RoundService
    Server state machine for 1v1 and 2v2 competitive PvP matches.
    Phases: Buy Phase (15s) -&gt; Live Phase (60s) -&gt; RoundEnd Phase (5s) -&gt; Intermission Phase (3s).
    Rules: First to 7 rounds wins; sudden-death round at 6-6 tie (5000 credits).
    Features: spectate on death (suppressing mid-round respawn), character reset, team elimination detection.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local NetworkFolder = ReplicatedStorage:WaitForChild("Network")
local RemoteEvents = require(NetworkFolder:WaitForChild("RemoteEvents") :: any)

local EconomyService = require(script.Parent:WaitForChild("EconomyService") :: any)
local SpawnService = require(script.Parent:WaitForChild("SpawnService") :: any)
local DynamicSpawnService = require(script.Parent:WaitForChild("DynamicSpawnService") :: any)

export type RoundPhase = "Buy" | "Live" | "RoundEnd" | "Intermission" | "Ended"
export type QueueMode = "1v1" | "2v2"
export type TeamId = number

export type RoundPlayerData = {
	player: Player,
	userId: number,
	teamId: TeamId,
	isAlive: boolean,
}

export type MatchState = {
	matchId: string,
	mode: QueueMode,
	currentRound: number,
	team1Score: number,
	team2Score: number,
	team1LossStreak: number,
	team2LossStreak: number,
	phase: RoundPhase,
	timeRemaining: number,
	isSuddenDeath: boolean,
	winningTeam: TeamId?,
	team1Players: { RoundPlayerData },
	team2Players: { RoundPlayerData },
	allPlayers: { Player },
	playerLookup: { [number]: RoundPlayerData },
	activeThread: thread?,
	isMatchOver: boolean,
}

local RoundService = {}

-- Key Constants
RoundService.BUY_PHASE_DURATION = 15
RoundService.LIVE_PHASE_DURATION = 60
RoundService.ROUND_END_DURATION = 5
RoundService.INTERMISSION_DURATION = 3
RoundService.TARGET_SCORE = 7
RoundService.SUDDEN_DEATH_TIE_SCORE = 6

-- Active matches dictionary (matchId -&gt; MatchState)
local activeMatches: { [string]: MatchState } = {}
-- Player to Match mapping (userId -&gt; matchId)
local playerMatchMap: { [number]: string } = {}

-- External references
local _combatServerRef: any = nil
local _directChallengeServiceRef: any = nil

local function getDirectChallengeService()
	if not _directChallengeServiceRef then
		local servicesFolder = ServerScriptService:FindFirstChild("Services")
		if servicesFolder then
			local dcs = servicesFolder:FindFirstChild("DirectChallengeService")
			if dcs then
				_directChallengeServiceRef = require(dcs :: any)
			end
		end
	end
	return _directChallengeServiceRef
end

--- Sets CombatServer reference
function RoundService.SetCombatServer(combatServer: any)
	_combatServerRef = combatServer
end

--- Gets active match by matchId
function RoundService.GetMatch(matchId: string): MatchState?
	return activeMatches[matchId]
end

--- Gets active match for a given player
function RoundService.GetPlayerMatch(player: Player): MatchState?
	local matchId = playerMatchMap[player.UserId]
	if matchId then
		return activeMatches[matchId]
	end
	return nil
end

--- Gets current phase for a given player
function RoundService.GetPlayerPhase(player: Player): RoundPhase?
	local match = RoundService.GetPlayerMatch(player)
	if match then
		return match.phase
	end
	return nil
end

--- Returns whether player is currently in an active round match
function RoundService.IsPlayerInActiveMatch(player: Player): boolean
	local match = RoundService.GetPlayerMatch(player)
	return match ~= nil and not match.isMatchOver
end

--- Computes dynamic spawn position to prevent spawn-camping
local function computeSpawnPosition(match: MatchState, teamId: TeamId, index: number): Vector3
	local candidateSpawns = {
		CFrame.new(-60 + (index - 1) * 6, 105, (index - 1) * 3),
		CFrame.new(-40, 105, 40),
		CFrame.new(60 + (index - 1) * 6, 105, (index - 1) * 3),
		CFrame.new(40, 105, -40),
		CFrame.new(0, 105, 80),
		CFrame.new(0, 105, -80),
	}

	-- Identify enemies for dynamic spawn avoidance
	local enemies = {}
	for _, pData in pairs(match.team1Players) do
		if pData.teamId ~= teamId and pData.isAlive and pData.player.Character then
			table.insert(enemies, pData.player)
		end
	end
	for _, pData in pairs(match.team2Players) do
		if pData.teamId ~= teamId and pData.isAlive and pData.player.Character then
			table.insert(enemies, pData.player)
		end
	end

	local optimalSpawnCFrame = DynamicSpawnService.GetOptimalSpawn(candidateSpawns, enemies)
	return optimalSpawnCFrame.Position
end

--- Broadcasts round state update to clients in match
function RoundService.BroadcastState(match: MatchState)
	local payload = {
		matchId = match.matchId,
		phase = match.phase,
		timeRemaining = match.timeRemaining,
		currentRound = match.currentRound,
		team1Score = match.team1Score,
		team2Score = match.team2Score,
		isSuddenDeath = match.isSuddenDeath,
		winningTeam = match.winningTeam,
	}

	pcall(function()
		local roundStateRemote = RemoteEvents.GetReliable("RoundStateChanged" :: any)
		if roundStateRemote then
			for _, player in match.allPlayers do
				if player and player.Parent then
					roundStateRemote:FireClient(player, payload)
				end
			end
		end
	end)
end

--- Teleports character to spawn and restores health/armor
local function resetPlayerCharacter(playerData: RoundPlayerData, index: number)
	local player = playerData.player
	if not player or not player.Parent then
		return
	end

	playerData.isAlive = true

	local spawnPos = computeSpawnPosition(match, playerData.teamId, index)
	local targetCFrame = CFrame.new(spawnPos)

	-- If character is missing or dead, spawn via SpawnService; otherwise teleport safely
	local char = player.Character
	if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health &lt;= 0 then
		SpawnService.SpawnPlayer(player, "Match", targetCFrame)
		char = player.Character
	else
		SpawnService.TeleportCharacter(player, targetCFrame)
		SpawnService.SetPlayerLocation(player, "Match")
	end

	if char then
		local hum = char:FindFirstChild("Humanoid") :: Humanoid?
		if hum then
			hum.Health = hum.MaxHealth
		end

		-- Clear temporary debuffs / status attributes
		char:SetAttribute("Stunned", nil)
		char:SetAttribute("SpeedMultiplier", nil)
	end

	-- Sync CombatServer health and shield
	if _combatServerRef then
		local armorVal = 0
		if char then
			armorVal = (char:GetAttribute("Armor") :: number) or 0
		end
		_combatServerRef:RegisterPlayer(player.UserId, 100, armorVal)
	end
end

--- Resets character positions, health, and status for all match players
function RoundService.ResetAllPlayers(match: MatchState)
	for idx, pData in match.team1Players do
		resetPlayerCharacter(pData, idx)
	end
	for idx, pData in match.team2Players do
		resetPlayerCharacter(pData, idx)
	end
end

--- Evaluates end of round (winner, score update, economy bonus, next round/match end)
function RoundService.EvaluateRoundEnd(match: MatchState, winningTeam: TeamId?)
	if match.phase == "RoundEnd" or match.phase == "Ended" or match.isMatchOver then
		return
	end

	match.phase = "RoundEnd"
	-- Lock in elimination immediately so Live loop breaks promptly
	if _combatServerRef then
		_combatServerRef:SetMatchPhase("Lobby")
	end
	match.timeRemaining = RoundService.ROUND_END_DURATION

	-- Determine winner if not passed explicitly
	if not winningTeam then
		-- Timer expired: compare remaining health
		local t1Health = 0
		local t2Health = 0

		if _combatServerRef then
			for _, pData in match.team1Players do
				if pData.isAlive then
					local st = _combatServerRef:GetPlayerHealth(pData.userId)
					t1Health += (st and st.health) or 100
				end
			end
			for _, pData in match.team2Players do
				if pData.isAlive then
					local st = _combatServerRef:GetPlayerHealth(pData.userId)
					t2Health += (st and st.health) or 100
				end
			end
		else
			for _, pData in match.team1Players do
				if pData.isAlive and pData.player.Character and pData.player.Character:FindFirstChild("Humanoid") then
					t1Health += pData.player.Character.Humanoid.Health
				end
			end
			for _, pData in match.team2Players do
				if pData.isAlive and pData.player.Character and pData.player.Character:FindFirstChild("Humanoid") then
					t2Health += pData.player.Character.Humanoid.Health
				end
			end
		end

		if t1Health &gt;= t2Health then
			winningTeam = 1
		else
			winningTeam = 2
		end
	end

	match.winningTeam = winningTeam

	-- Update Scores &amp; Loss Streaks
	local winnerPlayers: { Player } = {}
	local loserPlayers: { Player } = {}
	local loserStreak = 0

	if winningTeam == 1 then
		match.team1Score += 1
		match.team1LossStreak = 0
		match.team2LossStreak += 1
		loserStreak = match.team2LossStreak

		for _, pData in match.team1Players do
			table.insert(winnerPlayers, pData.player)
		end
		for _, pData in match.team2Players do
			table.insert(loserPlayers, pData.player)
		end
	else
		match.team2Score += 1
		match.team2LossStreak = 0
		match.team1LossStreak += 1
		loserStreak = match.team1LossStreak

		for _, pData in match.team2Players do
			table.insert(winnerPlayers, pData.player)
		end
		for _, pData in match.team1Players do
			table.insert(loserPlayers, pData.player)
		end
	end

	-- Process Economy Round End Bonuses
	EconomyService.ProcessRoundEnd(winnerPlayers, loserPlayers, loserStreak)

	-- Broadcast state update
	RoundService.BroadcastState(match)

	-- Check Match Completion
	if match.team1Score &gt;= RoundService.TARGET_SCORE or match.team2Score &gt;= RoundService.TARGET_SCORE then
		match.isMatchOver = true
		match.phase = "Ended"
		RoundService.BroadcastState(match)

		task.wait(RoundService.ROUND_END_DURATION)
		RoundService.EndMatch(match.matchId, winningTeam)
		return
	end

	-- Prepare for next round
	match.currentRound += 1
end

--- Checks and applies Sudden Death condition (6-6 tie score)
function RoundService.CheckSuddenDeath(match: MatchState): boolean
	if
		match.team1Score == RoundService.SUDDEN_DEATH_TIE_SCORE
		and match.team2Score == RoundService.SUDDEN_DEATH_TIE_SCORE
	then
		match.isSuddenDeath = true
		EconomyService.SetSuddenDeathCredits(match.allPlayers)
		return true
	else
		match.isSuddenDeath = false
		return false
	end
end

--- Starts a round lifecycle flow for a match
function RoundService.StartRound(match: MatchState)
	if match.isMatchOver then
		return
	end

	-- Check Sudden Death condition (6-6 tie score, Round 13)
	RoundService.CheckSuddenDeath(match)

	-- Reset characters, positions, health
	RoundService.ResetAllPlayers(match)

	-- 1. BUY PHASE (15s)
	match.phase = "Buy"
	if _combatServerRef then
		_combatServerRef:SetMatchPhase("Lobby")
	end
	match.timeRemaining = RoundService.BUY_PHASE_DURATION
	match.winningTeam = nil
	RoundService.BroadcastState(match)

	for t = RoundService.BUY_PHASE_DURATION, 1, -1 do
		if match.isMatchOver then
			return
		end
		match.timeRemaining = t
		task.wait(1)
	end

	if match.isMatchOver then
		return
	end

	-- 2. LIVE PHASE (60s)
	match.phase = "Live"
	if _combatServerRef then
		_combatServerRef:SetMatchPhase("InGame")
	end
	match.timeRemaining = RoundService.LIVE_PHASE_DURATION
	RoundService.BroadcastState(match)

	local liveTimerPassed = 0
	while liveTimerPassed &lt; RoundService.LIVE_PHASE_DURATION do
		if match.isMatchOver then
			return
		end
		if match.phase ~= "Live" then
			-- Mid-round elimination occurred!
			break
		end

		task.wait(1)
		liveTimerPassed += 1
		match.timeRemaining = RoundService.LIVE_PHASE_DURATION - liveTimerPassed

		if match.phase == "Live" then
			RoundService.BroadcastState(match)
		else
			break
		end
	end

	if match.isMatchOver then
		return
	end

	-- If Live phase completed without full elimination, evaluate winner by health
	if match.phase == "Live" then
		RoundService.EvaluateRoundEnd(match, nil)
	end

	if match.isMatchOver then
		return
	end

	-- 3. ROUND END PHASE DELAY (5s)
	-- EvaluateRoundEnd set match.phase = "RoundEnd"
	for t = RoundService.ROUND_END_DURATION, 1, -1 do
		if match.isMatchOver then
			return
		end
		match.timeRemaining = t
		RoundService.BroadcastState(match)
		task.wait(1)
	end

	if match.isMatchOver then
		return
	end

	-- 4. INTERMISSION PHASE (3s)
	match.phase = "Intermission"
	if _combatServerRef then
		_combatServerRef:SetMatchPhase("Lobby")
	end
	match.timeRemaining = RoundService.INTERMISSION_DURATION
	RoundService.BroadcastState(match)

	for t = RoundService.INTERMISSION_DURATION, 1, -1 do
		if match.isMatchOver then
			return
		end
		match.timeRemaining = t
		RoundService.BroadcastState(match)
		task.wait(1)
	end

	if match.isMatchOver then
		return
	end

	-- Next Round Loop — spawn new task to avoid stack growth
	if not match.isMatchOver then
		match.activeThread = task.spawn(function()
			RoundService.StartRound(match)
		end)
	end
end

--- Handles mid-round player death
function RoundService.OnPlayerDied(victimPlayer: Player, killerPlayer: Player?)
	local match = RoundService.GetPlayerMatch(victimPlayer)
	if not match or match.isMatchOver then
		return
	end

	-- Only process mid-round elimination during Live phase
	if match.phase ~= "Live" then
		return
	end

	local pData = match.playerLookup[victimPlayer.UserId]
	if pData then
		pData.isAlive = false
	end

	-- Award kill reward if killer is on opposing team
	if killerPlayer and killerPlayer ~= victimPlayer then
		local kData = match.playerLookup[killerPlayer.UserId]
		if kData and kData.teamId ~= (pData and pData.teamId or 0) then
			EconomyService.AwardKillReward(killerPlayer)
		end
	end

	-- Check team elimination
	local t1Alive = 0
	for _, p in match.team1Players do
		if p.isAlive then
			t1Alive += 1
		end
	end

	local t2Alive = 0
	for _, p in match.team2Players do
		if p.isAlive then
			t2Alive += 1
		end
	end

	if t1Alive == 0 and t2Alive &gt; 0 then
		-- Team 2 wins round
		RoundService.EvaluateRoundEnd(match, 2)
	elseif t2Alive == 0 and t1Alive &gt; 0 then
		-- Team 1 wins round
		RoundService.EvaluateRoundEnd(match, 1)
	elseif t1Alive == 0 and t2Alive == 0 then
		-- Draw / Team 1 default
		RoundService.EvaluateRoundEnd(match, 1)
	end
end

--- Initializes and starts a new match
function RoundService.StartMatch(matchId: string, mode: QueueMode, team1: { Player }, team2: { Player }): MatchState
	local team1Players: { RoundPlayerData } = {}
	local team2Players: { RoundPlayerData } = {}
	local allPlayers: { Player } = {}
	local playerLookup: { [number]: RoundPlayerData } = {}

	for _, p in team1 do
		local pData: RoundPlayerData = { player = p, userId = p.UserId, teamId = 1, isAlive = true }
		table.insert(team1Players, pData)
		table.insert(allPlayers, p)
		playerLookup[p.UserId] = pData
		playerMatchMap[p.UserId] = matchId

		EconomyService.InitializePlayer(p, EconomyService.PISTOL_ROUND_CREDITS)

		local dcs = getDirectChallengeService()
		if dcs then
			dcs.SetPlayerStatus(p, "In Match")
		end
	end

	for _, p in team2 do
		local pData: RoundPlayerData = { player = p, userId = p.UserId, teamId = 2, isAlive = true }
		table.insert(team2Players, pData)
		table.insert(allPlayers, p)
		playerLookup[p.UserId] = pData
		playerMatchMap[p.UserId] = matchId

		EconomyService.InitializePlayer(p, EconomyService.PISTOL_ROUND_CREDITS)

		local dcs = getDirectChallengeService()
		if dcs then
			dcs.SetPlayerStatus(p, "In Match")
		end
	end

	local match: MatchState = {
		matchId = matchId,
		mode = mode,
		currentRound = 1,
		team1Score = 0,
		team2Score = 0,
		team1LossStreak = 0,
		team2LossStreak = 0,
		phase = "Buy",
		timeRemaining = RoundService.BUY_PHASE_DURATION,
		isSuddenDeath = false,
		winningTeam = nil,
		team1Players = team1Players,
		team2Players = team2Players,
		allPlayers = allPlayers,
		playerLookup = playerLookup,
		isMatchOver = false,
	}

	activeMatches[matchId] = match

	-- Spawn match thread
	match.activeThread = task.spawn(function()
		RoundService.StartRound(match)
	end)

	return match
end

--- Concludes match and cleans up player statuses
function RoundService.EndMatch(matchId: string, winningTeam: TeamId?)
	local match = activeMatches[matchId]
	if not match then
		return
	end

	match.isMatchOver = true
	match.phase = "Ended"
	match.winningTeam = winningTeam
	RoundService.BroadcastState(match)
	if match.activeThread then
		pcall(task.cancel, match.activeThread)
		match.activeThread = nil
	end

	local dcs = getDirectChallengeService()

	for _, p in match.allPlayers do
		if p and p.Parent then
			playerMatchMap[p.UserId] = nil

			if dcs then
				dcs.SetPlayerStatus(p, "In Lobby")
			end

			-- Teleport back to Lobby — prevents stuck in arena
			pcall(function()
				SpawnService.SpawnPlayer(p, "Lobby")
				p:SetAttribute("IsPracticeRange", nil)
			end)

			pcall(function()
				local matchPhaseRemote = RemoteEvents.GetReliable("MatchPhaseTransition" :: any)
				if matchPhaseRemote then
					matchPhaseRemote:FireClient(p, {
						phase = "Lobby",
						matchId = matchId,
						winningTeam = winningTeam,
					})
				end
			end)
			-- Combat health reset is done by SpawnService + next match InitializePlayer
			if _combatServerRef then
				pcall(function()
					_combatServerRef:RegisterPlayer(p.UserId, 100, 0)
				end)
			end
		end
	end

	activeMatches[matchId] = nil
	print("[RoundService] Match " .. matchId .. " ended. Winner: Team " .. tostring(winningTeam))
end

--- Clean up player match mapping on player leave
function RoundService.OnPlayerRemoving(player: Player)
	local matchId = playerMatchMap[player.UserId]
	if matchId then
		playerMatchMap[player.UserId] = nil
		local match = activeMatches[matchId]
		if match then
			local pData = match.playerLookup[player.UserId]
			if pData and match.mode == "1v1" and not match.isMatchOver then
				local winningTeam = pData.teamId == 1 and 2 or 1
				RoundService.EndMatch(match.matchId, winningTeam)
			else
				RoundService.OnPlayerDied(player, nil)
			end
		end
	end
end

--- Initializes RoundService lifecycle listeners
function RoundService.Init(combatServerRef: any?)
	if combatServerRef then
		_combatServerRef = combatServerRef
	end

	Players.PlayerRemoving:Connect(function(player)
		RoundService.OnPlayerRemoving(player)
	end)

	print("[RoundService] Initialized successfully.")
end

return RoundService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX78"><Properties><string name="Name">RoundService.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for RoundService
    Validates round state machine phase transitions, match lifecycle (1v1 / 2v2),
    team elimination round end evaluation, loss streak updates, sudden-death handling (6-6 tie),
    and match completion rules (first to 7).
]=]

local ServerScriptService = game:GetService("ServerScriptService")
local RoundService = require(ServerScriptService:WaitForChild("Services"):WaitForChild("RoundService") :: any)
local EconomyService = require(ServerScriptService:WaitForChild("Services"):WaitForChild("EconomyService") :: any)

local function runTests()
	RoundService.Init()
	EconomyService.Init()

	local p1 = Instance.new("Player")
	p1.Name = "RSTestPlayer1"

	local p2 = Instance.new("Player")
	p2.Name = "RSTestPlayer2"

	-- 1. Test Key Phase Duration Constants
	assert(RoundService.BUY_PHASE_DURATION == 15, "BUY_PHASE_DURATION should be 15s")
	assert(RoundService.LIVE_PHASE_DURATION == 60, "LIVE_PHASE_DURATION should be 60s")
	assert(RoundService.ROUND_END_DURATION == 5, "ROUND_END_DURATION should be 5s")
	assert(RoundService.INTERMISSION_DURATION == 3, "INTERMISSION_DURATION should be 3s")
	assert(RoundService.TARGET_SCORE == 7, "TARGET_SCORE should be 7")
	assert(RoundService.SUDDEN_DEATH_TIE_SCORE == 6, "SUDDEN_DEATH_TIE_SCORE should be 6")

	-- 2. Test Match Initialization
	local matchId = "TestMatch_101"
	local match = RoundService.StartMatch(matchId, "1v1", { p1 }, { p2 })

	assert(match ~= nil, "Match object should be created")
	assert(match.matchId == matchId, "Match ID should match")
	assert(match.currentRound == 1, "Match current round should start at 1")
	assert(match.team1Score == 0, "Team 1 score should be 0")
	assert(match.team2Score == 0, "Team 2 score should be 0")
	assert(match.phase == "Buy", "Initial phase should be Buy")
	assert(match.isSuddenDeath == false, "Initial round should not be sudden death")

	-- Check starting credits (Pistol Round = 800)
	assert(EconomyService.GetCredits(p1) == 800, "P1 should start pistol round with 800 credits")
	assert(EconomyService.GetCredits(p2) == 800, "P2 should start pistol round with 800 credits")

	-- 3. Test Mid-Round Player Elimination &amp; Winner Evaluation
	match.phase = "Live"
	RoundService.OnPlayerDied(p2, p1) -- p2 killed by p1

	assert(match.team1Score == 1, "Team 1 score should be incremented to 1")
	assert(match.team2Score == 0, "Team 2 score should remain 0")
	assert(match.team1LossStreak == 0, "Team 1 loss streak should be reset to 0")
	assert(match.team2LossStreak == 1, "Team 2 loss streak should be incremented to 1")
	assert(match.winningTeam == 1, "Winning team should be 1")
	assert(EconomyService.GetCredits(p1) == 800 + 3000 + 200, "P1 should get 800 + 3000 (win) + 200 (kill) = 4000 credits")

	-- 4. Test Sudden Death Initialization via CheckSuddenDeath (6-6 Tie)
	match.team1Score = 6
	match.team2Score = 6
	match.isMatchOver = false
	match.phase = "Buy"

	local isSD = RoundService.CheckSuddenDeath(match)

	assert(isSD == true, "CheckSuddenDeath should return true for 6-6 tie")
	assert(match.isSuddenDeath == true, "6-6 tie should trigger sudden death state")
	assert(EconomyService.GetCredits(p1) == 5000, "Sudden death starting credits for p1 should be 5000")
	assert(EconomyService.GetCredits(p2) == 5000, "Sudden death starting credits for p2 should be 5000")

	-- 5. Test Match Completion (First to 7)
	match.team1Score = 6
	match.team2Score = 5
	match.phase = "Live"

	RoundService.EvaluateRoundEnd(match, 1) -- Team 1 wins 7th round

	assert(match.team1Score == 7, "Team 1 score should reach 7")
	assert(match.isMatchOver == true, "Match should be marked as over when target score reached")

	-- Cleanup
	p1:Destroy()
	p2:Destroy()

	print("[RoundService.spec] All unit tests passed successfully!")
	return true
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX79"><Properties><string name="Name">SocialInviteService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: SocialInviteService
    Handles rewarded viral game invites using SocialService:PromptGameInvite(),
    condensed launch data encoding (&lt;=200 chars), join data polling retry intercept (10 attempts, 1s interval),
    in-game teleportation to friends, and referral currency distribution.
]=]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local TeleportService = game:GetService("TeleportService")
local DataStoreService = game:GetService("DataStoreService")

local SocialInviteService = {}

local function getSpawnService(): any
	local servicesFolder = game:GetService("ServerScriptService"):FindFirstChild("Services")
	if servicesFolder then
		local ssMod = servicesFolder:FindFirstChild("SpawnService")
		if ssMod then
			return require(ssMod :: any)
		end
	end
	return nil
end

local function waitForCharacterWithTimeout(player: Player, timeout: number): Model?
    if player.Character then return player.Character end
    local char: Model? = nil
    local thread = coroutine.running()
    local conn: RBXScriptConnection
    conn = player.CharacterAdded:Connect(function(c)
        char = c
        conn:Disconnect()
        task.spawn(thread)
    end)
    local disconnectConn: RBXScriptConnection
    disconnectConn = game:GetService("Players").PlayerRemoving:Connect(function(p)
        if p == player then
            disconnectConn:Disconnect()
            conn:Disconnect()
            task.spawn(thread)
        end
    end)
    task.delay(timeout, function()
        conn:Disconnect()
        disconnectConn:Disconnect()
        task.spawn(thread)
    end)
    coroutine.yield()
    disconnectConn:Disconnect()
    return char
end

export type LaunchDataPayload = {
	inv: number, -- Inviter UserId
	t: number, -- Timestamp
	src: string?, -- Referral source tag
	[string]: any,
}

export type ReferralRewardCallback = (inviterUserId: number, invitedUserId: number, currencyAmount: number) -&gt; ()

local MAX_POLL_ATTEMPTS = 10
local POLL_INTERVAL_SECONDS = 1
local DEFAULT_REFERRAL_REWARD_AMOUNT = 100
local MAX_LAUNCH_DATA_LENGTH = 200

local _isTestMode: boolean = false
local _processedReferrals: { [string]: boolean } = {}
local _processedCount: number = 0
local _mockJoinData: { [Player]: string } = {}
local _rewardCallback: ReferralRewardCallback? = nil

function SocialInviteService.SetTestMode(enabled: boolean)
	_isTestMode = enabled
end

function SocialInviteService.SetReferralRewardCallback(callback: ReferralRewardCallback)
	_rewardCallback = callback
end

function SocialInviteService.EncodeLaunchData(data: { [string]: any }): string
	local jsonStr = HttpService:JSONEncode(data)
	if #jsonStr &gt; MAX_LAUNCH_DATA_LENGTH then
		warn("[SocialInviteService] LaunchData exceeds 200 character limit! Length: " .. tostring(#jsonStr))
	end
	return jsonStr
end

function SocialInviteService.DecodeLaunchData(launchDataStr: string): LaunchDataPayload?
	if not launchDataStr or launchDataStr == "" then
		return nil
	end

	local success, result = pcall(function()
		return HttpService:JSONDecode(launchDataStr)
	end)

	if success and typeof(result) == "table" then
		return result :: LaunchDataPayload
	else
		warn("[SocialInviteService] Failed to decode LaunchData: " .. tostring(launchDataStr))
		return nil
	end
end

function SocialInviteService.PromptGameInvite(player: Player, customLaunchData: { [string]: any }?): boolean
	local payload: LaunchDataPayload = {
		inv = player.UserId,
		t = os.time(),
		src = (customLaunchData and customLaunchData.src) or "viral_prompt",
	}

	if customLaunchData then
		for k, v in customLaunchData do
			if k ~= "inv" and k ~= "t" then
				payload[k] = v
			end
		end
	end

	local launchDataString = SocialInviteService.EncodeLaunchData(payload)

	if _isTestMode then
		return true
	end

	local options = Instance.new("ExperienceInviteOptions")
	options.LaunchData = launchDataString

	local success, err = pcall(function()
		SocialService:PromptGameInvite(player, options)
	end)

	if not success then
		warn("[SocialInviteService] PromptGameInvite error for player " .. player.Name .. ": " .. tostring(err))
		return false
	end

	return true
end

function SocialInviteService.InjectMockJoinData(player: Player, launchDataStr: string)
	_mockJoinData[player] = launchDataStr
end

local function teleportToInviter(joiningPlayer: Player, inviterPlayer: Player)
	local function doTeleport()
		local joiningChar = waitForCharacterWithTimeout(joiningPlayer, 10)
		local inviterChar = waitForCharacterWithTimeout(inviterPlayer, 10)

		if joiningChar and inviterChar then
			local inviterRoot = inviterChar:FindFirstChild("HumanoidRootPart") :: BasePart?
			if inviterRoot then
				local targetCFrame = inviterRoot.CFrame * CFrame.new(3, 0, 3)
				local ss = getSpawnService()
				if ss then
					ss.TeleportCharacter(joiningPlayer, targetCFrame)
				else
					warn("[SocialInviteService] SpawnService not available for teleport.")
				end
			end
		end
	end

	task.spawn(function()
		pcall(doTeleport)
	end)
end

function SocialInviteService.TeleportPlayerToFriendInstance(player: Player, placeId: number, instanceId: string): boolean
	if _isTestMode then
		return true
	end

	local success, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(placeId, instanceId, player)
	end)

	if not success then
		warn("[SocialInviteService] TeleportToPlaceInstance failed: " .. tostring(err))
		return false
	end

	return true
end

function SocialInviteService.ProcessPlayerJoin(player: Player): boolean
	local rawLaunchData: string? = nil

	if _mockJoinData[player] then
		rawLaunchData = _mockJoinData[player]
	else
		-- Polling retry loop: up to 10 attempts with 1s interval
		for attempt = 1, MAX_POLL_ATTEMPTS do
			local joinDataSuccess, joinData = pcall(function()
				return player:GetJoinData()
			end)

			if joinDataSuccess and joinData and joinData.LaunchData and joinData.LaunchData ~= "" then
				rawLaunchData = joinData.LaunchData
				break
			end

			if attempt &lt; MAX_POLL_ATTEMPTS then
				task.wait(POLL_INTERVAL_SECONDS)
			end
		end
	end

	if not rawLaunchData then
		return false
	end

	local decoded = SocialInviteService.DecodeLaunchData(rawLaunchData)
	if not decoded or not decoded.inv or typeof(decoded.inv) ~= "number" then
		return false
	end

	local inviterUserId = decoded.inv
	if inviterUserId == player.UserId then
		warn("[SocialInviteService] Ignored self-referral attempt from UserId: " .. tostring(player.UserId))
		return false
	end

	local pairKey = tostring(inviterUserId) .. "_" .. tostring(player.UserId)
	if _processedReferrals[pairKey] then
		return false
	end

	-- NOTE: Referrals should be persisted via ProfileService for a robust implementation.
	-- Quick fix: use a dedicated "ProcessedReferrals" DataStore.
	local dsSuccess, hasReferred = pcall(function()
		return DataStoreService:GetDataStore("ProcessedReferrals"):GetAsync(pairKey)
	end)
	if dsSuccess and hasReferred then
		return false
	end

	_processedReferrals[pairKey] = true
	pcall(function()
		DataStoreService:GetDataStore("ProcessedReferrals"):SetAsync(pairKey, true)
	end)
	
	_processedCount += 1

	-- Award referral reward currency
	if _rewardCallback then
		pcall(function()
			_rewardCallback(inviterUserId, player.UserId, DEFAULT_REFERRAL_REWARD_AMOUNT)
		end)
	end

	-- Teleport joining player to friend if in same server
	local inviterPlayer = Players:GetPlayerByUserId(inviterUserId)
	if inviterPlayer then
		teleportToInviter(player, inviterPlayer)
	end

	return true
end

function SocialInviteService.GetProcessedCount(): number
	return _processedCount
end

function SocialInviteService.ResetState()
	table.clear(_processedReferrals)
	table.clear(_mockJoinData)
	_processedCount = 0
	_rewardCallback = nil
	_isTestMode = false
end

function SocialInviteService.Init()
	Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(function()
			SocialInviteService.ProcessPlayerJoin(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		_mockJoinData[player] = nil
	end)
end

return SocialInviteService
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX80"><Properties><string name="Name">SocialInviteService.spec</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Unit Tests for SocialInviteService
]=]

local ServerScriptService = game:GetService("ServerScriptService")
local SocialInviteService = require(ServerScriptService:WaitForChild("Services"):WaitForChild("SocialInviteService"))

local function runTests()
	SocialInviteService.ResetState()
	SocialInviteService.SetTestMode(true)

	-- 1. Test Launch Data Encoding &amp; Decoding
	local testPayload = {
		inv = 12345678,
		t = 1722600000,
		src = "viral_invite_test",
	}

	local encodedStr = SocialInviteService.EncodeLaunchData(testPayload)
	assert(typeof(encodedStr) == "string", "Encoded launch data must be string")
	assert(#encodedStr &lt;= 200, "Encoded launch data must be &lt;= 200 chars, got: " .. tostring(#encodedStr))

	local decodedPayload = SocialInviteService.DecodeLaunchData(encodedStr)
	assert(decodedPayload ~= nil, "Decoded payload must not be nil")
	assert(decodedPayload and decodedPayload.inv == 12345678, "Inviter UserId mismatch")
	assert(decodedPayload and decodedPayload.src == "viral_invite_test", "Source mismatch")

	-- 2. Test Player Join Intercept &amp; Reward Referral
	local mockJoiningPlayer = Instance.new("Player")
	mockJoiningPlayer.Name = "InvitedPlayer"

	SocialInviteService.InjectMockJoinData(mockJoiningPlayer, encodedStr)

	local rewardAwarded = false
	local awardedInviterId = 0
	local awardedJoiningId = 0

	SocialInviteService.SetReferralRewardCallback(function(inviterId, joiningId, amount)
		rewardAwarded = true
		awardedInviterId = inviterId
		awardedJoiningId = joiningId
		assert(amount == 100, "Expected reward amount 100")
	end)

	local joinProcessed = SocialInviteService.ProcessPlayerJoin(mockJoiningPlayer)
	assert(joinProcessed, "ProcessPlayerJoin should succeed for valid LaunchData")
	assert(rewardAwarded, "Referral reward callback should have been invoked")
	assert(awardedInviterId == 12345678, "Awarded inviter ID mismatch")
	assert(SocialInviteService.GetProcessedCount() == 1, "Processed count should be 1")

	-- 3. Test Duplicate Referral Prevention
	local duplicateProcessed = SocialInviteService.ProcessPlayerJoin(mockJoiningPlayer)
	assert(not duplicateProcessed, "Duplicate referral processing should be rejected")
	assert(SocialInviteService.GetProcessedCount() == 1, "Processed count should remain 1")

	mockJoiningPlayer:Destroy()
	SocialInviteService.ResetState()
	print("[SocialInviteService.spec] All tests passed!")
end

runTests()
return true
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX81"><Properties><string name="Name">SpawnService</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: SpawnService
    Single Spawn Authority (R2).
    Sole authoritative owner of Player:LoadCharacter(), player.RespawnLocation,
    character:PivotTo(), location state tracking ("Lobby" | "PracticeRange" | "Match"),
    concurrency locking, character death handling, and falling player void rescue.
]=]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

export type LocationType = "Lobby" | "PracticeRange" | "Match"

local SpawnService = {}

-- Key Constants
local LOBBY_FALLBACK_CFRAME = CFrame.new(0, 106, 0)
local PRACTICE_RANGE_CFRAME = CFrame.new(500, 105, 60)
local VOID_RESCUE_Y = -200
local LOCK_TIMEOUT_SECONDS = 0.5

-- Internal State Tracking
local playerLocations: { [number]: LocationType } = {}
local customSpawns: { [number]: CFrame } = {}
local spawnLocks: { [number]: boolean } = {}
local rescueCooldowns: { [number]: boolean } = {}
local respawnRetries: { [number]: number } = {}

-- Lazy-required service references
local _lobbyFolderRef: any = nil
local _practiceRangeLayoutRef: any = nil
local _roundServiceRef: any = nil
local _directChallengeServiceRef: any = nil

local function getLobbyFolder(): any
	if not _lobbyFolderRef then
		local mapFolder = ReplicatedStorage:FindFirstChild("Map")
		if mapFolder then
			local lobbyMod = mapFolder:FindFirstChild("LobbyFolder")
			if lobbyMod then
				_lobbyFolderRef = require(lobbyMod :: any)
			end
		end
	end
	return _lobbyFolderRef
end

local function getPracticeRangeLayout(): any
	if not _practiceRangeLayoutRef then
		local mapFolder = ReplicatedStorage:FindFirstChild("Map")
		if mapFolder then
			local prMod = mapFolder:FindFirstChild("PracticeRangeMapLayout")
			if prMod then
				_practiceRangeLayoutRef = require(prMod :: any)
			end
		end
	end
	return _practiceRangeLayoutRef
end

local function getRoundService(): any
	if not _roundServiceRef then
		local services = ServerScriptService:FindFirstChild("Services")
		if services then
			local rsMod = services:FindFirstChild("RoundService")
			if rsMod then
				_roundServiceRef = require(rsMod :: any)
			end
		end
	end
	return _roundServiceRef
end

local function getDirectChallengeService(): any
	if not _directChallengeServiceRef then
		local services = ServerScriptService:FindFirstChild("Services")
		if services then
			local dcsMod = services:FindFirstChild("DirectChallengeService")
			if dcsMod then
				_directChallengeServiceRef = require(dcsMod :: any)
			end
		end
	end
	return _directChallengeServiceRef
end

--- Get Lobby SpawnLocation object for player
local function getLobbySpawnLocation(player: Player): SpawnLocation?
	local lobbyFolder = getLobbyFolder()
	if lobbyFolder and lobbyFolder.GetSpawnLocations then
		local spawnsList = lobbyFolder.GetSpawnLocations()
		if #spawnsList &gt; 0 then
			return spawnsList[((math.abs(player.UserId) - 1) % #spawnsList) + 1]
		end
	end
	return nil
end

--- Get Practice Range SpawnLocation object
local function getPracticeRangeSpawnLocation(): SpawnLocation?
	local workspaceRef = game:GetService("Workspace")
	local practiceMap = workspaceRef:FindFirstChild("PracticeRangeMap")
	for _, desc in workspaceRef:GetDescendants() do
		if desc:IsA("SpawnLocation") then
			if
				desc:GetAttribute("PracticeSpawnIndex") ~= nil
				or desc:GetAttribute("IsPracticeSpawn") == true
				or (practiceMap and desc:IsDescendantOf(practiceMap))
			then
				return desc
			end
		end
	end
	return nil
end

--- Get Lobby target CFrame
local function getLobbyCFrame(player: Player): CFrame
	local spawn = getLobbySpawnLocation(player)
	if spawn then
		return spawn.CFrame + Vector3.new(0, 5, 0)
	end
	return LOBBY_FALLBACK_CFRAME
end

--- Get Practice Range target CFrame
local function getPracticeRangeCFrame(player: Player, spawnIndex: number?): CFrame
	local workspaceRef = game:GetService("Workspace")
	local mapFolder = workspaceRef:FindFirstChild("PracticeRangeMap")
	if not mapFolder then
		local prLayout = getPracticeRangeLayout()
		if prLayout and prLayout.BuildMap then
			mapFolder = prLayout.BuildMap(workspaceRef)
			-- Roblox map-maker: wait a frame for physics to settle so raycast floor checks pass
			task.wait(0.05)
			-- Also ensure map is at expected world position (MAP_OFFSET = 500,100,0)
			if mapFolder and not workspaceRef:FindFirstChild("PracticeRangeMap") then
				-- BuildMap should parent itself, fallback
				mapFolder.Parent = workspaceRef
			end
			mapFolder = workspaceRef:FindFirstChild("PracticeRangeMap")
		end
	end

	local prLayout = getPracticeRangeLayout()
	if prLayout and prLayout.GetSpawnPoints then
		local spawns = prLayout.GetSpawnPoints()
		if spawns and #spawns &gt; 0 then
			-- Cycle spawn per player to spread out (3 spawns available)
			local idx = spawnIndex or ((math.abs(player.UserId) % #spawns) + 1)
			if idx &lt; 1 or idx &gt; #spawns then
				idx = 1
			end
			local pos = spawns[idx]
			if typeof(pos) == "Vector3" then
				-- 5 studs above floor to avoid clipping into pad
				return CFrame.new(pos + Vector3.new(0, 5, 0))
			elseif typeof(pos) == "CFrame" then
				return (pos :: CFrame) + Vector3.new(0, 5, 0)
			end
		end
	end
	-- Fallback still inside the map bounds (pre-offset + MAP_OFFSET)
	warn("[SPAWN] PracticeRange spawns missing, using fallback " .. tostring(PRACTICE_RANGE_CFRAME))
	return PRACTICE_RANGE_CFRAME
end

--- Determines appropriate CFrame for destination type
local function getDestinationCFrame(
	player: Player,
	destinationType: LocationType,
	customCFrame: CFrame?,
	spawnIndex: number?
): CFrame
	if customCFrame then
		return customCFrame
	end
	if destinationType == "Match" then
		return customSpawns[player.UserId] or getLobbyCFrame(player)
	elseif destinationType == "PracticeRange" then
		return getPracticeRangeCFrame(player, spawnIndex)
	else
		return getLobbyCFrame(player)
	end
end

--- Updates player's location state
function SpawnService.SetPlayerLocation(player: Player, location: LocationType)
	playerLocations[player.UserId] = location
end

--- Gets player's current location state
function SpawnService.GetPlayerLocation(player: Player): LocationType
	return playerLocations[player.UserId] or "Lobby"
end

--- Teleports existing character model to target CFrame safely
function SpawnService.TeleportCharacter(player: Player, cframe: CFrame): boolean
	local character = player.Character
	if not character then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	character:PivotTo(cframe)
	return true
end

--- Attaches void rescue safety net to player character
function SpawnService.AttachVoidRescue(player: Player, character: Model)
	local currentRoot = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not currentRoot then
		return
	end

	task.spawn(function()
		-- Track the current character/root, auto-exit when character removed/replaced
		local conn: RBXScriptConnection? = nil
		local root: BasePart? = currentRoot
		local activeChar: Model = character
		conn = player.CharacterAdded:Connect(function(newChar)
			activeChar = newChar
			root = newChar:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		end)
		while activeChar.Parent and player.Parent == Players do
			-- Refresh root if character swapped
			if not root or not root.Parent then
				root = activeChar:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not root then
					task.wait(0.25)
					continue
				end
			end
			if root.Position.Y &lt; VOID_RESCUE_Y and not rescueCooldowns[player.UserId] then
				rescueCooldowns[player.UserId] = true
				local loc = SpawnService.GetPlayerLocation(player)
				local workspaceRef = game:GetService("Workspace")

				if loc == "PracticeRange" and not workspaceRef:FindFirstChild("PracticeRangeMap") then
					warn(
						("[VOID] Rescue target map PracticeRange missing for %s! Rescuing to Lobby."):format(
							player.Name
						)
					)
					playerLocations[player.UserId] = "Lobby"
					loc = "Lobby"
				end

				local destCFrame = getDestinationCFrame(player, loc, customSpawns[player.UserId])

				if loc == "PracticeRange" and not workspaceRef:FindFirstChild("PracticeRangeMap") then
					destCFrame = getLobbyCFrame(player)
					playerLocations[player.UserId] = "Lobby"
					loc = "Lobby"
				end

				warn(
					("[VOID] Rescuing %s from Y=%.1f to %s at %s"):format(
						player.Name,
						root.Position.Y,
						loc,
						tostring(destCFrame.Position)
					)
				)

				if activeChar.Parent and root.Parent then
					activeChar:PivotTo(destCFrame)
				end
				task.wait(2)
				rescueCooldowns[player.UserId] = nil
			end
			task.wait(0.25)
			-- Exit when the original tracked character is gone and we are watching a new one via CharacterAdded
			if activeChar ~= character and not character.Parent then
				-- let loop continue tracking new character until player leaves
			end
			if not activeChar.Parent then
				break
			end
		end
		if conn then
			conn:Disconnect()
		end
	end)
end

--- Authoritative character spawn entry point
function SpawnService.SpawnPlayer(
	selfOrPlayer: any,
	destinationTypeOrMode: any,
	customCFrameOrIndex: any
): (boolean, CFrame)
	local player: Player
	local modeStr: LocationType = "Lobby"
	local customCFrame: CFrame? = nil
	local spawnIndex: number? = nil

	-- Handle both SpawnService:SpawnPlayer(player, mode, spawnIndex) and SpawnService.SpawnPlayer(player, mode, spawnIndex)
	if typeof(selfOrPlayer) == "table" and selfOrPlayer == SpawnService then
		player = destinationTypeOrMode :: Player
		local rawMode = customCFrameOrIndex
		if rawMode == "PracticeRange" or rawMode == "Practice" then
			modeStr = "PracticeRange"
		elseif rawMode == "Match" then
			modeStr = "Match"
		else
			modeStr = "Lobby"
		end
	else
		player = selfOrPlayer :: Player
		local rawMode = destinationTypeOrMode
		if rawMode == "PracticeRange" or rawMode == "Practice" then
			modeStr = "PracticeRange"
		elseif rawMode == "Match" then
			modeStr = "Match"
		else
			modeStr = "Lobby"
		end
		if typeof(customCFrameOrIndex) == "CFrame" then
			customCFrame = customCFrameOrIndex
		elseif typeof(customCFrameOrIndex) == "number" then
			spawnIndex = customCFrameOrIndex
		end
	end

	local userId = player.UserId

	-- Concurrency mutex: wait briefly for any in-progress spawn, then claim lock (Roblox dev best practice: queue, don't drop)
	if spawnLocks[userId] then
		local waited = 0
		while spawnLocks[userId] and waited &lt; 1.2 do
			task.wait(0.05)
			waited += 0.05
		end
		if spawnLocks[userId] then
			warn(("[SPAWN] Spawn rejected for %s — busy (waited %.1fs)"):format(player.Name, waited))
			return false, getDestinationCFrame(player, modeStr, customCFrame, spawnIndex)
		end
	end
	spawnLocks[userId] = true

	-- Update state tracking
	playerLocations[userId] = modeStr
	if customCFrame then
		customSpawns[userId] = customCFrame
	end

	local destCFrame = getDestinationCFrame(player, modeStr, customCFrame, spawnIndex)

	-- Configure Roblox RespawnLocation to match designated SpawnLocation
	if modeStr == "Lobby" then
		local spawnObj = getLobbySpawnLocation(player)
		if spawnObj then
			player.RespawnLocation = spawnObj
		end
	elseif modeStr == "PracticeRange" then
		local spawnObj = getPracticeRangeSpawnLocation()
		if spawnObj then
			player.RespawnLocation = spawnObj
		end
	else
		player.RespawnLocation = nil
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid") :: Humanoid?
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?

	-- If character is already alive, TELEPORT directly using PivotTo without destroying via LoadCharacter
	if character and humanoid and humanoid.Health &gt; 0 and root and character.Parent == game:GetService("Workspace") then
		character:PivotTo(destCFrame)
		task.defer(function()
			if character and character.Parent then
				character:PivotTo(destCFrame)
			end
		end)
		print(
			("[SPAWN] Teleported alive player %s -&gt; %s at %.1f, %.1f, %.1f"):format(
				player.Name,
				modeStr,
				destCFrame.Position.X,
				destCFrame.Position.Y,
				destCFrame.Position.Z
			)
		)
		task.delay(LOCK_TIMEOUT_SECONDS, function()
			spawnLocks[userId] = nil
		end)
		return true, destCFrame
	end

	-- Otherwise, LoadCharacter is required (robust: retry PivotTo even if HumanoidRootPart delayed)
	player:LoadCharacter()
	character = player.Character or player.CharacterAdded:Wait()
	-- Wait for HumanoidRootPart with longer timeout and fallback to any PrimaryPart
	local loadedRoot = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not loadedRoot then
		loadedRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart? or character.PrimaryPart :: BasePart?
	end
	-- Always attempt PivotTo even if root not yet found, with retries
	local function doPivot()
		if character and character.Parent == workspace then
			pcall(function() character:PivotTo(destCFrame) end)
		end
	end
	doPivot()
	task.defer(doPivot)
	task.delay(0.1, doPivot)
	task.delay(0.3, doPivot)
	if loadedRoot then
		print(
			("[SPAWN] Loaded character for player %s -&gt; %s at %.1f, %.1f, %.1f"):format(
				player.Name,
				modeStr,
				destCFrame.Position.X,
				destCFrame.Position.Y,
				destCFrame.Position.Z
			)
		)
	else
		warn(("[SPAWN] HumanoidRootPart missing for %s, retried PivotTo to %s"):format(player.Name, tostring(destCFrame.Position)))
	end

	SpawnService.AttachVoidRescue(player, character)

	task.delay(LOCK_TIMEOUT_SECONDS, function()
		spawnLocks[userId] = nil
	end)

	return true, destCFrame
end

--- Handles character death and respawning rules
function SpawnService.HandleCharacterRespawn(player: Player)
	local dcs = getDirectChallengeService()
	local rs = getRoundService()

	local status = if dcs then dcs.GetPlayerStatus(player) else "In Lobby"
	local inActiveMatch = rs and rs.IsPlayerInActiveMatch and rs.IsPlayerInActiveMatch(player)

	if status == "In Match" or inActiveMatch then
		-- In PvP match: mid-round respawn handled by RoundService (spectate)
		pcall(function()
			if rs and rs.OnPlayerDied then
				rs.OnPlayerDied(player, nil)
			end
		end)
	else
		-- Non-match (Lobby / PracticeRange): auto-respawn after delay
		local retries = respawnRetries[player.UserId] or 0
		if retries &gt;= 3 then
			SpawnService.SpawnPlayer(player, "Lobby")
			respawnRetries[player.UserId] = 0
			return
		end
		respawnRetries[player.UserId] = retries + 1

		task.wait(2)
		if player.Parent == Players then
			local currentLocation = SpawnService.GetPlayerLocation(player)
			SpawnService.SpawnPlayer(player, currentLocation)
			respawnRetries[player.UserId] = 0
		end
	end
end

--- Called on PlayerAdded
function SpawnService.OnPlayerAdded(player: Player)
	playerLocations[player.UserId] = "Lobby"

	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.Died:Connect(function()
				SpawnService.HandleCharacterRespawn(player)
			end)
		end
	end)

	SpawnService.SpawnPlayer(player, "Lobby")
end

--- Called on PlayerRemoving
function SpawnService.OnPlayerRemoving(player: Player)
	playerLocations[player.UserId] = nil
	customSpawns[player.UserId] = nil
	spawnLocks[player.UserId] = nil
	rescueCooldowns[player.UserId] = nil
	respawnRetries[player.UserId] = nil
end

--- Initialize SpawnService
function SpawnService.Init()
	Players.CharacterAutoLoads = false

	Players.PlayerAdded:Connect(function(player)
		SpawnService.OnPlayerAdded(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		SpawnService.OnPlayerRemoving(player)
	end)

	for _, player in Players:GetPlayers() do
		task.spawn(function()
			SpawnService.OnPlayerAdded(player)
		end)
	end

	print("[SpawnService] Initialized as Single Spawn Authority.")
end

return SpawnService
]]&gt;</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX19"><Properties><string name="Name">Combat</string></Properties><Item class="ModuleScript" referent="RBX82"><Properties><string name="Name">CombatServer</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Combat Server Authority
    Central server module responsible for network listener bindings, payload validation,
    rate limiting (leaky bucket), rollback verification, damage application, and match state
    phase checks. Silently discards invalid or malicious client requests.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage:WaitForChild("Types") :: any)

local RollbackBuffer = require(script.Parent.RollbackBuffer)
local HitValidation = require(script.Parent.HitValidation)
local MovementValidator = require(script.Parent.MovementValidator)
local BufferSerializer = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("BufferSerializer") :: any)

local RemoteEvents = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("RemoteEvents") :: any)

local DataFolder = ReplicatedStorage:WaitForChild("Data")
local WeaponStats = require(DataFolder:WaitForChild("WeaponStats") :: any)

local DirectChallengeService =
	require(script.Parent.Parent:WaitForChild("Services"):WaitForChild("DirectChallengeService") :: any)
local PlayerDataService =
	require(script.Parent.Parent:WaitForChild("Services"):WaitForChild("PlayerDataService") :: any)

local CombatServer = {}
CombatServer.__index = CombatServer

-- Leaky bucket state per player &amp; action
type BucketState = {
	tokens: number,
	lastUpdate: number,
	capacity: number,
	refillRate: number, -- Tokens added per second
}

export type PlayerHealthState = {
	health: number,
	maxHealth: number,
	shield: number,
	maxShield: number,
}

export type CombatServerOptions = {
	maxRollbackMs: number,
	matchPhase: Types.MatchState,
}

export type CombatServerClass = typeof(setmetatable(
	{} :: {
		_rollbackBuffer: RollbackBuffer.RollbackBufferClass,
		_rateLimiters: { [number]: { [string]: BucketState } },
		_playerHealth: { [number]: PlayerHealthState },
		_matchPhase: Types.MatchState,
		_options: CombatServerOptions,
	},
	CombatServer
))

--- Creates a new CombatServer instance.
function CombatServer.new(
	rollbackBuffer: RollbackBuffer.RollbackBufferClass?,
	options: CombatServerOptions?
): CombatServerClass
	local self = setmetatable({
		_rollbackBuffer = rollbackBuffer or RollbackBuffer.new(120, 60),
		_rateLimiters = {} :: { [number]: { [string]: BucketState } },
		_playerHealth = {} :: { [number]: PlayerHealthState },
		_matchPhase = (options and options.matchPhase) or "InGame",
		_options = options or { maxRollbackMs = 500, matchPhase = "InGame" },
	}, CombatServer)
	return self
end

-- ----------------------------------------------------------------------------
-- 1. Leaky Bucket Rate Limiter
-- ----------------------------------------------------------------------------

function CombatServer._checkRateLimit(
	self: CombatServerClass,
	userId: number,
	action: string,
	capacity: number,
	refillRate: number
): boolean
	local now = os.clock()
	local playerBuckets = self._rateLimiters[userId]
	if not playerBuckets then
		playerBuckets = {}
		self._rateLimiters[userId] = playerBuckets
	end

	local bucket = playerBuckets[action]
	if not bucket then
		bucket = {
			tokens = capacity,
			lastUpdate = now,
			capacity = capacity,
			refillRate = refillRate,
		}
		playerBuckets[action] = bucket
	end

	-- Refill tokens based on elapsed time
	local elapsed = math.max(0, now - bucket.lastUpdate)
	bucket.tokens = math.min(bucket.capacity, bucket.tokens + elapsed * bucket.refillRate)
	bucket.lastUpdate = now

	if bucket.tokens &gt;= 1 then
		bucket.tokens -= 1
		return true
	end

	return false -- Rate limit exceeded
end

-- ----------------------------------------------------------------------------
-- 2. State Machine &amp; Match Phase Management
-- ----------------------------------------------------------------------------

function CombatServer.SetMatchPhase(self: CombatServerClass, phase: Types.MatchState)
	self._matchPhase = phase
end

function CombatServer.GetMatchPhase(self: CombatServerClass): Types.MatchState
	return self._matchPhase
end

function CombatServer.RegisterPlayer(self: CombatServerClass, userId: number, health: number?, shield: number?)
	self._playerHealth[userId] = {
		health = health or 100,
		maxHealth = 100,
		shield = shield or 50,
		maxShield = 50,
	}
end

function CombatServer.UnregisterPlayer(self: CombatServerClass, userId: number)
	self._playerHealth[userId] = nil
	self._rateLimiters[userId] = nil
	self._rollbackBuffer:ClearEntity(tostring(userId))
end

function CombatServer.IsPlayerAlive(self: CombatServerClass, userId: number): boolean
	local state = self._playerHealth[userId]
	return state ~= nil and state.health &gt; 0
end

function CombatServer.GetPlayerHealth(self: CombatServerClass, userId: number): PlayerHealthState?
	return self._playerHealth[userId]
end

-- ----------------------------------------------------------------------------
-- 3. Payload Bounds &amp; Type Validation Helpers
-- ----------------------------------------------------------------------------

local MAX_STRING_LEN = 64

local function validateString(val: any, maxLen: number?): boolean
	if type(val) ~= "string" then
		return false
	end
	local limit = maxLen or MAX_STRING_LEN
	return #val &gt; 0 and #val &lt;= limit
end

local function validateVector3(v: any): boolean
	if typeof(v) ~= "Vector3" then
		return false
	end
	-- Reject NaN or Infinity values
	if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
		return false
	end
	if math.abs(v.X) &gt; 1e6 or math.abs(v.Y) &gt; 1e6 or math.abs(v.Z) &gt; 1e6 then
		return false
	end
	return true
end

local function validateNumber(num: any, minVal: number?, maxVal: number?): boolean
	if type(num) ~= "number" then
		return false
	end
	if num ~= num or num == math.huge or num == -math.huge then
		return false
	end
	if minVal and num &lt; minVal then
		return false
	end
	if maxVal and num &gt; maxVal then
		return false
	end
	return true
end

function CombatServer.ValidateHitPayload(payload: any): boolean
	if type(payload) ~= "table" then
		return false
	end
	if not validateVector3(payload.origin) then
		return false
	end
	if not validateVector3(payload.direction) then
		return false
	end
	if not validateVector3(payload.hitPosition) then
		return false
	end
	if not validateNumber(payload.distance, 0, 10000) then
		return false
	end
	if not validateNumber(payload.clientTimestamp, 0) then
		return false
	end
	if not validateNumber(payload.sequenceId, 0) then
		return false
	end
	if not validateString(payload.weaponId, 32) then
		return false
	end

	-- Direction magnitude check
	local dirMag = payload.direction.Magnitude
	if dirMag &lt; 0.9 or dirMag &gt; 1.1 then
		return false
	end

	-- Payload must include seed for server spread re-sim (reject pre-seeded client spread exploits)
	if payload.seed ~= nil and type(payload.seed) ~= "number" then
		return false
	end

	return true
end

-- ----------------------------------------------------------------------------
-- 4. Spatial Position Update &amp; Snapshot Ingestion
-- ----------------------------------------------------------------------------

function CombatServer.UpdatePlayerSpatial(
	self: CombatServerClass,
	userId: number,
	position: Vector3,
	velocity: Vector3,
	cframe: CFrame,
	timestamp: number?
)
	if not validateVector3(position) or not validateVector3(velocity) then
		return
	end

	local ts = timestamp or os.clock()
	self._rollbackBuffer:PushSnapshot(tostring(userId), {
		timestamp = ts,
		position = position,
		velocity = velocity,
		cframe = cframe,
	})
end

-- ----------------------------------------------------------------------------
-- 5. Hit Processing &amp; Damage Application Pipeline
-- ----------------------------------------------------------------------------

function CombatServer.ProcessHitReport(
	self: CombatServerClass,
	attackerUserId: number,
	victimUserId: number,
	payload: Types.HitVerificationPayload,
	maxWeaponRange: number?,
	baseDamage: number?
): (boolean, string?, number?)
	-- State Machine Phase Check (Allow InGame or PracticeRange)
	if self._matchPhase ~= "InGame" and self._matchPhase ~= "PracticeRange" then
		return false, "InvalidMatchPhase", nil
	end

	-- Player Match Status Check
	local attackerPlayer = Players:GetPlayerByUserId(attackerUserId)
	local victimPlayer = Players:GetPlayerByUserId(victimUserId)

	if attackerPlayer then
		local status = DirectChallengeService.GetPlayerStatus(attackerPlayer)
		if status == "In Lobby" then
			return false, "AttackerInLobby", nil
		end
	end

	if victimPlayer and victimUserId ~= 0 then
		local status = DirectChallengeService.GetPlayerStatus(victimPlayer)
		if status == "In Lobby" then
			return false, "VictimInLobby", nil
		end
	end

	-- Attacker &amp; Victim Alive Checks
	if not self:IsPlayerAlive(attackerUserId) then
		return false, "AttackerDead", nil
	end
	if victimPlayer and victimUserId ~= 0 and not self:IsPlayerAlive(victimUserId) then
		return false, "VictimDead", nil
	end

	-- Leaky Bucket Rate Limiter Check (Capacity 10, Refill 25/sec)
	if not self:_checkRateLimit(attackerUserId, "ReportHit", 10, 25) then
		return false, "RateLimitExceeded", nil
	end

	-- Type &amp; Bounds Validation
	if not CombatServer.ValidateHitPayload(payload) then
		return false, "MalformedPayload", nil
	end

	-- Server Damage Calculation
	local weaponName = payload.weaponId or "AssaultRifle"
	local stats = WeaponStats.Get(weaponName)
	if not stats then
		warn("Invalid weapon ID received from client: " .. tostring(weaponName))
		return false, "InvalidWeapon", nil
	end

	-- isHeadshot is NOT trusted from client — derived server-side after rollback; payload.isHeadshot ignored
	local reportedDistance = payload.distance or 0
	local isHeadshot = false -- body-shot assumption for base calc; true headshot bonus applied after OBB if validated
	local rawDamage = WeaponStats.CalculateDamage(weaponName, isHeadshot, math.min(reportedDistance, 10000))
	-- baseDamage override: only honor when attacker is not a real Player (internal deployable). Client ReportHit always has attackerUserId == player
	if baseDamage and baseDamage &gt; 0 then
		local attackerPlayerCheck = Players:GetPlayerByUserId(attackerUserId)
		if not attackerPlayerCheck then
			rawDamage = baseDamage
		end
	end

	-- Weapon Range Bounds Check — pre-check on reported distance; server-measured distance checked after rollback
	local maxRange = maxWeaponRange or stats.maxRange or 1000
	if reportedDistance &gt; maxRange + 5.0 then
		return false, "ExceedsWeaponRange", nil
	end

	-- Server spread cone check — direction must be within spreadMax of rewound attacker lookVector
	do
		local attackerSnap = self._rollbackBuffer:GetSnapshot(tostring(attackerUserId), payload.clientTimestamp)
		if attackerSnap and attackerSnap.cframe then
			local forward = attackerSnap.cframe.LookVector
			local dir = payload.direction.Unit
			local dot = math.clamp(forward:Dot(dir), -1, 1)
			local angleDeg = math.deg(math.acos(dot))
			local allowed = (stats.spreadMax or 5) + 2.0 -- +2 deg tolerance for movement
			if angleDeg &gt; allowed then
				return false, "SpreadExceeded", nil
			end
		end
	end

	local now = os.clock()

	-- Non-player victim handling (Practice Range Patrol Bot or Target Wall)
	if not victimPlayer or victimUserId == 0 then
		if payload.targetInstance then
			local targetInst = payload.targetInstance
			local targetModel = targetInst:FindFirstAncestorOfClass("Model")
			local botHumanoid = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
			if botHumanoid then
				botHumanoid:TakeDamage(rawDamage)
				return true, nil, botHumanoid.Health
			end
			local isBullseye = targetInst:GetAttribute("IsBullseye") == true
				or targetInst.Name == "Bullseye"
				or string.find(targetInst.Name, "TargetRing_") ~= nil
			local isTargetWall = targetInst:GetAttribute("IsTarget") == true
				or string.find(targetInst.Name, "Target") ~= nil
				or isBullseye
			if
				isTargetWall
				or targetInst:GetAttribute("IsPracticeTarget") == true
				or targetInst.Name == "PracticeTarget"
			then
				return true, nil, 0
			end
		end
		if self._matchPhase == "PracticeRange" then
			return true, nil, 0
		end
	end

	-- Server-Authoritative Hit Validation Pipeline for Player Victim
	if victimPlayer and victimUserId ~= 0 then
		local valResult = HitValidation.ValidateHit(
			self._rollbackBuffer,
			tostring(attackerUserId),
			tostring(victimUserId),
			payload,
			now,
			{
				maxRollbackMs = self._options.maxRollbackMs,
				maxOriginTolerance = 15.0,
				rayDistanceMargin = 4.0,
			}
		)

		if not valResult.valid then
			return false, valResult.reason, nil
		end
		-- Server-measured distance check (prevents client lying about distance=0)
		if valResult.calculatedDistance and valResult.calculatedDistance &gt; maxRange + 5.0 then
			return false, "ExceedsWeaponRange", nil
		end
		-- Use server-validated hitPosition/distance when available
		if valResult.hitPosition then
			payload.hitPosition = valResult.hitPosition
		end
	end

	-- Apply Damage to Victim (50% Armor Absorption Logic)
	local victimState = self._playerHealth[victimUserId]
	local healthDmgToApply = rawDamage
	if victimState then
		if victimState.shield &gt; 0 then
			local maxAbsorption = math.floor(rawDamage * 0.5)
			local shieldDmg = math.min(victimState.shield, maxAbsorption)
			healthDmgToApply = rawDamage - shieldDmg

			victimState.shield -= shieldDmg
			victimState.health = math.max(0, victimState.health - healthDmgToApply)
		else
			victimState.health = math.max(0, victimState.health - rawDamage)
			healthDmgToApply = rawDamage
		end
	end

	-- Apply damage to Roblox Character Humanoid
	local wasKilled = false
	if victimPlayer and victimPlayer.Character then
		local hum = victimPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			local prevHealth = hum.Health
			hum:TakeDamage(healthDmgToApply)

			if prevHealth &gt; 0 and hum.Health &lt;= 0 then
				wasKilled = true
			end
		end
	end

	if wasKilled then
		local attackerP = Players:GetPlayerByUserId(attackerUserId)
		if attackerP then
			PlayerDataService.AddKill(attackerP)
		end
		if victimPlayer then
			PlayerDataService.AddDeath(victimPlayer)
		end
	end

	-- Dispatch Reliable Damage Remote Event
	local pcallSuccess, pcallErr = pcall(function()
		local damageRemote = RemoteEvents.GetReliable("DamageDealt")
		if damageRemote then
			local attackerP = Players:GetPlayerByUserId(attackerUserId)
			if attackerP then
				damageRemote:FireClient(attackerP, {
					attackerUserId = attackerUserId,
					victimUserId = victimUserId,
					remainingHealth = victimState and victimState.health or 0,
					remainingShield = victimState and victimState.shield or 0,
					hitPosition = payload.hitPosition,
				})
			end
			local victimP = Players:GetPlayerByUserId(victimUserId)
			if victimP then
				damageRemote:FireClient(victimP, {
					attackerUserId = attackerUserId,
					victimUserId = victimUserId,
					remainingHealth = victimState and victimState.health or 0,
					remainingShield = victimState and victimState.shield or 0,
					hitPosition = payload.hitPosition,
				})
			end
		end
	end)

	if not pcallSuccess then
		-- Silently handle network dispatch errors
	end

	return true, nil, victimState and victimState.health
end

-- ----------------------------------------------------------------------------
-- 6. Initialization &amp; Network Event Binding
-- ----------------------------------------------------------------------------

function CombatServer.InitializeNetworkListeners(self: CombatServerClass)
	RemoteEvents.Initialize()

	local combatRemote = RemoteEvents.GetReliable("ReliableCombat")
	combatRemote.OnServerEvent:Connect(function(player: Player, rawData: any)
		-- Wrap processing in pcall to silently discard invalid/malicious payloads without crashing
		pcall(function()
			if typeof(player) ~= "Instance" or not player:IsA("Player") or not player:IsDescendantOf(Players) then
				return
			end
			if typeof(rawData) ~= "table" then
				return
			end

			local action = rawData.action
			local payload = rawData.payload
			if typeof(action) ~= "string" or typeof(payload) ~= "table" then
				return
			end

			if action == "ReportHit" then
				if
					typeof(payload.victimUserId) == "number"
					and payload.victimUserId &gt;= 0
					and payload.victimUserId == math.floor(payload.victimUserId)
				then
					self:ProcessHitReport(player.UserId, payload.victimUserId, payload.hitData)
				end
			end
		end)
	end)

	local unreliableCombat = RemoteEvents.GetUnreliable("UnreliableCombat")
	unreliableCombat.OnServerEvent:Connect(function(player: Player, bufferData: any)
		pcall(function()
			if typeof(player) ~= "Instance" or not player:IsA("Player") or typeof(bufferData) ~= "buffer" then
				return
			end

			if self:_checkRateLimit(player.UserId, "FireWeapon", 10, 20) then
				local origin, direction = BufferSerializer.DeserializeFireIntent(bufferData)
				if validateVector3(origin) and validateVector3(direction) then
					direction = direction.Unit
					local char = player.Character
					if char then
						local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
						if hrp and (hrp.Position - origin).Magnitude &gt; 10 then
							return
						end
					end
					local tracerRemote = RemoteEvents.GetUnreliable("BulletTracer")
					if tracerRemote then
						tracerRemote:FireAllClients({
							shooterId = player.UserId,
							origin = origin,
							direction = direction,
						})
					end
				end
			end
		end)
	end)

	-- Spatial Position Sync (Client -&gt; Server over Unreliable)
	local spatialSyncRemote = RemoteEvents.GetUnreliable("SpatialStateSync")
	if spatialSyncRemote then
		spatialSyncRemote.OnServerEvent:Connect(function(player: Player, bufferData: any)
			if typeof(player) ~= "Instance" or not player:IsA("Player") or typeof(bufferData) ~= "buffer" then
				return
			end

			-- Enforce 30Hz rate limit on updates
			if self:_checkRateLimit(player.UserId, "SpatialSync", 30, 40) then
				local timestamp, pos, vel = BufferSerializer.DeserializeSpatialState(bufferData)
				if validateVector3(pos) and validateVector3(vel) then
					local isValid = MovementValidator.ValidateClientState(player.UserId, timestamp, pos, vel)
					if isValid then
						local char = player.Character
						local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
						local cframe = hrp and hrp.CFrame or CFrame.new(pos)

						self:UpdatePlayerSpatial(player.UserId, pos, vel, cframe, os.clock())
					else
						-- Rubberband on violation
						MovementValidator.HandleViolation(player.UserId)
					end
				end
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		MovementValidator.ClearPlayer(player.UserId)
	end)
end

return CombatServer
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX83"><Properties><string name="Name">HitValidation</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Server Hit Validation Engine
    Validates weapon fire and hit reports against server-authoritative rewind history.
    Enforces clamped temporal rollback windows (250-1000ms threshold), origin distance checks,
    and mathematical Oriented Bounding Box (OBB) ray intersection without moving workspace parts.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Types = require(ReplicatedStorage:WaitForChild("Types") :: any)

local RollbackBuffer = require(script.Parent.RollbackBuffer)

export type HitValidationOptions = {
    maxRollbackMs: number, -- Max latency compensation window in ms (clamped 250-1000ms)
    maxOriginTolerance: number, -- Max allowed distance between claimed origin and rewound position
    rayDistanceMargin: number, -- Margin allowed for max ray distance checks
}

export type OBBHitResult = {
    hit: boolean,
    distance: number?,
    hitPosition: Vector3?,
    hitNormal: Vector3?,
}

export type HitValidationResult = {
    valid: boolean,
    reason: string?,
    attackerState: RollbackBuffer.SpatialSnapshot?,
    victimState: RollbackBuffer.SpatialSnapshot?,
    hitPosition: Vector3?,
    calculatedDistance: number?,
}

local HitValidation = {}

local DEFAULT_OPTIONS: HitValidationOptions = {
    maxRollbackMs = 500, -- Default 500ms (clamped between 250ms and 1000ms)
    maxOriginTolerance = 15.0, -- Increased to 15.0 to account for FirstPerson camera offset from HRP
    rayDistanceMargin = 4.0, -- 4 Roblox units distance tolerance
}

-- ----------------------------------------------------------------------------
-- 1. Mathematical Oriented Bounding Box (OBB) Ray Intersection Test
-- Slab test performed in local OBB object frame. No physical parts are moved.
-- ----------------------------------------------------------------------------

--- Tests a ray against an Oriented Bounding Box (OBB) in pure mathematical space.
function HitValidation.TestRayOBB(
    rayOrigin: Vector3,
    rayDirection: Vector3,
    maxDistance: number,
    obbCFrame: CFrame,
    obbSize: Vector3
): OBBHitResult
    local dirMag = rayDirection.Magnitude
    if dirMag &lt; 1e-6 then
        return { hit = false }
    end
    local normDir = rayDirection / dirMag

    -- Transform ray to OBB local object frame
    local localOrigin = obbCFrame:PointToObjectSpace(rayOrigin)
    local localDir = obbCFrame:VectorToObjectSpace(normDir)

    -- Half extents of box
    local halfSize = obbSize * 0.5

    local tMin = 0.0
    local tMax = maxDistance

    local hitAxis = 0
    local hitSign = 1

    local localOrigArr = { localOrigin.X, localOrigin.Y, localOrigin.Z }
    local localDirArr = { localDir.X, localDir.Y, localDir.Z }
    local halfSizeArr = { halfSize.X, halfSize.Y, halfSize.Z }

    for i = 1, 3 do
        local dirComponent = localDirArr[i]
        local origComponent = localOrigArr[i]
        local halfExtent = halfSizeArr[i]

        if math.abs(dirComponent) &lt; 1e-7 then
            -- Ray is parallel to slab; check if origin is outside slab bounds
            if origComponent &lt; -halfExtent or origComponent &gt; halfExtent then
                return { hit = false }
            end
        else
            local t1 = (-halfExtent - origComponent) / dirComponent
            local t2 = (halfExtent - origComponent) / dirComponent

            local sign1 = -1
            local sign2 = 1

            if t1 &gt; t2 then
                t1, t2 = t2, t1
                sign1, sign2 = sign2, sign1
            end

            if t1 &gt; tMin then
                tMin = t1
                hitAxis = i
                hitSign = sign1
            end

            if t2 &lt; tMax then
                tMax = t2
            end

            if tMin &gt; tMax then
                return { hit = false }
            end
        end
    end

    if tMin &lt; 0 or tMin &gt; maxDistance then
        return { hit = false }
    end

    -- World-space hit position &amp; surface normal calculation
    local localHitPos = localOrigin + localDir * tMin
    local worldHitPos = obbCFrame:PointToWorldSpace(localHitPos)

    local localNormal = Vector3.zero
    if hitAxis == 0 then
        localNormal = if localDir.Magnitude &gt; 0 then -localDir.Unit else Vector3.new(0, 1, 0)
    elseif hitAxis == 1 then
        localNormal = Vector3.new(hitSign, 0, 0)
    elseif hitAxis == 2 then
        localNormal = Vector3.new(0, hitSign, 0)
    elseif hitAxis == 3 then
        localNormal = Vector3.new(0, 0, hitSign)
    end

    local worldNormal = obbCFrame:VectorToWorldSpace(localNormal)

    return {
        hit = true,
        distance = tMin,
        hitPosition = worldHitPos,
        hitNormal = worldNormal,
    }
end

-- ----------------------------------------------------------------------------
-- 2. Full Server Hit Validation Pipeline
-- ----------------------------------------------------------------------------

--- Validates a client hit report against server-authoritative rollback history.
function HitValidation.ValidateHit(
    rollbackBuffer: RollbackBuffer.RollbackBufferClass,
    attackerId: string,
    victimId: string,
    payload: Types.HitVerificationPayload,
    serverTimeNow: number,
    customOptions: HitValidationOptions?,
    victimObbSize: Vector3?
): HitValidationResult
    local options = customOptions or DEFAULT_OPTIONS
    options.maxOriginTolerance = math.clamp(options.maxOriginTolerance or 15, 0, 50)
    options.rayDistanceMargin = math.clamp(options.rayDistanceMargin or 5, 0, 50)

    -- Clamped temporal rollback threshold (strictly enforced between 250ms and 1000ms)
    local rawThresholdMs = options.maxRollbackMs
    local clampedMs = math.clamp(rawThresholdMs, 250, 1000)
    local maxRollbackSec = clampedMs / 1000

    -- Step 1: Temporal Rollback Window Validation
    local clientTimestamp = payload.clientTimestamp
    local latency = serverTimeNow - clientTimestamp

    -- Reject timestamps in far future (&gt; 50ms drift tolerance) or older than maxRollbackSec
    if latency &lt; -0.05 then
        return { valid = false, reason = "TimestampInFuture" }
    end
    if latency &gt; maxRollbackSec then
        return { valid = false, reason = "TimestampExceedsRollbackWindow" }
    end

    -- Step 2: Retrieve Rewound Spatial Snapshots via Hermite Spline Interpolation
    local attackerState = rollbackBuffer:GetInterpolatedState(attackerId, clientTimestamp)
    local victimState = rollbackBuffer:GetInterpolatedState(victimId, clientTimestamp)

    if not attackerState then
        return { valid = false, reason = "AttackerHistoryNotFound" }
    end
    if not victimState then
        return { valid = false, reason = "VictimHistoryNotFound" }
    end

    -- Step 3: Origin Distance Validation against Attacker's Rewound Position
    local originDist = (payload.origin - attackerState.position).Magnitude
    if originDist &gt; options.maxOriginTolerance then
        return { valid = false, reason = "OriginDistanceExceeded" }
    end

    -- Step 4: Distance Sanity Check
    if payload.distance &lt; 0 or payload.distance &gt; 10000 then
        return { valid = false, reason = "InvalidHitDistance" }
    end

    -- Step 5: Oriented Bounding Box (OBB) Mathematical Ray Intersection Test
    local boxSize = victimObbSize or victimState.size or Vector3.new(4, 6, 4)
    local obbResult = HitValidation.TestRayOBB(
        payload.origin,
        payload.direction,
        payload.distance + options.rayDistanceMargin,
        victimState.cframe,
        boxSize
    )

    if not obbResult.hit then
        return { valid = false, reason = "OBBIntersectionFailed" }
    end

    -- Step 6: Raycast Wall-penetration Block (Line of Sight)
    -- Perform a physical raycast on the server to ensure no static walls block the shot.
    -- (We ignore character models because they have moved; we only check static environment)
    if obbResult.hitPosition then
        local losDir = obbResult.hitPosition - payload.origin
        local losDist = losDir.Magnitude
        if losDist &gt; 0.1 then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            -- Filter out ALL character models to avoid false positives from current real-time positions
            local chars = {}
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p.Character then table.insert(chars, p.Character) end
            end
            rayParams.FilterDescendantsInstances = chars
            rayParams.IgnoreWater = true

            local losResult = Workspace:Raycast(payload.origin, losDir.Unit * losDist, rayParams)
            if losResult then
                local hitModel = losResult.Instance:FindFirstAncestorOfClass("Model")
                local isTarget = false
                if hitModel then
                    if hitModel.Name == victimId or tostring(hitModel:GetAttribute("BotId")) == victimId then
                        isTarget = true
                    end
                end

                if not isTarget then
                    return { valid = false, reason = "WallPenetrationDetected" }
                end
            end
        end
    end

    return {
        valid = true,
        attackerState = attackerState,
        victimState = victimState,
        hitPosition = obbResult.hitPosition,
        calculatedDistance = obbResult.distance,
    }
end

return HitValidation
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX84"><Properties><string name="Name">M2_TestRunner</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Milestone 2 Automated Unit Test Runner
    Executes unit and integration tests across BufferSerializer, RollbackBuffer,
    HitValidation, RemoteEvents, and CombatServer to ensure 100% correctness and reliability.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage:WaitForChild("Types") :: any)

local BufferSerializer = require(ReplicatedStorage:WaitForChild("Network"):WaitForChild("BufferSerializer") :: any)
local RollbackBuffer = require(script.Parent.RollbackBuffer)
local HitValidation = require(script.Parent.HitValidation)
local CombatServer = require(script.Parent.CombatServer)

local M2_TestRunner = {}

function M2_TestRunner.RunAllTests(): (boolean, number, number, { string })
    local passed = 0
    local failed = 0
    local errors: { string } = {}

    local function assertTest(condition: boolean, testName: string, detail: string?)
        if condition then
            passed += 1
            print(`[PASS] {testName}`)
        else
            failed += 1
            local msg = `[FAIL] {testName}` .. (detail and `: {detail}` or "")
            table.insert(errors, msg)
            warn(msg)
        end
    end

    print("==================================================")
    print("RUNNING MILESTONE 2 SUITE FOR OVERCLOCK")
    print("==================================================")

    -- ------------------------------------------------------------------------
    -- TEST SUITE 1: BufferSerializer
    -- ------------------------------------------------------------------------
    do
        -- Test 1.1: Vector3 Serialization (12 bytes exact)
        local testVec = Vector3.new(123.456, -789.012, 0.001)
        local vecBuf = BufferSerializer.SerializeVector3(testVec)
        local vecLen = buffer.len(vecBuf)
        assertTest(vecLen == 12, "BufferSerializer: Vector3 Buffer Size", `Expected 12 bytes, got {vecLen}`)

        local roundVec, nextOff = BufferSerializer.DeserializeVector3(vecBuf, 0)
        local vecDiff = (testVec - roundVec).Magnitude
        assertTest(vecDiff &lt; 1e-4, "BufferSerializer: Vector3 Round-trip", `Diff magnitude: {vecDiff}`)
        assertTest(nextOff == 12, "BufferSerializer: Vector3 Offset Return", `Expected offset 12, got {nextOff}`)

        -- Test 1.2: CFrame Serialization (15 bytes exact)
        local testCF = CFrame.new(10, 20, 30) * CFrame.Angles(0.5, -0.2, 0.8)
        local cfBuf = BufferSerializer.SerializeCFrame(testCF)
        local cfLen = buffer.len(cfBuf)
        assertTest(cfLen == 15, "BufferSerializer: CFrame 15b Buffer Size", `Expected 15 bytes, got {cfLen}`)

        local roundCF, cfNextOff = BufferSerializer.DeserializeCFrame(cfBuf, 0)
        local posDiff = (testCF.Position - roundCF.Position).Magnitude
        assertTest(posDiff &lt; 1e-4, "BufferSerializer: CFrame Position Precision", `Position diff: {posDiff}`)
        assertTest(cfNextOff == 15, "BufferSerializer: CFrame Offset Return", `Expected offset 15, got {cfNextOff}`)

        -- Test 1.3: CFrame Serialization 13 bytes
        local cfBuf13 = BufferSerializer.SerializeCFrame13(testCF)
        assertTest(buffer.len(cfBuf13) == 13, "BufferSerializer: CFrame 13b Buffer Size")

        -- Test 1.4: Boolean Bit-Packing (8 per byte)
        local bools = { true, false, true, true, false, false, true, false, true, true } -- 10 booleans -&gt; 2 bytes
        local boolBuf = BufferSerializer.BitPackBooleans(bools)
        local boolBufLen = buffer.len(boolBuf)
        assertTest(boolBufLen == 2, "BufferSerializer: BitPackBooleans Byte Count", `Expected 2 bytes for 10 booleans, got {boolBufLen}`)

        local unpackedBools = BufferSerializer.BitUnpackBooleans(boolBuf, 0, #bools)
        local boolsMatch = true
        for i = 1, #bools do
            if unpackedBools[i] ~= bools[i] then
                boolsMatch = false
                break
            end
        end
        assertTest(boolsMatch, "BufferSerializer: BitUnpackBooleans Round-trip")

        -- Test 1.5: HitVerification Payload Serialization
        local hitPayload: Types.HitVerificationPayload = {
            origin = Vector3.new(0, 5, 0),
            direction = Vector3.new(0, 0, -1),
            distance = 50.5,
            hitPosition = Vector3.new(0, 5, -50.5),
            clientTimestamp = 1000.123456,
            sequenceId = 42,
            weaponId = "RIFLE_AK47",
        }
        local hitBuf = BufferSerializer.SerializeHitVerification(hitPayload)
        local roundHitPayload = BufferSerializer.DeserializeHitVerification(hitBuf, 0)
        assertTest(roundHitPayload.weaponId == "RIFLE_AK47", "BufferSerializer: HitPayload WeaponId Round-trip")
        assertTest((roundHitPayload.origin - hitPayload.origin).Magnitude &lt; 1e-4, "BufferSerializer: HitPayload Origin Round-trip")
        assertTest(roundHitPayload.sequenceId == 42, "BufferSerializer: HitPayload SequenceId Round-trip")
    end

    -- ------------------------------------------------------------------------
    -- TEST SUITE 2: RollbackBuffer &amp; Hermite Spline Interpolation
    -- ------------------------------------------------------------------------
    do
        local rb = RollbackBuffer.new(10, 60)
        local entityId = "Player1"

        -- Push snapshots at t=0s, t=1s, t=2s
        rb:PushSnapshot(entityId, {
            timestamp = 0.0,
            position = Vector3.new(0, 0, 0),
            velocity = Vector3.new(10, 0, 0),
            cframe = CFrame.new(0, 0, 0),
            size = Vector3.new(2, 5, 2),
        })

        rb:PushSnapshot(entityId, {
            timestamp = 1.0,
            position = Vector3.new(10, 0, 0),
            velocity = Vector3.new(10, 0, 0),
            cframe = CFrame.new(10, 0, 0),
            size = Vector3.new(2, 5, 2),
        })

        rb:PushSnapshot(entityId, {
            timestamp = 2.0,
            position = Vector3.new(20, 0, 0),
            velocity = Vector3.new(10, 0, 0),
            cframe = CFrame.new(20, 0, 0),
            size = Vector3.new(2, 5, 2),
        })

        local snapshots = rb:GetSnapshots(entityId)
        assertTest(#snapshots == 3, "RollbackBuffer: Ring Buffer Count", `Expected 3, got {#snapshots}`)

        -- Test Interpolation at t = 0.5s (midway)
        local interpState = rb:GetInterpolatedState(entityId, 0.5)
        assertTest(interpState ~= nil, "RollbackBuffer: GetInterpolatedState Returns Value")

        if interpState then
            -- Hermite cubic spline with linear motion (vel=10) should evaluate position X close to 5.0
            local posErr = math.abs(interpState.position.X - 5.0)
            assertTest(posErr &lt; 1e-3, "RollbackBuffer: Hermite Spline Interpolated Position", `Pos X expected 5.0, got {interpState.position.X}`)
            assertTest(interpState.timestamp == 0.5, "RollbackBuffer: Interpolated Timestamp Preserved")
        end
    end

    -- ------------------------------------------------------------------------
    -- TEST SUITE 3: HitValidation &amp; OBB Slab Ray Intersection
    -- ------------------------------------------------------------------------
    do
        -- Test 3.1: OBB Ray Intersection Test (Pure Mathematical Geometry)
        local rayOrigin = Vector3.new(0, 0, 10)
        local rayDirection = Vector3.new(0, 0, -1) -- Pointing along -Z towards box
        local maxDist = 20.0
        local obbCFrame = CFrame.new(0, 0, 0) -- Centered at origin
        local obbSize = Vector3.new(2, 4, 2) -- Bounds: X[-1,1], Y[-2,2], Z[-1,1]

        local obbResult = HitValidation.TestRayOBB(rayOrigin, rayDirection, maxDist, obbCFrame, obbSize)
        assertTest(obbResult.hit == true, "HitValidation: TestRayOBB Hit True")
        if obbResult.hit then
            -- Ray hits front face of box at Z = +1 (dist = 10 - 1 = 9)
            local distErr = math.abs((obbResult.distance or 0) - 9.0)
            assertTest(distErr &lt; 1e-3, "HitValidation: OBB Hit Distance Precision", `Expected 9.0, got {obbResult.distance}`)
        end

        -- Test 3.2: OBB Ray Intersection Miss
        local rayMissDir = Vector3.new(1, 0, 0) -- Pointing away along +X
        local obbMissResult = HitValidation.TestRayOBB(rayOrigin, rayMissDir, maxDist, obbCFrame, obbSize)
        assertTest(obbMissResult.hit == false, "HitValidation: TestRayOBB Miss")

        -- Test 3.3: Clamped Rollback Window Validation
        local rb = RollbackBuffer.new(60, 60)
        rb:PushSnapshot("Attacker", {
            timestamp = 10.0,
            position = Vector3.new(0, 0, 10),
            velocity = Vector3.zero,
            cframe = CFrame.new(0, 0, 10),
        })
        rb:PushSnapshot("Victim", {
            timestamp = 10.0,
            position = Vector3.new(0, 0, 0),
            velocity = Vector3.zero,
            cframe = CFrame.new(0, 0, 0),
            size = Vector3.new(2, 5, 2),
        })

        local payload: Types.HitVerificationPayload = {
            origin = Vector3.new(0, 0, 10),
            direction = Vector3.new(0, 0, -1),
            distance = 10.0,
            hitPosition = Vector3.new(0, 0, 1),
            clientTimestamp = 10.0,
            sequenceId = 1,
            weaponId = "RIFLE",
        }

        -- Server time = 10.3s (latency = 0.3s = 300ms, valid for 500ms rollback window)
        local valResult = HitValidation.ValidateHit(rb, "Attacker", "Victim", payload, 10.3, {
            maxRollbackMs = 500,
            maxOriginTolerance = 8.0,
            rayDistanceMargin = 4.0,
        })
        assertTest(valResult.valid == true, "HitValidation: ValidateHit Valid Hit", `Reason: {valResult.reason}`)

        -- Server time = 11.5s (latency = 1.5s &gt; max rollback window, should be rejected)
        local valExpiredResult = HitValidation.ValidateHit(rb, "Attacker", "Victim", payload, 11.5, {
            maxRollbackMs = 500,
            maxOriginTolerance = 8.0,
            rayDistanceMargin = 4.0,
        })
        assertTest(valExpiredResult.valid == false, "HitValidation: ValidateHit Reject Expired Timestamp")
        assertTest(valExpiredResult.reason == "TimestampExceedsRollbackWindow", "HitValidation: Reject Reason Correct")
    end

    -- ------------------------------------------------------------------------
    -- TEST SUITE 4: CombatServer &amp; Damage Pipeline
    -- ------------------------------------------------------------------------
    do
        local cs = CombatServer.new(nil, { maxRollbackMs = 500, matchPhase = "InGame" })
        cs:RegisterPlayer(100, 100, 50) -- Attacker
        cs:RegisterPlayer(200, 100, 50) -- Victim (100 HP, 50 Shield)

        cs:UpdatePlayerSpatial(100, Vector3.new(0, 0, 10), Vector3.zero, CFrame.new(0, 0, 10), 100.0)
        cs:UpdatePlayerSpatial(200, Vector3.new(0, 0, 0), Vector3.zero, CFrame.new(0, 0, 0), 100.0)

        local payload: Types.HitVerificationPayload = {
            origin = Vector3.new(0, 0, 10),
            direction = Vector3.new(0, 0, -1),
            distance = 10.0,
            hitPosition = Vector3.new(0, 0, 1),
            clientTimestamp = 10.0,
            sequenceId = 1,
            weaponId = "RIFLE_M4A1",
        }

        -- Process hit (base damage = 40, serverTimestamp = 10.1s)
        local success, reason, remHealth = cs:ProcessHitReport(100, 200, payload, 10.1, 40)
        assertTest(success == true, "CombatServer: ProcessHitReport Success", `Reason: {reason}`)

        local victimHP = cs:GetPlayerHealth(200)
        assertTest(victimHP ~= nil and victimHP.shield == 10, "CombatServer: Shield Damage Absorbed", `Shield remaining: {victimHP and victimHP.shield}`)
        assertTest(victimHP ~= nil and victimHP.health == 100, "CombatServer: Health Preserved When Shielded")

        -- Test rate limiting on rapid hits
        local rateLimitExceeded = false
        for _ = 1, 10 do
            local succ, r, _ = cs:ProcessHitReport(100, 200, payload, 100, 10)
            if not succ and r == "RateLimitExceeded" then
                rateLimitExceeded = true
                break
            end
        end
        assertTest(rateLimitExceeded, "CombatServer: Leaky Bucket Rate Limiter Enforced")

        -- Test match phase blocking
        cs:SetMatchPhase("PostGame")
        local phaseSuccess, phaseReason = cs:ProcessHitReport(100, 200, payload, 100, 10)
        assertTest(phaseSuccess == false and phaseReason == "InvalidMatchPhase", "CombatServer: Discard Inactive Match Phase Hits")
    end

    print("==================================================")
    print(`SUITE COMPLETED: {passed} PASSED, {failed} FAILED`)
    print("==================================================")

    return failed == 0, passed, failed, errors
end

-- Automatically execute test runner if script is executed directly
if not script.Parent:IsA("Model") then
    M2_TestRunner.RunAllTests()
end

return M2_TestRunner
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX85"><Properties><string name="Name">MovementValidator</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Server Movement Validator
    Reconciles client physics buffers against server physics constraints.
    Prevents speed hacking and teleportation by enforcing max Delta V
    and Rubberbanding invalid states.
]=]

local Players = game:GetService("Players")

local MovementValidator = {}

export type PlayerMovementState = {
    lastTimestamp: number,
    lastPosition: Vector3,
    lastVelocity: Vector3,
    violations: number,
    skipNextValidation: boolean?,
    speedMultiplier: number?,
}

local playerStates: { [number]: PlayerMovementState } = {}

-- Constraints based on MovementController max speeds
local MAX_WALK_SPEED = 20.0
local MAX_ACCELERATION = 120.0 -- High to account for instant strafing
local MAX_TOLERANCE_MULTIPLIER = 1.3 -- 30% tolerance for network jitter

function MovementValidator.ValidateClientState(userId: number, timestamp: number, position: Vector3, velocity: Vector3): boolean
    local player = Players:GetPlayerByUserId(userId)
    if not player or not player.Character then return false end

    local hrp = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hrp then return false end

    local state = playerStates[userId]
    if not state then
        -- First state received, initialize it based on server's truth
        playerStates[userId] = {
            lastTimestamp = timestamp,
            lastPosition = hrp.Position,
            lastVelocity = hrp.AssemblyLinearVelocity,
            violations = 0,
        }
        return true
    end

    local dt = timestamp - state.lastTimestamp
    if dt &lt;= 0 then return false end -- Out of order or duplicate packet

    if state.skipNextValidation then
        state.skipNextValidation = false
        state.lastTimestamp = timestamp
        state.lastPosition = position
        state.lastVelocity = velocity
        return true
    end

    -- 1. Validate Velocity Magnitude (Speed Hack)
    local multiplier = state.speedMultiplier or 1.0
    local horizVel = Vector3.new(velocity.X, 0, velocity.Z)
    if horizVel.Magnitude &gt; MAX_WALK_SPEED * MAX_TOLERANCE_MULTIPLIER * multiplier then
        state.violations += 1
        return false
    end

    -- 2. Validate Acceleration (Instant TP / Speed Hack)
    local dv = (velocity - state.lastVelocity).Magnitude
    local expectedMaxDv = MAX_ACCELERATION * dt * MAX_TOLERANCE_MULTIPLIER
    if dv &gt; expectedMaxDv and velocity.Y &gt;= 0 then -- Ignore downward falling acceleration which can be huge
        state.violations += 1
        return false
    end

    -- 3. Validate Position (Teleportation)
    local dp = (position - state.lastPosition).Magnitude
    -- Max possible distance traveled = max speed * dt
    local expectedMaxDp = (MAX_WALK_SPEED * MAX_TOLERANCE_MULTIPLIER) * dt
    -- Allow some extra tolerance for falling or external physics impulses
    if dp &gt; expectedMaxDp + 5.0 then
        state.violations += 1
        return false
    end

    -- Valid state
    state.lastTimestamp = timestamp
    state.lastPosition = position
    state.lastVelocity = velocity
    
    -- Decay violations
    if state.violations &gt; 0 then
        state.violations = math.max(0, state.violations - 1)
    end
    
    return true
end

function MovementValidator.HandleViolation(userId: number)
    local state = playerStates[userId]
    if not state then return end
    
    -- Rubberband player back to last valid server position
    local player = Players:GetPlayerByUserId(userId)
    if player and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if hrp then
            hrp.CFrame = CFrame.new(state.lastPosition)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
    
    -- Reset state to allow clean reconciliation
    playerStates[userId] = nil
end

function MovementValidator.ClearPlayer(userId: number)
    playerStates[userId] = nil
end

function MovementValidator.NotifyTeleport(player: Player)
    local state = playerStates[player.UserId]
    if state then
        state.skipNextValidation = true
    end
end

function MovementValidator.SetSpeedMultiplier(player: Player, multiplier: number)
    local state = playerStates[player.UserId]
    if state then
        state.speedMultiplier = multiplier
    end
end

return MovementValidator
]]&gt;</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX86"><Properties><string name="Name">RollbackBuffer</string><ProtectedString name="Source">&lt;![CDATA[--!strict
--[=[
    Project OVERCLOCK: Rollback Spatial Ring Buffer
    Circular ring buffer storing per-entity spatial snapshots at ~60Hz with configurable capacity.
    Provides Hermite cubic spline state interpolation between snapshots for lag compensation.
]=]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage:WaitForChild("Types") :: any)

export type SpatialSnapshot = {
    timestamp: number,
    position: Vector3,
    velocity: Vector3,
    cframe: CFrame,
    size: Vector3?,
}

type EntityRingBuffer = {
    capacity: number,
    count: number,
    head: number, -- 1-based write index
    snapshots: { SpatialSnapshot },
}

local RollbackBuffer = {}
RollbackBuffer.__index = RollbackBuffer

export type RollbackBufferClass = typeof(setmetatable({} :: {
    _defaultCapacity: number,
    _sampleRateHz: number,
    _buffers: { [string]: EntityRingBuffer },
}, RollbackBuffer))

--- Creates a new RollbackBuffer manager.
-- Default capacity is 120 (2 seconds at 60Hz tick rate).
function RollbackBuffer.new(capacity: number?, sampleRateHz: number?): RollbackBufferClass
    local self = setmetatable({
        _defaultCapacity = capacity or 120,
        _sampleRateHz = sampleRateHz or 60,
        _buffers = {} :: { [string]: EntityRingBuffer },
    }, RollbackBuffer)
    return self
end

function RollbackBuffer._getOrCreateBuffer(self: RollbackBufferClass, entityId: string): EntityRingBuffer
    local buf = self._buffers[entityId]
    if not buf then
        buf = {
            capacity = self._defaultCapacity,
            count = 0,
            head = 1,
            snapshots = table.create(self._defaultCapacity) :: { SpatialSnapshot },
        }
        self._buffers[entityId] = buf
    end
    return buf
end

--- Pushes a spatial snapshot into the circular ring buffer for entityId.
function RollbackBuffer.PushSnapshot(self: RollbackBufferClass, entityId: string, snapshot: SpatialSnapshot)
    local buf = self._getOrCreateBuffer(self, entityId)
    buf.snapshots[buf.head] = snapshot
    buf.head = (buf.head % buf.capacity) + 1
    if buf.count &lt; buf.capacity then
        buf.count += 1
    end
end

--- Returns all valid stored snapshots for an entity, ordered by timestamp ascending.
function RollbackBuffer.GetSnapshots(self: RollbackBufferClass, entityId: string): { SpatialSnapshot }
    local buf = self._buffers[entityId]
    if not buf or buf.count == 0 then
        return {}
    end

    local result: { SpatialSnapshot } = table.create(buf.count)
    local startIdx = 1
    if buf.count == buf.capacity then
        startIdx = buf.head -- Oldest snapshot is at head when ring buffer is full
    end

    for i = 1, buf.count do
        local idx = ((startIdx + i - 2) % buf.capacity) + 1
        result[i] = buf.snapshots[idx]
    end

    return result
end

--- Calculates Hermite cubic spline interpolated spatial state at the requested timestamp.
-- Interpolates position and velocity via Hermite basis functions and orientation via Slerp.
function RollbackBuffer.GetInterpolatedState(self: RollbackBufferClass, entityId: string, timestamp: number): SpatialSnapshot?
    local snapshots = self:GetSnapshots(entityId)
    local count = #snapshots
    if count == 0 then
        return nil
    end

    -- Edge boundary cases
    if timestamp &lt;= snapshots[1].timestamp then
        return snapshots[1]
    end
    if timestamp &gt;= snapshots[count].timestamp then
        return snapshots[count]
    end

    -- Binary search for surrounding snapshots s0 (&lt;= timestamp) and s1 (&gt;= timestamp)
    local low = 1
    local high = count
    local i0 = 1

    while low &lt;= high do
        local mid = math.floor((low + high) / 2)
        if snapshots[mid].timestamp &lt;= timestamp then
            i0 = mid
            low = mid + 1
        else
            high = mid - 1
        end
    end

    local i1 = math.min(i0 + 1, count)
    local s0 = snapshots[i0]
    local s1 = snapshots[i1]

    if i0 == i1 or math.abs(s1.timestamp - s0.timestamp) &lt; 1e-6 then
        return s0
    end

    -- Hermite cubic spline interpolation calculations
    local dt = s1.timestamp - s0.timestamp
    local u = (timestamp - s0.timestamp) / dt
    local u2 = u * u
    local u3 = u2 * u

    -- Hermite basis functions
    local h00 = 2 * u3 - 3 * u2 + 1
    local h10 = u3 - 2 * u2 + u
    local h01 = -2 * u3 + 3 * u2
    local h11 = u3 - u2

    -- Tangents scaled by interval duration dt
    local m0 = s0.velocity * dt
    local m1 = s1.velocity * dt

    -- Interpolated position P(u)
    local interpPos = s0.position * h00 + m0 * h10 + s1.position * h01 + m1 * h11

    -- Hermite basis function derivatives for velocity tangent V(u) = dP/dt
    local dh00 = 6 * u2 - 6 * u
    local dh10 = 3 * u2 - 4 * u + 1
    local dh01 = -6 * u2 + 6 * u
    local dh11 = 3 * u2 - 2 * u

    local dPdu = s0.position * dh00 + m0 * dh10 + s1.position * dh01 + m1 * dh11
    local interpVel = dPdu / dt

    -- Orientation interpolation (Slerp via CFrame Lerp on rotation)
    local rot0 = s0.cframe.Rotation
    local rot1 = s1.cframe.Rotation
    local interpRot = rot0:Lerp(rot1, u)
    local interpCFrame = CFrame.new(interpPos) * interpRot

    -- Size interpolation if present
    local interpSize: Vector3? = nil
    if s0.size and s1.size then
        interpSize = s0.size:Lerp(s1.size, u)
    elseif s0.size then
        interpSize = s0.size
    elseif s1.size then
        interpSize = s1.size
    end

    return {
        timestamp = timestamp,
        position = interpPos,
        velocity = interpVel,
        cframe = interpCFrame,
        size = interpSize,
    }
end

--- Clears stored snapshot buffer for an entity.
function RollbackBuffer.ClearEntity(self: RollbackBufferClass, entityId: string)
    self._buffers[entityId] = nil
end

--- Clears all entity snapshot buffers.
function RollbackBuffer.ClearAll(self: RollbackBufferClass)
    table.clear(self._buffers)
end

return RollbackBuffer
